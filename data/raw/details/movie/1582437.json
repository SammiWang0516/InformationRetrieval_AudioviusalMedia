      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Gorsza od samej burzy na wrzosowiskach okazuje się prawda o dworze Wuthering Heights, nawiedzonym przez mściwego ducha Catherine Earnshaw. Pogrążony w obsesji Heathcliff składa jej w ofierze przypadkowych ludzi, by przywrócić ukochaną do życia. Przybyły do posiadłości Lockwood musi za wszelką cenę uciec z przeklętego domu, zanim sam trafi pod nóż.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BE",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Meneer Lockwood arriveert in de afgelegen en door storm geteisterde Wuthering Heights, niet wetende dat Catherine's wraakzuchtige geest door de gangen loopt. Haar geobsedeerde minnaar, Heathcliff, voedt haar bloeddorst met mensenoffers, in de hoop haar ziel een nieuw lichaam te geven om in te wonen. Terwijl Lockwood ziek wordt en waanvoorstellingen krijgt, wordt hij dieper meegezogen in hun dodelijke, eeuwige liefde en moet hij ontsnappen voordat hij hun volgende slachtoffer wordt.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
