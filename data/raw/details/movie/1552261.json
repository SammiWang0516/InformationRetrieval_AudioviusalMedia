        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "W ciągu zaledwie kilku dni Antoine Blanchet, spadkobierca rodzinnej firmy produkującej na skalę przemysłową, staje się obiektem katastrofy. Zwolniony były pracownik głośno protestuje i koczuje przed fabryką; brygadzista naraża produkcję, ponieważ zdradza go żona; nieodparty stażysta przyciąga wzrok… W przededniu otrzymania nagrody za wybitne osiągnięcia, mającej uhonorować jego fabrykę, musi pilnie ratować firmę i utrzymać porządek w swoim dobrze zorganizowanym, małym świecie. Zabiera się do tego na swój własny, paternalistyczny i autorytarny sposób: jak każdy dobry szef?",
          "runtime": 87,
          "tagline": "",
          "title": "Un bon patron"
        }
      }
    ]
