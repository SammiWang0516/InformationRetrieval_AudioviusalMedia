      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Ранен бандит намира неочаквана милост в грижите за дъщерята на ранчо. Надеждата на любовта го дърпа към различен живот, докато законът и насилственото му минало не се затварят в новия му дом. Сега трябва да избере какъв човек ще стане.",
          "runtime": 0,
          "tagline": "",
          "title": "Ангел и Лошият Човек"
        }
      },
      {
        "iso_3166_1": "ES",
