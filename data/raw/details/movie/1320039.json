  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.quiverdistribution.com/slate/stranglehold",
          "overview": "Fed up with their lives, barely eking by in small-town Arkansas, a stripper with dreams and her Army vet husband decide to rob the strip club that employs her.",
          "runtime": 105,
          "tagline": "It's the most wonderful crime of the year.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "A kisvárosi Arkansasban élő Bailey egzotikus táncosként dolgozik, miközben egyre nehezebben viseli a nélkülözést, és a közösségi médiában látott csillogó életekhez méri saját kilátástalan hétköznapjait. Karácsony közeledtével, hogy kisbabájuknak szebb ünnepet és maguknak jobb jövőt teremtsenek, volt katona férjével, Timmel elhatározzák, hogy kirabolják azt a sztriptízklubot, ahol Bailey dolgozik. A kétségbeesettnek szánt, gyors pénzszerzési akció azonban hamar veszélyes káosszá fajul, amikor kiderül, hogy ugyanazon az estén a klubban alvilági figurák is jelen vannak, és a rosszul időzített rablás nemcsak a tervüket, hanem az életüket is veszélybe sodorja.",
          "runtime": 105,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Bailey to tancerka erotyczna o wielkich marzeniach. Wraz z mężem Timem – weteranem armii – mają dość życia w niedostatku w małym miasteczku w Arkansas, więc postanawiają obrabować klub ze striptizem, w którym ona pracuje.",
          "runtime": 0,
          "tagline": "To najwspanialsze przestępstwo roku.",
          "title": "Stranglehold"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "小镇脱衣舞娘贝利与退伍丈夫生活拮据，为给襁褓中的女儿过一个像样的圣诞节，二人密谋抢劫她打工的脱衣舞俱乐部。不料行动当晚黑帮大佬恰好到访，抢劫计划全面失控，这对底层夫妻被迫卷入黑道混战，求财之路直接变成生死逃亡。",
          "runtime": 0,
          "tagline": "",
          "title": "穷煞鸳鸯"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "아칸소의 작은 마을, 스트립 클럽 댄서 베일리는 아무리 일해도 나아지지 않는 형편에 지쳐 간다. 어린 딸에게만큼은 제대로 된 크리스마스를 선물하고 싶었던 그녀는 군인 출신 남편 팀과 손잡고 자신이 일하는 클럽을 털기로 한다. 하지만 하필 결행의 밤, 지역을 주무르는 범죄 조직의 보스가 아들과 함께 클럽에서 크리스마스 파티를 벌이고 있다. 치밀하게 세운 계획은 순식간에 어긋나고, 클럽 안에 갇힌 사람들 사이로 총성과 피가 터져 나오기 시작한다. 크리스마스 이브의 은밀한 한탕이 걷잡을 수 없는 인질극으로 번진 이 밤, 베일리와 팀은 무사히 딸의 곁으로 돌아갈 수 있을까.",
          "runtime": 0,
          "tagline": "가장 위험한 크리스마스 선물을 훔치러 간다",
          "title": "스트랭글홀드"
        }
      }
    ]
  },
