      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Lola (16 lat) to samotna dziewczyna, naznaczona traumą, która towarzyszy jej od dzieciństwa: tajemniczym zniknięciem ojca. Choć jest utalentowaną pływaczką i posiada pokaźną kolekcję medali, skrywa pewien sekret – nie potrafi pływać stylem motylkowym. Jej relacja z matką jest pełna napięć, a po jednej z kolejnych kłótni Lola postanawia spędzić wakacje samotnie w miejscowości, w której mieszka jej wujek. Tam życie nastolatki zmienia się diametralnie: zakochuje się w Gabrielu, poznaje nowych przyjaciół i dołącza do lokalnej drużyny pływackiej, która zmaga się z wieloma trudnościami. Teraz, za każdym razem, gdy Lola wchodzi do wody, nowe emocje budzą w niej wspomnienia z przeszłości. Tuż przed ważnymi zawodami dziewczyna musi stawić czoła lękom i traumom, których się nie spodziewała – w tym poznać prawdę o śmierci swojego ojca.",
          "runtime": 0,
          "tagline": "",
          "title": "Medley"
        }
      }
