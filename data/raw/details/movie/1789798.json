  "translations": {
    "translations": [
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Hanabi treina todos os dias para virar gigante, assim, acredita que poderá viver na Vila do Futuro, no topo de uma imensa montanha onde tudo é verde e a água é fresca. Seu povo se divide de acordo com a altura: quanto mais alto, mais perto se vive da Vila do Futuro. Obcecada por ser gigante, Hanabi resolve adentrar um patamar na montanha que é proibido para ela, por ela ser considerada pequena demais. Então, ela é expulsa de sua vila e mandada para um exílio. Nessa jornada, ela encontra um misterioso gigante, Bonjongo. Depois de insistir que ele a treine, uma amizade surge. Hanabi aprende com ele outra forma de ser gigante e questiona as tradições de sua própria origem.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      }
    ]
  },
