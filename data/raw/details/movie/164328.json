      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Em um apartamento em Berlim, uma família se reúne para uma tarde de rituais prosaicos: uma conversa em torno da mesa de jantar, o conserto de uma máquina de lavar ou pequenos reparos, como pregar um botão que foi deliberadamente arrancado. Em uma cadeia de ações e reações cuidadosamente encenada, os mais simples gestos familiares ganham aos poucos contornos absurdos, em que até animais e objetos desempenham novos papéis.",
          "runtime": 0,
          "tagline": "",
          "title": "A Gatinha Esquisita"
        }
      }
