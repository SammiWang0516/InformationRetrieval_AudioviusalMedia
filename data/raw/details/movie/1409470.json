  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "黄燕（宋佳 饰）在按部就班的火化工作中逐渐失去了对生活的期待，变得悲观麻木。直到她意识到自己终将死亡，才决定更勇敢、更大胆地活出自我。一次意外，让她与通透、明媚的姚雪（文淇 饰）相遇。她们彼此治愈，像冬天里靠在一起取暖的两个人；她们互相擦干眼泪，勇敢做自己想做的事，把自己放在人生的第一位，一起体验这仅有一次的人生！",
          "runtime": 113,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Huang Yan, a terminally ill crematorium worker, accidentally mixed up two sets of ashes during her work. When she confessed the truth, neither family wanted to swap them back. Only Yao Xue, the daughter of one of the deceased, believed Huang Yan. The two embarked on a wild and absurd journey to return the ashes, where they came to understand life anew and chose to live bravely in the face of death.",
          "runtime": 114,
          "tagline": "",
          "title": "Embers"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "身患絕症的女火化師黃燕在工作中誤將兩份骨灰弄錯，當她坦白真相，兩家人竟都不願換回，唯有其中一位死者的女兒姚雪相信黃燕，兩人結伴踏上瘋狂而荒誕的換骨灰之路，重新理解生命，向死而生。",
          "runtime": 0,
          "tagline": "",
          "title": "餘燼"
        }
      }
    ]
