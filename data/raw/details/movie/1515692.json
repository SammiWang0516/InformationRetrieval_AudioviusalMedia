        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Im Jahr 1986 sperrt ein schüchterner achtjähriger Junge in Madras versehentlich einen gefürchteten Gangster in einer verlassenen Schultoilette ein. Während der Gangster mit Hunger, Einsamkeit und seiner eigenen Verletzlichkeit konfrontiert ist, entsteht zwischen den beiden eine ungewöhnliche Verbindung, die ihr Leben für immer verändert.",
          "runtime": 160,
          "tagline": "",
          "title": "Baththa"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "1986年马德拉斯，一个胆怯的八岁男孩意外将一名令人闻风丧胆的黑帮分子锁在学校洗手间。一段意想不到的友谊由此展开，也让两人的人生发生改变。",
          "runtime": 0,
          "tagline": "",
          "title": "禁闭洗手间"
        }
      },
      {
        "iso_3166_1": "GR",
        "iso_639_1": "el",
        "name": "ελληνικά",
        "english_name": "Greek",
        "data": {
          "homepage": "",
          "overview": "Στο Μαντράς του 1986, ένα δειλό οκτάχρονο αγόρι παγιδεύει κατά λάθος έναν διαβόητο γκάνγκστερ μέσα στις εγκαταλελειμμένες τουαλέτες ενός σχολείου. Καθώς ο γκάνγκστερ αναγκάζεται να έρθει αντιμέτωπος με την πείνα, τη μοναξιά και την ίδια του την ευαλωτότητα, ένας απρόσμενος δεσμός αρχίζει να αναπτύσσεται μεταξύ τους, αλλάζοντας τις ζωές τους για πάντα.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
