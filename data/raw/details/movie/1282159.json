        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Dwie najlepsze przyjaciółki, Emma i Phoebe, postanawiają zajść w ciążę jednocześnie, aby wspólnie stawić czoła macierzyństwu. Ich przyjaźń zostaje jednak wystawiona na próbę, gdy tylko jedna z nich zachodzi w ciążę.",
          "runtime": 90,
          "tagline": "",
          "title": "Let's Have Kids!"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Les amies d'enfance Emma et Phoebe ont le pacte de tomber enceintes en même temps, persuadées de pouvoir affronter la maternité ensemble. Mais quand leur plan plonge dans le chaos, ce qui devait les rapprocher menace de les séparer. Alors que leurs vies s'éloignent, elles doivent lutter pour protéger l'amitié qui les a fait traverser toutes les épreuves.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Две най-добри приятелки решават да станат майки заедно, но когато само едната забременява, приятелството им е подложено на тежко изпитание.",
          "runtime": 0,
          "tagline": "",
          "title": "Да си имаме деца!"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "两位从小到大的挚友 Emma 与 Phoebe 约定要在同一时间怀孕，自信能够携手并肩体验为人父母的奇妙旅程。然而，计划赶不上变化，最终仅有一人成功怀孕。这一重大人生阶段的落差导致原本亲密的计划陷入混乱，两人的生活轨迹开始朝不同方向拉扯，这段深厚的友谊也面临着严峻的考验。",
          "runtime": 0,
          "tagline": "",
          "title": "好孕同盟"
        }
      }
