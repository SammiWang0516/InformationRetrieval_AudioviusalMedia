      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Trīs pusaugu meiteņu tēvi Bils, Bobo un Pontuss pievienojas kā pieskatītāji savu bērnu klasei ekskursijā izolētā arhipelāgā. Lai arī visu pušu – vecāku, bērnu un kempinga darbinieku – nodomi ir paši labākie, dažas situācijas viņi vienkārši nevarēja paredzēt. Spriedze starp paaudzēm strauji pieaug un visu savaldība sāk izčākstēt. Mijoties aizvainojumam un atmiņām, vecāki kļūst par bērniem, bet bērni grib spēlēt pieaugušos. Un drīz neviens vairs nevar nošķirt: kurš ir noteicējs un kurš ir briesmās?",
          "runtime": 0,
          "tagline": "",
          "title": "Pieaugušo uzraudzība"
        }
