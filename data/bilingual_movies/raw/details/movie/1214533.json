      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Dans un pays marqué par de profondes disparités raciales et socio-économiques, une femme noire d'origine rurale remet en question le statu quo en se présentant comme candidate à l'élection présidentielle. En se réappropriant le terme « égalé », Francia Márquez, qui est alors devenue vice-présidente de la Colombie lors des dernières élections, donne le coup d'envoi d'un mouvement sans précédent. Après quinze ans de production, ce documentaire révèle comment le changement peut se produire.",
          "runtime": 81,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "라틴 아메리카에서 가장 불평등한 나라 중 하나인 콜롬비아 흑인 농촌 운동가인 프란시아 마르케스(Francia Márquez)는 국가가 꿈을 꾸도록 영감을 주는 대통령 캠페인으로 관습에 도전한다.",
          "runtime": 81,
          "tagline": "",
          "title": "이구알라다, 쟁취하는 자"
        }
      }
