  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A retired professor in his seventies enjoys a quiet, carefree life – until his daughter, amid a marital crisis, arrives with her two unruly children. As his peaceful routine unravels, he’s drawn into the chaos of family and unexpected emotions. Through this upheaval, he rediscovers the beauty and pain of love, and the deep human need to connect—despite the cost.",
          "runtime": 97,
          "tagline": "",
          "title": "Damned If You Do, Damned If You Don't"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Riuscire a evitare tutti i fastidi della vita quotidiana, mettersi in salvo da ogni rottura di scatole è sufficiente per essere felici? Il professore a settant’anni suonati ha trovato finalmente la serenità, ha una bella casa, una discreta pensione, degli amici con cui scherzare, una signora con cui passare qualche giornata. Si dedica solo a cose piacevoli. Fino a quando la sua vita è messa sottosopra dall’arrivo della figlia, in crisi coniugale, e dei due ingombrantissimi nipotini. Nuove preoccupazioni, nuove angosce, ma anche nuovi affetti. Comincia così un’avventura nelle vite sentimentali degli altri, e nella sua, che gli farà capire che l’amore vale sempre la pena di essere vissuto, anche se porta tribolazioni, sacrifici e patimenti. Un film che riflette sull’amore e sull’inesorabile istinto degli esseri umani a mischiare il proprio destino con quello degli altri, con tutto quello che ne può derivare: fatiche ma anche gioie, e l’impressione di aver vissuto veramente.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "La vida tranquila de un profesor jubilado con una buena pensión, amigos y una compañera se ve alterada cuando su hija llega a su casa, atravesando una crisis matrimonial, acompañada por sus dos hijos indisciplinados.",
          "runtime": 0,
          "tagline": "",
          "title": "Hagas lo que hagas, está mal"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Ein pensionierter Professor in seinen Siebzigern geniesst ein ruhiges Leben, bis seine Tochter, die mitten in einer Ehekrise steckt, mit ihren beiden ungestümen Kindern bei ihm auftaucht. Als seine sorgenfreie Routine aus den Fugen gerät, wird er in das familiäre Chaos hineingezogen. Durch diesen emotionalen Umbruch entdeckt er, dass die Liebe trotz aller Schwierigkeiten, Opfer und Herausforderungen immer lebenswert ist.",
          "runtime": 97,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um professor aposentado tem sua rotina tranquila transformada pela chegada da filha em crise e de seus dois netos indisciplinados. Em meio ao caos familiar, ele redescobre o amor, a dor dos vínculos e a necessidade humana de se conectar.",
          "runtime": 101,
          "tagline": "",
          "title": "Querendo ou Não"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Идеальный день профессора на пенсии - это когда ничего не происходит. Уютный дом, ленивый сон на диване и никаких забот. Но идиллия рушится, когда в дверях появляется дочь с внуками - она ушла от мужа, который ей изменил, и теперь им негде жить. Из размеренного убежища его квартира превращается в сумасшедший дом. Теперь у профессора одна миссия: помирить дочь с мужем.",
          "runtime": 0,
          "tagline": "",
          "title": "Семья на мою голову"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "פרופסור בדימוס מנהל חיים שלוים ונעימים – פנסיה נאה, חברים קבועים, ארוחות ויין טוב; אלא שהשקט מתפוגג בן-לילה כשבתו נוחתת בביתו עם שני ילדיה הסוערים ונישואים על סף פירוק. על רקע רחובות רומא הציוריים, הכיכרות ובתי הקפה הקטנים, נפרש בלגן משפחתי מצחיק - סיפור על דור ההורים שנאלץ ללמוד מחדש מהי משפחה, אחריות וסבלנות – ובעיקר איך לשרוד את הדור הבא.",
          "runtime": 0,
          "tagline": "",
          "title": "המשפחה האיטלקית שלי"
        }
      }
    ]
