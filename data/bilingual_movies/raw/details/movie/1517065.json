        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Two newly dead young people meet in the streets of Athens, amid the pulsing cityscape and the ghosts of history. One a translator, the other a photographer, they were outsiders in life; in death they struggle with the residue of their longings and mistakes. They wander the city together, finding consolation in the difficult beauty of existence and its aftermath.",
          "runtime": 27,
          "tagline": "",
          "title": ""
        }
      },
