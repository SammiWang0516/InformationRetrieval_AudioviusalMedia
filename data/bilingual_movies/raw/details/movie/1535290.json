      {
        "iso_3166_1": "IN",
        "iso_639_1": "hi",
        "name": "हिन्दी",
        "english_name": "Hindi",
        "data": {
          "homepage": "",
          "overview": "इंग को एक सुदूर द्वीप पर स्थित एक बालिका सुधार विद्यालय में भेजा जाता है। इंग को जल्दी ही पता चल जाता है कि विद्यालय का एकमात्र नियम सरल है। विद्यालय के प्रधानाचार्य की पूर्ण आज्ञाकारिता। विद्यालय एक सख्त पदानुक्रम के तहत संचालित होता है, जिसमें प्रधानाचार्य की पसंदीदा छात्रा, ऐम, सबसे ऊपर और इंग सबसे नीचे होती है। उसके आगमन के कुछ ही समय बाद, परेशान करने वाली घटनाओं की एक श्रृंखला शुरू हो जाती है। जैसे-जैसे ये परेशान करने वाली घटनाएँ बढ़ती जाती हैं, इंग को एक भयावह प्रश्न का सामना करना पड़ता है: क्या वह केवल इन अलौकिक घटनाओं का शिकार है, या वह स्वयं इनका स्रोत हो सकती है?",
