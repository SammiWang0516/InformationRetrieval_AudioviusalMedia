  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "อิงถูกส่งตัวไปยังโรงเรียนปฏิรูปพินิจคุน ซึ่งเป็นเรือนจำหญิงล้วนบนเกาะอันห่างไกล อิงตกเป็นเป้าเล่นงานจาก เอม หัวโจกของเหล่าเด็กสาว ทำให้ทุกวันของอิงไม่ต่างจากตกนรกทั้งเป็น มีเพียง ปิ่น หนุ่มคนเรือ เป็นความหวังเดียวที่จะพาเธอหนีออกไปจากที่นี่ แต่ไม่มีใครหรือแม้แต่อิงรู้เลยว่า บางสิ่งที่น่ากลัว สยดสยอง อย่าง ผีแม่ซื้อ ได้เกาะติดอิงมายังที่นี่ด้วย และมันกำลังทำให้เกาะแห่งนี้กลายเป็นนรกที่ไร้ทางออก",
          "runtime": 0,
          "tagline": "",
          "title": "แม่ซื้อ"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Ing is sent to Pinijkhun Reform School, an all-girls facility on a remote island. The only rule here is that everyone must obey orders.",
