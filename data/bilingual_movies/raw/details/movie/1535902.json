  "translations": {
    "translations": [
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "兩位美軍遺留在臺灣的混血兒，一人說客語，一人說臺語，在廢棄的美軍宿舍中，緩緩說出語言與臉孔無法安置的身世。他們的記憶，如幽靈般在歷史邊界中游移，沉默與斷裂化為一場詩性的凝視。以雙頻道影像與催眠式敘事，抵抗觀看與語言的單一結構，召喚那些被歷史壓抑的聲音與身體。",
          "runtime": 20,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
