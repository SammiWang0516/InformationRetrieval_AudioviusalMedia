        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Arini e sua família foram para uma cidade pequena para começar uma nova vida, mas tudo se transforma em um desastre depois que encontram um espelho antigo em um armazém secreto.",
          "runtime": 0,
          "tagline": "",
