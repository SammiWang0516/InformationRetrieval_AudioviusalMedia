    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "After separating from her husband Medhi, Elodie’s life is thrown off balance. When she learns, while staying at her parents’ house, of an event from her early childhood that had been kept secret for decades, she begins to explore the causes of her emotional blockages. The search for the truth leads her into her own past and confronts her with family silence, repressed memories, and the question of how early experiences shape a person’s life.",
          "runtime": 89,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Nach der Trennung von ihrem Mann Medhi gerät Elodies Leben aus dem Gleichgewicht. Als sie im Elternhaus von einem jahrzehntelang verschwiegenen Ereignis aus ihrer frühen Kindheit erfährt, beginnt sie, den Ursachen ihrer emotionalen Blockaden nachzugehen. Die Suche nach der Wahrheit führt sie in die eigene Vergangenheit und konfrontiert sie mit familiärem Schweigen, verdrängten Erinnerungen und der Frage, wie früheste Erfahrungen ein Leben prägen. So wächst aus der Auseinandersetzung die Möglichkeit eines Neuanfangs.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
