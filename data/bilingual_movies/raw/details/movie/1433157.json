  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Alliant poésie, science et émotion, ce film retrace l’histoire du vivant, de ses origines cosmiques à son évolution sur notre planète, en passant par les merveilles de la biodiversité et les défis contemporains auxquels elle fait face. À travers des images spectaculaires, Yann Arthus-Bertrand y interroge les paradoxes de notre époque et exhorte à une transformation collective pour réconcilier l'humanité avec la nature.",
          "runtime": 105,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Combining poetry, science and emotion, this film traces the history of life, from its cosmic origins to its evolution on our planet, through the wonders of biodiversity and the contemporary challenges it faces. Through spectacular images, Yann Arthus-Bertrand questions the paradoxes of our times and urges a collective transformation to reconcile humanity with nature.",
          "runtime": 105,
          "tagline": "",
          "title": "Nature: The Call for Reconciliation"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Mit atemberaubenden Bildern von Menschen, Tieren und Landschaften zeigt der vielfach preisgekrönte französische Filmemacher Yann Arthus-Bertrand in seinem bisher persönlichsten Film die unfassbare Vielfalt unserer Welt.",
          "runtime": 90,
          "tagline": "",
          "title": "Natur - Die Geschichte unseres Planeten"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "시와 과학, 감성을 아우르며 우주적 기원에서 지구의 진화와 생물다양성의 경이, 오늘의 위기까지 생명의 역사를 따라간다. 얀 아르튀스-베르트랑은 장엄한 이미지로 시대의 모순을 묻고, 인간과 자연의 새로운 화해를 위한 공동의 변화를 촉구한다.",
          "runtime": 105,
          "tagline": "",
          "title": "네이처: 화해를 위한 부름"
        }
      }
