  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "出身聋人家庭的健听律师李淇熟悉手语，却一直希望摆脱过去的生活，凭自己的能力获得名利与认可。一次偶然的机会，让他接触到一宗专门针对聋人群体的房产诈骗案件。起初，李淇把这场官司视作改变事业和生活的机会，并凭借自己的特殊背景逐渐受到关注。然而随着调查深入，他发现受害者面对的不只是一场普通骗局，背后还牵扯着更加复杂的利益关系。站在个人前途与那些信任他的聋人之间，李淇也开始不得不重新面对自己一直试图远离的世界……",
          "runtime": 125,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Lawyer Li Qi, driven by greed, becomes embroiled in a fraud case against deaf individuals, abandoning his deaf family background in pursuit of fame and fortune.",
          "runtime": 125,
          "tagline": "",
          "title": "Sound of Silence"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "灰度律師李淇（檀健次 飾）因出身於聾人家庭，被捲入一場聾人反詐案中。當他利用案件名利雙收之時，卻未曾想詐騙案遠比想像的複雜。這一次，在慾望和良知的抉擇中，他會如何破局？本片部分取材自 CODA 律師張琪真實從業經歷。",
          "runtime": 0,
          "tagline": "",
          "title": "震耳欲聾"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "灰度律師李淇（檀健次飾）因出身于聾人家庭，被卷入一場聾人反詐案中。當他利用案件名利雙收之時，卻未曾想詐騙案遠比想象的複雜。這一次，在欲望和良知的抉擇中，他會如何破局？本片部分取材自CODA律師張琪真實從業經歷。",
          "runtime": 125,
          "tagline": "",
          "title": "震耳欲聾"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "청각장애인 가정에서 태어나 회색지대를 오가며 살아온 변호사. 성공만을 좇던 그는 어린 청각장애 의뢰인의 사건을 맡으며, 자신이 걸어온 길을 의심하게 된다.",
          "runtime": 0,
          "tagline": "",
          "title": "고요한 외침"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ทนายความหนุ่มที่เกิดในครอบครัวคนหูหนวก (CODA) ซึ่งพยายามทิ้งรากเหง้าเพื่อแสวงหาความก้าวหน้า แต่กลับต้องมาพัวพันกับคดีฉ้อโกงที่เกี่ยวข้องกับผู้พิการทางการได้ยิน ทำให้นำไปสู่การทดสอบศีลธรรมและความขัดแย้งในใจ",
          "runtime": 0,
          "tagline": "",
          "title": "เสียงกู่ร้องในความเงียบ"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Sinh ra trong gia đình có cha mẹ khiếm thính, vị luật sư tham vọng nọ đặt câu hỏi về con đường của mình sau khi nhận vụ án liên quan đến một thân chủ trẻ cũng mất thính lực.",
          "runtime": 0,
          "tagline": "",
          "title": "Đinh Tai Nhức Óc"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Юрист Ли Ци вырос в семье глухонемых, поэтому владеет жестовым языком. Когда его просит о помощи глухонемая девушка Чжан Сяожуй, он оказывается втянут в дело о борьбе с мошенничеством в среде глухонемых. Ци достигает успеха и славы благодаря этому делу, однако он не подозревает, что мошенническая схема оказалась намного сложнее. Адвокат оказывается перед выбором между жаждой наживы и совестью.",
          "runtime": 0,
          "tagline": "",
          "title": "Звук тишины"
        }
