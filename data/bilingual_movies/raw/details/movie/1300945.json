      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Chen Yutong, una estudiante de secundaria, muere tras caer desde lo alto después de sufrir acoso escolar durante un largo periodo. El acoso no cesa y se extiende a su mejor amiga. Sin embargo, los acosadores comienzan a morir uno a uno en circunstancias misteriosas. A medida que se desarrollan los asesinatos en serie, surgen varios sospechosos: la madre de la niña, que fue testigo de cómo le sellaban la boca a su hija con pegamento, o el conserje de la escuela, que parece conocer la verdad",
          "runtime": 0,
          "tagline": "",
          "title": "Un lugar llamado silencio"
        }
      }
