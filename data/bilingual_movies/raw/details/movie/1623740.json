      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Después de escapar de la prisión durante el ataque de un monstruo, el convicto Wu Chuan debe navegar por una ciudad invadida por criaturas prehistóricas y liderar una lucha desesperada para salvar a su madre atrapada y evitar que una antigua bestia destruya la ciudad.",
