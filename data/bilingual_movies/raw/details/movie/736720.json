      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "外表猙獰的醜男兄弟宰弼（李星民 飾）和塽邱（李熙俊 飾）因外貌深受世人誤解，決心用全副身家買下神秘荒廢小屋，歸隱田園，與狗狗過寧靜安穩的生活。豈料到埗第一天，因救了一個前來度假的女學生美娜（孔昇延 飾），卻被同行朋友當成變態殺人狂魔，因此而被警察盯上…平淡日子遙遙無期，更發生連串誤會，多人在他們的温馨小屋意外死亡，同時竟喚醒了屋內被封印多年的超級惡魔，兄弟臨時組成「屠魔二人組」拯救世界，高呼「我很醜，但我很好人」！",
          "runtime": 0,
          "tagline": "",
          "title": "沒有美色殺人狂"
        }
