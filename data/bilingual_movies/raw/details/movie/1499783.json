      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "동네의 친숙한 수영장이 사라질 위기에 처하자, 두 소녀는 이를 지키기 위해 나선다. 무관심한 어른들 사이에서도 포기하지 않고 고군분투하는 아이들의 순수한 열정과 기발한 작전들이 유쾌하게 펼쳐진다.",
          "runtime": 87,
