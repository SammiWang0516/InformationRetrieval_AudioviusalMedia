      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Коли таємнича темна сила підкорює одного із супергероїв, Зоряна планета опиняється перед лицем небезпеки, а вчорашні союзники стають ворогами. Щоб урятувати друга й відвернути катастрофу, команді доведеться вирушити назустріч небезпечним пригодам, розкрити таємницю загадкової сили та кинути виклик могутньому ворогу. Водночас інша боротьба розгортається за захист рідного дому та всього, що дороге його мешканцям. На героїв чекають непрості випробування, несподівані повороти й вирішальне протистояння, у якому лише відвага, довіра та єдність допоможуть подолати темряву й урятувати світ.",
          "runtime": 99,
          "tagline": "",
          "title": "Супергерої"
        }
      }
