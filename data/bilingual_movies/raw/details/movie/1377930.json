      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "Ado的“心脏”演唱会是一场堪称传奇的演出，在2024年4月27日至28日的两天内吸引了14万名观众，标志着她成为首位在日本国立竞技场举办单独演唱会的女歌手。全场共演唱了26首歌曲，包括她与初音未来同台合唱的《樱日和与时间机器》、邀请B'z成员松本孝弘担任客座吉他手的《尊严》、以及日本环球影城合作曲目《唱》等。此次影院上映将为错过现场演出或想要重温的粉丝们带来一场全新的沉浸式体验。",
          "runtime": 0,
          "tagline": "",
          "title": "Ado“心脏”特别演唱会 劇場版"
        }
