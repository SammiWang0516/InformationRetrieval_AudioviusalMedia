      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Niemand is er klaar voor om een keer wakker te worden van explosies buiten zonder plan, zonder levensperspectief. Gevangen onder bezetting in hun eigen appartement, moet een koppel angst, wanhoop, liefde en hoop ontdekken.",
          "runtime": 0,
