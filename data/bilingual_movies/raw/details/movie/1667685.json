      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "見習巫師阿康和小楊為了拯救被披蓬詛咒的母親，而踏入深山的旅程。與此同時，一座偏遠村莊發生了一系列駭人聽聞的死亡事件，人們懷疑是阿蒙和她的女兒小盧所為，因為她們有著與惡魔相似的特徵。然而，在這片被詛咒的森林深處，還隱藏著其他驚人的秘密，阿康和小楊將展開一場永無止境、追尋披蓬真面目的旅程。",
          "runtime": 0,
          "tagline": "",
          "title": "血鬼村"
