      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "어머니가 베트남 고산 지역 소수민족의 전설에 등장하는 피에 굶주린 악귀 ‘피퐁’ 의 저주에 걸리자, 무당 견습생 형제 콘과 즈엉은 어머니를 구하기 위해 깊은 산속으로 향한다. 한편 외딴 마을에서는 기괴하고 참혹한 죽음이 이어지고, 전설 속 괴물과 기이한 특징을 닮은 몬과 그녀의 딸 루아에게 사람들의 의심이 쏠린다. 저주받은 밀림 깊은 곳에는 훨씬 어두운 비밀이 도사리고 있었고, 진짜 '피퐁'의 정체를 쫓는 두 형제를 끈질기고도 무서운 추적전 속으로 몰아넣는다.",
          "runtime": 120,
          "tagline": "",
          "title": "피퐁: 성스러운 숲의 혈귀"
        }
      },
