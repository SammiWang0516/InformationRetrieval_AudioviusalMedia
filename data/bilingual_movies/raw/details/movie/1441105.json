  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://luxboxfilms.com/ill-be-gone-in-june",
          "overview": "In 2001, Franny, a 16-year-old exchange student from Germany, arrives in the sleepy desert town of Las Cruces, New Mexico. Far from home, Franny struggles through awkward school days, stifling heat, and restless nights until she meets Elliott, a boy whose quiet sadness mirrors her own. As America reels from 9/11, something resonates within Franny and an unexpected tenderness begins to bloom.",
          "runtime": 124,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "六月我将离去"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Une étudiante allemande débarque dans le désert du Nouveau-Mexique pour une année d’échange. Elle pensait trouver l’Amérique de ses rêves. Elle découvre un pays inquiet, un amour fragile, et cette vérité que chaque génération finit par rencontrer : le monde que l’on nous promet n’est jamais celui qu’on trouve.",
          "runtime": 125,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Em 2001, Franny, uma intercambista alemã de 16 anos, chega a Las Cruces, pacata cidade no deserto do Novo México. Longe de casa, enfrenta dias constrangedores na escola, o calor sufocante e noites inquietas até que conhece Elliott, um garoto cuja tristeza silenciosa reflete a sua. Enquanto os Estados Unidos ainda absorvem o choque do 11 de Setembro, o abalo coletivo encontra eco em Franny e uma ternura inesperada começa a florescer.",
          "runtime": 125,
          "tagline": "",
          "title": "Vou Embora em Junho"
        }
      }
    ]
  },
