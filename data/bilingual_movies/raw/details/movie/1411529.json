  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "李明奇是东北老工业基地的一名普通工人，从年轻时起便痴迷飞行，一直怀揣着亲手飞上天空的梦想。成家后，为了妻子高雅风和现实生活，他不得不重新回到地面，将自己的飞行梦暂时搁置。随着生活的压力接踵而来，这个曾被旁人视为异想天开的梦想，却一次次成为支撑李明奇走过困境的力量。在家人和朋友的陪伴下，他重新拾起那些尘封已久的零件与念头，试图在柴米油盐与生活重压之间，再一次向天空靠近……",
          "runtime": 122,
          "tagline": "",
          "title": "飞行家"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
