      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Luca, ein vierzigjähriger Lehrer, steckt in einer Beziehungskrise mit seiner Frau Sara, die deutlich wohlhabender ist als er. Während des Lockdowns gerät Luca in das Leben seiner neuen Nachbarin Amanda und beschließt, die Kluft zwischen ihnen zu überbrücken – mit verheerenden Folgen.",
          "runtime": 0,
          "tagline": "",
          "title": "Close To Me"
        }
      },
      {
        "iso_3166_1": "ES",
