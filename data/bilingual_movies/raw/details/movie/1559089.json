      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Der Seeweg über das Mittelmeer nach Europa ist eine der gefährlichsten Fluchtrouten der Welt und für viele Menschen oft die letzte Chance, Krieg, Verfolgung und Hunger zu entkommen. Da immer mehr Frauen und ihre Kinder diese Reise antreten müssen, gehören zur Besatzung eines Seenotrettungsschiffes zunehmend auch Hebammen",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Voor velen is de oversteek over de Middellandse Zee de laatste hoop om te ontsnappen aan oorlog, vervolging en honger. Nu steeds meer vrouwen gedwongen worden deze dodelijke route te nemen, maakt een verloskundige inmiddels permanent deel uit van de bemanning van een reddingsschip. Terwijl verloskundige Anne-Katrin aan haar eerste missie deelneemt, vertellen overlevenden over de verschrikkingen van hun reis. Hun werelden raken elkaar kortstondig voordat de geredde vrouwen een nieuwe, onzekere toekomst tegemoet gaan.",
          "runtime": 82,
          "tagline": "",
          "title": ""
        }
      }
