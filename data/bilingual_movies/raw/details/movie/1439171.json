  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The film follows criminal police officer Cui Xun over half a century of investigative work. Alongside his colleagues, he solved numerous major cases while staying true to his original aspiration of 'serving the people.' This legendary detective not only witnessed the evolution of China's public security system but also stood as a living testament to the rise of New China.",
          "runtime": 140,
          "tagline": "",
          "title": "Traces of Justice"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "凡是经过，皆有痕迹。刑事技术警察崔寻走过半个多世纪，与同事屡破大案，这位秉承着“为人民服务”初心的神探，不仅见证了公安事业的发展，更见证了新中国的崛起。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "靈感源自中國刑事鑒識先驅之一崔道植的真實非凡故事。六十餘年間，他通過對痕跡證據的開創性研究，推動刑事科學技術發展，並參與偵辦眾多重大及備受矚目的刑事案件。他累計完成7000餘次鑒定檢驗，被譽為中國刑偵領域的「福爾摩斯」，以從最細微的痕跡中發現決定性線索而聞名。",
          "runtime": 0,
          "tagline": "",
          "title": "神探之痕跡"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Der Film begleitet den Kriminalpolizisten Cui Xun über ein halbes Jahrhundert seiner Ermittlungsarbeit. Gemeinsam mit seinen Kollegen löste er zahlreiche bedeutende Fälle und blieb dabei stets seinem ursprünglichen Leitgedanken treu, „dem Volk zu dienen“. Dieser legendäre Kriminalbeamte war nicht nur Zeuge der Entwicklung des chinesischen Systems der öffentlichen Sicherheit, sondern auch ein lebendiges Zeugnis für den Aufstieg des Neuen China.",
          "runtime": 140,
          "tagline": "",
          "title": "Traces of Justice"
        }
      }
    ]
  },
