  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "驻外记者马笑与志愿医生潘文佳夫妇，在归国前陪同工程师苗峰前往郊区维修基站，却突然遭遇当地局势恶化。三人在逃离武装冲突的途中不断躲避袭击，最终仍被恐怖组织俘获，沦为人质，并在囚禁中结识了华侨商人周伟杰。失去与外界联系后，等待他们的不只是暴力与勒索，还有随时可能降临的死亡威胁。为了活着离开这片战乱之地，几个原本互不相识的普通人只能彼此依靠，在绝境中寻找每一个可能逃生的机会……",
          "runtime": 131,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The couple of Ma Xiao, a foreign correspondent, and Pan Wenjia, a volunteer doctor, accompanied engineer Miao Feng on a trip to the suburbs to repair a base station. During the trip, the local situation suddenly changed and the three were kidnapped by an extremist organisation. While in prison, they met Zhou Weijie, an overseas Chinese businessman. In order to find a chance of survival, they embarked on a journey of escape in the midst of barbaric warfare and chaos.",
          "runtime": 131,
          "tagline": "",
          "title": "Escape from the Outland"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Het echtpaar Ma Xiao, een buitenlandse correspondent, en Pan Wenjia, een vrijwillige arts, vergezelde ingenieur Miao Feng op een reis naar de buitenwijken om een basisstation te repareren. Tijdens de reis veranderde de lokale situatie plotseling en werden de drie ontvoerd door een extremistische organisatie. Terwijl ze in de gevangenis zaten, ontmoetten ze Zhou Weijie, een overzeese Chinese zakenman. Om een kans op overleving te vinden, begonnen ze aan een ontsnappingsreis te midden van barbaarse oorlogvoering en chaos.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "駐外記者馬笑（肖央 飾）和志願醫生潘文佳（齊溪 飾）夫婦，陪同工程師苗峯（鄭愷 飾）赴郊區修理基地台時，當地局勢突變。三人一路躲避恐怖組織的無差別攻擊，最後還是被綁架淪為人質，並在獄中結識了華僑商人周偉傑（任達華 飾）。面對恐怖分子聞所未聞的屠殺暴行和以命換錢的勒索，他們歷經 105 天，展開了一場驚心動魄的自救逃生。",
          "runtime": 0,
          "tagline": "",
          "title": "用武之地"
        }
