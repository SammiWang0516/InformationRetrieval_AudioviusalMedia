      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Vivant au bord de l'autoroute Transbrasiliana en Amazonie brésilienne, Edna est témoin d'une terre en ruine construite sur les massacres de la dictature militaire. À partir de son journal intime, le film dresse le portrait magnifique de cette survivante qui s'est obstinée à résister avec une force et un courage inouïs envers et contre cette guerre « qui ne finit jamais ».",
          "runtime": 64,
          "tagline": "",
          "title": ""
        }
