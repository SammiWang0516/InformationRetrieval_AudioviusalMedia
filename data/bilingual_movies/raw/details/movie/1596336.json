      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Uwięzieni w muzealnych archiwach, przodkowie zakrzywiają czas i przestrzeń, by odnaleźć drogę do domu. Historia, duchowość i prawo ścierają się, gdy specjaliści od repatriacji plemion walczą o odzyskanie i ponowne pochowanie szczątków rdzennych mieszkańców, ukazując wnikliwy wgląd w wciąż powszechne światopoglądy, które uzasadniały ich gromadzenie.",
          "runtime": 85,
          "tagline": "",
          "title": "Aanikoobijigan"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "박물관 수장고에 갇힌 조상들은 고향으로 돌아가기 위해 시간과 공간을 초월한다. 부족의 유해 송환 전문가들이 원주민의 유해를 되찾아 안장하려 분투하는 가운데 역사와 영성, 법이 충돌한다. 원주민 유해 수집 당시 이를 정당화했던, 아직도 만연한 세계관이 그들의 투쟁 속에서 드러난다.",
          "runtime": 80,
          "tagline": "",
          "title": "조상과 후손들"
        }
      }
    ]
