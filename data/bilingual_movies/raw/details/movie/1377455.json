        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Cas, adolescent sensible de 15 ans, pose pour Jard, son prof stagiaire et photographe amateur. Mal à l’aise avec le rapport de pouvoir, il décide de reprendre le contrôle.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
