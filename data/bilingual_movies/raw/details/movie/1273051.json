        "data": {
          "homepage": "",
          "overview": "Obsáhlá kronika důsledků ruské invaze na Ukrajinu v roce 2022. Jak žijí občané v době války, jak násilí a smrt podmiňují každodenní život: od škol v protiatomových krytech po rehabilitační centra pro zmrzačené; rány a mlčení, gesta a slova.",
          "runtime": 140,
          "tagline": "",
          "title": "Invaze"
        }
