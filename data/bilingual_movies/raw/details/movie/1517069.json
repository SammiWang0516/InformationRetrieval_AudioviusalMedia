      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "בסרטה התיעודי הראשון, הבמאית סופיה קופולה יוצרת דיוקן אינטימי ויוצא דופן של מעצב האופנה האמריקני הנודע מארק ג'ייקובס, חבר קרוב שלה זה למעלה משלושה עשורים. במהלך 12 השבועות שקדמו לתצוגת האופנה שלו בשנת 2024, קופולה מלווה את ג'ייקובס מאחורי הקלעים וחושפת את תהליך היצירה, מקורות ההשראה והחזון שהפכו אותו לאחת הדמויות המשפיעות בעולם האופנה. לצד תיעוד העבודה על הקולקציה החדשה, הסרט משלב חומרי ארכיון, שיחות אישיות ורגעים נדירים מחייו ומקריירה פורצת הדרך שלו, ומשרטט דיוקן מרתק של אמן הנמצא בחיפוש מתמיד אחר יצירה והתחדשות.",
          "runtime": 87,
          "tagline": "",
          "title": "מארק מאת סופיה"
        }
      }
