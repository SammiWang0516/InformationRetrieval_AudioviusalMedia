        }
      },
      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Nejauša garāmgājēja pazemes alā ierauga sievietes līķi, kuru apvij čūskas. Lietu izmeklē policijas kapteinis Lionels Orfiss. Lai gan viņš necieš tumšas un šauras vietas, viņam nākas sadarboties ar pazemes izmeklētāju grupu, kuru vada Eleonora Valansa – viņa jaunības mīlestība. Abu atkalredzēšanās neizbēgami atdzīvina senas jūtas. Divas dienas vēlāk līdzīgos apstākļos noslepkavotu atrod vēl vienu sievieti. Meklējot noslēpumaino slepkavu, izmeklētāji sastop flamenko māksliniekus, sengrieķu mitoloģijas pētniekus un mūsdienu vīrišķības sludinātājus. Kas saista šīs dažādās pasaules un abas noslepkavotās sievietes?",
          "runtime": 0,
          "tagline": "",
          "title": "Slepkavība Katalonijā"
        }
      },
      {
        "iso_3166_1": "LT",
        "iso_639_1": "lt",
        "name": "Lietuvių",
        "english_name": "Lithuanian",
        "data": {
          "homepage": "",
          "overview": "Speleologinės ekspedicijos metu visuomenei uždarytoje teritorijos dalyje randamas moters kūnas. Jį apsivijusi raudonpilvė juoda gyvatė. Bylai vadovauja inspektorius, nekenčiantis tamsių ir uždarų erdvių. Paaiškės, kad į pagalbą pakviesta požeminių tyrimų grupės vadovė yra jo jaunystės meilė. Susitikimas po 20 metų pažadins jausmus ir atgaivins senas traumas.",
          "runtime": 0,
          "tagline": "",
          "title": "Mirtys katalonų krašte"
        }
      }
