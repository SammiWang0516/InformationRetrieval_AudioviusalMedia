  "translations": {
    "translations": [
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "廉署總調查主任程德明正在調查一宗私煙案，某拳館館主涉嫌行賄海關，讓他的私煙進口。經過一番的追查，程德明鎖定了前拳王曾樂恆，更在一次行動中成功人贓並獲。然而，曾樂恆把一切罪狀都往自己身上摃，明顯是在包庇幕後主腦。正當調查一籌莫展之際，程德明突然被隔壁組的Tammy抓去問話！原來一筆神秘的錢，打進了他父親的帳戶，令程德明涉嫌受賄。程德明本想找處長理論，卻發現處長早就找人調查自己，更直接把他停職了！",
          "runtime": 93,
          "tagline": "",
          "title": "棋拳風暴"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "ICAC investigator Ching probes cigarette smuggling, catching an ex-boxer, only to be suspended and investigated himself after mysterious bribery funds appear in his father's account.",
          "runtime": 93,
          "tagline": "",
          "title": "Hybrid Storm"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "廉政公署首席调查主任程德明将棋拳带入香港，他调查私烟案时，抓获前拳王曾乐恒，对方却包揽罪状包庇幕后黑手。此时，一笔神秘款项打入其父亲账户，程德明遭调查并被停职，一场关乎人性的反贪故事就此...",
          "runtime": 0,
          "tagline": "",
          "title": "棋拳风暴"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Главный следователь по финансовым преступлениям Чин Так-мин пытается раскрыть дело о крупной контрабанде сигарет. Ему удаётся арестовать главного подозреваемого - бывшего боксёра. Но неожиданно триумф героя оборачивается катастрофой, когда на счету его отца всплывают необъяснимые суммы, предположительно, полученные в качестве взяток. В результате Чина отстраняют от службы, и в отношении него начинается служебная проверка. Оказавшись в эпицентре сложной интриги, Так-мин должен не только распутать паутину обмана, но и доказать свою полную непричастность к преступной схеме.",
          "runtime": 0,
          "tagline": "",
          "title": "Гибридный шторм"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Một nhân viên ICAC điều tra vụ án buôn lậu và bắt giữ một cựu võ sĩ quyền Anh. Nhưng rồi chính anh lại bị điều tra khi những khoản tiền hối lộ bí ẩn xuất hiện trong tài khoản của bố mình.",
          "runtime": 0,
          "tagline": "",
          "title": "Kỳ Quyền Phong Bạo"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "ICAC 수석 조사관 정덕명은 불법 담배 밀수 사건을 수사하던 중 핵심 용의자인 복싱 체육관 관장을 체포하지만 끝내 배후는 밝혀내지 못한다. 설상가상으로 아버지의 계좌에서 의문의 거액이 발견되면서 정덕명은 순식간의 뇌물 수수 혐의의 피의자로 몰린다. 조직에서 직무 정지까지 당한 그는 누명을 벗고 거대한 음모의 실체를 파헤치기 위해 홀로 사건을 추적하기 시작한다.",
          "runtime": 0,
          "tagline": "",
          "title": "하이브리드 스톰"
