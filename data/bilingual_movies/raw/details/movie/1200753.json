        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "改编自切萨雷·帕韦塞1947年出版的《与勒乌科的对话》中的章节《海之泡沫》。古希腊诗人萨福与仙女布里托马蒂斯在海边相遇，展开了一场关于爱与死亡的对话。据说，萨福因相思之苦而投海自尽，而布里托马蒂斯则是在逃避一名男子时从悬崖跌入海中。两人共同探讨围绕她们的故事与形象，试图在片刻间理解欲望那既甜美又苦涩的本质。",
          "runtime": 64,
          "tagline": "",
          "title": "你燃烧了我"
        }
