      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Dziesięcioletni Filip jedzie z ojcem do najbliższego miasta, aby kupić nowe buty do szkoły. Kiedy ojciec zostaje zdezorientowany przez starego przyjaciela, Filip musi radzić sobie sam. Prosty błąd w sklepie obuwniczym – kupno dwóch butów na prawą nogę – rozpoczyna nieoczekiwaną przygodę w nieznanym świecie. Zbyt zawstydzony, by wrócić do domu z pustymi rękami, Filip postanawia sam rozwiązać problem. Po drodze zaprzyjaźnia się z bezdomnym psem, któremu nadaje imię na cześć swojego ulubionego piłkarza, i znajduje nieoczekiwanego towarzysza. Poprzez drobne wybory, chwile strachu i cichej odwagi Filip stawia pierwsze kroki ku niezależności i dorastaniu.",
          "runtime": 85,
          "tagline": "",
          "title": "Atlasul Universului"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Après avoir acheté par erreur deux chaussures droites, Filip, dix ans, se lance à travers la campagne à la recherche de la chaussure gauche manquante.",
          "runtime": 0,
          "tagline": "",
          "title": "Atlas of the Universe"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "아버지와 함께 새 신발을 사러 나선 열 살 소년 필립은 아버지가 친구를 만나 딴길로 새버리는 바람에 홀로 신발을 사게 된다. 그런데 실수로 오른쪽 신발만 두 켤레를 사게 된 필립은 스스로 문제를 해결하기로 결심한다. 낯선 세계 속에 뛰어들게 된 필립은 우연히 만난 떠돌이 개에게 자신이 가장 좋아하는 축구 선수의 이름을 붙여주고, 함께하는 즐거움을 얻게 된다.",
          "runtime": 85,
          "tagline": "",
          "title": "우주의 아틀라스"
        }
      }
    ]
