      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Londra'nın ikonik Prince Charles Sineması'nda geçen film, talihsiz çalışanlarının hayatından bir günü konu alıyor. Vardiyaları sırasında film izler, müşterilerle tartışır ve hepsinden önemlisi birbirleriyle uğraşırlar.",
          "runtime": 0,
          "tagline": "",
          "title": "Müdavimler"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Ambientado no icônico Prince Charles Cinema de Londres, o filme acompanha um dia na vida de seus infelizes funcionários. Durante seu turno, eles assistem a filmes, discutem com os clientes e acima de tudo, lidam uns com os outros. Com base nas experiências e histórias reais daqueles que trabalham no Prince Charles Cinema, Fil Freitas - um ex-lanterninha que se tornou gerente - criou um longa-metragem de comédia dramática que explora a vida atrás do balcão.",
          "runtime": 106,
          "tagline": "",
          "title": ""
        }
      }
