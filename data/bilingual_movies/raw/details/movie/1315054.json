      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Mit \"Jugend – Harte Zeiten\" setzt Wang Bing seine Dokumentarfilm-Trilogie über junge Arbeiter in chinesischen Textilfabriken fort. Der Film spielt in Zhili, einer Gemeinde der Stadt Huzhou, die als Zentrum der chinesischen Kinderbekleidungsindustrie gilt. Hier eskaliert ein schwelender Konflikt zwischen Arbeitern und der Firmenleitung.",
          "runtime": 0,
          "tagline": "",
          "title": "Jugend - Harte Zeiten"
        }
