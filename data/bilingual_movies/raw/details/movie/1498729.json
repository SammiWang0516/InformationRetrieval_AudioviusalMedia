      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "影片基于纪录片与虚构手法的交融，追溯了库奇内利生命轨迹中的关键地点与时刻：从乡村童年，到被他改造成为人文资本主义象征的索洛梅奥小镇。通过见证、档案影像和个人回忆，展现了一个出身卑微、却创立了世界知名企业，并始终坚持尊严、美与社会正义价值观的人。故事的结尾达成了一种共识：那些用勇气浇灌的梦想，才是引导命运的真正力量。",
          "runtime": 0,
          "tagline": "",
          "title": "布鲁内洛：温文尔雅的梦想家"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "",
