        "data": {
          "homepage": "",
          "overview": "Medan hela världen följer VM i Italien 1990, utnyttjar någon Argentinas matcher för att begå brutala mord. En jakt på en hänsynslös seriemördare börjar, mitt i fotbollsfesten.",
          "runtime": 80,
          "tagline": "",
          "title": "No One Will Hear Your Scream"
        }
      },
