      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "https://andreeesty.com/films/if-i-make-it-to-the-morning",
          "overview": "在美国大学巡回访问的最后一站，一个中国少女在母亲陪伴下考虑在纽约学习和生活。她的姑姑似乎过着完美的生活。但在螃蟹晚餐时，紧张气氛开始上升，主人公发现自己独自一人在纽约的夜晚幻想着她的未来。",
          "runtime": 9,
          "tagline": "",
          "title": "月亮总在照顾大地"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "子亦跟著掌控慾超強的媽媽，一路跑遍各州參觀大學，最後一晚，終於在紐約的酷炫阿姨家放鬆一下。本以為這裡會是理想的求學之地，沒想到一個關於女生愛女生的秘密，瞬間讓氣氛變得超緊繃。",
          "runtime": 0,
          "tagline": "",
          "title": "月亮總在照顧大地"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "과보호적인 엄마와 함께 주(州) 간 대학 탐방을 마무리한 중국인 십대 즈이는 뉴욕에 사는 세련된 이모의 아파트에서 마지막 밤을 보낸다. 즈이가 이곳이 앞으로 공부하며 살아가기엔 완벽한 곳일지도 모른다고 생각하기 시작하던 순간, 뜻밖의 사실이 드러나면서 세 사람 사이에 긴장이 흐르기 시작한다.",
          "runtime": 0,
          "tagline": "",
          "title": "아침까지 버틴다면"
