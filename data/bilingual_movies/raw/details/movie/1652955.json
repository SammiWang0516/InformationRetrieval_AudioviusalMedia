    "translations": [
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "https://www.escolaletithappen.com/casa",
          "overview": "Nos anos 50, o Centro de Reeducação de Santo Inácio é governado por uma mulher que impõe uma disciplina cruel a jovens considerados problemáticos. Décadas depois, um grupo de alunos entra no edifício abandonado para realizar um trabalho escolar e desperta uma presença que permanecia entre aquelas paredes. No presente, outros jovens procuram abrigo de uma tempestade e descobrem que a casa continua assombrada pelo seu passado. Separados pelo tempo, os três grupos enfrentam o mesmo mal e dependem uns dos outros para sobreviver.",
          "runtime": 88,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.escolaletithappen.com/casa",
          "overview": "In the 1950s, the Santo Inácio Re-education Centre is ruled by a woman who subjects supposedly troubled young people to cruel discipline. Decades later, a group of students enters the abandoned building for a school assignment and awakens a presence that has remained within its walls. In the present day, other young people take shelter from a storm and discover that the house is still haunted by its past. Separated by time, the three groups confront the same evil and must rely on one another to survive.",
          "runtime": 88,
          "tagline": "",
          "title": ""
        }
      }
