        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "În această dramă poetică în format de documentar, cineasta Vladlena Sandu își explorează amintirile traumatizante din timpul războiului din Cecenia.",
          "runtime": 98,
          "tagline": "",
          "title": "Memorie"
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Szülei válása után a hatéves Vladlena Sandu Groznijba költözik, mit sem sejtve a közelgő csecsen háborúról. Évekkel később filmrendezőként tekint vissza traumatikus gyermekkorára, és azt vizsgálja, hogyan formálja a gyermeki lelket az erőszak körforgása, és hogyan lehetséges a gyógyulás és a változás.",
          "runtime": 0,
          "tagline": "",
          "title": "Emlékeim"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Após o divórcio dos pais, Vladlena, de seis anos, se muda da Crimeia para Grozny, ainda sem saber das mudanças que a aguardam. Quando a guerra irrompe na Chechênia, ela afeta profundamente sua cidade e família. Anos depois, a cineasta Sandu reflete sobre sua infância neste filme híbrido poético e autobiográfico, explorando como os ciclos de violência moldam as crianças e como a cura e a mudança são possíveis.",
          "runtime": 0,
          "tagline": "",
          "title": "Memory"
        }
      }
