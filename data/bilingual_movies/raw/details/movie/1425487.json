      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "En la cima de su carrera musical, Maja se desmorona y debe renunciar a sus ambiciones. Deprimida y sin dinero, regresa a casa de su madre y trabaja a tiempo parcial en un instituto local. Lejos de los focos y rodeada de la amabilidad de lo cotidiano, poco a poco recupera las ganas de vivir.",
          "runtime": 105,
          "tagline": "",
          "title": "Sin expectativas"
        }
      },
      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Varbūt viss nav tik vienkārši. Kulta statuss tīmekļa pasaulē, kas sasniegts, iespējams, nedaudz par agru. Savas mūziķes karjeras virsotnē Maja piedzīvo sabrukumu. Izjūtot iekšēju spiedienu un kardināli mainot dzīvesveidu, meitene nolemj visu sākt no sākuma un ievācas pie savas mātes. Maja strādā par skolotāju palīdzi, uzraugot skolēnu eksāmenus, satiekot vecos mīlniekus un klausoties apceres par “visu laiku labāko” filmu “Sadursme” (1995). Viņa jūtas iestrēgusi, jo visi gaidīja tik daudz. Arī viņa pati.",
          "runtime": 0,
          "tagline": "",
          "title": "Zemas cerības"
        }
