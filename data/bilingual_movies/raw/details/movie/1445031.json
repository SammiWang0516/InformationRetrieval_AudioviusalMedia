  "translations": {
    "translations": [
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "https://gutekfilm.pl/trzy-milosci-grzegorzek",
          "overview": "Bohater filmu, Jan, nie mogąc pogodzić się z rozwodem z Leną, wynajmuje mieszkanie z widokiem na jej okna. Podgląda ją przez lunetę, a na telefonie instaluje aplikację szpiegowską. Gdy Lena traci głowę dla młodego chłopaka, Kundla, Jan zrobi wszystko by stanąć na drodze tej relacji. Tymczasem obiekt uczuć Leny niespodziewanie zakochuje się w Janie.",
          "runtime": 99,
          "tagline": "Niektóre związki potrzebują trzeciej szansy.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Lena, a 40-year-old actress freshly divorced, is determined to rebuild her life. Embracing change, she quickly plunges into the vibrant nightlife of Warsaw—and into the arms of Kundel, a young, charismatic student. Their relationship is a passionate explosion where the boundaries between intimacy and desire begin to blur. Meanwhile, Lena’s ex-husband Jan, a respected lawyer, struggles to accept the end of their marriage.",
          "runtime": 99,
          "tagline": "",
          "title": "Three Loves"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "https://meteor-film.com/three-loves/",
          "overview": "Als Lena sich Hals über Kopf in den Studenten Kundel verliebt, beginnt eine leidenschaftliche Affäre und eine Reihe intensiver sexueller Erfahrungen, die Lena den Alltag vergessen lassen – wäre da nicht ihr Ex-Mann Jan, der sie auf keinen Fall so einfach aufgeben will. Stück für Stück drängt er sich wieder in ihr Leben zurück und obwohl Lena anfangs zögert, lässt sie Jans Näherungsversuche irgendwann zu. Auch Kundel scheint nichts gegen den verführerischen Nebenbuhler zu haben, der schon bald wie selbstverständlich die lustvolle Zweisamkeit der beiden in eine heiße Dreierbeziehung explodieren lässt. Zuerst scheint das wilde Trio mit dieser Entscheidung die Patentlösung für all seine Leidenschaften gefunden zu haben, doch schon bald wird deutlich, dass mit diesem sexuellen Abenteuer auch ein Preis zu zahlen ist…",
          "runtime": 101,
          "tagline": "",
          "title": "Three Loves"
        }
      },
