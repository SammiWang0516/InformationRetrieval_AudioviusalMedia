  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A sinister spin on twenty-something party culture, revealing the darkness beneath the carefree facade. What starts as a wild girls trip turns dangerous when hostile locals escalate tensions and Amber's past trauma surfaces. As the group fractures under toxic dynamics, their fun getaway transforms into a revenge-fueled nightmare.",
          "runtime": 92,
          "tagline": "A party to die for.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "安珀和四位闺蜜从洛杉矶驱车前往约书亚树，打算用一场肆意的沙漠派对放松身心。刚踏入偏僻的沙漠小镇，她们就接连遭遇当地男性的骚扰与敌意，看似热情的小镇处处藏着不对劲。外部的矛盾不断升级，闺蜜团内部的隔阂与不满也跟着发酵，没人注意到安珀一直藏着一段不愿提起的创伤往事。随着冲突彻底爆发，一行人被困在空旷的荒漠里，前有围堵的当地人，后有解不开的内部心结，原本轻松的度假之旅，一步步滑向失控的边缘。",
          "runtime": 0,
          "tagline": "",
          "title": "觅友惊魂"
        }
      },
