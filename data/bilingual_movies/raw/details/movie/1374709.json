        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "A halálos beteg Gildának egyetlen kívánsága van: szeretne fájdalommentesen meghalni, ám öngyilkossági kísérletei komikus módon mind kudarcba fulladnak. Ezt elunva Gilda inkább szakemberhez fordul és egy terápiás csoportban társat is talál tervéhez.",
          "runtime": 0,
          "tagline": "",
          "title": "Oroszlánokról álmodom"
        }
      },
      {
        "iso_3166_1": "CZ",
