        "data": {
          "homepage": "",
          "overview": "Gilda je nevyléčitelně nemocná a přeje si zemřít bez bolesti. Když její komické pokusy o sebevraždu selžou, vyhledá odbornou pomoc.",
          "runtime": 0,
          "tagline": "",
          "title": "Sen o lvech"
        }
      },
