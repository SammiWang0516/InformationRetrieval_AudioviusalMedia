      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "הסרט מתאר את ניסיון ההתנקשות בשנת 2018 בעיר סולסברי באנגליה, שבו הורעל המרגל הרוסי לשעבר סרגיי סקריפל ובתו באמצעות גז עצבים קטלני. מה שהתחיל כאירוע מקומי מסתורי הפך במהירות למשבר בינלאומי, וחשף עימות חשאי בין רוסיה למערב. בסופו של דבר, הסרט חושף את המציאות של ריגול מודרני הנתמך על ידי מדינות, ואת ההשפעה המתמשכת של האירוע על היחסים הבינלאומיים ועל חיי האנשים שנקלעו אליו.",
          "runtime": 0,
          "tagline": "",
          "title": "הרעלות בסולסברי: מרגל מהדלת הסמוכה"
        }
      },
      {
        "iso_3166_1": "FI",
        "iso_639_1": "fi",
        "name": "suomi",
        "english_name": "Finnish",
        "data": {
          "homepage": "",
          "overview": "Dokumentti seuraa entisen venäläisagentin Sergei Skripalin ja hänen tyttärensä Yulian myrkyttämistä Novitshok-hermomyrkyllä. Paikallinen tapaus kasvaa nopeasti geopoliittiseksi kriisiksi, joka paljastaa Venäjän ja lännen välisen salaisen vakoilusodan.",
          "runtime": 0,
          "tagline": "",
          "title": "Vakooja naapurissa"
        }
      },
      {
        "iso_3166_1": "DK",
        "iso_639_1": "da",
        "name": "Dansk",
        "english_name": "Danish",
        "data": {
          "homepage": "",
          "overview": "Historien om det opsigtsvækkende giftangreb på den tidligere russiske spion Sergei Skripal og hans datter, Yulia. De blev fundet livløse på en bænk i den engelske by Salisbury, forgiftet med nervegiften Novichok, hvilket udløste en diplomatisk krise mellem Rusland og Vesten.",
          "runtime": 0,
          "tagline": "",
          "title": "Døden i parfumeflasken"
        }
