    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://takemehomefilm.com",
          "overview": "Anna, a middle-aged Korean adoptee with a cognitive disability, cares for her aging parents in a fragile balance of meeting one another’s needs. Alongside her sister Emily and her father, they must confront challenging questions about the future, but Anna remains determined to build a life where all of them can thrive.",
          "runtime": 91,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Après la mort de leur mère, une jeune femme avec un handicap cognitif et sa sœur, qui était éloignée d'elle, doivent apprendre à communiquer pour aller de l'avant.",
          "runtime": 0,
          "tagline": "",
          "title": "Ramène-moi à la maison"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "테이크 미 홈"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "安娜，一位38岁患有认知障碍的韩国裔被收养者，在与年迈父母相互依存的需求中维持着脆弱的平衡。当佛罗里达的热浪击碎了这个家庭与安娜的日常，她的未来陷入迷茫，直到她创造出一个能够让自己茁壮成长的世界。",
          "runtime": 0,
          "tagline": "",
          "title": "带我回家"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Анна, 38-летняя кореянка с когнитивными нарушениями, удочерённая в раннем возрасте, заботится о своих стареющих родителях, с трудом поддерживая баланс между их потребностями. Когда из-за аномальной жары во Флориде их привычный уклад рушится, будущее Анны оказывается под вопросом — пока она не создаёт мир, в котором может процветать.",
          "runtime": 0,
          "tagline": "",
          "title": "Отведи меня домой"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Anna, 38-letnia Koreanka z niepełnosprawnością intelektualną, opiekuje się starzejącymi się rodzicami, próbując znaleźć równowagę między zaspokajaniem wzajemnych potrzeb. Kiedy fala upałów na Florydzie niszczy ich rodzinę i rutynę Anny, jej przyszłość jest niepewna – dopóki nie stworzy świata, w którym będzie mogła się rozwijać.",
          "runtime": 99,
          "tagline": "",
          "title": "Take Me Home"
        }
      }
    ]
  },
