  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Four individuals, adrift in their pursuit of sexual gratification, find themselves inextricably linked by a shared longing for a deeper, purer connection that transcends carnal desires.",
          "runtime": 105,
          "tagline": "",
          "title": "The Chronicles of Libidoists"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "四個殘破不堪的靈魂遇上彼此，在親密接觸下嘗試給出自己的真心……。 會夢遺的女警小綠（劉主平飾）和閨密白Q（梁湘華飾）常分享約炮經驗，但這次遇到有才又會撩的『單親霸』（吳慷仁飾）讓小綠有點暈…。而白Q正進行一段說不出口的『付費約會』，對象是個穿膠衣蒙面的『外送屌Uberdick』（柯煒林飾）。四個藏在假面具下的人，每人都有各自最深的秘密。在痛快的無涯慾海裡，誰能順利上岸？",
          "runtime": 115,
          "tagline": "先做愛，再戀愛",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "「我夢遺了」女警小綠（劉主平 飾）跟高冷的閨密白 Q（梁湘華 飾）總是這樣有一搭沒一搭的聊著她的怪夢。兩個女人總是這樣交換著極度私密的訊息。兩個人雖然無話不談，但是有些秘密還真的無法透露：因為聯自己都無法分辨那些心思的真偽。\r 只談性不談愛的小綠，在遇到有才又會撩的情聖「單親霸」（吳慷仁 飾）後，竟然有點沉船？而即將步入婚姻的白 Q，則是和從未露過臉的膠衣縛繩師「Uberdick」（柯煒林 飾）進行一段説不出口的重口味「付費約會」，沉溺在綑綁性愛之中 。四個藏在假面具下殘破不堪的靈魂，在肉體親密交接的不確定關係裏，要怎麼交出自己的真心？",
          "runtime": 0,
          "tagline": "",
          "title": "破浪男女"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "四个残破不堪的灵魂遇上彼此，在亲密接触下尝试给出自己的真心…… 会梦遗的女警小绿（刘主平 饰）和闺密白Q（梁湘华 饰）常分享约炮经验，但这次遇到有才又会撩的「单亲霸」（吴慷仁 饰）让小绿有点晕… 而白Q正进行一段说不出口的「付费约会」，对象是个穿胶衣蒙面的「外卖屌Uberdick」（柯炜林 饰）。四个藏在假面具下的人，每人都有各自最深的秘密。在痛快的无涯欲海里，谁能顺利上岸？",
          "runtime": 0,
          "tagline": "先做爱，再恋爱",
          "title": "破浪男女"
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "『人魚姫』の人魚を少年とした再解釈版。親密さやアイデンティティが断絶された世界で繋がりを求めることの複雑さを、台北のセックス・シーンを背景に大胆に描く。",
          "runtime": 0,
          "tagline": "",
          "title": "狂ったリビドー"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "비밀이 있는 경찰 루. 가벼운 만남을 추구하는 작가 천. 사랑 없는 결혼을 하는 퀴디. 은밀한 아르바이트를 하는 우버딕. 아슬아슬한 관계 속에서 욕망을 갈망하는 네 남녀. 그들은 서로에게 깊어질수록 더 큰 성적 만족을 찾게 되는데...",
          "runtime": 106,
          "tagline": "고독한 이들의 예측 불가능한 사랑",
          "title": "성욕주의: 은밀한 밀회"
        }
      }
