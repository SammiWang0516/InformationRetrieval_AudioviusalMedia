      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Quando uma vidente alerta que sua mãe pode morrer em breve, Sakol reúne a família para visitar nove templos budistas num único dia, na esperança de prolongar a vida dela. Espremidas numa van, três gerações atravessam a exuberante arquitetura tailandesa enquanto tensões antigas, diferenças religiosas e a saúde frágil da matriarca ameaçam o percurso. Entre o sagrado e o cotidiano, a peregrinação se torna uma reflexão sobre fé, família e mortalidade.",
          "runtime": 140,
          "tagline": "",
          "title": "9 Templos Para o Céu"
        }
      }
