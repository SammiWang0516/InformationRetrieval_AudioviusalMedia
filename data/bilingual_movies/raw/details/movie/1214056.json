        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "30歲的紐約客利奧卡德納與兒時暗戀對象伊娃夏皮羅重逢後，決定舉行成年禮。為了完成成年禮項目，利奧必須在截止日期前處理各種曖昧關係、前任以及家人之間的關係。",
          "runtime": 0,
          "tagline": "",
          "title": "31支蠟燭"
        }
      }
