      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "모리스 라벨의 탄생 150주년을 기념하여 제작된 시적 플레이리스트 영상. 그의 대표작과 잘 알려지지 않은 작품을 아우르며 음악적 세계를 시각적으로 탐험하는 프로그램이다. 클라우스 메켈라의 지휘 아래 파리 오케스트라와 솔리스트 사빈 드비예르, 베르트랑 샤마유, 모딜리아니 현악사중주단이 주요 곡을 연주한다. 몽포르 라마리 집, 시부르 교회 등 라벨의 삶과 관련된 장소에서 촬영되어 시청각적 몰입감을 극대화화며 각 음악 장면은 라벨의 성격과 작품 세계의 다양한 면모를 섬세하게 반영한다.",
          "runtime": 80,
          "tagline": "시대가 사랑한 작곡가 라벨의 세계를 걷다",
          "title": "천 개의 빛: 라벨"
        }
      }
    ]
