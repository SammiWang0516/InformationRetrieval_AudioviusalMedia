        "data": {
          "homepage": "",
          "overview": "Após um jornalista americano ser sequestrado por forças russas, um esquadrão de elite de soldados ucranianos, auxiliado por agentes de inteligência americanos, é reunido para resgatá-lo.",
          "runtime": 0,
          "tagline": "",
          "title": "Killhouse"
