      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "A carta não deixava dúvidas: Lisa não quer ser encontrada. Sabe-se que a ausência é também um projecto, o de fotografar campos de futebol consumidos pelo tempo e vegetação na Geórgia rural. Irakli (pai) e Levani (melhor amigo) decidem-se a refazer os seus passos, interrogando estranhos, animais e balizas pacatas.",
          "runtime": 0,
          "tagline": "",
