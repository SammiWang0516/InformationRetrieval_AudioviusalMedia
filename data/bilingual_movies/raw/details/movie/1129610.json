      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://bocchi.rocks/",
          "overview": "ギターを愛する孤独なぼっちちゃんこと、後藤ひとりは、極度の人見知りだった。彼女は家でひとりきり、ギターを弾く日々を送っていたが、伊地知虹夏がドラムを務める結束バンドに加入する。人前で演奏することに不慣れだった彼女は、徐々に変化を見せ始める。",
          "runtime": 90,
          "tagline": "——私がバンドをやっている理由。",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
