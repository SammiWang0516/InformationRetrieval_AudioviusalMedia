      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Aizraujošs ceļojums grupas drosmīgajā jaunajā ērā, vienlaikus godinot fanus, kas to padarījuši iespējamu. Filmā iekļauti līdz šim nepublicēti kadri, EYEKONS fanu video un atklātas intervijas ar grupas dalībniecēm, atklājot spēcīgo saikni starp KATSEYE un viņu fanu kopienu visā pasaulē. Šī ir mīlestības vēstule EYEKONS, kuri palīdzēja izveidot šo kustību, un liecība tam, kāpēc grupas stāsts vēl tikai sākas.",
          "runtime": 80,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "https://www.katseyewildheartsfilm.com/",
          "overview": "Com imagens inéditas, vídeos enviados pelo fandom EYEKONS e entrevistas intimas com as integrantes, o filme explora o poderoso vínculo entre o KATSEYE e seu fandom global.",
          "runtime": 80,
          "tagline": "Uma carta de amor aos Eyekons.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "兩度入圍格林美獎的國際女團 KATSEYE 即將席捲全球大銀幕，強勢推出限定放映，為她們的第三張 EP《WILD》華麗熱身！  《KATSEYE: WILD HEARTS》記錄了這段動人旅程，見證她們大膽邁向全新時代，並向所有成就這場奇蹟的粉絲致上最深切的謝意。影片首度公開從未曝光的珍貴畫面、EYEKONS 的熱血應援片段，以及團員私密又真誠的深度訪談，捕捉 KATSEYE 與全球粉絲之間的強大羈絆。這是一封寫給 EYEKONS 的情書，感謝成就這股浪潮的每一位，《KATSEYE: WILD HEARTS》將向世界宣告：這群女孩的故事，才正要揭開序幕。  從《Dream Academy》的高壓舞台，到橫掃各大音樂榜單的爆紅奇蹟，觀眾將一同見證 KATSEYE 邁向國際流行巨星之路的高峰與低谷、背後的犧牲與突破。KATSEYE 憑著對表演藝術的不懈追求與震撼人心的現場魅力，榮獲《紐約時報》、《Vogue》、《Rolling Stone》及《Billboard》等國際頂尖媒體一致盛讚。作為當今流行樂壇最受矚目的新生代國際團體，她們正以勢不可擋的姿態，奠定其世界級女團的地位。  大熱 Netflix 紀錄片《POP STAR ACADEMY》原班幕後團隊再度力作，全新推出《KATSEYE: WILD HEARTS》，由 Interscope Films 與 Boardwalk Pictures 攜手製作，聯同 HYBE X GEFFEN 聯名推出，並由 Nadia Hallgren 親自執導。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
