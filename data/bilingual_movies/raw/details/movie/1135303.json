      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "59岁的迈克·弗林特或许已年过半百，不适合再踏上大学橄榄球场，但他并未因年岁增长而忘却未竟之事的沉重。时隔近四十年，他重返母校，只为重现那次改变一切的撞击。身负伤痕、饱受质疑、几近崩溃的他，仍执意再战一场——不是为了荣耀，而是为了那些逝去的队友、支离破碎的家庭，以及他依然坚信可能实现的结局。",
          "runtime": 0,
          "tagline": "",
          "title": "高年新生"
        }
