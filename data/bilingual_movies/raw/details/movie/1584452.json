      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Šķiet, 13 gadus vecās Frankas dzīvē viss ir nevainojami, taču patiesībā viņa pārdzīvo par savu vecāku strīdiem un par to, ka vienaudži viņu apceļ. Kad viņas dzīvē ienāk pamests suns, tas kļūst par viņas vienīgo atbalstu un cerību uz pārmaiņām. Šis iejūtīgais stāsts par draudzību starp cilvēku un dzīvnieku pievēršas vientulībai, ģimenes attiecībām un pusaudžu garīgajai veselībai, parādot, cik svarīgi ir nebaidīties lūgt palīdzību.",
          "runtime": 99,
          "tagline": "",
          "title": "Smārtijs un es"
        }
