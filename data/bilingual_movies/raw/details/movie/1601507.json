    "translations": [
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Op de dag van een beslissende rechtszaak en een belangrijk huwelijksoptreden wordt het privéleven van een rustige huwelijksmuzikant blootgesteld aan publieke kritiek. Hij wordt beschuldigd van het uitbuiten van zijn huwelijk en beweegt zich tussen de rechtszaal, de straten van de stad en het podium, terwijl hij gebukt gaat onder het gewicht van het oordeel, loyaliteit en onuitgesproken schuldgevoelens. Gedwongen om een terughoudende maar onomkeerbare beslissing te nemen, volgt de film een man wiens innerlijke waarheid ongrijpbaar blijft, gevangen tussen toewijding, waardigheid en verlies.",
          "runtime": 27,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
