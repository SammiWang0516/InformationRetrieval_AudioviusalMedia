  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Malena, a woman who divides her life between two jobs: by night she's a dancer in a cabaret and by day she answers a \"Hot Line,\" an erotic telephone line. However, her routine turns into a nightmare when a serial killer begins calling her, recounting his crimes in chilling detail and announcing that she will be his next victim. This is a clear homage to the Italian Giallo.HoH",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Buenos Aires, anni '80. Malena conduce una doppia vita: di notte è una ballerina in un vivace cabaret; di giorno risponde alle chiamate di un numero verde. La città è sconvolta da una serie di brutali omicidi riportati da radio e TV. Una chiamata sconvolge la routine di Malena. Non è un cliente in cerca di fantasie, ma una voce agghiacciante dall'altro capo del telefono.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Buenos Aires, fines de los 80. Malena lleva una doble vida: de noche, es bailarina en un cabaret; de día, contesta llamadas para una línea erótica telefónica. La ciudad está amenazada por una serie de brutales asesinatos reportados en la radio y la televisión. Una llamada rompe la rutina de Malena. No es un cliente buscando fantasía, sino una voz escalofriante al otro lado de la línea. Un hombre se revela con calma como el notorio asesino de la ciudad. Relata detalles específicos y horribles de sus crímenes pasados y le susurra una aterradora certeza: Malena es la siguiente.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "玛莲娜身兼两份工作：夜晚，她是卡巴莱歌舞表演场所的舞者；白天，她在一条 “热线”—— 一条色情电话热线 —— 接听来电。然而，当一名连环杀手开始给她打电话，极其惊悚地详细讲述其罪行，并宣称她将成为下一个受害者时，她原本的日常生活变成了一场噩梦。这明显是对意大利黑色电影的致敬。",
          "runtime": 0,
          "tagline": "",
          "title": "电话热线"
        }
      },
      {
        "iso_3166_1": "GE",
        "iso_639_1": "ka",
        "name": "ქართული",
        "english_name": "Georgian",
        "data": {
          "homepage": "",
          "overview": "ბუენოს-აირესი, 1980-იანი წლების ბოლო. ტელეფონით სექსუალური მომსახურების ოპერატორი ხდება სერიული მკვლელის სამიზნე, რომელიც ამავე „ცხელ ხაზს“ იყენებს თავისი დანაშაულების აღსაწერად...",
          "runtime": 0,
          "tagline": "",
          "title": "ცხელი ხაზი"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "1980년대 부에노스아이레스. 말레나는 밤에는 화려한 카바레의 댄서로, 낮에는 성인 전화 상담 ‘핫라인’ 상담원으로 이중생활을 이어간다. 하지만 연쇄살인범이 그녀에게 전화를 걸어 자신의 범행을 생생히 털어놓기 시작하면서, 말레나의 일상은 급격히 악몽으로 변한다. 살인범은 다음 타깃이 바로 그녀라고 예고하고 말레나는 욕망과 공포, 도시의 퇴폐적 분위기 속에서 점점 조여오는 죽음의 위협과 맞서게 된다.",
          "runtime": 90,
          "tagline": "",
          "title": "핫라인"
        }
      }
    ]
  },
