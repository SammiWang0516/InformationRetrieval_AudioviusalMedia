      {
        "iso_3166_1": "LT",
        "iso_639_1": "lt",
        "name": "Lietuvių",
        "english_name": "Lithuanian",
        "data": {
          "homepage": "",
          "overview": "Turtingas ir nuobodžiaujantis markizas nuosavoje saloje nuolat organizuoja siautulingus vakarėlius, kuriuose dalyvauja visuomenės elgesio normų nesuvaržyti žmonės. Viename tokių vakarėlių jis susipažįsta su Elena ir tarp jų iš karto užsiplieskia nenugalima aistra. Išsiskyręs su žmona ir vedęs Eleną, markizas pagaliau vėl atgauna gyvenimo džiaugsmą ir nusikrato nuobodulio. Laimingi įsimylėjėliai nevaržo nei savo jausmų, nei seksualinio elgesio formų. Iš pradžių atsitiktinai, o vėliau – ir sąmoningai jie leidžia pašaliniams stebėti jų erotinius žaidimus, kurie tampa vis įmantresni ir vis dažniau balansuojantys ant moralės ir pavojingų veiksmų ribos...",
          "runtime": 90,
          "tagline": "",
          "title": "Kitų akimis"
        }
      },
      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Erotisks trilleris par noslēpumaino Elenu, kura ierodas Vidusjūras salā un uzsāk kaislīgu romānu ar ekscentrisko, pasakaini bagāto marķīzu Lelio. Pāris ātri vien ieslīgst bīstamās varas spēlēs un luksusa dzīves izvirtībā, izrādot savu intīmo dzīvi svešām viesu acīm. Gadu gaitā elegantā villa pārvēršas par psiholoģisku cietumu, kurā Elena ieslīgst depresijā, bet Lelio kļūst slimīgi greizsirdīgs un kontrolējošs. Līdz kādu dienu erotiskās spēles izvēršas asiņainā un traģiskā nobeigumā.",
          "runtime": 90,
          "tagline": "",
          "title": "Svešām acīm"
