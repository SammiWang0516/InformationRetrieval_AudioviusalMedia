        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "A lenda do punk que se tornou sensação do pop, Billy Idol, abre o jogo neste documentário eletrizante, revelando sua ascensão à fama, a batalha contra o vício e o retorno triunfante que conquistou milhões de fãs em todo o mundo.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
