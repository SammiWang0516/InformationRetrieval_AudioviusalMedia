      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "קפטן ג'ורדן רייט (קיפר סאתרלנד) ולוחמי היחידה המיוחדת שלו מגיעים לעיירה בדרום אמריקה כדי להשתתף בחתונתו של חברם לנשק. אלא שהחגיגה הופכת למרחץ דמים כאשר החבר נרצח באכזריות בידי אנשי קרטל סמים השולט בעיירה.  נחושים לנקום את מותו ולהגן על התושבים, יוצאים הלוחמים למלחמה חסרת פשרות נגד הקרטל האכזרי.  אך כאשר כוחות הקרטל סוגרים עליהם מכל עבר וכל דרכי המילוט נחסמות, מבינים רייט ואנשיו כי הדרך היחידה לשרוד היא להילחם עד הכדור האחרון ולנצל את האימונים שהכשירו אותם להתקבל ליחידה המיוחדת.",
          "runtime": 0,
          "tagline": "",
          "title": "שטח אש"
        }
