      {
        "iso_3166_1": "ES",
        "iso_639_1": "eu",
        "name": "euskera",
        "english_name": "Basque",
        "data": {
          "homepage": "",
          "overview": "Maia, neska irudimentsu eta bihurria, eta Jan, hiriko mutil beldurtua, biak 9 urtekoak, denboraren aurkako lasterketa egingo dute Sebastian Sebastian eraikitzaile eszentrikoak mehatxatutako udako kanpalekua salbatzeko. Helburua lortzeko, nekaezin bilatuko dute haranean oraindik bizi dela uste duten baina inork ikusi ez duen hartz bat. Abentura ausart honetan, Fritzek lagunduko die, mofeta dibertigarri eta haserrekorra —hitz egiten duena!—, harana eta bertako animaliak salbatzeko taldean sartuko dena.",
          "runtime": 0,
          "tagline": "",
          "title": "Hartz-atzapar kanpamentua"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
