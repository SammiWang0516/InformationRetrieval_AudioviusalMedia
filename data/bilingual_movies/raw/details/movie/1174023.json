  "translations": {
    "translations": [
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Mitten in der ostdeutschen Provinz wird ein wohlkonserviertes Skelett aus dem Moor gezogen. Tine und das Dorf spekulieren: Wer könnte das gewesen sein? Ein desertierter Wehrmachtssoldat? Ein verzweifelter LPGler? Der ominöse 3. Mann vom BND? Es entspinnt sich ein historisches Rätsel, in dem das letzte deutsche Jahrhundert im Heute eines Landstrichs aufscheint. Tine fragt sich: Was geht mich das an? Bis sie am eigenen Leib erfährt, wie sich die Geschichte in ihr Leben mischt.",
          "runtime": 133,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "“If the ghosts can visit our time, we can visit theirs”. This freewheeling tour of German history of the 20th and 21st centuries follows a postmodern artist back to her East German village birthplace – where a discovered skeleton opens up mysteries both personal and political.",
          "runtime": 133,
          "tagline": "",
          "title": "Red Stars Upon the Field"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "如果歷史可以穿越，回到過去是否就能改寫未來？曾拍攝多部短片及在電視台工作的導演蘿拉拉普斯執導首部長片，將不同形式及風格的影像巧妙融合，疑幻疑真的電視片段配上德國哲學家本雅明的金句，大膽破格，挑戰我們對歷史的認知。藝術家天妮希望用行動為社會帶來改變，當她為逃避警察追查而回到家鄉小鎮，赫然發現鎮上驚現人的骸骨。究竟骸骨是屬於納粹時代的亡魂，還是另有內情？骸骨和鎮上的居民又有何關係？當天妮拿起攝錄機拍攝短片時，才發現案中有案，謎團有如陰霾般縈繞不散，帶領觀眾走進一段不可告人的德國黑歷史。",
          "runtime": 0,
          "tagline": "",
          "title": "骨中自有黑歷史"
        }
      },
      {
        "iso_3166_1": "SE",
        "iso_639_1": "sv",
        "name": "svenska",
        "english_name": "Swedish",
        "data": {
          "homepage": "",
          "overview": "Vänsteraktivisten Tine är på flykt. Hon hamnar på den östtyska landsbygden; bland nazister, före detta Stasi-agenter och mitt i en mystisk mordgåta som utspelar sig under 100 år av tysk historia.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
