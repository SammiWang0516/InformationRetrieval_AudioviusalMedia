  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "PLEASE is a dark comedy about humankind’s desire to love and be loved. An animated short centred around neediness, intimacy and romance. In a world that preaches self-control, the film explores the vulnerable sides of ourselves we try to hide.",
          "runtime": 9,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "In einer Großstadt sind mehrere Figuren, die sich verzweifelt nach Zuneigung sehnen, auf der Suche nach einer liebevollen Beziehung und geraten dabei in Situationen, die zugleich absurd, komisch und bewegend sind.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Una commedia nera sul desiderio dell’umanità di amare ed essere amata. Il film ruota attorno ai temi del bisogno d’affetto, dell’intimità e del romanticismo. Attraverso una serie di scene vagamente collegate tra loro, tenere e assurde, il film segue le vicende di persone alla ricerca di vicinanza e accettazione. In un mondo che predica l’autocontrollo, il film esplora i lati di noi stessi che cerchiamo di nascondere, come il sentirci bisognosi d’affetto e patetici. Le storie si intrecciano e ricompaiono, formando gradualmente un ritratto del desiderio collettivo.",
          "runtime": 9,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Dans une grande ville, plusieurs personnages désespérément en manque d'affection sont en quête d'une relation affective et vont se retrouver plongés dans des situations à la fois absurdes, drôles et émouvantes...",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "城市裡，一群渴望被愛的人努力尋找彼此。一次次荒謬又尷尬的相遇，讓孤獨、親密與渴望交織成一則既幽默又心碎的群像故事。",
          "runtime": 0,
          "tagline": "",
          "title": "請"
        }
