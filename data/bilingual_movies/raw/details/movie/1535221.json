      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Gentry Wade, filha de uma lendária estrela da música, retorna ao Grand Ole Opry, um dos mais famosos palcos da música country dos Estados Unidos, para as comemorações de seu centenário durante o Natal.",
          "runtime": 87,
          "tagline": "",
          "title": "Natal no Grand Ole Opry"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Джентри Уэйд оставила музыку после смерти отца много лет назад. Теперь ей придется вернуться в прошлое, когда знаменитый Гранд-Ол-Опри приглашает ее на свое рождественское шоу, чтобы почтить память ее покойного отца - легенды кантри.",
          "runtime": 0,
          "tagline": "",
          "title": "Рождество в Гранд Ол Опри"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "几十年前，父亲去世后便放弃音乐的金特里·韦德，在纳什维尔的大奥普里剧院邀请她在圣诞庆典上纪念她已故的乡村音乐明星父亲时，必须直面自己的过去。",
          "runtime": 0,
          "tagline": "",
          "title": "大奥普里圣诞夜"
        }
      },
      {
        "iso_3166_1": "DK",
        "iso_639_1": "da",
        "name": "Dansk",
        "english_name": "Danish",
        "data": {
          "homepage": "",
          "overview": "Gentry Woods, der opgav musikken efter sin fars død for årtier siden, må se sin fortid i øjnene, da Nashvilles Grand Ole Opry inviterer hende til at hylde sin afdøde far – en countrystjerne – ved deres julefejring.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Gentry, fille du chanteur Jett Wade du duo country Winters and Wade, est invitée à monter sur scène au Grand Ole Opry pour rendre hommage à son père décédé. Mais elle hésite, ne se sentant pas légitime après avoir échoué à percer comme compositrice. C'est alors qu'elle et son meilleur ami sont propulsés trente ans en arrière, quelques jours avant le dernier concert du duo.",
          "runtime": 90,
          "tagline": "",
          "title": "Le Noël des légendes"
        }
      },
