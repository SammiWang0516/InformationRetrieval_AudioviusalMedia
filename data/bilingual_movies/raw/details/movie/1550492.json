      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Szesnastoletni Maks trafia na Mazury, by opiekować się chorą babcią. Miejsce dziecięcych wspomnień okazuje się mroczne i obce. Ukochana babcia już go nie rozpoznaje, a starsza siostra Emma – pogrążona w kryzysie po sportowej porażce – szuka ukojenia w narkotykach i bezczynności. Relacja rodzeństwa, z początku naznaczona rywalizacją, zmienia się w erotyczną grę. W tym samym czasie w babci budzi się potwór; niemal równie przerażający co pożegnanie z niewinnością, z którym Maks musi się skonfrontować.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
