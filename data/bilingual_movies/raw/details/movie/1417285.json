  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "“ค่ำคืนเดียว ที่ทิ้งรอยตลอดกาล” คือคำจำกัดความของเรื่องราวที่เริ่มต้นจากความตายอันเป็นปริศนาของหญิงสาวในหอพักแห่งหนึ่ง ซึ่งเหตุการณ์นี้กลายเป็นโศกนาฏกรรมที่เริ่มเปิดเผยเงื่อนงำความสัมพันธ์  สายฟ้าแลบ  ระหว่างเธอ, แฟนหนุ่ม, รุ่นน้องสาว และเพื่อนสนิท ทุกคนล้วนมี  รอย  บางอย่างซ่อนไว้ และความจริงในคืนนั้นอาจเปลี่ยนชีวิตพวกเขาไปตลอดกาล",
          "runtime": 0,
          "tagline": "",
          "title": "ราคี"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "When Malee, a young woman with a dark past, is drawn by fate to an apartment where she must confront haunting memories from her childhood, she encounters Pran, a botanist, a tea blending master, and the founder of a Thai floral tea brand.",
          "runtime": 105,
          "tagline": "One night, one stain written into a lifetime.",
          "title": "The Stain"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "背負黑暗過去的瑪麗（Engfa飾演），重返一棟承載童年記憶的公寓，試圖尋找遺失已久的答案。在那裡，她邂逅了溫柔體貼的植物學家兼調茶師阿班（Apo飾演）。一段看似命中注定的愛情悄然萌芽，也讓瑪麗以為自己終於能擺脫過去陰影，重啟嶄新人生。不過，這段感情並不如表面般單純。隨著阿班的摯友阿亞（Jes飾演），以及與他關係密切的心理治療師小清（Freen飾演）相繼捲入其中，四人的命運開始產生無法預料的交集。愛情、友情與佔有慾逐漸失去界線；信任、猜忌與執念也悄悄滋長。當隱藏多年的秘密被一層層揭開，埋藏在記憶深處的傷痕與真相也隨之浮現，直到發生一場突如其來的死亡事件，更讓所有人的命運，朝難以挽回的方向逐漸失控……",
          "runtime": 0,
          "tagline": "",
          "title": "鬼汙"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Mang theo những ám ảnh từ quá khứ, Malee - do Engfa thủ vai, trở về khu căn hộ gắn liền với tuổi thơ và tìm thấy tình yêu bên Pran – một nhà thực vật học đam mê nghệ thuật pha trà. Thế nhưng, sự xuất hiện của những mối quan hệ xung quanh Pran cùng những bí mật tưởng đã bị chôn vùi từ lâu dần làm xáo trộn mọi thứ. Khi một cái chết bất ngờ xảy ra, những sự thật đen tối dần dần được phơi bày.",
          "runtime": 0,
          "tagline": "",
          "title": "Ma Nữ Oán Tình"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "背负黑暗过去的玛丽（Engfa 饰演），重返一栋承载童年记忆的公寓，试图寻找遗失已久的答案。在那里，她邂逅了温柔体贴的植物学家兼调茶师阿班（Apo 饰演）。一段看似命中注定的爱情悄然萌芽，也让玛丽以为自己终于能摆脱过去阴影，重启崭新人生。不过，这段感情并不如表面般单纯。随着阿班的挚友阿亚（Jes 饰演），以及与他关系密切的心理治疗师小清（Freen 饰演）相继卷入其中，四人的命运开始产生无法预料的交集。爱情、友情与占有欲逐渐失去界限；信任、猜忌与执念也悄悄滋长。当隐藏多年的秘密被一层层揭开，埋藏在记忆深处的伤痕与真相也随之浮现，直到发生一场突如其来的死亡事件，更让所有人的命运，朝难以挽回的方向逐渐失控……",
          "runtime": 0,
          "tagline": "一夜之间，一个污点写进了一生。",
          "title": "污点"
        }
      }
    ]
  },
