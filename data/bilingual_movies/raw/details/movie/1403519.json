  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Sofia works as a location scout for a TV pilot filming in New York City. It’s her job to find the homes, businesses, and exteriors where the show will be filmed. Driving around the city's different neighborhoods, she enters the private spaces of strangers to photograph their cozy apartments and eclectic shops, stepping into the fabric of their lives while trying to satisfy the demands of her erratic employers. Over a day filled with these encounters, Sofia witnesses moments of curiosity, vulnerability, and quiet tension until her work takes a sudden, personal turn.",
          "runtime": 89,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Fascynujące studium charakteru osadzone w zgiełku Nowego Jorku. W jego centrum znajduje się Sofia, poszukiwaczka lokalizacji, której zadaniem jest znalezienie idealnych wnętrz do nowego pilota serialu telewizyjnego — jednak to, czego naprawdę szuka, może być trudniejsze do określenia. Wślizguje się i wymyka z domów nieznajomych, uchwytując ulotne chwile intymności, ciekawości i wrażliwości, aż jej praca przybiera nagły, osobisty obrót.",
          "runtime": 89,
          "tagline": "",
          "title": "The Scout"
        }
      }
    ]
  },
