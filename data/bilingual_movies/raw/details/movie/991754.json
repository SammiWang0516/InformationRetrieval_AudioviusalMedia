  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Joe and Isabel’s marriage is dying when Kitti, a naked stranger found floating in the pool at their holiday villa in Greece, is invited to stay. Kitti collects and eats poisonous plants, and Nina, their teenage daughter, is enthralled by her. What kind of relief can Kitti provide for this family in crisis?",
          "runtime": 100,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "스위밍 홈"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Wanneer Isabel en haar familie bij hun vakantievilla aankomen, vinden ze Kitti naakt drijvend in het zwembad. Geheel onverwacht nodigt Isabel deze vreemdeling uit om te blijven. Kitti blijkt botanist te zijn en verzamelt giftige planten. Haar aanwezigheid zet de verhouding tussen Isabel en haar man Joe op scherp. Als de temperatuur stijgt en de spanningen verder oplopen, verandert de zonovergoten vakantie van het gezin in een hachelijk schouwspel waarbij verborgen gevoelens niet langer onderdrukt kunnen blijven.",
          "runtime": 99,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Amikor egy középosztálybeli család megérkezik a görög tengerparton lévő nyaralójába, egy idegen lányt találnak az úszómedencéjükben, akinek jelenléte, bár először segítségnek hitték, fokozatosan elmélyíti a szakadékot a családtagok között.",
          "runtime": 96,
          "tagline": "",
          "title": "Hazaúszom"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Žena pozve nahého cizince, kterého najde plavat v bazénu své rodinné prázdninové vily, aby jí pomohl osvobodit se, od těch které miluje.",
          "runtime": 0,
          "tagline": "",
          "title": "Žena z bazénu"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Historia rodziny z klasy średniej, której życie zostaje zakłócone przez pojawienie się nagiej nieznajomej w basenie ich wakacyjnej willi w Grecji.",
          "runtime": 0,
          "tagline": "",
          "title": "Płynąc do domu"
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Историята на семейство от средната класа, чийто живот е разстроен от появата на непозната гола жена на име Кити в басейна на вилата им в Гърция.",
          "runtime": 0,
          "tagline": "",
          "title": "Плуване към дома"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "乔和伊莎贝尔的婚姻正走向终结，此时基蒂——一个在希腊度假别墅泳池里漂浮的赤裸陌生人——被邀请留下。基蒂采集并食用有毒植物，他们十几岁的女儿妮娜被她深深迷住。基蒂能为这个陷入危机的家庭带来怎样的解脱？",
          "runtime": 0,
          "tagline": "",
          "title": "游泳回家"
        }
      },
      {
        "iso_3166_1": "SE",
        "iso_639_1": "sv",
        "name": "svenska",
        "english_name": "Swedish",
        "data": {
          "homepage": "",
          "overview": "Joe och Isabel gör ett sista försök att lappa ihop sitt äktenskap när de åker med sin dotter Nina till sitt soliga semesterhus. Plötsligt påträffas en naken främling i deras pool, och när Isabel bjuder in henne att stanna blir spänningarna i tillvaron än mer tänjda. Swimming Home är en sensuell tragikomedi med Christopher Abbott och Mackenzie Davis.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Joe ve Isabel, kızları Nina'yı güneşli tatil evlerine götürdüklerinde evliliklerini düzeltmek için son bir girişimde bulunurlar. Birdenbire havuzlarında çıplak bir yabancı bulunur ve Isabel onu kalmaya davet edince hayatlarındaki gerginlik daha da artar. Swimming Home, Christopher Abbott ve Mackenzie Davis'in başrollerini paylaştığı duygusal bir trajikomedi.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "En vacances, alors que leur mariage se délite, Joe et Isabel découvrent une belle inconnue flottant nue dans la piscine de leur villa. Pourquoi ne pas l’inviter à rester ? Sera-t-elle leur salut ou leur perte?",
          "runtime": 99,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "遊泳回家"
        }
      },
      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Spindz vējš, vijas saulē iedegušas ādas smarža. Kad sieva, vīrs, meita un ģimenes draudzene ierodas saules izsutinātajā piejūras villā, viņi sastop kailu svešinieci ar zaļiem nadziņiem. Sašūpojot ilgi gribētā miera gaidas, noslēpumainā Kitija pavada dienas novērojot un provocējot atpūtniekus. Starp sievu Izabellu, kara žurnālisti, un vīru Džo, veiksmīgu, bet pašdestrukcijā nokaitētu dzejnieku, no jauna nostājas pagātne un aizvainojums. Vēloties aizmirsties, varoņi zina vienu – dziņu elles loka sākums ir šis nevainīgais, tirkīzzilais baseins.",
          "runtime": 0,
          "tagline": "",
          "title": "Peldmāja"
        }
      }
    ]
