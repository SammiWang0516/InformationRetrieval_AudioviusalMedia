  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Dondo is a young surfer. His fisherman dad Willy disappeared a year ago.  No sign of his boat, nor his body. Dondo’s mother and the community know Willy has not survived a year in the Atlantic.  But Dondo thinks differently.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Юний серфінгіст Дондо намагається прийняти зникнення свого батька-рибалки у морі. До тями його приводить бунтівна розумниця Сас, яка не боїться підбивати інших на витівки. Вона пропонує хлопцю втекти з острова, щоб знайти власний шлях через хвилі, вірування, і пекельний вогонь.",
          "runtime": 90,
          "tagline": "",
          "title": "Тихий рев"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Dondo é um jovem surfista que ainda não superou o desaparecimento de seu pai, um pescador chamado Willy. A mãe de Dondo e a comunidade acreditam que Willy não sobreviveu ao tempo que passou no Atlântico, mas Dondo pensa diferente.",
          "runtime": 0,
          "tagline": "",
          "title": "Como Uma Onda no Mar"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Юный сёрфер Дондо пытается смириться с исчезновением своего отца-рыбака в море. Его выводит из оцепенения бунтарка Сас, которая не боится подбивать других на авантюры. Она предлагает парню сбежать с острова, чтобы найти свой путь через волны, верования и адский огонь.",
          "runtime": 0,
          "tagline": "",
          "title": "Рёв волны"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Un joven surfista tiene que enfrentarse al dolor por la muerte de su padre.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "丹多是个年轻的冲浪手，他的渔民父亲威利在一年前失踪了。没有发现他的船，也没有找到他的尸体。丹多的母亲和社区的人们都知道，威利不可能在大西洋上生存一年，但丹多不这么认为。",
          "runtime": 0,
          "tagline": "",
          "title": "无声咆哮"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Na odlehlém ostrově Lewis ve Vnějších Hebridách žijí Dondo a Sas, dospívající chlapec a dívka, kteří se snaží najít smysl svého života.",
          "runtime": 0,
          "tagline": "",
          "title": "Tiché burácení"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Na odległej wyspie Lewis mieszkają Dondo i Sas, nastoletni chłopak i dziewczyna, którzy próbują zrozumieć swoje życie.",
          "runtime": 0,
          "tagline": "",
          "title": "Cichy ryk"
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Egy fiatal szörfös történetét követi nyomon, akinek meg kell birkóznia a gyásszal, miután édesapja elhunyt.",
          "runtime": 0,
          "tagline": "",
          "title": "Csendes üvöltés"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Dondo, un tânăr surfer marcat de dispariția tatălui său în mare, trăiește o iubire secretă pentru Sas, care visează să părăsească insula. Viața lui se schimbă odată cu sosirea neașteptată a unui preot neobișnuit.",
          "runtime": 90,
          "tagline": "",
          "title": "Urlet tăcut"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "丹多是個年輕的衝浪手，他的漁民父親威利在一年前失蹤了。沒有發現他的船，也沒有找到他的屍體。丹多的母親和社區的人們都知道，威利不可能在大西洋上生存一年，但丹多不這麼認為。",
          "runtime": 0,
          "tagline": "",
          "title": "無聲咆哮"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "自從父親在船難中失蹤，少年丹多總是死抓著一塊衝浪板，獨自凝視蘇格蘭北方的海平線，彷彿能在碎散的浪花之間尋回父親的身影。丹多的同學莎絲渴望逃離這座沉悶孤島。只信奉搖滾和自由的她，不願承認丹多那純真迷惘的眼神，早已在她心中掀起波瀾。海岸彼方，是青春的狂風怒浪，在沉默中咆哮，將要席捲而來。",
          "runtime": 0,
          "tagline": "",
          "title": "追愛衝浪手"
        }
      }
    ]
