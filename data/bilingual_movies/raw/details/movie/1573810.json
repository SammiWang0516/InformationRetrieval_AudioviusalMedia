  "translations": {
    "translations": [
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Rázný a svérázný basketbalový trenér Marek neuspěje při pokusu dostat svůj tým do druhé národní ligy. Nejraději by s trénováním úplně seknul. Jenže jeho syn Šimon, který má mentální postižení, sní o tom, že jednou bude hrát basketbal za národní tým na paralympiádě. Marek, který svého syna miluje, se rozhodne mu tento sen splnit. Narazí ovšem na zásadní problém. Nedaří se mu totiž sestavit dostatečně početný tým vhodných hráčů, kteří by zároveň splňovali paralympijské parametry.",
          "runtime": 127,
          "tagline": "Sen, který se musí splnit. Za každou cenu!",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Marek is a failed basketball coach whose disabled son dreams of participating in the Paralympics in Rio. Unable to field a team of disabled athletes, Marek resorts to fraud and, under the influence of a slightly crazy neighbor, hires able-bodied basketball players to fake their disabilities. Together with his unsuspecting wife, he and his \"dream team\" set off for Rio, and it is only under the hot Brazilian sun that Marek realizes how karma is catching up with him and that even the best sporting performance may not be enough to escape it. The film Dream Team is not only full of crazy comic situations, but also tells the story of personal honor and the power of parental love.",
          "runtime": 127,
          "tagline": "",
          "title": "Dream Team"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Чтобы исполнить мечту сына с особенностями развития, тренер идёт на величайшую аферу в истории баскетбола. Он собирает команду из бывших зэков и актёров, чтобы они изображали игроков с ментальными отклонениями на Паралимпиаде. Смогут ли симулянты стать чемпионами, или их грандиозный обман раскроется?",
          "runtime": 0,
          "tagline": "",
          "title": "Команда мечты"
        }
      },
      {
        "iso_3166_1": "SK",
        "iso_639_1": "sk",
        "name": "Slovenčina",
        "english_name": "Slovak",
        "data": {
          "homepage": "",
          "overview": "Marek je neúspešný basketbalový tréner, ktorého postihnutý syn sníva o účasti na paralympiáde v Riu. Keďže Marek nedokáže zostaviť tím postihnutých športovcov, uchýli sa k podvodu a pod vplyvom mierne bláznivého suseda si najme telesne zdravých basketbalistov, aby predstierali svoje postihnutie. Spolu s nič netušiacou manželkou sa so svojím „dream teamom“ vydá na cestu do Ria a až pod horúcim brazílskym slnkom si Marek uvedomí, ako ho karma dobieha a že ani ten najlepší športový výkon nemusí stačiť na to, aby sa jej vyhol. Film Dream Team je nielen plný bláznivých komických situácií, ale rozpráva aj príbeh o osobnej cti a sile rodičovskej lásky.",
          "runtime": 0,
          "tagline": "",
          "title": "Dream Team"
        }
      }
    ]
  },
