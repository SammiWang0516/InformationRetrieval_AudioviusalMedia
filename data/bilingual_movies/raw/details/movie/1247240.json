        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "本片以 1946 年的河內戰役為背景，講述民兵範丹和熱愛鋼琴的少女俸香之間的愛情故事。他們在戰亂之中失散，但趕及在軍隊撤退到後方基地前的最後一天重逢，兩人努力把握時間完成婚禮，有情人終成眷屬。作品充分展現了愛情的偉大和 河內人民無懼戰爭的堅毅精神。",
          "runtime": 0,
          "tagline": "",
          "title": "戰事中相愛的我們"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "本片以1946年的河内战役为背景，讲述民兵范丹和热爱钢琴的少女俸香之间的爱情故事。他们在战乱之中失散，但赶及在军队撤退到后方基地前的最后一天重逢，两人努力把握时间完成婚礼，有情人终成眷属。作品充分展现了爱情的伟大和 河内人民无惧战争的坚毅精神。",
          "runtime": 0,
          "tagline": "",
          "title": "战事中相爱的我们"
        }
      }
