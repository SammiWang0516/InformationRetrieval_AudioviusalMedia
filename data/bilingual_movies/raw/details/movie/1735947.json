        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Sigue a Eva por Madrid y el Museo Reina Sofía mientras se enfrenta a cuestiones relacionadas con el trabajo, la memoria y el desplazamiento.",
          "runtime": 96,
          "tagline": "",
          "title": ""
        }
