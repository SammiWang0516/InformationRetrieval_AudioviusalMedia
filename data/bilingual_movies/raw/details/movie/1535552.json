      },
      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Zgodba zadnje jugoslovanske košarkarske reprezentance in njihovega prizadevanja za zlato medaljo na evropskem prvenstvu leta 1991, sredi političnih pretresov in bližajoče se vojne. Psihološka študija igralcev, preizkušenj njihove tovarišije ter izjemne izkušnje pripadnosti edinstveni ekipi v zgodovini športa - edini ekipi, ki je osvojila zlato, stala na odru in gledala, kako se dviga njihova zastava v čast državi, ki je tri dni prej prenehala obstajati.",
          "runtime": 0,
          "tagline": "",
          "title": "Izgubljeno moštvo"
        }
      },
      {
        "iso_3166_1": "HR",
        "iso_639_1": "hr",
        "name": "Hrvatski",
        "english_name": "Croatian",
        "data": {
          "homepage": "",
          "overview": "U ovom dokumentarcu jugoslavenska košarkaška reprezentacija 1991. bori se za osvajanje Europskog prvenstva usred neizvjesnosti dok im je država na rubu raspada.",
          "runtime": 0,
          "tagline": "",
          "title": "Izgubljeni Dream Team"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "The Lost Dream Team"
        }
      },
      {
        "iso_3166_1": "RS",
        "iso_639_1": "sr",
        "name": "Srpski",
        "english_name": "Serbian",
        "data": {
          "homepage": "",
          "overview": "Јун 1991. Југословенска кошаркашка репрезентација спрема се да наступи на Европском првенству у Риму. Они су актуелни светски и европски шампиони, слављени као једна од најбољих генерација у историји спорта. Међутим, ово првенство не личи ни на једно претходно – одвија се у сенци распада њихове земље и надолазећег рата. Изгубљени дрим тим доноси причу о јединственом тиму у историји спорта — једином тиму који је освојио златну медаљу, стајао на победничком постољу и гледао како се подиже застава, све у славу земље која је престала да постоји само три дана раније.",
          "runtime": 0,
          "tagline": "",
          "title": "Изгубљени дрим тим"
        }
      }
    ]
  },
