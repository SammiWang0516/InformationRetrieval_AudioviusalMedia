      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "太平洋某島，手眼通天的非法人蛇組織在海外綁架和詐騙中國人。為了營救出被綁架的養女，平日沉默寡言的老陳不惜揭露自己隱瞞二十年的秘密往事，和當地年輕警察阿燦攜手對抗龐大的犯罪集團，與黑惡勢力，展開生死決戰。",
          "runtime": 0,
          "tagline": "",
          "title": "殊死一搏"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "บนเกาะแห่งหนึ่งในมหาสมุทรแปซิฟิก องค์กรอสรพิษผิดกฎหมายซึ่งมีฝีมือร้ายกาจได้ลักพาตัวและหลอกลวงชาวจีน เพื่อช่วยลูกสาวบุญธรรมที่ถูกลักพาตัวไป เหล่าเฉินผู้เงียบขรึมไม่ลังเลที่จะเปิดเผยความลับในอดีตของเขาที่เขาซ่อนไว้มานานถึง 20 ปี และร่วมมือกับอาชั่นตำรวจหนุ่มในท้องที่เพื่อต่อสู้กับกลุ่มอาชญากรขนาดใหญ่และพลังชั่วร้ายในการต่อสู้ชี้เป็นชี้ตาย",
          "runtime": 0,
          "tagline": "",
          "title": "เดิมพันชีวิต"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "피의 복수가 시작된다! 양녀 샤오디가 범죄 조직에 납치되자, 정체를 숨기고 살아온 린하이야는 범죄 조직의 심장부로 들어간다. 그는 아버지의 원수를 쫓던 경찰 왕찬과 뜻밖의 동맹을 맺고… 두 사람은 각자의 목적을 위해 파쿤 일당과 목숨을 건 혈전을 벌인다.",
          "runtime": 0,
          "tagline": "",
          "title": "혈전"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Trên một hòn đảo nào đó ở Thái Bình Dương, tổ chức buôn người phi pháp thủ đoạn tày trời bắt cóc và lừa đảo người Trung Quốc ở nước ngoài. Để giải cứu con gái nuôi bị bắt cóc, ông Trần, người thường ngày ít nói, không ngần ngại tiết lộ bí mật đã giấu kín suốt 20 năm qua, hợp tác với cảnh sát trẻ địa phương A Xán để chống lại tập đoàn tội phạm khổng lồ và tiến hành cuộc quyết chiến sinh tử với thế lực đen tối.",
          "runtime": 0,
          "tagline": "",
          "title": "Trận Chiến Sống Còn"
