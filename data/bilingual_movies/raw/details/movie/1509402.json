      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "קומדיית אקשן הולנדית. לונה אסלן היא סוכנת סמויה, שבסיוע עמיתה נילס מצליחה ללכוד את הפושע הבכיר באריס לאחר משימה מסוכנת ומטלטלת. אך בעוד שבשטח היא מתמודדת עם עולם הפשע, בביתה ממתין לה אתגר מורכב לא פחות – בעלה אמרה. אמרה אינו מודע לחיים הכפולים של לונה, אך מתחיל לחשוד בהתנהגותה המסתורית. בעידוד בן דודו הערמומי פרהט, הוא משתכנע שלונה בוגדת בו. כאשר אי-ההבנות הולכות ומחריפות, ומתברר שבאריס סימן למטרה גם את לונה וגם את אמרה, נאלצים בני הזוג אסלן לשלב כוחות ולעשות הכול כדי להציל את חייהם.",
          "runtime": 0,
          "tagline": "",
          "title": "מר וגברת אסלן"
        }
