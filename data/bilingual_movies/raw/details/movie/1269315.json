  "translations": {
    "translations": [
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "幾乎被台北人遺忘的社子島上，在垃圾焚化廠工作的青年守著老鴿舍，被困在鐵皮屋裡反覆度日，生命遲滯。一個燥熱午後，河上漂來神祕女子，兩人身處慾望與命運的匯流處，他們能擺脫共同的生命困境、降河迴游，或從此沉淪擱淺沙洲？",
          "runtime": 102,
          "tagline": "",
          "title": "河鰻"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Liang’s simple, humdrum life in his deceased father’s dilapidated boathouse on the Shezi island takes a totally unexpected turn when he saves a mysterious young woman from drowning. A woman with her own painful past meets a man haunted by nightmares.",
          "runtime": 102,
          "tagline": "",
          "title": "Eel"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "父親一去不返，原本在城市上班的阿亮，回到被遺忘的沙洲，寄居河邊破房子，在垃圾場打工。島民為土地公抬轎，被丟棄的神明都擠在寺廟中。阿亮發現神秘紅裙女子漂浮於河上，她似乎有著不堪回首的過去，或許她根本就是河鰻化身？視覺藝術家朱駿騰首部長片，取景於台北市內遭限制開發逾半世紀的社子島，建構如夢似幻的幽靈地帶，以濃烈的符號和隱喻，展現實驗風格，透過一段萍水相逢的奇遇，映照生命的困頓與無常，探索慾望與歸屬。柏林影展視角單元。",
          "runtime": 0,
          "tagline": "",
          "title": "河鰻"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "父亲一去不返，原本在城市上班的阿亮，回到被遗忘的沙洲，寄居河边破房子，在垃圾场打工。岛民为土地公抬轿，被丢弃的神明都挤在寺庙中。阿亮发现神秘红裙女子漂浮于河上，她似乎有着不堪回首的过去，或许她根本就是河鳗化身？视觉艺术家朱骏腾首部长片，取景于台北市内遭限制开发逾半世纪的社子岛，建构如梦似幻的幽灵地带，以浓烈的符号和隐喻，展现实验风格，透过一段萍水相逢的奇遇，映照生命的困顿与无常，探索欲望与归属。柏林影展视角单元。",
          "runtime": 0,
          "tagline": "",
          "title": "河鳗"
        }
      },
      {
        "iso_3166_1": "LT",
        "iso_639_1": "lt",
        "name": "Lietuvių",
        "english_name": "Lithuanian",
        "data": {
          "homepage": "",
          "overview": "Atokioje saloje netoli Taipėjaus pasirodo paslaptinga  moteris – efemeriška ir nenuspėjama, įkūnijanti kažką pirmykščio ir, kartu, nežemiško. Saloje gyvenantis vyras, kadaise svajojęs apie pabėgimą, dabar yra įstrigęs tarp praeities, kurios negali pakeisti, ir ateities, kurios nenori priimti. Vietoje, kur laiką ir atmintį nusineša vanduo, jųdviejų gyvenimai susilieja kaip dvi srovės, plukdančios ilgesio, prisirišimo ir išsilaisvinimo paslaptis.",
          "runtime": 0,
          "tagline": "",
          "title": "Ungurys"
        }
      }
    ]
  },
