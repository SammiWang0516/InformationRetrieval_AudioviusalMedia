  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Nala live a seemingly harmonious family. The father always prayed for his family to remain healthy and happy, both in this world and the hereafter. However, a figure from the father's past, whose matters remained unresolved, eventually caused a rift in their family life.",
          "runtime": 113,
          "tagline": "",
          "title": "Only Your Name in My Prayers"
        }
      },
      {
        "iso_3166_1": "ID",
