  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ในหมู่บ้านเล็ก ๆ เชิงเขาบูโด เดียนา หญิงสาวที่เพิ่งแต่งงานกับอานัสได้ไม่นาน เริ่มมีอาการแปลกประหลาด หลังจากหายเข้าไปในป่าเขาบูโดเป็นเวลากว่าสองคืน เธออาละวาดทำร้ายทุกคนในบ้าน จนบาบอดิง พี่ชายของเธอต้องเข้ามาช่วย จนในที่สุด อานัสสามีของเธอ ถูกบีบให้ต้องตัดสินใจยิงภรรยาของตนเองเพื่อยุติหายนะ อานัสไม่อาจยอมรับการสูญเสีย และเชื่อว่าวิญญาณของเดียนายังติดอยู่ในโลกญิน เขาจึงร่วมมือกับ ญ่า น้องสาวของเขา เพื่อหาทางนำเดียนากลับมา",
          "runtime": 0,
          "tagline": "ทุกความเชื่อซ่อนบางสิ่งที่ไม่ควรถูกปลุก",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "In a village at the foot of Mount Budo, Diana begins behaving violently after disappearing into the forest, forcing her husband Anas to kill her.",
          "runtime": 97,
          "tagline": "Once it's in your soul, There's no way out.",
          "title": "The Djinn's Curse 2"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Tại một ngôi làng nhỏ dưới chân núi Budo, Deana - một cô gái trẻ vừa mới kết hôn với Anas - bắt đầu có những biểu hiện kỳ lạ sau khi mất tích bí ẩn trong khu rừng Budo suốt hai đêm liền. Cô trở nên điên loạn, bạo lực và tấn công tất cả mọi người trong nhà, cho đến khi Baboding, anh trai của cô, phải can thiệp khống chế. Cuối cùng, để chấm dứt thảm kịch, Anas đã buộc phải đưa ra một quyết định đau đớn tột cùng: nổ súng bắn chết chính người vợ của mình. Không thể chấp nhận mất mát này, Anas tin rằng linh hồn của Deana vẫn đang bị giam cầm trong thế giới của quỷ Djinn. Anh quyết định hợp lực cùng em gái mình là Ya, tìm mọi cách để đưa Deana trở về.",
          "runtime": 0,
          "tagline": "",
          "title": "Quỷ Móc Mắt"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "第一部的惊魂事件后，主角本以为早已摆脱南洋邪术的阴影，却因一场意外再次被卷入更深的禁忌漩涡。一行人踏入传说中一旦进入便无法逃离的邪地，触碰了被封印的古老秘术，沉睡的邪灵再度苏醒，诅咒如影随形。他们必须在被邪灵吞噬前，解开巫术背后的秘密，可越接近真相，就越接近万劫不复的深渊。",
          "runtime": 0,
          "tagline": "",
          "title": "南洋秘术2"
        }
      }
    ]
