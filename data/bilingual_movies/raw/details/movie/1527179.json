      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "电影取材自越南作家淑玲的灵异小说，讲述年轻新娘茉儿嫁入武氏家族后，意外陷入一场恐怖的「恶魔契约」，茉儿出身贫寒的儒学世家，在家族安排下嫁入富裕的武氏家族，她原以为能过上安逸优渥、备受丈夫疼爱的日子，却很快发现这门亲事背后潜藏着诡异的超自然真相，以及与丈夫家族财富有关的惊人秘密。",
          "runtime": 119,
          "tagline": "",
          "title": "契约新娘"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "出身貧寒的儒學世家年輕新娘茉兒，在家族安排下嫁入富裕的武氏家族。她原以為能過上安逸優渥、備受丈夫疼愛的日子，卻很快發現這門親事背後潛藏著詭異的超自然真相。一場恐怖的「惡魔契約」儀式，讓茉兒發現丈夫一家與家族財富的驚人祕密。",
          "runtime": 0,
          "tagline": "",
          "title": "婚陰泣約"
