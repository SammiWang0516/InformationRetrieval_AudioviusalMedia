      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ขณะที่คนในครอบครัวขัดแย้งกันเรื่องที่ดินของพ่อผู้ล่วงลับ ภาพวาดหลอนก็ปลดปล่อยบางสิ่งบางอย่างที่น่าสะพรึงกลัวออกมาในระหว่างพิธีศพที่กินเวลานาน 9 วัน",
          "runtime": 0,
          "tagline": "",
          "title": "หุ่นไล่กาอาถรรพ์"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Khi gia đình nọ lục đục vì mảnh đất do người bố quá cố để lại, một bức tranh kỳ quái xuất hiện và phóng thích thế lực tà ác trong suốt chín ngày tang lễ.",
          "runtime": 0,
          "tagline": "",
          "title": "Bù Nhìn"
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Monet és édesanyja, Rosa története, akik a családfő, Pabling halála miatt gyászolnak. A pasiyam kilenc napja alatt sötét titkok és egy rosszindulatú összeesküvés kezd kibontakozni.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在一座与世隔绝的古老祖宅里，一个家庭多年来隐藏的黑暗秘密开始浮出水面。随着女主角回到这座充满童年阴影的老屋，她发现那些被当成“稻草人”来吓唬小孩的古老传说，似乎并非虚构。每当夜幕降临，某种不可名状的恐惧就会在田野与走廊间游荡。这不仅是一场为了生存的逃亡，更是一次对家族罪孽的血色清算——当那些被掩盖的真相长出尖牙利爪，谁也无法逃脱。",
          "runtime": 90,
          "tagline": "",
          "title": "惊魂稻草人"
        }
      }
