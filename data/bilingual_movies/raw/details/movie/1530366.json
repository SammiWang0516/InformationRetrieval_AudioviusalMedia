      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Octubre, 1936. El franquismo abre campos de concentración por todo el territorio. Utilizan conventos, fábricas, escuelas, plazas de toros, monasterios... San Simón destaca por su insularidad. El régimen convierte el antiguo lazareto en un lugar de muerte donde los prisioneros sufren la represión rodeados de una belleza abrumadora. Siete años después, Lamas recuerda la historia de los hombres y las mujeres que, como él mismo, sufrieron la represión en esta pequeña isla de la costa gallega.",
          "runtime": 107,
          "tagline": "",
          "title": "San Simón"
