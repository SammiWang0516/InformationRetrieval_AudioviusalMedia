      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "当首都最高的摩天大楼陷入熊熊大火，威胁到平民和消防员同伴的生命时，年轻的消防员阿米尔需要站起来，通过克服过去的心理障碍来证明自己。",
          "runtime": 105,
          "tagline": "",
          "title": "烈焰先锋"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "นักผจญเพลิงที่กำลังทุกข์ใจเพราะการตายของรุ่นพี่ที่เขานับถือ ต้องรวบรวมกำลังเพื่อลุกขึ้นมานำทีมในภารกิจกู้ภัย เมื่อเกิดเหตุเพลิงไหม้บนตึกระฟ้าแห่งหนึ่ง",
          "runtime": 0,
          "tagline": "",
          "title": "ตำนานนักผจญเพลิง"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Đang vật lộn với cái chết của thầy mình, viên lính cứu hỏa nọ phải mạnh mẽ lãnh đạo đội trong nhiệm vụ giải cứu khi một tòa nhà chọc trời bốc cháy.",
          "runtime": 0,
          "tagline": "",
          "title": "Di Sản Lính Cứu Hỏa"
        }
      },
      {
        "iso_3166_1": "MY",
        "iso_639_1": "ms",
        "name": "Bahasa melayu",
        "english_name": "Malay",
        "data": {
          "homepage": "",
          "overview": "Selepas berjaya menyelamatkan beberapa pendaki remaja dari Gunung Kinabalu, Amir, seorang anggota pasukan Operasi Penyelamatan Taktik Khas (STORM), menjadi lebih rapat dengan mentornya Eddy. Namun, Eddy terlibat dalam satu kemalangan tragis dan merasa bersalah atas insiden tersebut. Ketika menara TEXVIN 118 terbakar, Amir ditugaskan untuk memimpin misi penting ini. Situasi menjadi semakin tegang apabila seorang anggota bomba juga terperangkap di dalam bangunan itu. Akankah Amir berjaya menyelamatkan mereka atau akankah tragedi masa lalu berulang kembali?",
          "runtime": 0,
          "tagline": "",
          "title": "Legasi: Bomba the Movie"
        }
