      {
        "iso_3166_1": "AZ",
        "iso_639_1": "az",
        "name": "Azərbaycan",
        "english_name": "Azerbaijani",
        "data": {
          "homepage": "https://tagiyevfilm.az/",
          "overview": "1888-ci ilin payızında bütün Bakı Çar III Aleksandrın səfərinə hazırlaşır. Artıq milyonçu olmuş, Bakı Şəhər Dumasının üzvü seçilmiş Hacı Zeynalabdin Tağıyev cəmiyyətdə nüfuz və status uğrunda mübarizə aparır. Şəhər meri Orlovski mövqeyindən istifadə edərək özünə qəsd etmiş Teymurbəyovun neft sahəsini ələ keçirməyə çalışır. Eyni zamanda Hacının böyük oğlu İsmayıl generalın qızı Nurcahan Ərəblinski ilə tanış olur və onunla evlənməyi planlaşdırır.",
          "runtime": 77,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Осенью 1888 г. Баку готовится к визиту Его Величества Александра III, миллионер и гласный Бакинской городской думы Гаджи Зейналабдин Тагиев борется за влияние и статус в обществе, городской голова Орловский, пользуясь своим положением, хочет прибрать нефтяной участок покончившего с собой Теймурбекова, а Исмаил, старший сын Гаджи, знакомится с генеральской дочкой Нурджахан Араблинской и намерен на ней жениться.",
          "runtime": 77,
          "tagline": "",
          "title": "Тагиев: Царь"
        }
      }
