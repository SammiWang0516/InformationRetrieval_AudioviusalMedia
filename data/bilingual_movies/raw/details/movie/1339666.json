      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Holly nap mint nap egy kilátástalan munkában tengődik, miközben a téridő-folytonosság repedéseiről ábrándozik, és azon töpreng, hol siklott félre az élete. Amikor összefut Arabellával, a nyolcéves, lázadó kislánnyal, aki épp elszökni készül az önimádó író apjától, Holly meggyőződésévé válik, hogy ez a találkozás egy égi jel. Szentül hiszi, hogy a kislány valójában a saját gyermekkori énje, akit azért sodort elé a sors, hogy kapjon egy második esélyt. A két elvarázsolt lélek közösen vág neki egy nem mindennapi utazásnak, amely során ráébrednek: pontosan egymás jelenlétére volt szükségük a továbblépéshez.",
          "runtime": 0,
          "tagline": "",
          "title": "Arabella elrablása"
        }
      },
