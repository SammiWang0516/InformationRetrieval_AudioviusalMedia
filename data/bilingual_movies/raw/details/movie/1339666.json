  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://arabella.oscilloscope.net/",
          "overview": "Holly spends days at her dead-end job fantasizing about holes in the space-time continuum and wondering where her life went wrong. When she meets Arabella, an eight-year-old rebel hoping to run away from her self-absorbed author father, Holly becomes convinced their meeting is a cosmic sign, and that Arabella is her past self sent back for a second chance. Embarking on an unconventional road trip, these two lost souls might be exactly what the other needs.",
          "runtime": 107,
          "tagline": "",
          "title": "The Kidnapping of Arabella"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Holly, 28 anni, ha sempre pensato di essere la versione sbagliata di sé stessa e che la sua vita non sia andata nel modo giusto. Quando incontra una bambina di nome Arabella, si convince di aver trovato sé stessa da piccola. Decisa a scappare di casa, la bambina nasconde la sua identità e asseconda il desiderio di Holly: tornare indietro e diventare qualcuno di speciale.",
          "runtime": 107,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Holly, lat 28, zawsze uważała, że ​​jest niewłaściwą wersją siebie i że jej życie nie układa się najlepiej. Kiedy poznaje dziewczynkę o imieniu Arabella, jest przekonana, że ​​odnalazła swoje dzieciństwo. Zdeterminowana, by uciec z domu, dziewczynka ukrywa swoją tożsamość i spełnia marzenie Holly: wrócić i stać się kimś wyjątkowym.",
          "runtime": 107,
          "tagline": "",
          "title": "Porwanie Arabelli"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "스물여덟 살 홀리는 늘 자신이 어딘가 잘못된 모습으로 살아가고 있고, 삶이 기대했던 방향으로 흘러가지 않았다고 생각한다. 그러던 중 아라벨라를 만나고, 그는 그 아이가 어린 시절의 자신이라고 믿게 된다. 집을 떠나고 싶어 하던 아라벨라는 과거를 바꾸고 다시 한번 특별한 존재가 되기 위해 홀리의 계획에 동참하기로 한다.",
          "runtime": 108,
          "tagline": "",
          "title": "아라벨라의 납치"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
