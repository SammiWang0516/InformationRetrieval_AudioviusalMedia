  "translations": {
    "translations": [
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://kazama-kyojo.jp/",
          "overview": "風間教場へ、ようこそー。",
          "runtime": 0,
