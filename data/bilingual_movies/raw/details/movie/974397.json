      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "На порозі свого тринадцятиріччя Бетті Флад стоїть перед вибором: бути людиною та нормальною, як відчайдушно хоче її мати Анеска, або неймовірно дивакуватою, як решта її родини. Коли Бетті дізнається правду про свою магічну спадщину, вона зрозуміє, що звичайне, дивне, чарівне та музичне — усе це частина… бути Бетті Флад.",
          "runtime": 0,
          "tagline": "",
          "title": "Моя химерна сімейка"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
