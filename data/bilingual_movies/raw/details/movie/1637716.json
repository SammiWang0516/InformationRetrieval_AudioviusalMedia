  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Three young friends from Belgrade drive from New York to Los Angeles in a Yugo – a cult relic of a car from the 1980s. A docu-comedy and a road trip with many unexpected encounters.",
          "runtime": 87,
          "tagline": "",
          "title": "Yugo Goes to America"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "세르비아 베오그라드 출신 네 명의 밀레니얼 세대가 한때 미국에서 최악의 자동차로 불렸던 낡은 유고슬라비아산 자동차 ‘유고’를 타고 미국 횡단에 나선다. ‘최악이 된다는 것은 어떤 의미인가?’에 대한 답을 찾기 위해 그들은 뉴욕에서 로스앤젤레스까지 24개 주를 달린다. 이 여정 속에서 이들은 자신의 뿌리를 탐색하고, 유고를 사랑하는 사람들을 만나며, 잊힌 자동차가 두 개의 머나먼 세계를 잇는 뜻밖의 방식을 발견한다.",
          "runtime": 87,
          "tagline": "",
          "title": "유고, 미국에 가다"
        }
      },
      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Štirje milenijci, rojeni v 90. letih v nekdanji Zvezni republiki Jugoslaviji se odpravijo na potovanje po Združenih držav Amerike. Z jugotom, starim jugoslovanskim avtomobilom, ki je bil razglašen za najslabši avtomobil v zgodovini ZDA, prepotujejo 24 zveznih držav, od New Yorka do Los Angelesa, da bi našli odgovor na vprašanje: kaj pomeni biti najslabši? Na poti spoznavajo ljudi, ki so sodelovali pri uvozu Yuga v ZDA v 80. letih, današnje »jugofanatike«, Američane in izseljence iz držav nekdanje Jugoslavije. Hkrati odkrivajo tudi svojo osebno zgodovino in spoznavajo, na kakšen način je neločljivo povezana z Yugom.",
          "runtime": 0,
          "tagline": "Štirje prijatelji, en Yugo in 24 ameriških držav.",
          "title": "Yugo gre v Ameriko"
        }
      }
    ]
  },
