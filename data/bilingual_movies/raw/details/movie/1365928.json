      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一名初出茅廬、滿腔熱血的實習老師即將開學，未料第一天就吃了擁有超硬老爸後臺學生的下馬威。更出乎意料的是，她進而發現三名女學生所組成的「黑魔法社團」，她們夜夜徵求靈魂大王的同意進入異世界，並藉此獲得好成績。這名並非人人想像中那麼「菜」的實習老師，誓死保護這些學生的靈魂，絕不讓她們如昔日學生落入魔掌。層層關卡等在前方，將如何再次挑戰並破解校園怪談？",
          "runtime": 0,
          "tagline": "",
          "title": "單細胞女孩與實習鬼事"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "这是一个的喜剧恐怖故事。恩京回到母校实习，追寻着一个由天才组成的黑魔法俱乐部的传说，这些天才在语言、数学和外语方面从未失手，并与各个学科的鬼魂战斗。",
          "runtime": 0,
          "tagline": "",
          "title": "单细胞少女与学校怪谈2：教学实习"
        }
      }
