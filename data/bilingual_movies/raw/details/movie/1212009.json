  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "患有尿毒症的凌敏一直努力维持着自己的生活，却在一次意外中结识了同样身患重症的吕途。一个清醒倔强，一个看似没心没肺，性格截然不同的两人因为一场特殊的“生命接力”约定被联系在一起。最初互相看不顺眼的他们，在一次次争吵、陪伴与共同面对病痛的过程中逐渐了解彼此，也开始成为对方生活中重要的支撑。面对无法预知的未来，两个年轻人决定不再只等待命运安排，而是一起认真地过好眼前的每一天……",
          "runtime": 129,
          "tagline": "",
          "title": "我们一起摇太阳"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A young woman who needs a kidney transplant wants to marry someone who will be able to donate a kidney, and meets a young man who has a brain disease.",
          "runtime": 129,
          "tagline": "",
          "title": "Viva La Vida"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "尿毒症女孩淩敏（李庚希飾）因一場偶然的事件結識了腦癌患者呂途（彭昱暢飾），性格迥異的兩位年輕人因彼此的出現，生活有了色彩，他們經歷過誤會、波折與考驗，最終，愛讓他們脆弱不堪的生命釋放出無窮的力量。",
          "runtime": 0,
          "tagline": "",
          "title": "我們一起搖太陽"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "當“沒頭腦”呂途（彭昱暢 飾）遇上“不高興”淩敏（李庚希 飾），兩個身患重症卻性格迥異的年輕人，因為“生命接力”的約定，陰差陽錯地踏上了一段充滿愛與力量的治愈之旅。影片是韓延導演“生命三部曲”終章，部分取材于紀實報道文章《最功利的婚姻交易，最動情的永恒約定》。",
          "runtime": 129,
          "tagline": "",
          "title": "我們一起搖太陽"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
