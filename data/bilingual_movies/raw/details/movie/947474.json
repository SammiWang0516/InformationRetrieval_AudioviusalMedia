      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "https://atomart.lv/laimigie",
          "overview": "Skolas brīvlaikā deviņgadīgā Elizabete dodas pie ģimenes uz Venecuēlas lietusmežiem. Tagad, kad pilsētā viņai ir izveidojušās jaunas draudzības, dzīve džungļos viņu vairs nevilina. Vēl jo mazāk viņa vēlas pieskatīt mazo brāli Leo. Kad mamma un tētis steidzami dodas uz pilsētu pie ārsta, Elizabete, aizrāvusies ar grāmatas lasīšanu, nepamana, ka Leo pazūd noslēpumainajos džungļos.Tas ir tikai sākums neparastiem piedzīvojumiem. Elizabetei jāpārvar bailes un jāatrod Leo pirms vecāku atgriešanās, lai atklātu ne tikai drošsirdību, iejūtību un ciešo saikni ar mazo brāli, bet arī īpašu džungļos glabātu noslēpumu.",
          "runtime": 73,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
