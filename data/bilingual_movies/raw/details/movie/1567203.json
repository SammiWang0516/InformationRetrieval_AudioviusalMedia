  "translations": {
    "translations": [
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://yakinjiken.com/",
          "overview": "女子大生・田鶴結貴乃は、古びたアパートで一人暮らしをしながら、高時給に惹かれて、寂れた住宅街の片隅にたたずむ一軒のコンビニで夜勤バイトをしている。ある夜から、店内で説明のつかない“違和感”が現れ始める。監視カメラに“何か”が映り…。",
          "runtime": 0,
          "tagline": "その恐怖は、深夜のコンビニから始まる",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://yakinjiken.com/",
          "overview": "Yukino, a part-time worker at a convenience store, and the strange experience she has when she encounters a mysterious customer in the middle of the night.",
          "runtime": 83,
