        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "사미 순록 목축민 시셀 스토르모 홀탄과 테르예 하우겐은 자신들의 조상 대대로 이어진 땅에 들어선 유럽 최대 규모의 풍력 발전 프로젝트에 맞서 20년 동안 싸워왔다. 노르웨이 대법원이 151기의 터빈이 사미인의 인권을 침해했다고 판결했음에도 불구하고, 정부는 시설 철거 대신 1,400만 유로의 보상금을 제시하며 판결보다 기업의 이익을 보호하는 선택을 했다.",
          "runtime": 102,
          "tagline": "",
          "title": "산을 살게 하라"
        }
      }
    ]
