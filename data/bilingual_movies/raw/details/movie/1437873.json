        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Mała wioska rybacka jednoczy się, aby odzyskać swoją rondallę (grupę marynarzy) po dwuletniej żałobie po tragicznej katastrofie jednego z jej kutrów rybackich.",
          "runtime": 112,
          "tagline": "",
          "title": "Rondallas"
        }
