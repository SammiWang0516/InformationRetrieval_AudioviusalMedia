      {
        "iso_3166_1": "FI",
        "iso_639_1": "fi",
        "name": "suomi",
        "english_name": "Finnish",
        "data": {
          "homepage": "",
          "overview": "Kolmiosainen Sodan edessä -sarja avaa ainutlaatuisen tilaisuuden seurata huipputason kansainvälistä päätöksentekoa kulissien takaa, kun sotilasliitto Naton pääsihteeri Jens Stoltenberg päästää kuvausryhmän taltioimaan omaa työtään. Stoltenbergin viimeinen vuosi virassa on täynnä haasteita. Venäjä on hyökännyt Ukrainaan ja koko Eurooppa pelkää sotaa. Ukrainalle annetut lupaukset tuesta koettelevat diplomatiaa ja liittouman yhtenäisyyttä. (Facing War, Norja & Belgia 2025)",
          "runtime": 0,
          "tagline": "",
          "title": "Sodan edessä"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Jens Stoltenberg hatte geplant, sein einflussreiches Amt als NATO-Generalsekretär nach neun Jahren niederzulegen. Der 65-jährige Politiker hatte bereits seine Sachen gepackt, um zu seiner Frau nach Norwegen zurückzukehren – so wie er es ihr versprochen hatte.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
