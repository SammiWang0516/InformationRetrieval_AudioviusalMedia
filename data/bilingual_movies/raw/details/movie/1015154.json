          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "במהלך מלחמת האזרחים באל סלבדור בשנות ה-80, קבוצת מורדים של גרילה שמאלנית נלחמת לחשוף את \"כוחות המוות\" של ממשלתה באמצעות רשת רדיו מחתרתית, בתקווה לשים קץ לשלטון הטרור של ממשלתה בעזרתו של עיתונאי אמריקאי.",
          "runtime": 0,
