      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "A Fireflies at El Mozote egy lebilincselő háborús akciódráma, amely erős társadalmi relevanciával bír, és amelyet valós események ihlettek. A film az El Mozote faluban (Morazán tartomány, El Salvador) elkövetett, jól dokumentált mészárlás krónikája, amelyet a modern latin-amerikai történelemben a kormányerők által a civilek ellen elkövetett legsúlyosabb atrocitásnak tartanak, egyben pedig a felnőtté válás története is egy tízéves túlélő számára, aki bosszút akar állni családja haláláért és faluja elpusztításáért.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
