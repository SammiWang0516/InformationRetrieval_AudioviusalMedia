      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Die Geschichte wirft ein düsteres Licht auf die Lore: Wendy trennt sich nach einer von Feenstaub-Drogen geprägten, missbräuchlichen Beziehung von James Hook. 18 Jahre später stellt sich heraus, dass Hook der leibliche Vater von Wendys Tochter Lily ist. Hook bricht aus dem Gefängnis aus und startet eine brutale Mordserie an Lily und ihren Freunden während eines Geburtstagswochenendes.",
          "runtime": 79,
          "tagline": "",
          "title": ""
        }
      },
