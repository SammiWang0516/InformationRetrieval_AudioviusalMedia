  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "http://www.gazellefilm.com",
          "overview": "Yakup, a Turkish music teacher seeking asylum in New York, is separated from his wife and young daughter, who remain under surveillance back home. When his asylum case stalls, he faces an impossible choice: wait years for legal reunification or risk everything to bring his family out by dangerous, clandestine means. Alone in an unfamiliar city, Yakup becomes increasingly consumed by the distance between himself and his family. As the wait stretches on, his obsession with reuniting his family begins to warp his sense of time, memory and reality. The more desperate he becomes, the less certain he is of who to trust and what is happening around him.",
          "runtime": 100,
          "tagline": "Exile is only the beginning.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Yakup, ein türkischer Musiklehrer, der in New York politisches Asyl sucht, versucht, sich irgendwie über Wasser zu halten, während er sich durch das US-Einwanderungssystem kämpft. Er arbeitet illegal in der Küche eines Restaurants – zusammen mit einer lebhaften Gruppe anderer Einwanderer – und setzt alles daran, die Voraussetzungen dafür zu schaffen, seine Frau und seine Tochter zu sich zu holen. In einem verzweifelten Versuch, den Prozess zu beschleunigen, wendet er sich an eine Gruppe zwielichtiger Landsleute, die auf riskante Methoden zurückgreifen, um Menschen aus der Türkei herauszuschleusen. Doch die Situation gerät schnell außer Kontrolle, und die Chancen auf eine Wiedervereinigung mit seinen Liebsten schwinden mit jeder Minute.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
  },
