        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在弗兰肯斯坦的怪物举行婚礼的那天，村民们暴动并杀死了他。他的新娘逃走了，发誓要报复负有责任的镇上的人，并最终复活了怪物——在她的身后留下了血迹。",
          "runtime": 0,
          "tagline": "",
          "title": "弗兰肯斯坦的新娘"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "W dniu ślubu Potwora Frankensteina wieśniacy wywołują zamieszki i zabijają go. Jego narzeczona ucieka, przysięga zemstę na odpowiedzialnych za to mieszkańcach miasteczka i ostatecznie wskrzesza Potwora, zostawiając za sobą krwawy ślad.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "科學怪人舉行婚禮的那天，憤怒的村民闖進教堂殺死了他。他的新娘成功逃了出來，誓言要對那些村民展開報仇。",
          "runtime": 0,
          "tagline": "",
          "title": "科學腥娘"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Op de dag van de bruiloft van Frankensteins monster komen de dorpelingen in opstand en vermoorden hem. Zijn bruid ontsnapt, zweert wraak op de verantwoordelijke dorpelingen en wekt uiteindelijk het monster weer tot leven – waarbij ze een spoor van bloed achterlaat.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Es ist der Tag der Hochzeit der von Dr. Victor Frankenstein erschaffenen Kreatur. Allerdings werden die Feierlichkeiten früh unterbrochen, als es zu einem Aufstand der Dorfbewohner kommt, die den Bräutigam als Monster sehen und ihn töten. Seine verzweifelte Braut kann gerade noch entkommen und schwört nun, an den Verantwortlichen Rache zu üben. Während die ebenfalls aus Teilen verstorbener Menschen zusammengesetzte Frau mit allen Mitteln versucht, ihren Liebsten wieder zum Leben zu erwecken, hinterlässt sie eine Blutspur, wo immer sie hinkommt … Der Low-Budget-Horrorfilm ist ein sogenannter „Mockbuster“. Er wurde von dem Studio The Asylum parallel zum Kinostart von Maggie Gyllenhaals „The Bride! – Es lebe die Braut“ veröffentlicht, um von dessen PR zu profitieren.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
  },
