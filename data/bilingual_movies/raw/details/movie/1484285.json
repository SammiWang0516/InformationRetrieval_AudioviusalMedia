      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "군사 훈련이 잦은 어느 마을. 군 당국은 주민들과의 관계를 개선하기 위해 퇴역을 앞둔 군인들을 보내 소와 양을 돌보게 한다. 하지만 이런 선의도 군사 훈련이 주민들의 삶에 남긴 오랜 상흔을 가리기에는 역부족이다. 동물을 돌보던 군인의 사소한 실수를 시작으로 군과 마을 사람들 사이에 숨어 있던 긴장과 갈등이 서서히 드러난다.",
          "runtime": 0,
          "tagline": "",
          "title": "이것은 내 소가 아니다"
        }
      }
    ]
  },
