      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "بعد الاختفاء الغامض لملايين البشر حول العالم، يدخل العالم في فوضى تقوده نحو حرب روحية شاملة في ظل صعود “الحكومة العالمية الجديدة” التي تسعى لفرض سيطرتها الكاملة على من تبقى من البشرية وهنا تنشأ مجموعة مقاومة تُعرف باسم “البقية” !",
          "runtime": 97,
          "tagline": "",
          "title": "مطر العدالة"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Khi một chính phủ thế giới mới nổi lên sau những vụ mất tích bí ẩn của người dân trên toàn thế giới, một nhóm người kháng chiến được gọi là Remnant sống và chết để bảo vệ một tài sản có giá trị sẽ mang lại hy vọng cho những người sống sót sau thảm họa này.",
          "runtime": 0,
          "tagline": "",
          "title": "Cơn Mưa Hi Vọng"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "世界各地人口神秘失踪后，反乌托邦世界中的交战势力为全人类的灵魂而战。新全球政府（NG）试图消灭残余势力，一群反抗者却拥有一本极其珍贵的超自然之书，这本书揭示了如何使用非此世的武器对抗NG。残余势力发现了自己的命运，这预言了邪恶势力在各国崛起。战争和战争的谣言最终演变成一场精神斗争，这场斗争将决定被遗弃的人类的命运。许多人将找到自己的声音、勇气和命运，他们将献出自己的生命来拯救未来。",
          "runtime": 0,
          "tagline": "",
          "title": "公平之雨"
        }
      }
