      {
        "iso_3166_1": "GR",
        "iso_639_1": "el",
        "name": "ελληνικά",
        "english_name": "Greek",
        "data": {
          "homepage": "",
          "overview": "Στο Πορτ Τάλμποτ της Ουαλίας, το 1942, ο Ρίτσαρντ Τζένκινς ζει ως ένας ατίθασος μαθητής, παγιδευμένος ανάμεσα στις πιέσεις της οικογένειάς του που αγωνίζεται, σε έναν καταστροφικό πόλεμο και στις δικές του φιλοδοξίες. Ωστόσο, μια νέα ευκαιρία προκύπτει όταν το φυσικό ταλέντο του Ρίτσαρντ για το θέατρο τραβάει την προσοχή του δασκάλου του, Φίλιπ Μπάρτον. Το Mr Burton είναι μια βρετανική βιογραφική δραματική ταινία για την πρώιμη ζωή του Ουαλού ηθοποιού Richard Burton.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "알코올 중독자 광부의 아들 리치가 최고의 스타 리처드 버튼이 되는 여정.",
          "runtime": 124,
