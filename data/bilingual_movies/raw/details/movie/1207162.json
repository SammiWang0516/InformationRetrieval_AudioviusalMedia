      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "تدور أحداث الفيلم تيمور: صعود الفاتح في القرن الرابع عشر، حيث ينهار طريق الحرير وتتمزق الأراضي بين فصائل متناحرة. ومن قلب المنفى، ينهض المحارب الشجاع تيمور بعد أن فقد كل شيء، ليبدأ رحلة توحيد الممالك المتفرقة.\r وبالاعتماد على ذكائه العسكري وإرادته الصلبة، يخوض معارك حاسمة لبناء إمبراطورية من قلب الفوضى. ومع سجل حافل بالانتصارات، يثبت نفسه كأحد أعظم القادة العسكريين في التاريخ، رغم سمعته القاسية، مؤسسًا الإمبراطورية التيمورية التي امتدت عبر أفغانستان وإيران وآسيا الوسطى.",
          "runtime": 0,
          "tagline": "",
          "title": "تيمور: صعود الفاتح"
