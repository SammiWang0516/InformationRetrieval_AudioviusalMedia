        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "伊丽莎白、科拉、海伦三名吸血鬼以天鹅绒复古酒廊为据点，依托约会软件筛选独居人类，用网恋约会当做诱饵，哄骗陌生人类赴约见面，伺机吸食人血。蛰伏在交友圈层的吸血鬼猎人摸清这套狩猎套路，全员伪装成相亲对象接单赴局，原本属于血族的捕猎饭局，接连反转变成猎人与吸血鬼的近身死斗，夜夜酒廊之内厮杀不断。",
          "runtime": 0,
          "tagline": "",
          "title": "天鹅绒酒吧的吸血鬼"
        }
      },
