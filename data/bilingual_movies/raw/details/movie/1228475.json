      },
      {
        "iso_3166_1": "BY",
        "iso_639_1": "be",
        "name": "беларуская мова",
        "english_name": "Belarusian",
        "data": {
          "homepage": "",
          "overview": "Фініст-ясны сокал - самы адважны волат Белогорья, самы моцны, самы спрытны і самы прыгожы. Усе астатнія волаты раўняюцца на яго, дзеці хочуць быць падобнымі на яго, а дзяўчаты проста зазіраюцца. Ён ганарлівы і ўпэўнены ў сабе, а часам нават адмаўляецца здзяйсняць подзвігі, калі лічыць іх сумнымі і нецікавымі. Але яму проста неабходна заставацца лепшым, каб людзі працягвалі ім захапляцца. Каб здзівіць усіх, Фініст адправіцца ў цяжкае падарожжа за новымі дасягненнямі, якое прывядзе яго ва ўсходнія землі, дзе герой зразумее простую ісціну - адзін у полі не воін.",
          "runtime": 0,
          "tagline": "",
          "title": "Фініст. Першы волат"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "菲尼斯特是貝洛戈裏最勇敢的戰士。他是最強大、最勇敢、最英俊的戰士。所有其他戰士都仰慕他，孩子們想成為他那樣的人，貝洛戈裏最美麗的女孩也迷戀他。他驕傲而自信，有時甚至拒絕幫助他認為任務無聊乏味的人。他只需要保持最好的狀態，這樣人們就會永遠欽佩他。為了讓所有人感到驚訝，菲尼斯特開始了一項艱巨的任務，這將帶他前往神秘的東方土地。在那裏，他將明白一個簡單的道理——沒有團隊就無法取勝。",
          "runtime": 0,
          "tagline": "",
          "title": "最初的勇士"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Finist to wojownik Biełogorii. Najodważniejszy, najsilniejszy i najprzystojniejszy. Wszyscy inni wojownicy patrzą na niego z podziwem, dzieci chcą być jak on, a najpiękniejsze dziewczyny z Biełogorii są w nim zakochane. Finist jest dumny i pewny siebie, czasem nawet odmawia pomocy, jeśli uzna zadanie za nudne i nieciekawe. Musi pozostać najlepszy, aby ludzie podziwiali go na zawsze. Aby zaskoczyć wszystkich, Finist wyrusza na trudną misję, która zaprowadzi go do tajemniczych ziem Wschodu. Tam zrozumie prostą prawdę - nie można zwyciężyć bez drużyny.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
