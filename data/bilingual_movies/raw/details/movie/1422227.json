      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Film opowiada o Rüzgarze i Hayal, którzy mają zupełnie inne życie i kulturę, a także o ich przeszłości, która nigdy ich nie opuszcza, oraz o tym, jak trzymają się miłości.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Rüzgar arbeitet in einer Bar. Eines Tages bittet ihn sein Freund Ferit, sein Taxi zu fahren. Während dieser Fahrt lernt Rüzgar Hayal kennen, und sie verlieben sich ineinander. Doch als Hayals Familie von ihrer Beziehung erfährt, stellt sie sich vehement dagegen. Sie glauben, dass Rüzgar ein Mörder ist – doch die Wahrheit ist weitaus komplizierter. Rüzgars Vater tötete seine Mutter und schob ihm die Tat in die Schuhe...",
          "runtime": 112,
          "tagline": "",
          "title": ""
        }
