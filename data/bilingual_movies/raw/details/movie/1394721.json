  "translations": {
    "translations": [
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "龍家村村長龍卷峯（許紹雄飾）育有三女一子，分別名叫龍小東（高海寧飾）龍小南（陳靜飾）龍小茜（郭佩文飾）和龍小北（文佐匡飾） 大家姐小東是聯續五年晉身最佳業績的百萬元桌級經理。外表事業女王的小東卻是一個「天生麻將狂」，更偏偏戀上科學家男友馬壯（馬國明飾）馬壯對小東情深一往，只是他一世人最憎人打麻雀，為了不讓愛郎失望，小東竭力隱瞞自己是麻雀狂的真相，二妹小南攻讀戲劇，畢業後當不了演員，卻在片場擔任「親密指導員」，遇上了躁狂影帝千紅哥（陳家樂飾），二人對戲劇追求南轅北轍，但兩個火星撞地球的人偏偏在相處過程由歡喜冤家變成擦出愛火花。\r 三妹小茜一天竟被小北老闆，胸圍廠太子爺林雨雲（李尚正鉓）落力追求，以為大團圓結局之際誰知真相峯廻路轉，小茜和雨雲相愛背後，其實也暗藏一個驚天秘密。\r 三對男女，情場上各有各精彩，如何收科？一切在 2025 蛇年賀歲片《麻雀女王追男仔》中自有分曉！",
          "runtime": 100,
          "tagline": "",
          "title": "麻雀女王追男仔"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Queen of Mahjong follows the hilarious and heartwarming stories of love, family, and hidden secrets in the Long family – Village Chief Long with his 3 daughters and 1 son. With three couples navigating love and laughter in their own unique ways, how will it all end?",
          "runtime": 99,
          "tagline": "",
          "title": "Queen of Mahjong"
        }
