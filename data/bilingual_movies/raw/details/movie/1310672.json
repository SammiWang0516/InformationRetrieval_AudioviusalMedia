      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.crunchyroll.com/series/GMTE00355226/fuuto-pi-the-portrait-of-kamen-rider-skull",
          "overview": "Shotaro tells Tokime all about his mentor, Shokichi Narumi, and the night he and Philip became Kamen Rider W.",
