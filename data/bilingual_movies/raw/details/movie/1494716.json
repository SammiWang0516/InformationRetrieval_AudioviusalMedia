      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Set in 2004, Iranian immigrant Yasamin aka Yasi is the new girl at a Canadian school. Her high school experience is daunting, as she tries to improve her English by watching her favorite sitcom and befriends a trio of pastel-clad girls who feed Yasi’s need to fit in. Desperate for acceptance, she dyes her hair blonde and, in doing so, also attracts a demonic force.",
          "runtime": 80,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Иммигрантка из Ирана Ясамин Карими отчаянно пытается стать своей в новой канадской школе, а для этого ей надо добиться расположения королевы класса Рэйчел Стэнфорд. На пути к своей цели девочка избавляется от своих черных кудрей, оттачивает английский и перекрашивается в блондинку. Но по мере того, как она превращается в икону стиля 2004 года, начинает пробуждаться страшный древний демон, связанный с ее предками.",
          "runtime": 80,
          "tagline": "",
          "title": "Чужая"
        }
      }
    ]
