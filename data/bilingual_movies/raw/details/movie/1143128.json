        "data": {
          "homepage": "",
          "overview": "Pětapadesátiletá manželka a matka z Miami na Floridě, které byla diagnostikována černá díra rostoucí v hrudi a která uvízla ve smyčce, v níž prožívá posledních pět dní svého života, se rozhodne vyřešit cestování časem, aby se vrátila zpět a stala se osobou, kterou vždy chtěla být.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一位55岁的佛罗里达州迈阿密主妇被诊断出胸腔内生长着黑洞，且被困在人生最后五天的循环中。她决定破解时间旅行的奥秘，只为回到过去，成为自己曾经渴望成为的那个人。",
          "runtime": 0,
          "tagline": "",
          "title": "全向循环"
        }
