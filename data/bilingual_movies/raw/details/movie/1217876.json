      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Malý duch Elli nemá domov, a tak hledá místo, kam by mohla patřit. Zaklepáním na dveře výstředních obyvatel Vlaku duchů upoutá pozornost „vnějšího světa“. Teď nezbývá, než se spojit s nesourodou partou strašidýlek a společně se vydat na šílenou cestu za záchranou nejen budoucnosti Vlaku duchů, ale také jediné šance Elli najít vlastní rodinu.",
          "runtime": 0,
          "tagline": "I duchové potřebují rodinu",
          "title": "Elli a parta příšeráků"
        }
      },
