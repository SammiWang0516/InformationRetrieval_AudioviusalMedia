        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "由于预订错误，两个截然不同的家庭，以及一个有点势利的出版商和他想要出版的影响者，被迫共享一个绝妙的度假屋。文化冲突是直接的，体现在不相容的习惯和强烈的个性之间。然而，尽管存在紧张和误解，这次被迫的假期却发生了意想不到的转折，变成了一次充满惊喜和欢笑的冒险。",
          "runtime": 0,
          "tagline": "",
          "title": "强制休假"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Door een boekingsfout worden twee totaal verschillende families, een ietwat snobistische uitgever en de influencer die hij wil publiceren, gedwongen een prachtig vakantiehuis te delen. De cultuurclash is direct voelbaar, tussen onverenigbare gewoonten en sterke persoonlijkheden. Maar ondanks de spanningen en misverstanden neemt deze gedwongen vakantie een onverwachte wending en blijkt het een avontuur vol verrassingen en lachbuien te zijn.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
