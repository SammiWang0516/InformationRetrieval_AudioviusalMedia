  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Vincent travaille au sein d’une équipe de nuit sur le chantier de Grand Ciel, un nouveau quartier futuriste. Lorsqu’un ouvrier disparaît, Vincent et ses collègues suspectent leur hiérarchie d’avoir dissimulé son accident. Mais bientôt un autre ouvrier disparaît.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Vincent works the night shift on the construction site of a futuristic district. When a worker goes missing, Vincent and his colleagues suspect that their superiors are covering up an accident. But soon another worker disappears.",
          "runtime": 91,
          "tagline": "",
          "title": "The Site"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Vincent, trzydziestolatek, pracuje na nocnej zmianie na gigantycznym placu budowy Grand Ciel, futurystycznej dzielnicy. Kiedy znika jeden z pracowników, Vincent i jego koledzy podejrzewają, że lider zespołu ukrył jego ciało na placu budowy. Wkrótce Vincent jest świadkiem dziwnych manifestacji na placu budowy, a następnie znika kolejny pracownik.",
          "runtime": 91,
          "tagline": "",
          "title": "Miejsce"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Vincent lavora di notte nel cantiere di un quartiere futuristico. Quando un operaio scompare, Vincent e i suoi colleghi iniziano a sospettare che i loro superiori stiano insabbiando un incidente. Ma presto scompare un altro operaio.",
          "runtime": 91,
          "tagline": "",
          "title": "Grand Ciel"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Vincent trabaja en el turno de noche en Grand Ciel, un complejo futurista en construcción. Cuando un obrero desaparece sin dejar rastro, el equipo sospecha de un encubrimiento por parte de la dirección. Pero la tensión aumenta cuando otro trabajador también se esfuma y el ambiente se vuelve cada vez más inquietante. Vincent se obsesiona con descubrir qué ocurre realmente y decide investigar por su cuenta, aunque eso lo ponga en el punto de mira.",
          "runtime": 0,
          "tagline": "",
          "title": "El complejo"
        }
      }
    ]
