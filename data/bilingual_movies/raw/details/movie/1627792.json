      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "모터사이클 라이더 ‘미카’와 그녀의 전담 정비사이자 연인인 ‘니코’ 두 사람은 최고의 모터숍 레이싱 팀에 스카우트되며 꿈에 그리던 성공 가도에 올라탄다. 하지만 승리를 향한 집착과 거대한 자본이 지배하는 팀의 세계는 그들이 상상했던 것보다 훨씬 더 혹독하고 유혹적이었다. 새로운 팀에서 마주한 치명적인 라이벌과 은밀한 제안들. 스피드가 높아질수록 두 사람 사이는 뜨거워지고, 서로를 향한 질투와 집착으로 변해간다. 과연 이들의 사랑은 레이스처럼 끝까지 버틸 수 있을까?",
          "runtime": 0,
          "tagline": "",
          "title": "욕망의 스피드 레이서"
        }
      }
