  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.umbrellaent.com.au/film/mum-i-m-alien-pregnant",
          "overview": "When a messy underachiever accidentally gets alien-pregnant, she must overcome skeptical doctors, a useless baby daddy, and her oversharing mum in order to survive and reclaim her life.",
          "runtime": 95,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "瑪麗已成年卻還跟媽媽住，鎮日無所事事魯在家中。某天她終於踏出舒適圈前進洗衣房，巧遇同樣宅到不行還是個媽寶的鄰居阿布。謠傳阿布有外星人的「神祕器官」，在瑪麗的慫恿下，精蟲衝腦的阿布同意拔刀相見，沒想到突如其來的噴發，竟讓瑪麗意外懷孕！面對滿腹懷疑的醫生、不太可靠的孩子親爹、以及她過度熱心的老媽，望著超速膨脹的肚皮，她該如何是好？！",
          "runtime": 0,
          "tagline": "",
          "title": "外星級孕事"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Mary é uma millennial desorganizada que mora com a mãe e não sabe o que fazer da vida. Após um encontro sexual desastroso com o vizinho, descobre que carrega um feto extraterrestre de crescimento acelerado. Entre médicos incrédulos, um futuro pai inútil, uma mãe sem filtros e transformações corporais bizarras, ela precisa retomar o controle do corpo e da vida.",
          "runtime": 0,
          "tagline": "",
          "title": "Mãe, Engravidei de um Alien"
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Когато вечно проваляща се млада жена неволно забременява от извънземно, тя трябва да се справи с невярващи лекари, безполезен татко и досадната си майка, за да си върне живота.",
          "runtime": 0,
          "tagline": "",
          "title": "Мамо, бременна съм от извънземно"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "改编自导演组合THUNDERLIPS于2024年创作的同名短片。一名生活颓废、缺乏目标的千禧一代女性意外怀上外星宝宝。面对不相信她的医生、不靠谱的孩子父亲和爱多嘴的母亲，她必须克服重重困难，重新掌控自己的身体与生活。",
          "runtime": 0,
          "tagline": "",
          "title": "妈，我怀了外星宝宝"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Мэри - инфантильная девушка-миллениал, которая живет в пригороде Новой Зеландии вместе со своей чересчур болтливой матерью Синтией. Ее жизнь резко меняется после нелепой интимной связи в прачечной с эксцентричным соседом по имени Бу. Вскоре выясняется, что Бу наполовину пришелец, а Мэри забеременела. Инопланетный плод развивается внутри нее с бешеной скоростью, вызывая пугающие и гротескные изменения в теле. Мэри приходится рассчитывать только на себя, так как местные врачи отказываются верить в происходящее, а новоиспеченный отец слишком незрел и бесполезен, чтобы хоть чем-то помочь.",
          "runtime": 94,
          "tagline": "",
          "title": "Мама, я беременна от пришельца"
        }
