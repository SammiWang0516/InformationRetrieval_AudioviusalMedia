  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://tandemfilms.fr/film/alter-ego",
          "overview": "Alex a un problème : son nouveau voisin est son sosie parfait. Avec des cheveux. Un double en mieux, qui va totalement bouleverser son existence.",
          "runtime": 99,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A quiet, middle-aged man spirals into obsession and paranoia when a charismatic look-alike moves in next door, featuring the exact same face—and a full head of hair.",
          "runtime": 100,
          "tagline": "",
          "title": "Alter Ego"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Alex (Laurent Lafitte), spokojny czterdziestoparolatek, wiedzie zwyczajne życie, dopóki nie wprowadzają się nowi sąsiedzi. Mąż jest idealnym sobowtórem Alexa… z jednym wyjątkiem: ma włosy. Alex popada w narastającą paranoję, zaabsorbowany tym bardziej charyzmatycznym, błyskotliwym i utalentowanym tajemniczym sobowtórem.",
          "runtime": 104,
          "tagline": "A co jeśli Twoim sąsiadem, który jest jednocześnie Twoim kolegą, byłbyś Ty… tylko lepszy?",
          "title": "Alter Ego"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "以失守的髮際線力展中年危機的艾力克，生活過得平淡無奇，直到撞見隔壁搬來的新鄰居，竟然是「完美版自己」？更加荒謬的是，如此顯而易見的事實卻成了只有自己察覺、說不出口的祕密。面對眼前這位魅力爆棚、生活情趣滿點，連名字都只差一個字的完美分身艾克索，一切如鏡像般卻又令人嫉妒的存在，讓他逐漸陷入偏執的泥淖。這名神祕分身的出現，究竟是他平庸人生的救贖，還是自我崩解的開端？",
          "runtime": 0,
          "tagline": "",
          "title": "分身髮術"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "四十多歲，內性格向的Alex過著平凡的生活，直到新鄰居搬來。新鄰居的丈夫長得和Alex一模一樣……除了一個差別：他有頭髮。亞歷克斯開始對這個更有魅力、更聰明、更成功的神秘「分身」感到越來越在意，並逐漸陷入偏執的情緒中。",
          "runtime": 0,
          "tagline": "",
          "title": "分身髮術"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "새로 이사 온 이웃이 자신과 똑같이 생겼는데 머리카락이 풍성하다. 대머리 남자의 삶이 뒤흔들린다.",
          "runtime": 100,
          "tagline": "",
          "title": "나였으면"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "发际线失守的中年大叔，意外发现隔壁新邻居竟是“完美版自己”。不仅魅力爆棚，连头发都乌黑茂密，为他带来一连串自我认同危机。法国凯萨奖影帝罗伦拉菲帝一人分饰二角，精湛演绎荒谬满点的法式喜剧。",
          "runtime": 99,
          "tagline": "",
          "title": "镜像自我"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Alex tiene un problema: su nuevo vecino es su doble perfecto. Con pelo. Un doble mejor, que está a punto de cambiarle la vida por completo.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Жизнь лысеющего мужчины летит под откос, когда в соседнюю квартиру въезжает новый жилец - его точная копия, только с густой шевелюрой. Неожиданное сходство переворачивает привычный мир героя и заставляет его взглянуть на собственную жизнь совершенно иначе. Это ироничная комедия о самооценке, внешности и непростых отношениях человека с самим собой. Появление необычного двойника становится для героя началом череды забавных и неожиданных ситуаций, заставляющих задуматься о том, действительно ли внешность определяет то, кем мы являемся.",
          "runtime": 0,
          "tagline": "",
          "title": "Он лучшая версия меня"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Mittvierziger Alex führt ein eher langweiliges Leben, das gelegentlich durch erotische Rollenspiele mit seiner Frau aufgepeppt wird. Doch plötzlich zieht der neue Nachbar Axel ein, der ihm fast bis aufs Haar gleicht – mal abgesehen von Alex’ Halbglatze. Auch sonst wirkt Axel wie sein aufgemotzter Doppelgänger: sportlicher, gutmenschlicher und mit dem größeren Weinkeller. Doch die Ähnlichkeit scheint nur Alex aufzufallen, was ihn in eine schwere Midlife-Crisis stürzt. Sein verzweifeltes Bemühen, besser als die perfekte Version seiner selbst zu sein, mündet bald in einer Katastrophe.",
          "runtime": 104,
          "tagline": "",
          "title": "The Better Me"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Alex, een rustige veertiger, leidt een gewoon leven totdat er nieuwe buren komen wonen. De man lijkt sprekend op Alex… op één ding na: hij heeft haar. Alex raakt steeds meer in de ban van paranoia naarmate hij geobsedeerd raakt door deze charismatische, briljante en succesvolle, mysterieuze dubbelganger.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Kırklı yaşlarında, sakin ve sıradan bir yaşam süren Alex'in hayatı, yeni komşularının taşınmasıyla beklenmedik bir şekilde değişir. Komşusunun kocası, Alex'in adeta birebir kopyasıdır... Tek bir farkla: Onun saçları vardır. Zamanla bu karizmatik, zeki ve hayatın her alanında daha başarılı görünen gizemli ikizine takıntı geliştiren Alex, giderek büyüyen bir paranoyanın içine sürüklenir. Gerçeklik algısı sarsılırken, kendi kimliğiyle yüzleşmek zorunda kalır.",
          "runtime": 0,
          "tagline": "",
          "title": "Daha İyi Bir Ben"
        }
      }
    ]
