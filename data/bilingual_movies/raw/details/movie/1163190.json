        "data": {
          "homepage": "",
          "overview": "Anadolu'da dağların eteklerindeki bir köyde geçen film, karısının aşkını ve sevgisini geri kazanmak için çabalayan genç bir adamın, Ali'nin, ağaların ve yerel çetelerin tahakkümüne karşı direnişinin hikâyesini anlatıyor.",
          "runtime": 123,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
