      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "אולגה חיה בדירה בשיכון ענק במקסיקו סיטי, ללא משפחה או ידידים, משחקת סודוקו על מחשב מיושן, נלחמת בזבוב מזדמן. להשלמת הכנסה היא משכירה חדר לגבר שאשתו מאושפזת בבית חולים סמוך, בלי לדעת שהוא יגניב את בנו בן ה-9 לדירה. מבלי משים, החיבה לכריסטיאן הצעיר מתגנבת אל לבה של אולגה הנרגנת ומתחילה למוטט את הקירות שבנתה בקפידה.",
          "runtime": 99,
          "tagline": "",
          "title": "זבובים"
