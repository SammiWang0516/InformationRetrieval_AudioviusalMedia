      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Debra, die niet weet dat een seriemoordenaar het gemunt heeft op winkelmedewerkers in 24-uurs supermarkten, neemt met tegenzin de nachtdienst aan bij haar baantje als tankstation medewerker, waar ze een minimumloon verdient, nadat haar collega is verdwenen. Wat begint als routineklusjes zoals schappen vullen en de vloer vegen, mondt al snel uit in een hartverscheurende afdaling in paranoia, angst en bloeddorstige waanzin naarmate de moordenaar dichterbij komt.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
