      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "卡西烏斯是一位前特種部隊士兵，和艾比蓋爾一位年輕的孤兒，在傳染性疫情爆發後相依為命。他們遇到了一位懷孕的婦女，梅根和她的丈夫大衛，他們誓言要幫助他們躲避這群變種的喪屍，帶領梅根到可以安全生產的庇護所。",
          "runtime": 0,
          "tagline": "",
          "title": "寂靜地帶"
