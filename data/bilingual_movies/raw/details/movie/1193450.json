      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Zbrodnie przeciwko naturze budzą ich zgorszenie, niesprawiedliwość wyrządzona kobietom budzi w nich odrazę: Zielone Pantery, dzisiejsi Robin Hoodowie, dokonują włamań przeciwko trucicielom zanieczyszczeń i prześladowcom. Aby jednak otworzyć sejf swoich marzeń, będą musieli połączyć siły z Bernardem, starzejącym się włamywaczem, niezbyt na bieżąco z ekofeminizmem...",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
