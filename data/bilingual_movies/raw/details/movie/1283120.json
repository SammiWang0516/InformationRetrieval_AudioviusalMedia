        "data": {
          "homepage": "",
          "overview": "一场枪击案发生后，一名童年困顿的贫穷年轻男子锒铛入狱，必须在残酷的黑帮之中争得一席之地，才能生存下来。",
          "runtime": 0,
          "tagline": "",
          "title": "青春之囚"
        }
      },
      {
        "iso_3166_1": "BR",
