    "translations": [
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "https://constantin.film/kino/das-kanu-des-manitu/",
          "overview": "Abahachi, der Häuptling der Apachen und sein weißer Blutsbruder Ranger kämpfen unermüdlich für Frieden und Gerechtigkeit – doch eine neue, aufstrebende Bande macht ihnen das Leben besonders schwer! Sie locken Abahachi und Ranger in eine Falle, um an das sagenumwobene \"Kanu des Manitu\" zu gelangen.",
          "runtime": 89,
          "tagline": "Wieder da. Aber diesmal mit Tiefgang.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Abahachi, the Apache chief, and his white blood brother Ranger fight tirelessly for peace and justice - but a new, up-and-coming gang is making life particularly difficult for them! They lure Abahachi and Ranger into a trap in order to get their hands on the legendary “Canoe of Manitou”.",
          "runtime": 89,
          "tagline": "",
          "title": "Manitou's Canoe"
        }
      },
      {
        "iso_3166_1": "FR",
