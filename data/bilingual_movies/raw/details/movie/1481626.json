      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "https://www.filmland.com.br/PORT/2026/05/19/love-kills/",
          "overview": "No centro de São Paulo, devastado pelo crack, uma jovem vampira, Helena, assombra um café sujo, cativando um garçom ingênuo. À medida que o garçom descobre os segredos dela, assim como o submundo da cidade, passa a ser atraído para um mundo perigoso de intrigas imortais, desafiando a própria mortalidade.",
          "runtime": 96,
          "tagline": "O amor tem sede de sangue.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "In downtown São Paulo, absolutely ravaged by crack cocaine, Helena, a young black vampire, wanders around a filthy café trying to captivate Marcos, a naive waiter. As she begins to discover his secrets and the ins and outs of the metropolis, the girl will go on to venture into a dangerous world of immortal intrigues that will challenge her own mortality.",
          "runtime": 96,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "크랙 코카인으로 완전히 황폐화된 상파울루 도심에서, 젊은 흑인 뱀파이어 헬레나는 허름한 카페를 배회하며 순진한 웨이터 마르코스를 유혹하려 한다. 그의 비밀과 대도시의 이면을 하나씩 알아가면서, 헬레나는 자신의 불멸성마저 시험에 들게 할 위험한 뱀파이어들의 음모와 권력의 세계로 발을 들인다.",
          "runtime": 0,
          "tagline": "",
          "title": "뱀파이어 나이트"
        }
      }
