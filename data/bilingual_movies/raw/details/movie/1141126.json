  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Set in 1984 during the UEFA Euro craze, 7-year-old Rita wants to go to the beach. Unfortunately, her father makes watching the match his priority, and what her father says goes. For the first time in her life, Rita sees and realises that her home is not safe, especially for her mother.",
          "runtime": 94,
          "tagline": "Sometimes only our dreams can save us.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Sevilla, Junio de 1984. Rita y Lolo son dos hermanos de 7 y 5 años que viven en el seno de una sencilla familia obrera. Comienzan las vacaciones de verano y el país entero está revolucionado con la Eurocopa de fútbol, donde España ha pasado a los cuartos de final. El calor aprieta y Rita sueña con ir a la playa, pero la vida en el barrio le tiene reservadas otras sorpresas…",
          "runtime": 94,
          "tagline": "A veces sólo nuestros sueños pueden salvarnos.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Sedmiletá Rita a její pětiletý bratr Lolo z dělnické rodiny v době, kdy celá země šílí z mistrovství Evropy ve fotbale, kde je Španělsko ve čtvrtfinále.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "De zevenjarige Rita en haar vijfjarige broertje Lolo uit een arbeidersgezin terwijl het hele land uit zijn dak gaat op de Europese voetbalkampioenschappen, met Spanje in de kwartfinales.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Sewilla, czerwiec 1984 r. Rita i Lolo to rodzeństwo w wieku 7 i 5 lat, żyjące w prostej rodzinie robotniczej. Zaczynają się wakacje i cały kraj z niecierpliwością czeka na Mistrzostwa Europy w Piłce Nożnej, w których Hiszpania dotarła do ćwierćfinału. Panuje upał i Rita marzy o wyjeździe na plażę, ale życie w okolicy ma dla niej inne niespodzianki…",
          "runtime": 94,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Sevilla, junio de 1984. Rita y Lolo son dos hermanos de 7 y 5 años que viven en el seno de una sencilla familia obrera. Comienzan las vacaciones de verano y el país entero está revolucionado con la Eurocopa de fútbol, donde España ha pasado a los cuartos de final. El calor aprieta y Rita sueña con ir a la playa, pero la vida en el barrio le tiene reservadas otras sorpresas",
          "runtime": 0,
          "tagline": "A veces sólo nuestros sueños pueden salvarnos.",
          "title": "Rita"
        }
      },
      {
        "iso_3166_1": "CN",
