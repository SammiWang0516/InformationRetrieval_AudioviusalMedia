  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A long time ago, Nightingale the Robber managed to defeat Ilya Muromets by cunning. He rewrote history, appropriating to himself all the exploits and glory of the hero. Thanks to the elixir of immortality, the Nightingale has survived to this day. And now he wants to revive the dark god Veles, to whom he then sold his soul. Today only the family of our heroes knows this secret. The father of the heroes, Professor Kiselyov, manages to find Muromets in the north, in the ice of an underwater cave, where the last battle between the hero and the robber took place. Thanks to Kiselyov's development - the heart of steel - Muromets returns to our world. However, this feat costs the professor his life. Now his sons, Maksim and Egor, will have to not only stop the Nightingale, but also restore the honorable name of Ilya Muromets - in fights between giant robot warriors at the RoboArena.",
          "runtime": 115,
          "tagline": "",
          "title": "Solovei vs. Muromets"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Давным-давно Соловью-Разбойнику удалось хитростью победить Илью Муромца. Он переписал историю, присвоив себе все подвиги и славу богатыря. Благодаря эликсиру бессмертия Соловей дожил до наших дней. И теперь он хочет оживить темного бога Велеса, которому тогда продал душу. Сегодня лишь семья наших героев знает эту тайну. Отцу героев, профессору Киселеву, удается найти Муромца на севере, во льдах подводной пещеры, где состоялся последний бой между богатырем и разбойником. Благодаря разработке Киселева — стальному сердцу — Муромец возвращается в наш мир. Однако этот подвиг стоит профессору жизни. Теперь его сыновьям, Максиму и Егору, предстоит не только остановить Соловья, но и вернуть честное имя Ильи Муромца — в поединках гигантских воинов-роботов на «Робоарене».",
          "runtime": 115,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Преди много време, нощната птица-крадец успя да победи Иля Муромец с хитрост. Той пренаписа историята, присвоявайки си всички подвизи и слава на героя. Благодарение на еликсира на безсмъртието, Нощната птица е оцелял до днес. А сега той иска да възкреси тъмния бог Велес, на когото тогава е продал душата си. Днес само семейството на нашите герои знае тази тайна. Бащата на героите, професор Кисельов, успява да намери Муромец на север, в леда на подводна пещера, където се е състояла последната битка между героя и крадеца. Благодарение на разработката на Кисельов - сърцето от стомана - Муромец се завръща в нашия свят. Въпреки това, този подвиг струва на професора живота му. Сега неговите синове, Максим и Егор, ще трябва не само да спрат Нощната птица, но и да възстановят почетното име на Иля Муромец - в битки между гигантски робот войни на РобоАрена.",
          "runtime": 0,
          "tagline": "",
          "title": "Соловей срещу Муромец"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "钢铁之心"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "很久以前，盜賊夜鶯憑藉著詭計擊敗了伊利亞·穆羅梅茨。他篡改了歷史，將這位英雄的所有功績和榮耀據為己有。多虧了長生不老藥，夜鶯得以存活至今。如今，他想要復活黑暗之神維列斯，他曾將自己的靈魂出賣給了維列斯。如今，只有我們英雄的家人知道這個秘密。英雄的父親，基謝廖夫教授，在北方一座水下洞穴的冰層中找到了穆羅梅茨，那裡正是英雄與盜賊決戰的地方。多虧了基謝廖夫的“鋼鐵之心”，穆羅梅茲才得以重返人間。然而，教授也為此付出了生命的代價。現在，他的兒子馬克西姆和葉戈爾不僅要阻止夜鶯，還要在機器人競技場的巨型機器人戰士戰鬥中，重振伊利亞·穆羅梅茨的榮光。",
          "runtime": 0,
          "tagline": "",
          "title": "鋼鐵之心"
        }
      }
    ]
