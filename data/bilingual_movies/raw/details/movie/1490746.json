        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Quando o hotel onde trabalha é vendido, Catarina tem de mostrar a sua capacidade para gerir uma equipa pouco profissional, cuidar de hóspedes excêntricos e lidar com fantasmas do passado, trazidos por uma visita inesperada.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "https://imovision.com.br/hotel-amor",
          "overview": "Quando o hotel onde a workaholic Catarina trabalha é vendido, ela precisa provar que sabe manter tudo em pé, mesmo com uma equipe desastrosa. Entre os hóspedes pra lá de esquisitos e um fantasma do passado que aparece para revirar os seus sentimentos, confusões e crises existenciais nos corredores, Catarina vai descobrir que manter um hotel funcionando pode ser mais caótico do que parece.",
          "runtime": 93,
          "tagline": "",
          "title": ""
        }
      }
