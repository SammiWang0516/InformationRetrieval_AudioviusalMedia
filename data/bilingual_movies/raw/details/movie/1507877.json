  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.studiocanal.fr/title/garance-2026/",
          "overview": "Garance est une jeune actrice sans être une vedette. Elle gère et assure tout de son mieux, vaillante, joyeuse, soldate, et elle trouve dans l’alcool un carburant, un réconfort, inconditionnel. Garance change de vie et commence alors un parcours de huit ans de déménagements, de travail, de rencontres, de fêtes et d’angoisses, de joies et de coups durs… Une révolution intime, amicale et sexuelle, Mais elle consomme, toujours plus. Jusqu'à la potentialité de la mort..",
          "runtime": 105,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Garance is a young actress, but not a star. She manages everything as best she can, valiant, cheerful, a soldier, and she finds in alcohol an unconditional fuel, a source of comfort. Garance changes her life and begins an eight-year journey of moves, work, encounters, parties and anxieties, joys and hardships… An intimate, friendly, and sexual revolution. But she consumes, more and more. Until the very possibility of death…",
          "runtime": 120,
          "tagline": "",
          "title": "Another Day"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "가랑스"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "才华横溢的年轻演员嘉朗丝有着浑然天成的魅力和活力无限的精神，但还未赢得她所渴望的认可。她住在巴黎一间狭小的公寓，勉强维持生计，人生被短暂即逝的关系、越发严重的焦虑和酒瘾萦绕。她要照顾染病的妹妹，又与波琳展开了一段柔软的爱情，一切是那么脆弱。而随着这些纽带的加深，她找到了力量去面对此前一直躲避的内心阴影，踏上了一场艰难但革新性的自我更新之旅。",
          "runtime": 0,
          "tagline": "",
          "title": "嘉朗丝"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Garance to młoda aktorka, nie gwiazda. Radzi sobie ze wszystkim najlepiej, jak potrafi, dzielna, radosna, żołnierka, a w alkoholu odnajduje bezwarunkowe paliwo, źródło pocieszenia. Garance zmienia swoje życie i rozpoczyna ośmioletnią podróż pełną przeprowadzek, pracy, spotkań, imprez i lęków, radości i trudności… Intymną, przyjacielską i seksualną rewolucję. Ale konsumuje, coraz więcej. Aż do samej możliwości śmierci…",
          "runtime": 0,
          "tagline": "",
          "title": "Garance"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "才華橫溢的女演員嘉杭絲遲遲等不到伯樂賞識，長年倚靠酒精度日，在狂歡夜場與曖昧關係間揮霍青春。從玻璃杯望出去的天地如夢幻泡影，得過且過的是迷航人生。戒不掉的癮，終於讓嘉杭絲丟了劇團工作與身心健康，與摯愛寶琳的感情也陷入危機。眼看生命就要被酒精腐蝕殆盡，坐困愁城的嘉杭絲，能否重啟人生？",
          "runtime": 0,
          "tagline": "",
          "title": "醉愛每一天"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Ґаранс — молода акторка, але не зірка. Вона намагається якнайкраще впоратися з життям, знаходячи в алкоголі енергію та розраду. Вона вирушає у восьмирічну подорож, сповнену змін у житті, і п’є дедалі більше. Аж доки смерть не починає здаватися неминучою.",
          "runtime": 0,
          "tagline": "",
          "title": "Ґаранс"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Garance é uma jovem atriz, mas não é uma estrela. Ela lida com tudo da melhor maneira possível, corajosa, alegre, como uma guerreira, e encontra no álcool um combustível incondicional, uma fonte de conforto. Garance muda de vida e inicia uma jornada de oito anos repleta de mudanças, trabalho, encontros, festas e ansiedades, alegrias e dificuldades… Uma revolução íntima, amigável e sexual. Mas ela bebe cada vez mais. Até a própria possibilidade da morte…",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "Garance是一位極具天賦的年輕女演員，她未經雕琢的魅力和活潑奔放的精神，卻仍未為她贏得渴望已久的認可。她住在巴黎一間小公寓中勉強度日，並日漸感到窒息。她的生活正悄悄地被短暫的戀情、日益加劇的焦慮，以及酒精成癮纏繞着，並且越收越緊。",
          "runtime": 0,
          "tagline": "",
          "title": "一日又一日"
        }
      }
    ]
