      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "신화적 세계와 유럽 애니메이션 특유의 매혹적인 화풍이 어우러진 폴란드 애니메이션. 미지의 판타지 세계로 향하는 흥미진진한 모험을 그리며, 거창한 스펙터클이나 자극적인 전개에 의지하기보다 탄탄한 이야기로 소년의 모험을 전달한다. 고유의 서정성과 신비로운 세계관이 매력적으로 다가오는 작품으로, 미지의 공간을 탐험하는 여정을 편안하게 따라갈 수 있는 경이로운 판타지.",
          "runtime": 88,
          "tagline": "",
          "title": "세상 끝의 소년"
        }
