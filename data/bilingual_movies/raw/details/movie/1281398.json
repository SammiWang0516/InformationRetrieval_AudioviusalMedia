  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "แดน ตำรวจหนุ่มจากเมืองกรุง ที่ถูกย้ายลงมาประจำการที่ชายแดน เขาต้องการทำผลงานเพื่อย้ายกลับเขาเมือง โดยการตามล่าตัว เสี่ยตั้บ พ่อค้ายารายใหญ่ที่หนีออกจากคุกมุ่งไปทางประเทศเพื่อนบ้านผ่านไปแห่งนี้ แม้จะมีการทัดทานจาก วิ ที่รับรู้ถึงอันตรายของผืนป่านั้น แต่แดนก็ตัดสินใจรวบรวมสมัครพรรคพวกตำรวจที่ไม่ค่อยมีประสบการณ์ไล่ล่า เพื่อหยุดเสี่ยตั้บเอาไว้ให้ทันเวลาโดยหารู้ไม่ว่า เสี่ยตั๊บเชี่ยวชาญเรื่องวิชาอาคม และหมายจะใช้วิชามืด ปลุก \"บางสั่ง\" ใน HalaBala ให้ออกมาคุ้มครองตน",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://brandthinkcinema.me/portfolio-item/halabala/",
          "overview": "Inspector Dan leads the team of infirm police officers to hunt down the brutal escaped prisoner in the Halabala forest down south, only to discover that the dark secret inside the forest is turning against them.",
          "runtime": 105,
          "tagline": "The monsters you slayed are growing within you.",
          "title": "Halabala"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "\"Thanh tra Dan – kẻ mang biệt danh rùng rợn “Dan Trăm Xác” – là một cảnh sát liều mạng, nổi tiếng với quá khứ đẫm máu và những phi vụ bất chấp luật lệ. Sau một sai lầm kinh hoàng trong lúc thực hiện nhiệm vụ, Dan bị giáng chức và chuyển công tác về vùng hẻo lánh. Với nổ lực để có cơ hội trở lại Bangkok – anh cần bắt được Tup Ta Fai: tên trùm tội phạm loạn trí vừa trốn khỏi ngục, hiện đang ẩn náu trong khu rừng cấm Halabala. Thế nhưng, Halabala không phải một khu rừng bình thường. Nơi đây bị nguyền rủa bởi truyền thuyết quỷ Bataya và Batow – tộc người ăn thịt từng sống trong rừng sâu và đang nuôi dưỡng con quỷ Bataya bằng hận thù và xác người. Trong cuộc truy đuổi đẫm máu giữa rừng thiêng, Dan không chỉ phải đối đầu với Ta Fai, mà còn bị ám ảnh bởi những tiếng gọi ma quái, những ám ảnh dị dạng và nỗi sợ sâu kín nhất của chính anh.",
          "runtime": 0,
          "tagline": "",
          "title": "Halabala: Rừng Ma Tế Xác"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "丹督察带领一队体弱的警察在南部的哈拉巴拉森林追捕残忍的逃犯，却发现森林里的黑暗秘密正在对他们不利。",
          "runtime": 0,
          "tagline": "",
          "title": "失心疯"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "실제 출입이 제한된 태국 남부 국경지대의 할라발라 원시림. 무자비한 형사 단은 탈옥한 갱단 두목 툽을 뒤쫓아 할라발라의 저주받은 마을 바또우로 들어선다. 그 순간, 밀림은 거대한 포식자로 돌변한다.",
          "runtime": 100,
          "tagline": "",
          "title": "할라발라"
        }
      }
    ]
