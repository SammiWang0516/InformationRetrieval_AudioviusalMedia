    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.theasylum.cc/index.php/titles/detail?id=653",
          "overview": "A former circus clown escapes a mental institution on the tenth anniversary of his first kills. Now, as unsuspecting high schoolers throw a Summerween party at the clown’s abandoned mansion, a police officer and father to one of the party goers must rescue his daughter before the clown kills again.",
          "runtime": 87,
          "tagline": "He’ll make you smile… by any means…",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Tijdens Summerween ontsnapt een voormalige circusclown uit een psychiatrische instelling om terug te keren naar zijn verlaten landhuis en de tieners die daar feestvieren op te jagen.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "故事发生在盛夏“夏日万圣节”的狂欢夜晚，独居女主搬进城郊一栋老式独栋住宅，本打算趁着特色节日放松独处时光。一名妆容破败、面部带有撕裂伤痕的变态小丑杀手盯上了这栋偏僻屋子，最经典的名场面正是海报里，小丑从门缝里死死窥视屋内住户的桥段。杀手没有立刻破门强攻，而是先进行长时间的屋外骚扰、门锁试探、暗处监视，一点点摧毁女主角的心理防线；在主角陷入高度恐惧后，小丑暴力闯入住宅，在狭窄走廊、卧室、玄关等密闭居家空间展开猎杀。这名小丑有着标志性变态执念：会用尽一切残忍手段，逼迫濒死受害者强行展露笑容，以此获得病态快感。",
          "runtime": 0,
          "tagline": "",
          "title": "仲夏惊魂夜"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Am zehnten Jahrestag seiner ersten Morde entkommt ein ehemaliger Zirkusclown aus einer psychiatrischen Anstalt. Während ahnungslose Highschool-Schüler in der verlassenen Villa des Clowns eine „Summerween“-Party feiern, muss ein Polizist – der Vater einer der Partygäste – seine Tochter retten, bevor der Clown erneut zuschlägt.",
          "runtime": 87,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Bývalý cirkusový klaun uprchne z psychiatrické léčebny právě v den desátého výročí svých prvních vražd. Nyní, když nic netušící středoškoláci pořádají v opuštěném sídle klauna párty s názvem „Summerween“, musí policista a otec jedné z účastnic večírku zachránit svou dceru, než klaun znovu zabije.",
          "runtime": 0,
          "tagline": "Donutí vás se usmát… za každou cenu…",
          "title": ""
        }
