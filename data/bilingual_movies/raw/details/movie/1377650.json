      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Озорные братья-медведи Бриар и Брамбл перенесутся в далекое будущее — в мир, где человечество оказалось на грани исчезновения. И, кажется, в этом замешан их старый приятель Вик. Отважным братьям и их друзьям предстоит раскрыть правду, предотвратить катастрофу и найти путь домой.",
          "runtime": 109,
          "tagline": "",
          "title": "Побег из будущего"
        }
      },
