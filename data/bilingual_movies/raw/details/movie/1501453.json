      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ฮารุกะ ซากุระ เด็กหนุ่มผู้ยึดถือความแข็งแกร่ง ย้ายเข้าโรงเรียนฟูรินที่ขึ้นชื่อเรื่องนักเลง เพื่อเป็นอันดับหนึ่ง แต่เขากลับพบว่าเหล่านักเรียนภายใต้ชื่อ WIND BREAKER (โบฟูริน) ใช้พลังการต่อสู้เพื่อ ปกป้องผู้คนในเมืองจากนักสู้ผู้โดดเดี่ยว ซากุระค่อย ๆ เรียนรู้ความหมายของมิตรภาพ ความรับผิดชอบ และความแข็งแกร่งที่แท้จริง ผ่านการต่อสู้ดุเดือดเพื่อผู้อื่น",
          "runtime": 0,
          "tagline": "",
          "title": "นักเลงผู้พิทักษ์"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "本片改编自同名人气不良少年漫画，以“偏差值最低、打架最强”的风铃高校为舞台，讲述为成为最强而来到这座城市的少年樱遥（水上恒司 饰），加入守护街道的义气不良组织“防风铃”，与伙伴们并肩作战、守护街道的热血故事。",
          "runtime": 0,
          "tagline": "",
          "title": "防风少年"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Sakura, cậu thiếu niên bất hảo quen với việc bị xa lánh vì mái tóc nửa trắng, nhập học trường Furin với mục tiêu trở thành kẻ đánh đấm số một. Ngôi trường do Bofurin — tức \"Wind Breakers\", băng nhóm đường phố chính nghĩa bảo vệ khu phố mua sắm và được người dân yêu mến — cai quản. Lần đầu tiên trong đời, Sakura được ai đó chấp nhận và nhận ra mình chiến đấu vì người khác, thay vì cho rằng dựa dẫm vào người khác là yếu đuối. Bản phim là chuyển thể rút gọn của bốn tập đầu manga (tương đương mười tập đầu bản anime truyền hình).",
          "runtime": 0,
          "tagline": "",
          "title": "Wind Breaker"
        }
