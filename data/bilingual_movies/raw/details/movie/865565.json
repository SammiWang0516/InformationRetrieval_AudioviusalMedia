      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Verano de 1990. Chile se encuentra en pleno proceso de retorno a la democracia tras 17 años bajo la dictadura de Augusto Pinochet. En un pueblo costero cerca del desierto de Atacama, Celeste, de 15 años, pasa la Nochevieja con sus amigos y familiares en la playa. Justo cuando el mundo parece estar lleno de alegría y esperanza por lo que traerá un nuevo futuro, un trágico suceso rompe el ambiente idílico y optimista.",
          "runtime": 93,
          "tagline": "",
          "title": ""
        }
