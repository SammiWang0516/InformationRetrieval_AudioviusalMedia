    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.snd-films.com/movies/11",
          "overview": "Quand Maria Bodin, fermière autoritaire et revêche, et son fils Christian, apprennent qu'une usine de fromage industrielle s'apprête à s'installer dans leur petit village, ils sont prêts à tout pour défendre leur fromagerie artisanale..",
          "runtime": 95,
          "tagline": "Ils reviennent mettre le souk !",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "博丁一家重返银幕！当专制又倔强的农场主玛丽亚·博丁和她的儿子克里斯蒂安得知一家工业奶酪工厂即将落户他们的小镇时，他们决心不惜一切代价保护他们的手工奶酪厂。从农业展览会到摩洛哥沙漠，他们将不遗余力地阻止工厂项目的实施：敲诈、斗殴、追逐，博丁一家再次将勇闯重重危险，以捍卫他们的价值观和传统。",
          "runtime": 0,
          "tagline": "",
          "title": "博丹一家失控了"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Od chwili narodzin Christiana Bodina wszystkie przyjęcia urodzinowe okazały się kompletną katastrofą! Ale tym razem, z okazji 50. urodzin syna, Maria Bodin zrobi wszystko, aby ta rocznica była niezapomniana. Ale pozostaje jeden główny cel: znalezienie prezentu dla Christiana... Dlaczego nie dziewczyny? To nie koniec kłopotów i niespodzianek dla Marii...",
          "runtime": 104,
          "tagline": "",
          "title": "Bodinowie idą na całość"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "When Maria Bodin, a strong-willed and cantankerous farmer, and her son Christian learn that an industrial cheese factory is about to be built in their small village, they are ready to do anything to defend their artisanal cheese dairy. From the Agricultural Show to the Moroccan desert, they will stop at nothing to thwart this factory project: blackmail, brawls, car chases—once again, the Bodins will brave all dangers to save their values and traditions.",
          "runtime": 105,
          "tagline": "",
          "title": ""
        }
      }
    ]
