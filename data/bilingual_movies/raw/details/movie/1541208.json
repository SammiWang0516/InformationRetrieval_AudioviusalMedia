      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "세계 최고의 활강 스키 선수들은 다른 이들이 두려워하는 상황을 극복하며 성장하는 듯 보인다. 승리하려면 코스를 이탈하지 않으면서도 한계를 넘어서야 한다. 〈눈 위의 질주〉는 로드맵 형식의 다큐멘터리로, 2024년 잘바흐 월드컵 파이널부터 최고의 하이라이트인 2025 FIS 알파인 세계 스키 선수권 대회까지, 알파인 스키 레이싱의 카리스마 넘치는 남자 선수들을 따라간다.",
          "runtime": 128,
          "tagline": "",
          "title": "눈 위의 질주"
        }
      }
