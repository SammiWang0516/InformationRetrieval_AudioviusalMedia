        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um executivo renuncia uma vida lucrativa e confortável para administrar a loja da família no interior, mas problemas do passado põem o plano em xeque.",
          "runtime": 0,
          "tagline": "",
          "title": "Alimento de Família"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Муруган вырос за прилавком отцовской закусочной в деревне Тхени, но мечтал о лучшей жизни. Он уехал в город, стал шеф-поваром у миллионера Вишнувардхана и готовится к свадьбе с его дочерью Мирой. Известие о смерти отца возвращает его в деревню. Он хочет продать закусочную и вернуться в новую жизнь, но постепенно переосмысливает ценности. В деревне он встречает бывшую возлюбленную Каял, презирающую его за предательство родителей, и опасного конкурента Марисами, метящего на заведение. Решение не продавать бизнес приводит к конфликту с семьей невесты и её братом Ашвином. Теперь герою предстоит выбор между мечтой и наследием отца...",
          "runtime": 0,
          "tagline": "",
          "title": "Закусочная с идли"
        }
      }
