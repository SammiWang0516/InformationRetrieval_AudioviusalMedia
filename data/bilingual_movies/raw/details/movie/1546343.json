      {
        "iso_3166_1": "SE",
        "iso_639_1": "sv",
        "name": "svenska",
        "english_name": "Swedish",
        "data": {
          "homepage": "",
          "overview": "Lily Garner får en del att stå i när hon ska balansera sitt jobb som festfixare med att försöka ta hand om den busiga hunden Valentine, vars påhitt skapar en hel del kaos. Men så träffar hon Shane, en hundtränare som ger henne nya perspektiv på såväl hunden som livet och kärleken. Romantisk dramakomedi med Arielle Kebbel (Gilmore Girls, Ballers) och Benjamin Hollingsworth (Virgin River).",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Zapracowana organizatorka imprez bierze pod opiekę niesfornego psa o imieniu Valentine. Choć chaotyczne wybryki czworonoga wywracają jej życie do góry nogami, stają się również pretekstem do zawarcia nowych przyjaźni...",
          "runtime": 0,
          "tagline": "",
          "title": "Miłość na czterech łapach"
        }
