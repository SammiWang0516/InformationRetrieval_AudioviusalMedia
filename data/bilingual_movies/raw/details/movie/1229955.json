      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Lola boldog életet él párjával, Brunóval, mígnem egy váratlan terhesség felborítja minden tervét. Úgy érzi, az anyaság nem neki való, ám párja apa akar lenni. A társadalmi elvárások és Bruno arra ösztönzik, hogy nézzen szembe félelmeivel.",
          "runtime": 0,
          "tagline": "",
          "title": "Anyaság"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Neplánované těhotenství překazí Lolin plán. Brání se mateřství, zatímco Bruno chce být otcem, což ji nutí čelit svým vnitřním obavám.",
          "runtime": 0,
          "tagline": "",
          "title": "Mateřský instinkt"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Lola disfruta de una vida feliz con su pareja, Bruno, hasta que un embarazo inesperado revoluciona todos sus planes. Aunque Lola siempre ha tenido claro que lo de ser madre no va con ella, ahora se siente cuestionada por las expectativas sociales y se enfrenta a sus temores internos. Durante los tres días que tienen que esperar hasta que llegue su cita en la clínica, Lola se acerca a sus amigas y su familia con la intención de reafirmar su decisión. Bruno tampoco se había imaginado nunca como padre. Hasta ahora.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
