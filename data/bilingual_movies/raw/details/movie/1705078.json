    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "她叫哈莉玛，住在摩洛哥海边，靠捡拾和售卖贻贝维持生计。一通陌生电话，让她埋藏已久的过去重新浮出水面。丈夫离世后，哈莉玛独自留守山区老宅。那片土地正经历剧烈的变迁，家园、生计与归属，一切都变得不再稳固。丧亲、困顿、流离接连而至。命运一次次把她摁在地上，但她从没认过输。导演曾是新闻摄影记者，用冷峻的镜头记录下这场一个人的战争。影片没有宏大的呐喊，只有日复一日的韧劲：在流动与失去之中，一个女人用最硬的骨头，寻找属于自己的立足之地。",
          "runtime": 85,
          "tagline": "",
          "title": "哈莉玛"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Halima lives on Morocco’s coast and makes a living by gathering and selling mussels. An unknown phone call brings her long-buried past back to light.  After her husband passed away, Halima stayed alone in their old house in the mountains. The land is undergoing drastic changes, leaving her home, livelihood and sense of belonging all precarious. Grief, hardship and displacement follow one after another. Though fate knocks her down time and again, she never surrenders.A former photojournalist, the director captures this one-woman battle with stark cinematography. Free from grand outcries, the film lays bare her everyday resilience. Amid constant flux and loss, this woman stands firm, striving to carve out her own place in the world.",
          "runtime": 85,
          "tagline": "",
          "title": "Halima"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Halima, de 86 anos, vive de forma modesta à beira-mar coletando mexilhões com o marido. Sua rotina pacífica, contudo, esconde um segredo do passado. Anos antes, ela morava sozinha em uma casa isolada nas montanhas do Rif, no Marrocos. Quando um projeto ambiental exigiu a remoção dos moradores locais, Halima resistiu ferozmente para proteger as memórias do falecido primeiro marido. Mas a resistência ocultava uma verdade sombria: após a perda de seu gado e sem renda, ela passou a permitir que contrabandistas de haxixe usassem sua antiga casa como esconderijo.",
          "runtime": 85,
          "tagline": "",
          "title": ""
        }
      }
