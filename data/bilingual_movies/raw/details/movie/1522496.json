  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "“มะเหมี่ยว” (มาริโอ้ เมาเร่อ) อดีตช่างเสียงในกองถ่าย ที่ปลดระวางมาเป็นอินฟลูเอ็นเซอร์ Live ASMR จำใจต้องร่วมเดินทางกับ “ซารัง” เด็กชายชาวเกาหลี ที่พลัดหลงจากแม่ที่มาถ่ายงานในเมืองไทย เด็กน้อยงอนแม่เลยแอบหนีขึ้นรถ Foodtruck ของ “เจ็ก” ทำเอากองถ่ายวุ่นวายเมื่อลูกชายของลูกค้าหายไป โดยที่ เจ็ก (แจ็ค เฉลิมพล) และ “บ็อบบี้” (แจ๊ส ผดุง) อาร์ตไดเรคเตอร์ที่ติดรถมาด้วย ไม่รู้เลยว่ารถของตัวเองจะนำพา “มะเหมี่ยว” หวนกลับไปหาอดีตอีกครั้ง ระหว่างเส้นทางมุ่งสู่บางแสน มะเหมี่ยว, เจ็ก และ  บ็อบบี้ ต้องเผชิญหน้ากับตำรวจท้องที่เล็ก ๆ ที่ใฝ่ฝันอยากทำคดีใหญ่ ได้ไล่ล่าผู้ร้ายในแบบหนังฮอลลีวู้ด มัคทายกผู้เชิญชวนให้คนมาทำบุญที่วัด เจ้าหน้าที่สวนสัตว์ที่รักสัตว์ที่ตัวเองดูแลดั่งลูกไปจนถึงฮิปโปแคระเซเลบตัวนั้น",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
