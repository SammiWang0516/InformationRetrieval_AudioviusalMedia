        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Prawdziwa historia Herberta Hellera, który przez lata ukrywał przed rodziną swoje przeżycia z Auschwitz.",
          "runtime": 102,
          "tagline": "",
          "title": "Wyzwolenie"
