      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "평화유지군이 떠난 카불의 공항에서 탈출하려는 민간인 구출작전을 위해 투입된 특수부대가 탈레반의 저지를 뚫고 민간인을 구출해내는 이야기",
          "runtime": 97,
          "tagline": "폐쇄된 공항, 민간인 구출작전 실화",
          "title": "밀리터리 OPS"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Oparty na prawdziwej historii operacji „Szaman Shield”, podczas której węgierscy żołnierze ewakuowali 540 osób, w tym 180 dzieci, z Afganistanu w związku z wycofywaniem się sił NATO. Premiera jesienią 2025 roku.",
          "runtime": 0,
          "tagline": "",
          "title": "Operacja Kabul"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "　　2021年北约撤军阿富汗期间，喀布尔局势全面失控。匈牙利国防军接到秘密任务，执行“萨满之盾”撤离行动，在被围困的机场与城市中撤出540名平民，其中包含180名儿童。特战小队在炮火与混乱中穿梭，一边对抗步步紧逼的武装势力，一边护送平民突围。行动过程中，队长意外重逢失联多年的爱人，任务与私人情感交织，所有人都要在绝境里做出抉择。",
          "runtime": 0,
          "tagline": "",
          "title": "龙临喀布尔"
        }
