  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A newly sober man's Christmas Eve dental emergency leads to an unexpected romance with his older dentist as they explore Baltimore together.",
          "runtime": 101,
          "tagline": "They found themselves. Together. In Baltimore.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "תוכניות ערב חג המולד של קליף ובת זוגו משתבשות עוד לפני שנכנסו אל בית הוריה, והוא מוצא עצמו במרפאת השיניים היחידה שעוד פתוחה בעיר. דידי, הרופאה התורנית, עוברת חוויית חג משובשת משלה בגלל משפחתה המפורקת – ולא מתארת לעצמה עד כמה המצב עומד לצאת משליטה. יחד, קליף ודידי יעבירו ערב בלתי נשכח שאולי ישנה את חייהם ואולי רק ייחקק כזיכרון יפה שיעלה חיוך קטן.",
          "runtime": 0,
          "tagline": "",
          "title": "אבודים בבולטימור"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Richtig festlich fühlt sich der Ex-Impro-Comedian und trockener Alkoholiker Cliff nicht, als er sich an Heiligabend einen Zahn ausschlägt. Dafür lernt er so  Zahnärztin Didi kennen, die selbst eine schmerzhafte Erfahrung gemacht hat: Ihr Ex hat eine deutlich Jüngere geheiratet. Gemeinsam streifen die beiden durch die Nacht, in der nichts so läuft wie vorhergesehen.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "В канун Рождества бывший алкоголик обращается за срочной стоматологической помощью и встречает обаятельную женщину-дантиста. Неожиданное знакомство перерастает в тёплый роман и прогулку по огням праздничного Балтимора.",
          "runtime": 0,
          "tagline": "",
          "title": "Чудаки из Балтимора"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "La veille de Noël, Cliff, humoriste qui se relève doucement d’une grosse dépression, se casse une dent. Il se rend chez Didi, dentiste de garde et fraîchement divorcée. Par un concours de circonstances, leur rencontre se transforme en odyssée urbaine dans les rues glacées de Baltimore. Entre rencontres improbables et aveux désarmants, Didi et Cliff font durer leur virée jusqu’au bout de la nuit.",
          "runtime": 100,
          "tagline": "",
          "title": "The Baltimorons - Noël à Baltimore"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "La emergencia dental de Nochebuena de un hombre recién sobrio lleva a un romance inesperado con su dentista mientras exploran Baltimore juntos.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Urgența stomatologică din Ajunul Crăciunului a unui bărbat care tocmai a renunțat la băutură duce la o poveste de dragoste neașteptată cu dentistul său mai în vârstă, pe măsură ce explorează orașul Baltimore împreună.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Na božični večer novopečeni abstinent potrebuje nujni zobozdravstveni poseg, kar nepričakovano vodi v romanco z njegovo starejšo zobozdravnico. Skupaj odkrivata mesto Baltimore in drug drugega.",
          "runtime": 0,
          "tagline": "Našla sta se. Skupaj. V Baltimoru.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
