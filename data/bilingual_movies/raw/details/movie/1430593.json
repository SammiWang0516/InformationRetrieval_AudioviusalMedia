  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A washed-up Hollywood action hero is tricked into starring in a small English town’s chaotic Christmas pantomime, where a straight-talking dance instructor and his estranged daughter just might help him rediscover the magic of the season.",
          "runtime": 94,
          "tagline": "Star-struck at Christmas.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Зірка кіно приголомшений, коли його успішну екшн-франшизу скасовують. Зі стрімким занепадом кар'єрних перспектив у Голлівуді він вирушає до Англії, аби відродити себе на театральних підмостках лондонського Вест-Енду. Та на свій жах, він опиняється у затишному англійському селищі, де йому дісталася роль у місцевій різдвяній виставі — традиційному дійстві, що поєднує пісні, танці, смішні сценки та активну участь глядачів. Оточений колоритними місцевими жителями, серед яких він знаходить і нове кохання, він отримує шанс відновити стосунки з родиною. Те, що починалося як найгірший період його життя, перетворюється на чудову різдвяну історію про другий шанс і силу справжніх почуттів.",
          "runtime": 0,
          "tagline": "",
          "title": "Зірка не того масштабу"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "בראד מאק הוא כוכב קולנוע הוליווודי שהקריירה שלו נתונה במשבר. הוא התפרסם ככוכב בסדרת סרטי פעולה מצליחה אך כעת כשהיא הסתיימה הוא חיב למצוא לעצמו אתגר חדש. הסוכן שלו שולח אותו לשחק בתאטרון הבריטי אך במהרה הוא מגלה שהוא לא עמוד לשחק שייקספיר או לכבוש את במות הווסט אנד בלונדון אלא נשכר להפקה מוזרה של סינדרלה בעיירה בריטית קטנה. האם יצליח להתגבר על מכשולי האגו שהביא עמו מהוליווד ולכבוש את ליבם של אנשי העיירה?",
          "runtime": 0,
          "tagline": "",
          "title": "כוכב נופל"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Bradley Mack to zapatrzony w siebie gwiazdor z Hollywood, znany z popularnej serii filmów akcji. Gdy produkcja dochodowej franczyzy zostaje anulowana, aktor zmuszony jest znaleźć nową pracę. W tym celu agentka wysyła go do teatru w Anglii. Na miejscu - ku swemu zaskoczeniu - szybko odkrywa, że nie czeka go tu kariera na West Endzie, a rola lokaja w \"Kopciuszku\", w prowincjonalnej pantomimie - osobliwej brytyjskiej tradycji, o której nigdy nie słyszał. Jednak im bliżej poznaje mieszkańców pokrytego śnieżnym puchem Stoneford i ekipę ekscentrycznego przedstawienia, z nieprzebierającą w słowach choreografką Jill na czele, tym bardziej ustępują w nim niechęć i uprzedzenia. A przede wszystkim - zaczyna odkrywać też szansę na nowy początek, który może odmienić jego życie.",
          "runtime": 94,
          "tagline": "",
          "title": "Miasto w blasku świąt"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "https://www.capelight.de/das-wunder-von-stoneford",
          "overview": "Der abgehalfterte Hollywoodstar Bradley Mack (Kiefer Sutherland) erlebt einen herben Rückschlag, als seine Actionfilmreihe abgesetzt wird. Ausgerechnet ein Engagement in England soll nun seiner Karriere eine neue Richtung geben. Doch statt auf die großen Bühnen des Londoner West Ends verschlägt es ihn in die britische Provinzstadt Stoneford, wo er in einer schrulligen Weihnachtsaufführung neben Laiendarstellern sein Theaterdebüt geben soll.",
          "runtime": 93,
          "tagline": "",
          "title": "Das Wunder von Stoneford"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Comedia navideña en la que un actor de acción de Hollywood en horas bajas cree haber encontrado su camino de vuelta al estrellato en el Reino Unido... aunque quizá termine encontrando algo más importante.",
          "runtime": 0,
