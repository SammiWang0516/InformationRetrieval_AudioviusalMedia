      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Graham Norton si povídá s „královnou popu“, zpěvačkou, skladatelkou, hudební producentkou, herečkou, podnikatelkou, zakladatelkou charitativní organizace a aktivistkou za práva LGBT a genderovou rovnost – Madonnou. Oba hovoří o její dlouhé kariéře, během níž dosáhla celosvětově 18 multiplatinových alb, sedmi cen Grammy, dvou cen Zlatý glóbus, dvaceti cen MTV Video Music Awards a uvedení do Rock and Rollové síně slávy.",
          "runtime": 0,
          "tagline": "",
          "title": "Madonna & Graham Norton: Exkluzivní rozhovor"
        }
      },
      {
        "iso_3166_1": "SE",
        "iso_639_1": "sv",
        "name": "svenska",
        "english_name": "Swedish",
        "data": {
          "homepage": "",
          "overview": "Popikonen Madonna öppnar upp när hon bjuder in Graham Norton till ett nära samtal i London. Tillsammans besöker de platser som format henne, medan hon pratar om sitt skapande, sitt familjeliv, sin spiritualitet och sin aldrig sinande ambition. Dessutom berättar hon om ny musik, drivkraften bakom popikonens nästa kapitel, ett kommande album med kopplingar till Confessions on a Dancefloor.",
          "runtime": 48,
          "tagline": "",
          "title": "Ikonen Madonna"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "La reina del pop abre las puertas de su mundo para mantener una conversación íntima y sincera con Graham Norton. En este encuentro tan especial, repasa su trayectoria, su proceso creativo y su visión de la vida, la música y la familia, mostrando su lado más humano y la ambición intacta que siempre la ha caracterizado.",
          "runtime": 0,
          "tagline": "",
          "title": "Madonna & Graham: Confessions II"
        }
      }
