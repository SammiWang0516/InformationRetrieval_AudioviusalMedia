      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "https://www.parisfilmes.com.br/a-menina-dos-meus-olhos/",
          "overview": "A trama, uma refilmagem homônima de um filme taiwanês lançado em 2011, acompanha um grupo de amigos que frequentam uma escola particular e são apaixonados pela mesma garota, Sun-ah (Dahyun). Jin Young interpreta o único do grupo que afirma não ter sentimentos pela aluna popular.",
          "runtime": 102,
          "tagline": "Compartilhando cada batida do coração.",
          "title": "A Menina dos Meus Olhos"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "กลุ่มเพื่อนสนิทในโรงเรียนเอกชนต่างหลงใหลในตัว ซอนอา นักเรียนดาวเด่นที่มีเสน่ห์สดใสกันทุกคน ยกเว้นแค่ จินอู สมาชิกคนเดียวของกลุ่มที่อ้างว่าไม่ได้ชอบเธอ แต่สุดท้ายแล้ว เขาก็กลับตกหลุมรักเธอเช่นกัน",
          "runtime": 0,
          "tagline": "",
          "title": "รักเรา ยังจำได้ไหม?"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "影片改编自中国台湾作家九把刀的同名半自传小说，以2000年代为背景，描述一段跨越十五年的爱情旅程。故事围绕着男主角镇宇（郑振永 饰）和他的朋友们，他们一同经历了青春期的喜怒哀乐，但所有人都对同班的女神善雅（金多贤 饰）抱有共同的憧憬。善雅是个气质出众、学业优异的模范生，对于这群男孩来说，她仿佛是遥不可及的梦想。然而，尽管镇宇和善雅在个性与学业成绩上差异甚大，两人却因彼此的独特魅力而建立了深厚的羁绊。",
          "runtime": 108,
          "tagline": "",
          "title": "那些年，我们一起追的女孩"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Jin-woo y sus amigos atraviesan los altibajos de la adolescencia. Sin embargo, todos comparten una fascinación por Seon-ah, la elegante y hermosa estudiante modelo que parece un sueño inalcanzable, a pesar de estar en la misma clase.",
          "runtime": 101,
          "tagline": "",
          "title": "La niña de mis ojos"
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Özel bir okula devam eden bir grup yakın arkadaşın hepsi, güneşli yıldız öğrenci Sun-ah'ya karşı zayıflatıcı bir aşk beslemektedir. Grubun aşık olmadığını iddia eden tek üyesi Jin-woo'dur, ancak o da sonunda Sun-ah'a aşık olur.",
          "runtime": 0,
          "tagline": "Birlikte atan kalpler.",
          "title": "Gözbebeğim"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "不懂事的振宇（振永 飾）在向善雅（多賢 飾）告白前，共度的許多時光的 18 歲初戀故事。",
          "runtime": 0,
          "tagline": "",
          "title": "那些年的我們"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Một nhóm bạn thân học tại một trường tư thục đều phải lòng cô học sinh ngôi sao đầy nắng, Sun-ah. Thành viên duy nhất trong nhóm không nói rằng mình như vậy là Jin-woo, nhưng cuối cùng anh cũng yêu cô.",
          "runtime": 0,
          "tagline": "",
          "title": "Cô Gái Năm Ấy Chúng Ta Cùng Theo Đuổi"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Старшеклассник Ку Джин-ву плохо учится, у него нет амбиций, и он ни о чём особо не мечтает. Всё своё время парень проводит, гуляя и дурачась с друзьями, такими же беспечными подростками, как и он сам. Ку Джин-ву влюбляется в старосту класса, красавицу, зануду и отличницу О Сон-а, о которой мечтают все мальчики класса. Но девушку интересуют лишь занятия. Неожиданно девушка заступается за него перед преподавателем. Парень обретает надежду на то, что он ей небезразличен. Молодые люди начинают общаться, и девушка помогает ему подтянуть учёбу. Под её влиянием школьник начинает переосмысливать свою жизнь, но есть ли у него шанс на взаимность?",
          "runtime": 0,
          "tagline": "",
          "title": "Ты - самое дорогое, что у меня есть"
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "夢もなく友人たちと気ままな高校生活を送っていたジヌ（ジニョン）は、ある出来事をきっかけにクラスの模範生・ソナ（ダヒョン）への思いに気づく。誰もが憧れる彼女と少しずつ距離を縮め、かけがえない青春の日々を重ねていく二人。しかし卒業とともにそれぞれの道を歩み始め、やがてすれ違いが生まれていく。\r 台湾映画「あの頃、君を追いかけた」の韓国リメイク。",
          "runtime": 0,
          "tagline": "",
          "title": "あの夏、僕たちが好きだったソナへ"
        }
      }
    ]
