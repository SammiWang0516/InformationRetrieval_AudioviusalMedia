      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "夏日炎炎，11岁的少女艾瑞丝在街头肆意奔跑，突然得知多年未见的生父阿里斯为奔丧回到城中。母亲远行、哥哥缺席，她仿佛被全世界遗忘。带着一股不服输的倔强，她找到父亲，一场始于固执的纠缠，缓缓展开成一段脆弱却动人的重逢。",
          "runtime": 103,
          "tagline": "",
          "title": "艾瑞丝的忧夏"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "11살 아이리스는 동네 언니 다나에와 거리를 누비며 자유롭게 뛰놀던 중, 오랫동안 연락이 끊겼던 아빠가 할아버지의 장례식을 위해 마을로 돌아왔다는 소식을 듣는다. 소녀는 그가 홀로 지내는 낡은 조선소로 무작정 찾아간다. 아이리스의 고집스러운 재회 시도로 시작된 두 사람의 만남은 불완전하지만 애틋한 유대감으로 발전해 나간다.",
          "runtime": 83,
          "tagline": "",
          "title": "나를 놓지마"
        }
