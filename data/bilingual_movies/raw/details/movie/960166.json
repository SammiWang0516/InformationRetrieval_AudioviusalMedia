    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Un monde post-apocalyptique. La nature a maîtrisé la technologie. Mila, une fille de 12 ans, est anéantie par le meurtre de son père. Mila commence un voyage pour se racheter de ses mauvaises actions.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "http://www.altrofilm.it/",
          "overview": "In Sardinia, in the near future, the ancient settlements come back to life, once again hosting man. The young Mila is robbed of her father's inheritance by her paternal uncles. After many adventures she manages to obtain revenge. Despite this, the girl still struggles to find serenity and therefore decides to undertake a spiritual journey in search of herself.",
          "runtime": 100,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "http://www.altrofilm.com",
          "overview": "Un mondo post-apocalittico. La natura ha sopraffatto la tecnologia. La dodicenne Mila è distrutta dall'uccisione del padre. Mila inizia un viaggio per redimersi dalle sue azioni malvagie.",
          "runtime": 115,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Na Sardynii, w niedalekiej przyszłości, starożytne osady powracają do życia, ponownie goszcząc człowieka. Młoda Mila zostaje okradziona z dziedzictwa ojca przez swoich stryjów. Po wielu przygodach udaje jej się zemścić. Mimo to dziewczyna wciąż walczy o znalezienie spokoju i dlatego decyduje się na duchową podróż w poszukiwaniu siebie.",
          "runtime": 100,
          "tagline": "",
          "title": "Milarepa"
        }
      },
      {
        "iso_3166_1": "AE",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "http://www.altrofilm.it/",
          "overview": "في سردينيا، في مستقبل قريب، تعود المستوطنات القديمة إلى الحياة من جديد، لتستضيف الإنسان مرة أخرى. تُسلب الشابة ميلا ميراث والدها على يد أعمامها من جهة الأب. وبعد العديد من المغامرات، تتمكن من الانتقام. ومع ذلك، لا تزال الفتاة تكافح لإيجاد السكينة، فتقرر خوض رحلة روحية بحثًا عن ذاتها.",
          "runtime": 100,
          "tagline": "",
          "title": "ميلاريبا"
        }
      },
      {
        "iso_3166_1": "IR",
        "iso_639_1": "fa",
        "name": "فارسی",
        "english_name": "Persian",
        "data": {
          "homepage": "",
          "overview": "دنیای پسا آخرالزمانی. طبیعت بر فناوری غلبه کرد. میلا دختر 12 ساله در اثر قتل پدرش از بین می رود. میلا سفری را برای رهایی از اعمال شیطانی خود آغاز می کند.",
          "runtime": 0,
          "tagline": "",
          "title": "میلارپا"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "V blízké budoucnosti se na Sardinii starověká sídla znovu probouzejí k životu a znovu hostí člověka. Mladou Milu strýcové z otcovy strany okradou o dědictví po jejím otci. Po mnoha dobrodružstvích se jí podaří pomstít. Navzdory tomu se dívka stále snaží najít klid, a proto se rozhodne podniknout duchovní cestu a hledat sama sebe.",
