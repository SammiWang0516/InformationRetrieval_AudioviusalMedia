      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "בשנים האחרונות הולכת וגדלה באנגליה קהילת הנטוריסטים – אנשים שאוהבים לנהל את אורח החיים שלהם בעירום מלא. חלקם מתנהלים בעירום בקהילות סגורות אך חלקם שואפים לנרמל את הרעיון ולהוציא אותו גם אל מחוץ לדלתות ביתם – ללכת למסעדות, לטיולים, לעבודה, לבריכה ולחדר הכושר. בסרט הדוקו-שוק מאיר העיניים הזה, עוקבים אחר האנשים שבחרו בנטוריזם כחלק מאורח חייהם ומגלים מדוע הם מעדיפים להיות חופשיים מבגדים, ולא משנה מה הם עושים – מקניות בכפר המקומי ועד טיפוס צוקים על הגבעות המקומיות.",
          "runtime": 44,
          "tagline": "",
          "title": "אוהבים להיות עירומים"
        }
