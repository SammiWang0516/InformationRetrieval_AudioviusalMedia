  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "从哲学讲台到导演椅，路易·戈德布用15年的思辨功力，对准了一场最日常的“战争”：抢车位。一个车位、一对爱侣、一个陌生人。报警后冲突非但没结束，反而升级为一场无声的心理暗战。陌生人的一句话，如同多米诺骨牌，推倒了两人关系中所有看似坚固的东西。短短一夜，暗流涌动。影片用平静的空镜头制造紧绷的窒息感，点到为止的对白留给观众巨大的解读空间。当亲密关系遇上人性博弈，谁才是真正的“陌生人”？",
          "runtime": 85,
          "tagline": "",
          "title": "车位"
        }
