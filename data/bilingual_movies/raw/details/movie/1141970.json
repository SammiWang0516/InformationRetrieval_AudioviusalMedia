      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Sao, une jeune femme, travaille dans un restaurant à Bangkok. Un jour, elle reconnait, installé à une table, l'homme qui avait abusé d'elle quand elle avait 16 ans. En revanche, l'individu, prénommé Korn, ne la reconnaît pas. Elle échafaude alors sa vengeance : lui préparer tous les jours des repas délicieux mais mortels.",
          "runtime": 96,
          "tagline": "",
          "title": "Morte Cucina"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Sao, een getalenteerde kokkin, ontmoet per ongeluk de man die in het verleden misbruik van haar maakte. Ze zet haar wraakplan in gang en gebruikt haar kookkunst om een nogal onverwacht resultaat te bereiken.",
          "runtime": 96,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Sao to szefowa kuchni o nieprzeciętnym talencie. Jej umiejętności dostrzega mężczyzna, z którym łączy ją mroczna przeszłość. On jej nie rozpoznaje, ale obrazy dawnej traumy popychają kobietę ku jednej z najbardziej zawiłych intryg, jakie widziało i kino zemsty, i kino kulinarne.",
          "runtime": 0,
          "tagline": "",
          "title": "Morte Cucina"
