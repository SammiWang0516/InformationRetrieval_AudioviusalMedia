      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Pořad The Wonderful World of Disney: Holiday Spectacular, který uvádějí Julianne Hough a Alfonso Ribeiro, se vrací již podeváté. Tato slavnostní oslava nabízí okouzlující sestavu nových hudebních vystoupení, která se natáčela na pozadí kouzelných scenérií letovisek Walt Disney World na Floridě, Disneyland Resort v Kalifornii a Aulani, a Disney Resort & Spa v Ko'Olině na Havaji.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "The Wonderful World of Disney: Holiday Spectacular, gepresenteerd door Julianne Hough en Alfonso Ribeiro, keert terug voor zijn oogverblindende negende jaar. Deze feestelijke viering biedt een betoverende reeks nieuwe muziekuitvoeringen, gefilmd tegen de magische achtergronden van Walt Disney World Resort in Florida, Disneyland Resort in Californië en Aulani, een Disney Resort & Spa in Ko’Olina, Hawai’i.",
          "runtime": 0,
          "tagline": "Vier de feestdagen met muziek optredens.",
          "title": ""
        }
      }
    ]
