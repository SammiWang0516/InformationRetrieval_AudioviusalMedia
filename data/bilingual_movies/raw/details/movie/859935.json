  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "http://www.minorethefilm.com",
          "overview": "When mysterious creatures invade a Greek seaside port, a misfit band of musicians, tourists, bodybuilders, and grannies unite to save the city in this quirky action-comedy.",
          "runtime": 111,
          "tagline": "",
          "title": "Minore"
        }
      },
      {
        "iso_3166_1": "GR",
        "iso_639_1": "el",
        "name": "ελληνικά",
        "english_name": "Greek",
        "data": {
          "homepage": "",
          "overview": "Κάποια υγρή καλοκαιρινή νύχτα, μια παραλία της Ελλάδας γεμάτη από μουσική και χορούς, καλύπτεται ξαφνικά από ομίχλη. Παράξενα όντα πολιορκούν την πόλη, επιτίθενται σε ανθρώπους, άλλους τους τραβούν στην θάλασσα μετά από φρικτά όνειρα. Μια παρέα μουσικών ενώνει τις δυνάμεις της με έναν χαμένο ναύτη, και όλοι μαζί αντιστέκονται στους εισβολείς.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Cuando unas criaturas misteriosas invaden un puerto costero griego, un grupo de músicos inadaptados, turistas, culturistas y abuelas se unen para salvar la ciudad en esta peculiar comedia de acción.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Es ist ein angenehmer Abend im Sommer an der Küste Griechenlands. Die Menschen genießen die Zeit mit Tanz, Musik und leckerem Essen. Doch dann legt sich plötzlich ein mysteriöser Nebel über die Hafenstadt, der die Leute mit furchterregenden Visionen quält. Diese Trugbilder aber sind erst der Anfang. Mit einem Fall attackieren bizarre Monster mit Tentakeln die Bevölkerung. Eine Gruppe von Außenseitern aus Touristen, Musikern und Bodybuildern schließt sich mit einer willensstarken Rentnerin zusammen, um die Ungeheuer zu besiegen und die Stadt zu retten",
          "runtime": 111,
          "tagline": "",
          "title": "Minore: Creatures From Beyond"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一片宁静的雅典港内，居民们齐聚酒馆载歌载舞享受美好生活，从美国千里迢迢来到希腊寻父的美国水手也加入了其中，既发现了父亲的身影也仿佛收获了爱情。然而一场“地震”却引发了一系列怪异事件，有人不受控制的走向海中也有一场大雾弥漫了整个港口。果然，事出反常必有妖......",
          "runtime": 0,
          "tagline": "",
          "title": "衰仔斗邪神"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Quando misteriosas criaturas invadem um porto na Grécia, um grupo de pessoas desajustadas formado por músicos, fisiculturistas, turistas e avós se reúne para tentar salvar a cidade.",
          "runtime": 0,
          "tagline": "",
          "title": "O Ataque dos Monstros"
        }
      }
