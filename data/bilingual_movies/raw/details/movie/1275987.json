      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Aos 39 anos, Adela enfrenta a perda prematura da melhor amiga, Elena. Em meio ao absurdo de se despedir de alguém tão querido, e consumida pelo choque e pelo vazio iminente em seu futuro, ela se torna uma inesperada viajante do tempo. Transportada para uma década antes, Adela se reúne com Elena em uma casa de praia, acompanhada por outra amiga, Luci, e o filho, Paco, e embarcam em um fim de semana repleto de felicidade.",
          "runtime": 75,
          "tagline": "",
          "title": "Agarra-me Forte"
        }
      },
      {
        "iso_3166_1": "ES",
