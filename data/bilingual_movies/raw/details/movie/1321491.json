      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Miután bátyja rejtélyes módon eltűnik, Grace a veszélyes vadonba indul, hogy megtalálja őt. Miközben rájön az eltűnés szörnyű igazságára, szembesül a sötétséggel, amely őt is elragadja.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Cuando su hermano desaparece sin dejar rastro, Grace se adentra en un territorio salvaje y peligroso para buscarlo. Durante su investigación, descubre una terrible verdad que podría consumirla a ella también.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "Joseph Sims-Dennett意想不到的恐怖故事《被放逐》中,年轻女子格蕾丝不情愿地回到摇摇欲坠的家乡,却发现哥哥神秘失踪。她被愧疚所吞噬,踏上了寻找他的痛苦旅程,这让她深入小镇周围的黑暗荒野。 《放逐》从一开始就令人毛骨悚然、令人不安,它既是对文明边缘腐朽城镇的探索,也是对困扰它们的黑暗力量的探索。这部电影大气而可怕,将原始的恐惧与熟悉的恐惧联系起来,揭示了一种新的恐怖压力–,即使灯光恢复了,它也会离开电影院并与你一起生活。这是一部大气、怪异、令人不安的恐怖片,其令人惊叹的表演确实值得在大银幕上看到。",
          "runtime": 97,
          "tagline": "",
          "title": "放逐"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "ca",
        "name": "Català",
        "english_name": "Catalan",
        "data": {
          "homepage": "",
          "overview": "Quan el seu germà desapareix sense deixar rastre, Grace s'endinsa en un territori salvatge i perillós per buscar-lo. Durant la seva investigació, descobreix una terrible veritat que podria consumir-la també.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
