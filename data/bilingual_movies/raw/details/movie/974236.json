        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "When a sick factory worker becomes the first confirmed COVID-19 case in her rural Bulgarian town, she is scapegoated and ostracized by her employers, family, and entire community as the virus spreads and casualties mount.",
          "runtime": 109,
          "tagline": "",
