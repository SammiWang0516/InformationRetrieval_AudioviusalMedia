      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "A 12 éves Georg, és bátyja, Alfons a havas Alpok magaslatain keresztül igyekszik Olaszországba. A viszontagságos út során Georg megbetegszik, és Alfons magára hagyja őt egy menedékházban. A fiú összebarátkozik egy helyi kutyagondozó lányával, Resivel, aki megmutatja neki apja kutyáit, köztük a gyengécske bernáthegyi kölyköt, Barryt.",
          "runtime": 0,
          "tagline": "",
          "title": "Barry és én"
        }
