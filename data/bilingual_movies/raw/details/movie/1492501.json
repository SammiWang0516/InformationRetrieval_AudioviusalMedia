  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "After a failed suicide attempt, Zhang Xiaobing (Jiang Long) is sent to Ward 10 — a ward for the critically ill, but strangely full of joy. Among patients clinging to life, a man who wanted to die discovers the courage to live.",
          "runtime": 120,
          "tagline": "Live bravely, laugh freely.",
          "title": "Being Towards Death"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "亲人离世，一无所有的章小兵自杀未遂。为了还债，他以护工的身份进入了10号癌症病房进行“心理干预”。一个不想活的和一群要死的人朝夕相处，互相帮助渡过难关。最终找到了人生意义，开启全新的生活。",
          "runtime": 120,
          "tagline": "Live bravely, laugh freely.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "醫院走廊盡頭的10號房是一個特別的存在，別看這裡住著的都是重症病人，但卻每天歡聲笑語熱鬧非凡。而故事就從章小兵（蔣龍 飾）跳樓未遂的那天開始講起……\r 當一個一心求死的人，遇上一群拼命想活的人，他在這份滾燙的生命力裡豁然醒悟——勇敢活！放肆笑！",
          "runtime": 0,
          "tagline": "",
          "title": "10間敢死隊"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Nach einem gescheiterten Selbstmordversuch wird Zhang Xiaobing auf Station 10 verlegt – eine Station für Schwerkranke, die jedoch seltsamerweise von Freude erfüllt ist. Inmitten von Patienten, die um ihr Leben kämpfen, findet ein Mann, der sterben wollte, den Mut zum Leben.",
          "runtime": 121,
          "tagline": "",
          "title": "Being Towards Death"
        }
      },
