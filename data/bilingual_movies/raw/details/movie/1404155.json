      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://movies.shochiku.co.jp/paripikoumei-movie/",
          "overview": "三国志の天才軍師・諸葛孔明が、なぜか現代の渋谷に転生。  アマチュアシンガー月見英子の歌声に心奪われた孔明は、英子とともに音楽の力で＜天下泰平＞を目指す。そんな中、日本を代表する3大音楽レーベル、KEY TIME、SSSミュージック、V-EXが頂点を競う、史上最大の音楽バトルフェスの開幕が決定。  各レーベルから多彩な強者アーティストが集結する中、孔明と英子も参戦することに。  だが、そんな二人の前に三国時代の孔明の最大のライバル司馬懿の末裔・司馬潤、shin兄妹が立ちはだかる。  果たして、孔明と英子の運命は──？",
          "runtime": 0,
          "tagline": "YA BOY KONGMING!",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "https://movies.shochiku.co.jp/paripikoumei-movie/",
          "overview": "本电影的舞台是历史上最大的音乐战斗节“音乐战斗时间2025”。在代表日本的三大音乐品牌互相竞争的过程中，诸葛亮和英子的面前出现了三国时代诸葛亮最大的对手司马懿的后裔司马润此外，润的妹妹新也将参战，展现精彩的歌唱场面。",
          "runtime": 0,
          "tagline": "",
          "title": "派对浪客孔明 THE MOVIE"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "本電影的舞台是歷史上最大的音樂戰鬥節“音樂戰鬥時間 2025”。在代表日本的三大音樂品牌互相競爭的過程中，諸葛亮和英子的面前出現了三國時代諸葛亮最大的對手司馬懿的後裔司馬潤此外，潤的妹妹新也將參戰，展現精彩的歌唱場面。",
          "runtime": 0,
          "tagline": "",
          "title": "派對浪客孔明 THE MOVIE"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "《三國演義》中的天才軍事家諸葛孔明，死後不知何故重生到了現代的澀谷。混亂中孔明意外聽到素人歌手月見英子的歌聲，深受感動的他決定在第二人生，協助英子實現成名的夢想。如今，日本三大音樂廠牌宣佈將舉辦史上最大規模的音樂對抗賽，孔明與英子也決定參加這場盛會！",
          "runtime": 0,
          "tagline": "",
          "title": "電影版派對咖孔明"
        }
