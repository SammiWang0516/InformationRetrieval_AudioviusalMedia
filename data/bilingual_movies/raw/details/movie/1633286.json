  "translations": {
    "translations": [
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "La storia di Giorgio Bassani, scrittore, poeta, saggista, sceneggiatore, promotore culturale e politico, raccontata attraverso lo sguardo dei suoi figli, Paola ed Enrico. Un viaggio straordinario nel vissuto e nei luoghi che hanno ispirato l’autore de \"Il giardino dei Finzi-Contini\", uno dei romanzi più rappresentativi del Novecento italiano. È anche il racconto di una riconciliazione tra un padre e i suoi figli, che ritrovano nell’arte e nella letteratura il senso del loro rapporto.",
          "runtime": 110,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Het verhaal van Giorgio Bassani, schrijver, dichter, essayist, scenarioschrijver, cultureel en politiek promotor, verteld door de ogen van zijn kinderen, Paola en Enrico. Een buitengewone reis door de ervaringen en plaatsen die de auteur van \"De tuin van de Finzi-Continis\" inspireerden, een van de meest iconische romans van het twintigste-eeuwse Italië. Het is tevens het verhaal van een verzoening tussen een vader en zijn kinderen, die de betekenis van hun relatie herontdekken in kunst en literatuur.",
          "runtime": 110,
          "tagline": "",
          "title": ""
        }
      }
    ]
  },
