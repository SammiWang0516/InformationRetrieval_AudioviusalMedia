  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://thepattersonproject.org/",
          "overview": "A crew of acclaimed documentarians follow a young budding filmmaker as he attempts to create the world's greatest found footage horror film.",
          "runtime": 89,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Начинающий режиссёр решает любой ценой снять свой первый фильм ужасов про йети — в жанре «найденной пленки». Для этого он собирает команду неудачников. Когда съёмочная группа приезжает в глухомань, выясняется, что рядом действительно происходит нечто жуткое и необъяснимое. Грань между фантазией и реальностью стирается всё сильнее.",
          "runtime": 91,
          "tagline": "",
          "title": "Найденная пленка: История создания проекта \"Паттерсон\""
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Un grup de documentariști urmăresc un tânăr regizor independent, Chase Bradner, care vizează realizarea celui mai mare horror found footage despre Bigfoot. În căutarea unui succes fulminant, echipa se confruntă cu o serie de peripeții absurde: de la un casting în care se promovează un „Danielle Radcliffe” (fără legătură cu Daniel Radcliffe) până la o înșelătorie cu Alan Rickman. Pe măsură ce filmările avansează, evenimentele paranormale și tensiunile interne transformă producția într-un haos total.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "大脚怪追拍记"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Un cineasta en ciernes intenta producir su primer largometraje, una película de metraje encontrado sobre Bigfoot. A través de los ojos de un prestigioso equipo de documentalistas franceses, la historia sigue a su improbable grupo de inadaptados mientras luchan por mantener la producción a flote con un presupuesto mínimo. Mientras tanto, misteriosos y siniestros sucesos comienzan a desarrollarse entre bastidores, desdibujando los límites entre la magia del cine y la vida real. A medida que los días de rodaje se hacen más largos y aterradores, los cineastas se dan cuenta de que se han metido en una película de terror muy real.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
