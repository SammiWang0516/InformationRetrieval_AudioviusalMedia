  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Migrant and aspiring actress Thooya navigates Mumbai by leveraging beauty and wit, occasionally trading intimacy for opportunity. When she sublets her sugar daddy’s upscale apartment to Swetha, a fellow migrant working a corporate job, the two women from seemingly different worlds begin sharing more than just living space. Amid Mumbai’s relentless pulse, they discover silent empathy, though personal histories and wounds test their delicate connection in a strange and tender unfolding – of selfhood, of survival, of unexpected kinship.",
          "runtime": 77,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "她有個演員夢，為生計而秘密從事性工作。另一個她初來乍到，以客服工作糊口，對孟買生活充滿期許。背景迥異的二人因合租而交集，在瑣碎的日常中,她們下廚晾衣、哼唱民謠，也窺看對方的脆弱與傷痕，默默生出微妙而複雜的親密情感。溫柔不批判的長鏡頭，真實捕捉女性間的情感流動與獨立堅韌的姿態，構築一首平實的現代都市女性之歌。創作靈感源自導演自身記憶，童年好友因被迫早婚而消失不見，連道別也來不及。她藉角色的遺憾與樹的隱喻紀錄這段沉重的過去，揭露傳統文化制度對女性的無形壓迫。首位摘下威尼斯影展地平線單元最佳導演獎之印度導演，為印度女性故事注入力量與肯定。",
          "runtime": 0,
          "tagline": "",
          "title": "她和她的孟買新活"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Migrantka i początkująca aktorka Thooya porusza się po Mumbaju, wykorzystując urodę i dowcip, okazjonalnie wymieniając intymność na możliwości. Kiedy podnajmuje luksusowe mieszkanie swojego słodkiego tatusia, Swecie, innej migrantce pracującej w korporacji, dwie kobiety z pozornie odmiennych światów zaczynają dzielić coś więcej niż tylko przestrzeń życiową. Pośród nieustającego pulsu Mumbaju odkrywają cichą empatię, choć osobiste historie i rany wystawiają na próbę ich delikatną więź w dziwnym i delikatnym procesie – tożsamości, przetrwania, nieoczekiwanego pokrewieństwa.",
          "runtime": 80,
          "tagline": "",
          "title": "Songs of Forgotten Trees"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Thooya es una joven migrante en Mumbai que aspira ser actriz. Subarrienda una habitación de su vivienda a otra mujer recién llegada a la ciudad, empleada en un call center. La convivencia entre estas mujeres tan distintas, atravesada por la precariedad laboral y la búsqueda de estabilidad, las acerca de modo inesperado.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "她有个演员梦，为生计而秘密从事性工作。另一个她初来乍到，以客服工作糊口，对孟买生活充满期许。背景迥异的二人因合租而交集，在琐碎的日常中，她们下厨晾衣、哼唱民谣，也窥看对方的脆弱与伤痕，默默生出微妙而复杂的亲密情感。温柔不批判的长镜头，真实捕捉女性间的情感流动与独立坚韧的姿态，构筑一首平实的现代都市女性之歌。创作灵感源自导演自身记忆，童年好友因被迫早婚而消失不见，连道别也来不及。她借角色的遗憾与树的隐喻纪录这段沉重的过去，揭露传统文化制度对女性的无形压迫。首位摘下威尼斯影展地平线单元最佳导演奖之印度导演，为印度女性故事注入力量与肯定。",
          "runtime": 0,
          "tagline": "",
          "title": "被遗忘的树之歌"
        }
      }
