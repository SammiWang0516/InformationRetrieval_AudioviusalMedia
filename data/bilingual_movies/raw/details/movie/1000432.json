      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Франца Фанона було призначено головним лікарем психіатричної лікарні в Алжирі. Його інноваційні та прогресивні методи лікування достатньо швидко викликають гнів інших колег та директора цього закладу і обурюють персонал. Але головний герой зовсім не з тих, хто дозволить заганяти себе у рамки. Невдовзі разом із дружиною вони потрапляють в епіцентр страшного насильства, що змушує їх приєднатися до боротьби за незалежність Алжиру.",
          "runtime": 132,
          "tagline": "",
          "title": "Фанон"
