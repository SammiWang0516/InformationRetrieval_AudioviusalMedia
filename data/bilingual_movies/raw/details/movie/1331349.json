      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "長い国外生活を終えてフランスに戻ったピアニストのマティアス・フォグラーは、恩師エレナと再会し、コンサートの準備に取りかかる。ある日、公園で自分にそっくりな少年と出会ったことをきっかけに、かつて愛した女性クロードのもとへと導かれていく。",
