  "translations": {
    "translations": [
      {
        "iso_3166_1": "GR",
        "iso_639_1": "el",
        "name": "ελληνικά",
        "english_name": "Greek",
        "data": {
          "homepage": "",
          "overview": "Μία ιστορική ταινία που διαδραματίζεται στις αρχές του 19ου αιώνα και αναφέρεται στην αληθινή ιστορία του μεγαλύτερου Έλληνα πολιτικού και πρώτου Κυβερνήτη της Ελλάδας, Ιωάννη Καποδίστρια, μετά την απελευθέρωσή της από τους Οθωμανούς. Υπερασπίζεται με σθένος, καλοσύνη και αξιοπρέπεια την ελευθερία του κάθε ανθρώπου, θυσιάζοντας ακόμη και τον μεγάλο έρωτα της ζωής του, και δεν διστάζει να συγκρουστεί με τις δυνάμεις του κακού, θυσιάζοντας πλούτη, δόξα και διεθνή αναγνώριση. Όταν η Ελλάδα αποκτά την ελευθερία της, ο Καποδίστριας καλείται να αναλάβει πρώτος Κυβερνήτης. Παρότι διαισθάνεται ότι θα δολοφονηθεί, αποδέχεται αγόγγυστα την μοίρα του και θυσιάζεται, υπηρετώντας με πίστη και αφοσίωση την πατρίδα του. Αυτή η θυσία τον οδηγεί στην αληθινή ελευθερία.",
          "runtime": 128,
          "tagline": "Δώσε μου την πατρίδα που ποθώ.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The story of the statesman Ioannis Kapodistrias from his time as foreign minister of Russia all the way to Greece's independence in the 1820s.",
          "runtime": 128,
          "tagline": "Give me the homeland I desire.",
          "title": "Kapodistrias: The Governor"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Der Diplomat und Senatssekretär Ioannis Kapodistrias übernimmt nach der Befreiung seines Landes von der osmanischen Herrschaft eine zentrale Rolle beim Aufbau staatlicher Strukturen. Als erfahrener Politiker setzt er sich mit Mut und Menschlichkeit für jeden einzelnen ein und scheut auch nicht den Konflikt. Zwischen widerstreitenden Interessen im In- und Ausland muss er schließlich auch sein persönliches Glück, seine große Liebe hinter seine Verantwortung zurückstellen. Sein Handeln prägt das junge Griechenland nachhaltig …",
          "runtime": 128,
          "tagline": "",
          "title": "Kapodistrias"
        }
      }
    ]
  },
