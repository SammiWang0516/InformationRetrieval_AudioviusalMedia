        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.signature-entertainment.co.uk/film/the-partisan/",
          "overview": "A Polish spy working for the British during World War II is betrayed and compromised in Warsaw, leaving her no other choice but to descend into a dangerous world of treachery and deception in order to survive.",
          "runtime": 108,
          "tagline": "Deceive. Betray. Survive.",
          "title": ""
        }
