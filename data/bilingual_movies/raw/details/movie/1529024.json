      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "2022. gads. Marija ir izpilddirektore sociālo tīklu video “fabrikā” un zina savu profesionālo vērtību. Vits ir pieredzējis režisors, kurš ilgus gadus nav neko filmējis un ir uzņēmies mājas soli. Pēc 12 gadiem attiecībās viņu kopība ir saistāma vien ar meitu Dovili. Abi iemieso veiksmīgo vidusšķiru, bet rimtā līdzās pastāvēšana strauji izplēn: Marijai šķiet, ka dzīvei vajadzēja būt aizraujošai, bet tā vietā viņa ir tikusi pie krīzes. Kad Marija un Vits nolemj šķirties, sākas Krievijas pilna mēroga iebrukums Ukrainā…",
          "runtime": 0,
          "tagline": "",
          "title": "Kā šķirties kara laikā"
