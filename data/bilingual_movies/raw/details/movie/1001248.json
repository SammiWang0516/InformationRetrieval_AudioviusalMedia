  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.respiroproductions.com/film/dans-la-cuisine-des-nguyen",
          "overview": "Yvonne Nguyen, jeune femme d’origine vietnamienne, rêve d’une carrière dans la comédie musicale au grand dam de sa mère qui préférerait la voir reprendre son restaurant en banlieue. L’intimité de la cuisine, entre plats familiaux et recettes traditionnelles, leur permettra-t-elle enfin de communiquer, se comprendre et s’accepter ?",
          "runtime": 95,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.thepartysales.com/movie/in-the-nguyen-kitchen-working-title/",
          "overview": "French-Vietnamese actress Yvonne Nguyen dreams of a successful career in musicals, to the great displeasure of her mother, who would like her to pursue a more serious path. When Yvonne has no choice but to move back home, both women are strangers to each other. But, in the intimacy of the Vietnamese family restaurant's kitchen, they grow closer. Meanwhile, Yvonne is still after her dreams and finally gets the chance to audition for a big show.",
          "runtime": 99,
          "tagline": "",
          "title": "In the Nguyen Kitchen"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Yvonne Nguyen, młoda kobieta pochodzenia wietnamskiego, marzy o karierze w komedii muzycznej, ku wielkiemu niezadowoleniu swojej matki, która wolałaby, aby przejęła jej restaurację na przedmieściach. Czy intymność kuchni, rodzinnych dań i tradycyjnych przepisów, pozwoli im w końcu na komunikację, zrozumienie i akceptację siebie nawzajem?",
          "runtime": 99,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "프랑스계 베트남인 배우 이본 응유엔은 뮤지컬 무대에서의 성공을 꿈꾸지만, 그녀의 어머니는 좀 더 제대로 된 직업을 갖길 바란다. 불가피한 사정으로 어머니의 집에 얹혀살며 어색했던 둘의 관계가 조금씩 나아지던 중, 자신의 꿈을 포기하지 않던 이본에게 마침내 대형 뮤지컬 오디션에 도전할 기회가 찾아온다.",
          "runtime": 100,
          "tagline": "",
          "title": "응유엔의 키친"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Yvonne Nguyen, eine französisch-vietnamesische Schauspielerin, träumt von einer erfolgreichen Musicalkarriere, sehr zum Missfallen ihrer Mutter, die sich einen ernsthafteren Weg wünscht. Als sie keine andere Wahl hat, als wieder zu ihrer Mutter zu ziehen, sind sich beide Frauen fremd. Doch in der intimen Atmosphäre der Küche des vietnamesischen Familienrestaurants kommen sie sich näher. Währenddessen verfolgt Yvonne immer noch ihre Träume und bekommt endlich die Chance, für eine grosse Show vorzusprechen.",
          "runtime": 99,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Fransız-Vietnamlı oyuncu Yvonne Nguyễn, müzikallerde başarılı bir kariyer hayal ederken, onun daha ciddi bir yol izlemesini isteyen annesinin büyük hoşnutsuzluğuyla karşılaşır. Yvonne'un eve geri dönmekten başka çaresi kalmadığında, iki kadın birbirine yabancıdır. Ancak, Vietnam aile restoranının mutfağının samimiyetinde yakınlaşırlar. Bu sırada Yvonne hala hayallerinin peşindedir ve sonunda büyük bir gösteri için seçmelere katılma şansı yakalar.",
          "runtime": 0,
          "tagline": "",
          "title": "Nguyễn Mutfağında"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Yvonne Nguyen, aspirante attrice di origine vietnamita, sogna una carriera teatrale recitando in musical, contro il volere della madre. È nell'intimità della cucina, tra piatti di famiglia e ricette tradizionali, che riusciranno finalmente a comunicare, a capirsi e ad accettarsi a vicenda.",
          "runtime": 0,
          "tagline": "",
          "title": "Nguyen Kitchen"
        }
