        "data": {
          "homepage": "",
          "overview": "Świat licealistki Ai zaczyna się walić, gdy dziwna, sekciarska mentalność stopniowo zamienia ludzi w bezmyślnych wyznawców, którzy potrafią zamienić proste ćwiczenia gimnastyczne w koszmarny taniec śmierci.",
          "runtime": 82,
          "tagline": "",
          "title": "New Group"
        }
