      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Meenu látszólag hétköznapi fiatal nő, aki fogyatékkal élő édesapja mellett éli az életét, miközben a harcművészetekben szerzett tudása belső tartást és erőt ad neki. Amikor egy erőszakos, kiszámíthatatlan férfi fenyegetése váratlanul szétzilálja a világát, Meenu eltűnése és a körülötte kibontakozó nyomozás egyre sötétebb titkokhoz vezet. A rettegés, a kiszolgáltatottság és a társadalmi ítélkezés közepette a fiatal nőnek nemcsak túl kell élnie, hanem szembe kell néznie azokkal a döntésekkel is, amelyek meghatározzák, milyen jövőt tud kiharcolni magának.",
          "runtime": 0,
          "tagline": "",
          "title": "Thudakkam"
        }
      }
