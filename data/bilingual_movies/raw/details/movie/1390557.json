      {
        "iso_3166_1": "MY",
        "iso_639_1": "ms",
        "name": "Bahasa melayu",
        "english_name": "Malay",
        "data": {
          "homepage": "",
          "overview": "Setelah berjaya mengetuai timnya untuk menyelesaikan kes penipuan besar, ketua Persatuan Anti-Penipuan, Zeng Miao Zhu, menemui satu konspirasi yang lebih besar tersembunyi dalam kegelapan. Beliau kemudian menugaskan ahli-ahli elit Lam, Arrow, Big Mouth, dan Ba Jie untuk menyusup ke dalam permainan wang yang dikawal oleh Tang Gang. Misi mereka adalah menjadi jurucakap projek itu, dengan cepat menarik aliran dana yang besar sambil mengumpulkan bukti aktiviti jenayah. Namun, setelah Tang Gang meraih keuntungan yang sangat besar, rancangan itu mengalami perubahan yang tiba-tiba.",
          "runtime": 0,
          "tagline": "",
          "title": "Money Game$"
        }
