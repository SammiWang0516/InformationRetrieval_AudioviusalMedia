  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Vivian Vera is a multi-awarded journalist with a dark past. She sensationalized some of her breaking news for her ambition. Her distortion of the truth ruined lives, and these lives have begun to haunt Vivian – they want her to join them... or else they will kill everyone around her who helped her in the lie.",
          "runtime": 107,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Vivian Vera is een meermaals bekroonde journaliste met een duister verleden. Ze sensationaliseerde een deel van haar laatste nieuws vanwege haar ambitie. Haar verdraaiing van de waarheid heeft levens geruïneerd, en deze levens beginnen Vivian te achtervolgen - ze willen dat ze zich bij hen voegt... of anders zullen ze iedereen om haar heen vermoorden die haar in de leugen heeft geholpen.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "身為記者的Vivian一直受到公眾關注，她報導的手法及內容使她成為全國最具影響力人物之一。然而，她的成功其實是建立在謊言和操控之上，因此毀掉了許多人的生活。隨著Vivian的過去被逐一揭發，她不止面臨可怕的後果，因為她欺騙公眾的真相被揭露，亦逐漸威脅她的生活及事業…",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ชื่อเสียงและความก้าวหน้าที่ได้มาอย่างไม่ชอบธรรมของนักข่าวไร้หัวใจ ตามมาหลอกหลอนให้เธอต้องเผชิญผลกรรมที่ก่อไว้และผู้คนที่เธอเคยเหยียบย่ำเป็นบันไดสู่ความสำเร็จ",
          "runtime": 0,
          "tagline": "",
          "title": "ซ่อนเร้น"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Hành trình nổi tiếng bất chính của một nhà báo tàn nhẫn quay lại ám ảnh cô khi cô đối mặt với sự thật về những gì mình đã gây ra và những người cô từng làm tổn thương để tiến xa.",
          "runtime": 0,
          "tagline": "",
          "title": "Điều Chưa Kể"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在菲律宾社会某个被忽视的角落，或者在一个看似平静的家庭内部，埋藏着一段从未被公开的真相。电影聚焦于那些被刻意遗忘或被迫保持沉默的人们。随着一个意外事件的发生，那些“未被讲述”的往事开始像伤口一样被层层揭开。这不仅是一场对真相的追寻，更是一次关于痛苦、宽恕以及面对过去勇气的深度探讨。",
          "runtime": 108,
          "tagline": "",
          "title": "后日不语"
        }
      }
    ]
  },
