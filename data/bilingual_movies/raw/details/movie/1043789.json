        "data": {
          "homepage": "http://kroldopalaczyfilm.pl",
          "overview": "Inspirowana prawdziwymi wydarzeniami historia zawrotnej kariery zwykłego chłopaka, który zbudował imperium legalnych narkotyków i z dnia na dzień został milionerem.",
          "runtime": 117,
          "tagline": "Chcesz więcej?",
