        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "เรื่องราวเกิดขึ้นในเหมืองต้องคำสาป ทหารญี่ปุ่นและเชลยศึกถูกขังอยู่ด้วยกัน เมื่อความตึงเครียดระหว่างศัตรูใกล้ถึงจุดแตกหัก พวกเขาจึงถูกบีบบังคับให้เผชิญหน้ากับสัตว์ประหลาดโบราณสุดสยองที่ซ่อนตัวอยู่ในเงามืด",
          "runtime": 0,
          "tagline": "",
