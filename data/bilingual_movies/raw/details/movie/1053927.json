      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Elias é um jovem cientista que se apaixona por Anita, uma aspirante a cantora. Mas quando surge a oportunidade de participar de uma missão para investigar uma misteriosa fissura no fundo do oceano, ele escolhe a carreira em vez do amor.",
          "runtime": 0,
          "tagline": "",
          "title": "Universo Paralelo"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Молодой ученый-климатолог Элиас влюбляется в начинающую певицу Аниту. Но когда у него появляется возможность присоединиться к миссии по исследованию загадочной трещины на дне океана, он предпочитает карьеру любви. Спустя годы, во время своей миссии, Элиас видит видение того, какой могла бы быть его жизнь, если бы он сделал другой выбор. Новой навязчивой идеей Элиаса становится возвращение прежней жизни и любви.",
          "runtime": 0,
          "tagline": "",
          "title": "Навсегда"
        }
