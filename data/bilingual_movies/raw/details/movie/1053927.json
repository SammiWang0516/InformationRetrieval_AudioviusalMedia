  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Young climate change scientist, Elias falls in love with an aspiring singer, Anita. But when an opportunity arises for him to join a mission researching a dangerous climate change phenomenon – a mysterious fracture on the ocean floor – he chooses career over love. Years later, during his mission, he experiences a vision of what his life could have been like if he made a different choice and his new obsession becomes to get his old life and love back.",
          "runtime": 99,
          "tagline": "He wanted to find the answer but lost himself.",
          "title": "Eternal"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "De jonge klimaatveranderingswetenschapper Elias wordt verliefd op een aspirant-zangeres, Anita. Maar wanneer zich de kans voordoet om deel te nemen aan een missie die onderzoek doet naar een gevaarlijk fenomeen van klimaatverandering – een mysterieuze breuk op de oceaanbodem – kiest hij carrière boven liefde. Jaren later, tijdens zijn missie, ervaart hij een visie van hoe zijn leven eruit had kunnen zien als hij een andere keuze had gemaakt en zijn nieuwe obsessie wordt om zijn oude leven en liefde terug te krijgen.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "GE",
        "iso_639_1": "ka",
        "name": "ქართული",
        "english_name": "Georgian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
