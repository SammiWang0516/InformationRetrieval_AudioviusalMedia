  "translations": {
    "translations": [
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "日本女孩為撫平喪母之痛，受朋友之邀來到台灣散心。在陌生的台北街頭，邂逅了寂寞的台日混血男孩。即便身處異地，心卻掀起漣漪，彼此撩撥試探，曖昧就此蔓延滋長。",
          "runtime": 108,
          "tagline": "",
          "title": "鼠一般的你"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Still grieving the loss of her mother, Chizumi travels to Taipei at a friend's invitation. There she meets Shingo, aka Sinsin, who has a Japanese father and a Taiwanese mother. By spending time together in Taipei, Chizumi is freed from her feelings of loss.",
          "runtime": 108,
          "tagline": "",
          "title": "Sinsin and the Mouse"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "台日合製作品《SINSIN AND THE MOUSE》是日本導演真壁幸紀改編自吉本芭娜娜同名短篇小説的作品，故事講述甫失去至親的女孩受朋友邀約至台北觀賞演唱會，邂逅了內心同樣感到寂寞憂傷卻難以名狀的男孩，兩人在台北街頭展開一段療傷的過程。",
          "runtime": 0,
          "tagline": "",
          "title": "鼠一般的你"
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://www.culture-pub.jp/sinsinmovie/",
          "overview": "最愛の母を失った主人公「ちづみ」が、旅先の台北で「シンシン」という男性に出逢い、喪失感の中で再生していく―。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "自幼双亲离婚、与母亲相依为命的千澄（岸井雪乃 饰），在母亲病逝后陷入了长达三个月的孤绝状态。为了打破这种沉寂，她受朋友之邀前往台北，在Live House看表演的过程中遇见了中日混血青年辛辛（曾敬骅 饰），两人在陌生的城市地标与日常对话中，通过一本名为《秘密朋友》的绘本产生交集，在丧失感中寻回自我与疗愈。",
          "runtime": 0,
          "tagline": "",
          "title": "鼠一般的你"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "어머니를 잃은 치즈미는 타이페이로 여행을 떠나 신고를 만난다. 신신이라고도 불리는 그는 일본인 아버지와 대만인 어머니로부터 태어났다. 타이페이에서 시간을 보낸 후 치즈미는 상실의 고통에서 자유로워진다.",
          "runtime": 108,
          "tagline": "",
          "title": "신신 앤 더 마우스"
        }
      }
    ]
  },
