  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://pan-europeenne.com/film/mauvaise-pioche-gerard-jugnot/",
          "overview": "​Arrêté par erreur et confondu avec l’homme le plus recherché de France, Serge Martin, paisible retraité, devient la cible des médias. Pris dans un tourbillon sans fin, il va tout tenter pour prouver son innocence et retrouver sa vie... si c’est encore possible !",
          "runtime": 92,
          "tagline": "C'est lui l'homme le plus recherché de France ?",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "​Arrested by mistake and mistaken for France’s most wanted man, Serge Martin, a peaceful retiree, becomes the target of the media. Caught up in a never-ending whirlwind, he’ll do everything he can to prove his innocence and get his life back… if that’s even possible!",
          "runtime": 0,
          "tagline": "Is he the most wanted man in France?",
          "title": "Tough Luck"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Aresztowany przez pomyłkę i wzięty za najbardziej poszukiwanego człowieka Francji, Serge Martin, spokojny emeryt, staje się celem mediów. Wplątany w nieustanny wir wydarzeń, zrobi wszystko, by udowodnić swoją niewinność i odzyskać życie… o ile to w ogóle możliwe!",
          "runtime": 92,
          "tagline": "",
          "title": "Mauvaise pioche"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "退休人士Serge Martin過著平靜生活的，卻被誤認為是法國頭號通緝犯而被錯誤逮捕。他被捲入一場無法控制的媒體風暴中而不得不瘋狂地四處奔波，為要證明自己的清白，以便能重返平靜的生活。",
          "runtime": 0,
          "tagline": "",
          "title": "倒楣鬼"
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Miután véletlenül letartóztatják és Franciaország legkeresettebb emberének nézik, Serge Martin, a békés nyugdíjas a média célpontjává válik. Egy könyörtelen forgószélbe keveredve mindent megtesz, hogy bebizonyítsa ártatlanságát és visszakapja az életét - ha ez egyáltalán lehetséges... (Szarka Károly)",
          "runtime": 0,
          "tagline": "",
          "title": "Balszerencse akcióban"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Серж Мартен — обычный пенсионер, ведущий тихую и спокойную жизнь. Но однажды его по ошибке принимают за самого разыскиваемого преступника Франции. Мгновенно он становится главной мишенью СМИ, а его лицо — символом национального скандала. Серж оказывается в центре абсурдной охоты, где каждый его шаг превращается в новое испытание. Теперь ему предстоит доказать свою невиновность и вернуть себе право на нормальную жизнь… если это вообще возможно.",
          "runtime": 0,
          "tagline": "",
          "title": "Не на того напали"
        }
      },
