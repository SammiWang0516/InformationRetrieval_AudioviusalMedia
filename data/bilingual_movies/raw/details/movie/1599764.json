      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "鲍比驾车往返于连接维也纳与萨尔茨堡的高速公路上，为省油钱常让陌生人搭车，沿途与他们闲聊。谈话内容围绕着工作、家庭、移民展开；每位新乘客的故事也折射出鲍比人生的更多侧面。当窗外山川森林风驰电掣般掠过，一幅静水流深的当代欧洲政治图景徐徐浮现——既非虚构，亦非完整纪实。",
          "runtime": 0,
          "tagline": "",
          "title": "伦敦和其他时间"
        }
      },
