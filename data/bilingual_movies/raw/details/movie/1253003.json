        "data": {
          "homepage": "",
          "overview": "ack w średnim wieku, aresztowany za narkotyki, w ciągu sześciu tygodni stara się naprawić swoje małżeństwo, powstrzymać znęcającego się nad nim brata i pokierować swoim przyrodnim bratem na właściwą drogę, ale wszystkie wysiłki idą na marne, a jego życie coraz bardziej wymyka się spod kontroli.",
          "runtime": 96,
          "tagline": "",
          "title": "Marching Powder"
        }
      },
