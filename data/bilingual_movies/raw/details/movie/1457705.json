    "translations": [
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Während eines Urlaubs in den österreichischen Alpen gerät die langjährige Freundschaft zweier Ehepaare völlig außer Kontrolle, als ein Unfall ihrer Teenager-Töchter sie in ein herzzerreißendes moralisches Dilemma stürzt",
          "runtime": 103,
          "tagline": "",
          "title": "Our Girls"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A near-fatal accident involving their teen daughters upends the lives of two families as they consider how far they're willing to go to save their child.",
          "runtime": 103,
          "tagline": "Necessity knows no law, especially when it concerns your child. Right?",
          "title": "Our Girls"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Twee bevriende stellen delen al jaren een vakantiehuis in de Oostenrijkse Alpen. Wanneer hun puberdochters tijdens een gezamenlijke vakantie betrokken raken bij een ongeluk, brokkelt de ogenschijnlijke vriendschap tussen de ouders in rap tempo af. Oud zeer en opgekropte frustraties drijven de ouders steeds verder uit elkaar als ze horen dat één dochter kan worden gered, maar alleen als het andere meisje wordt opgegeven.  Wat begint als een moreel dilemma, ontaardt in een absurde strijd vol manipulaties en wanhopige acties waarbij de grenzen van fatsoen steeds verder vervagen.",
          "runtime": 103,
          "tagline": "",
          "title": "Voor De Meisjes"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Przez lata dwie pary dzieliły idealny dom wakacyjny w Alpach i cieszyły się swoim towarzystwem każdego lata. Jednak gdy ich nastoletnie córki biorą udział w szokującym wypadku, ich wieloletnia przyjaźń zostaje wystawiona na nową, niewyobrażalną próbę. Kiedy każda z par stara się odkryć prawdę i uratować własną córkę, długo skrywane napięcia i niewygodne prawdy wybuchają, zmuszając ich do porzucenia wszelkich pozorów przyzwoitości i zakwestionowania wszystkich pewników jako małżonków, rodziców i przyjaciół. Czy w kwestii ratowania swojego dziecka istnieje granica, której nie przekroczyłbyś, czy też wszystko jest dozwolone?",
          "runtime": 103,
          "tagline": "",
          "title": "Dziewczęta"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "多年来，两对夫妇共享阿尔卑斯山一间完美的度假屋，每年夏天共度美好时光。然而，当她们正值青春期的女儿卷入一场惨烈意外，这份绵延多年的情谊面临一场前所未有、无法想象的严峻考验。为了拼凑真相、拯救各自的孩子，两家人不得不直面积压已久的紧张关系和令人不安的真相，所有体面的伪装被彻底剥离，他们开始动摇自己作为夫妻、父母与朋友曾坚信不疑的一切。当涉及到拯救自己的孩子时，是否还有底线是不可逾越的，还是真的可以不择手段？",
          "runtime": 0,
          "tagline": "",
          "title": "女孩们"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
