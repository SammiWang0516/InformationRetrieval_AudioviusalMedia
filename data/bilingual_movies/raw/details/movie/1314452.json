        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Після смерті матері Еліс повертається до будинку дитинства, де приховані камери фіксують кожен крок. Невідомий спостерігач веде її до розкриття похмурої таємниці минулого.",
          "runtime": 0,
          "tagline": "",
          "title": "Інший"
