      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Saqr, ein legendärer Söldner, beschließt, sein gefährliches Doppelleben hinter sich zu lassen und einen Neuanfang zu wagen. Doch eine unerwartete Begegnung mit Bilal, einem gescheiterten Schriftsteller, der von der Welt der Spionage besessen ist, stellt seine Pläne auf den Kopf. Das ungleiche Duo gerät in ein spannendes und zugleich urkomisches Abenteuer, das alles verändert – wie nichts, was sie bisher erlebt haben.",
          "runtime": 120,
          "tagline": "",
          "title": "Sakr w Canaria"
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "تدور احداث الفيلم حين يقرر (صقر)، المرتزق المحترف، التخلي عن حياته المزدوجة المليئة بالمخاطر والبدء من جديد. لكن خططه تتعثر عندما يلتقي بـ(بلال)، الشهير بلقب \"كناريا\"، وهو كاتب فاشل ومهووس بعالم الجواسيس والعمليات السرية. وسرعان ما يجد الاثنان نفسيهما وسط سلسلة من الأحداث والمغامرات غير المتوقعة، في رحلة حافلة بالإثارة والمفاجآت ستغير مجرى حياتهما إلى الأبد.",
          "runtime": 0,
          "tagline": "",
          "title": "صقر وكناريا"
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Efsanevi paralı asker Sakar, tehlikeli çifte hayatını geride bırakıp yeni bir başlangıç yapmaya karar verir. Ancak casusluk dünyasına takıntılı, başarısız bir yazar olan Bilal’le beklenmedik bir şekilde karşılaşması, tüm planlarını altüst eder. Bu beklenmedik ikili, hayatlarında daha önce hiç yaşamadıkları kadar heyecanlı ve komik bir maceranın içine sürüklenir.",
          "runtime": 125,
          "tagline": "",
          "title": "Şahin ve Kanarya"
        }
      }
    ]
