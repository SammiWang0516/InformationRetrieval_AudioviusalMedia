      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "ONE OK ROCK DETOX JAPAN TOUR 2025 AT NISSAN STADIUM IN CINEMAS revela a essência de uma noite que definiu a carreira da banda — documentando o plano avassalador do icónico Estádio Nissan do Japão — onde riffs estrondosos, vozes poderosas e 70.000 vozes se fundem em algo eletrizante, forjando um laço inquebrável entre a banda e a sua legião mundial de fãs.",
          "runtime": 0,
