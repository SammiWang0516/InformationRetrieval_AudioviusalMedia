      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "외모와 지성을 겸비해 ′왕자′라 불리지만, 이성보다는 동성에게 ′멋진 남자′ 취급을 받는 현실에 복잡한 속내를 안고 살아가는 여고생 요이. 그녀의 앞에 또 다른 ′왕자′이자 화려한 존재감의 선배 코하쿠가 나타난다. 가벼워 보이는 인상과 달리 직진으로 마음을 전해오는 코하쿠의 애정 공세에 두 사람은 마침내 연애를 시작한다.",
          "runtime": 119,
          "tagline": "사랑 같은 거 난 알고 싶지 않아",
          "title": "아름다운 초저녁달"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "瀧口宵是一位容貌俊美、舉止瀟灑帥氣的女孩，由於宛如漫畫中的王子，而被同學們稱為「王子」。不過，在完美形象背後，宵始終對自己無法被當成一般女生看待而感到糾結，甚至早早就放棄了戀愛的念頭。直到某天，她遇見了同樣被稱為「王子」的市村琥珀……這場讓兩顆心逐漸靠近的相遇，將為兩人帶來什麼樣的悸動與改變？",
          "runtime": 0,
          "tagline": "",
          "title": "皎潔深宵之月"
