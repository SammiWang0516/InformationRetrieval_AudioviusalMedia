  "translations": {
    "translations": [
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Iván se enamora de Hadoum en el invernadero donde trabajan. Sin embargo, su anhelado ascenso laboral interfiere en la relación, obligándole a decidir qué tipo de hombre quiere ser.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Iván (33), a trans man, and Hadoum (30), a Spanish-Moroccan woman, fall in love at the industrial greenhouse they work in. While facing the opposition from their families and co-workers, Iván realizes he doesn’t need to be the man he is expected to be.",
          "runtime": 100,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "In einer Gewächshausanlage in Südspanien verliebt sich Iván in seine neue Kollegin Hadoum. Doch eine langersehnte Beförderung stellt ihre Beziehung vor Herausforderungen und Iván muss sich darüber klar werden, was für ein Mensch er sein will.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Iván zakochuje się w Hadoum, nowej koleżance, w szklarni w Almerii, gdzie oboje pracują. Jednak jego długo oczekiwany awans zakłóci ich związek, zmuszając go do podjęcia decyzji, jakim człowiekiem chce być.",
          "runtime": 101,
          "tagline": "",
          "title": "Iván & Hadoum"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "Іван і Хадум"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Иван (33 года), трансгендерный мужчина, и Хадум (30 лет), испано-марокканская женщина, влюбляются друг в друга на работе в промышленной теплице. Столкнувшись с неприятием со стороны своих семей и коллег, Иван понимает, что ему не нужно быть таким, каким от него ожидают.",
          "runtime": 0,
          "tagline": "",
          "title": "Иван и Хадум"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Dans une serre industrielle à Almería, en Espagne. Iván tombe amoureux de sa collègue Hadoum, une jeune femme hispano-marocaine. Cette relation remet en question la promotion professionnelle souhaitée par Iván.",
          "runtime": 103,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "果園工廠無新事。Iván 雖是工廠老闆世侄，仍要滿足家庭與社會對男性的期望而終日營營役役。直到新入職女工 Hadoum 的出現，他那安穩踏實的糊口生活大計則瞬間被二人無法壓抑的激情沖潰。敢作敢為的 Hadoum 組織工廠女工要求改善工作條件，身為準管理層的 Iván 要在麵包與真愛之間取捨，而兩者偏偏同樣關係到他作為年輕跨性別男性的身份認同。  西班牙跨性別導演 Ian de la Rosa 十年前憑短片《Victor XX》於康城嶄露頭角，首部劇情長片即奪得柏林泰迪熊獎殊榮。",
          "runtime": 0,
          "tagline": "",
          "title": "伊凡不平凡"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "西班牙南方小鎮，伊凡靠著溫室工作安穩度日，酷兒身分看似被認同，生活中歧視卻如影隨形。直到舊識荷朵以新同事之姿出現，兩人迅速墜入愛河，他才第一次覺得被完整接納，不料現實考驗接踵而來。為了撐持家中經濟，想升職的伊凡不得不向資方投誠，而荷朵和女工們醞釀的勞權運動卻迅速升溫。夾在社會有色眼鏡、勞資對立、家人期待與心中所愛的縫隙之間，伊凡該如何活出自己？",
          "runtime": 0,
          "tagline": "",
          "title": "跨出溫室的愛戀"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Nos vastos campos de estufas de tomates do sul da Espanha, Iván, um homem trans, apaixona-se por Hadoum, sua nova colega de origem marroquina. Mas, quando Iván recebe a promoção que esperava e se torna seu supervisor, a paixão entra em choque com o poder, a classe e o preconceito. Dividido entre a ambição e a solidariedade, Iván precisa decidir que tipo de homem deseja ser — e o que está disposto a sacrificar.",
          "runtime": 100,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "알메리아의 광활한 온실 지대에서 트랜스 남성 이반과 이주노동자 하둠 사이에 뜻밖의 사랑이 싹튼다. 하지만 이반이 오랫동안 바라온 승진을 이루고 하둠의 상사가 되면서, 두 사람의 관계는 사랑과 권력, 계급과 편견 사이에서 흔들리기 시작한다.",
          "runtime": 103,
          "tagline": "",
          "title": "이반 앤 하둠"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "ca",
        "name": "Català",
        "english_name": "Catalan",
        "data": {
          "homepage": "",
          "overview": "Iván s'enamora de Hadoum a l'hivernacle on treballen. Tot i això, el seu anhelat ascens laboral interfereix en la relació, obligant-lo a decidir quin tipus d'home vol ser.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
