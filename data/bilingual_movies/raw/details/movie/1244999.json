      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Dokumentumfilm, amely felfedi egy szuperrajongó mélyen személyes kapcsolatát az ikonikus rapperrel, Eminemmel, bemutatja az előadó munkásságának és személyiségének hatását, valamint a rajongói közösség identitás- és közösségteremtő erejét.",
