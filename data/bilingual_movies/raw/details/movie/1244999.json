        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "„Stans” to poruszający dokument muzyczny, który zagląda w świat najbardziej oddanych fanów Eminema – tytułowych „stanów”. Film analizuje zjawisko ekstremalnej fanowskiej fascynacji, które narodziło się po premierze kultowego utworu „Stan” z 2000 roku, a z czasem stało się częścią języka popkultury.",
          "runtime": 0,
