  "translations": {
    "translations": [
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "\"Zico: O Samurai de Quintino\" investiga a personalidade do craque por seu arquivo inédito, revelando histórias do Flamengo, Seleção e Japão, entre disciplina e legado.",
          "runtime": 101,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The film explores Zico's personality through previously unseen archival footage, revealing stories from his time with Flamengo, the National Team, and in Japan—balancing discipline and legacy.",
          "runtime": 101,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "ジョアン・ワイネル監督がサッカー界のレジェンド、ジーコ（アルトゥール・アントゥネス・コインブラ）の人生とキャリアを、未公開の個人アーカイブや家族・著名人の証言を通して描くドキュメンタリー。  人間ジーコに焦点を当てた構成で、日本との深い絆と「侍」の精神を描いており、タイトルの「侍」は、ジーコの決断力、謙虚さ、規律正しさが日本の文化と共鳴したことに由来しています。  1991年にサッカーの伝統がない日本の住友金属（現・鹿島アントラーズ）へ移籍した際の困難や、日本サッカーの基礎を築いた功績を深く掘り下げています。  また、ジーコ自身が長年保管していたスーパー8やVHSなどの個人アーカイブといった貴重なプライベート映像がデジタル化され、初めて公開されます。1981年トヨタカップの決勝で着用した背番号10のユニフォームなど、歴史的な品々も登場します。  ジーコは、自身のキャリアを通じて「連帯（コレクティブ）」や「他者への敬意」という価値観を伝えたいと考えており、ブラジルにおけるサッカーの歴史保存と記憶の継承の重要性についても言及しています。",
          "runtime": 101,
          "tagline": "",
          "title": "ジーコ：キンチーノの侍"
        }
      }
    ]
  },
