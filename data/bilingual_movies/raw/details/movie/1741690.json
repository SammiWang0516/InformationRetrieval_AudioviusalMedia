  "translations": {
    "translations": [
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "야심 많은 미용사 패니는 까다로운 비엔나 궁정에서 살아남아야 한다. 당대의 규율과 도덕을 개의치 않는 그녀의 태도는 황후와 대중으로부터 예상치 못한 관심을 불러 일으킨다.",
          "runtime": 30,
          "tagline": "",
          "title": "패니"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://mildersisters.com/fanny",
          "overview": "The ambitious hairdresser Fanny must survive within the demanding world of the Viennese court. When she pays no mind to the existing rules and moralities of the time, she draws the unexpected attention of the Empress, as well as a public audience.",
          "runtime": 30,
          "tagline": "Fanny is a tragicomic period piece about breaking stereotypes.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "De ambitieuze kapster Fanny moet zien te overleven binnen de veeleisende wereld van het Weense hof. Als ze de geldende moraal en regels aan haar elegante laarsjes lapt, trekt ze tegen alle verwachtingen in de aandacht van de keizerin en de ogen van een groot publiek.",
          "runtime": 30,
          "tagline": "",
          "title": "Fanny"
        }
      }
    ]
  },
