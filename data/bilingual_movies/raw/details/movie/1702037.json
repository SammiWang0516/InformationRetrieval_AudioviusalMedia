  "translations": {
    "translations": [
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Em um Brasil escravocrata de 1830, um jovem africano genial inventa a câmera fotográfica antes dos europeus e usa sua criação para ajudar na libertação de pessoas escravizadas, enquanto tem que lidar com um amor impossível pela filha de um poderoso barão.",
          "runtime": 105,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "1806年，非洲男孩阿马德欧被贩卖至葡萄牙为奴，却在拿破仑战争的炮火中意外重获自由。成年后，他前往南美游历，在船上与少女琳达邂逅，展开了一段《泰坦尼克号》式的浪漫关系。然而，一场海难将他冲上巴西海岸，也将他推入随时可能沦为奴隶的窘境。他被拉入一个“艺术家戏班”，在乔装隐居中将无望的爱化为发明的动力，创造出了史上第一台“照相机”，并以此协助黑人同胞发动解放起义。巴西女演员布伦达·利吉亚初执导筒，与前辈埃杜·费利斯托克携手合作，为这段历史注入了一份独特的细腻与共情。镜头下的琳达并非等待拯救的缪斯，而是对艺术与自由充满热情的理想主义者，她的独立与坚韧成为阿马德欧抗争路上的隐秘共振。影片将目光投向被历史遮蔽的边缘者，证明了当“影像”成为武器，夺回讲述自己故事的权利便成为可能",
          "runtime": 105,
          "tagline": "",
          "title": "阿马德欧与假设的新世界"
        }
      },
