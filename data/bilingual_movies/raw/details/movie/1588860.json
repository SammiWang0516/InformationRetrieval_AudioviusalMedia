        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "想体验VMX Beauty Ashley Lopez的特色服务吗？Ina是一位新来的按摩师，她赢得了首次光顾的顾客Joel的青睐。然而，尽管Joel不懈地追求Ina，Ina却不确定自己能否给他想要的幸福结局。",
          "runtime": 0,
          "tagline": "",
          "title": "浪漫结局"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "마사지 샵에 새로 온 신입 테라피스트 ‘이나’. 서툴지만 정성스러운 그녀의 손길은 고단한 삶에 지쳐있던 고객 ‘조엘’의 몸과 마음을 단번에 사로잡는다. 조엘은 단순한 마사지 이상의 ‘특별한 서비스’를 기대하며 끈질기게 그녀를 유혹하고, 이나의 일상 속으로 거침없이 파고든다. ‘조엘’이 그토록 갈구하는 로맨틱한 해피엔딩이 과연 자신에게도 허락된 결말일까? 침묵이 흐르는 마사지 룸 안, 두 사람의 아슬아슬한 밀당이 시작된다.",
          "runtime": 0,
          "tagline": "당신이 원하는 결말, 내가 줄 수 있는 걸까?",
          "title": "특별한 마사지 서비스"
        }
      }
    ]
