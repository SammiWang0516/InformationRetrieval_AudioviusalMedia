      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Miután lányuk eltűnt egy elmegyógyintézetből, Devonék öt felfedezőt bíznak meg, hogy vizsgálják meg az elhagyatott helyszínt, nem is sejtve, milyen baljós utazás és félelmetes élmény vár rájuk.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在女儿德文神秘失踪后，她的父母从未停止追寻真相。随着她失踪的精神病院被废弃，所有疑问似乎都将永远没有答案。多年后，一个神秘网站招募了五名勇敢者，前往这座荒废的病院，揭开当年女孩失踪的谜团。毫不知情的他们正踏上一条凶险且无法回头的道路。带着装备深入那片诡秘的黑暗，他们即将面对的是一场令人毛骨悚然、致命无比的恐怖经历。",
          "runtime": 0,
          "tagline": "",
          "title": "失踪女孩"
        }
      }
