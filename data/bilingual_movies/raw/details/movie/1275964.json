        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "A kiegyensúlyozott Katie és a társfüggő Delaney gyerekkoruk óta elválaszthatatlan jóbarátok. Katie-nek egy nap a barátja megkéri a kezét, ezért egy hétvégi kiruccanáson mondja el a nagy hírt barátnőjének, ám ezután elszabadulnak az események.",
          "runtime": 0,
          "tagline": "",
          "title": "A legjobb barinőm férjhez megy"
        }
      },
      {
        "iso_3166_1": "RO",
