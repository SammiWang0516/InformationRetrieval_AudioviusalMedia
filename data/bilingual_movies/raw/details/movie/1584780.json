      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Van zijn begin bij Saturday Night Live tot een reeks klassieke komedies, Chevy Chase heeft altijd een enorm komisch talent gehad. Hij is echter ook een complex en tegenstrijdig mens. Deze documentaire, met onthullende interviews met mensen die hem het dichtst bij staan, duikt in het talent, de tekortkomingen en de menselijkheid die van dit icoon hebben gemaakt.",
          "runtime": 0,
          "tagline": "",
          "title": "I’m Chevy Chase and You’re Not"
        }
