        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "סרט תיעודי מעורר מחשבה על עלייתו, תהילתו ושקיעתו של אחד הקומיקאים המשפיעים והשנויים ביותר במחלוקת של הוליווד – צ'בי צ'ייס. זהו דיוקן כנה של אייקון תרבותי, החושף את הפער בין הדימוי הקומי לבין האדם שמאחוריו, ובודק מה בסוף נשאר אחרי שהצחוק דועך.",
          "runtime": 0,
          "tagline": "",
          "title": "אני צ'בי צ'ייס ואתם לא"
        }
