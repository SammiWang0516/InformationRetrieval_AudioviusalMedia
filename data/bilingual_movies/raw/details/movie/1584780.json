      {
        "iso_3166_1": "SE",
        "iso_639_1": "sv",
        "name": "svenska",
        "english_name": "Swedish",
        "data": {
          "homepage": "",
          "overview": "Komedilegenden Chevy Chase var en av originalstjärnorna i det amerikanska sketchprogrammet Saturday Night Live, och har haft en lång och inflytelserik Hollywoodkarriär som präglat amerikansk humor i flera decennier. Samtidigt är han känd för sin vassa tunga, sitt oförsonliga temperament och hur han bränt alla broar i sikte. Vänner och familj beskriver honom som varm, klok och rolig - kritiker som en hänsynslös mobbare som slösat bort sin talang. Bilden som växer fram är en motsägelsefull människa med både briljans och brister i överflöd - det perfekta subjektet för en dokumentär.",
          "runtime": 98,
          "tagline": "",
          "title": ""
        }
