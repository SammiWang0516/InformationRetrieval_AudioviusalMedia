        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Dziewięciu, unikalnych na swój sposób przestępców, dowiaduje się, że jeden z nich został aresztowany. Jest tylko jedno wyjaśnienie: w ich szeregach pojawił się zdrajca. Pakt grupy wisi na włosku. Muszą zdemaskować wtykę, zanim pociągnie ich wszystkich, jednego po drugim, na dno. Ale niebezpieczeństwo nie zawsze czyha tam, gdzie się go spodziewamy.",
          "runtime": 0,
          "tagline": "",
          "title": "Zdrajca"
