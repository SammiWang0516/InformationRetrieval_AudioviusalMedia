        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Khi phát triển trò chơi kinh dị, Húc Xuyên vô tình mang con búp bê đất sét bị vỡ từ chỗ làm về nhà, không hay biết rằng nó chứa một linh hồn oán hận đang khao khát được giải thoát.",
          "runtime": 0,
          "tagline": "",
          "title": "Oán Thai Đòi Mẹ"
