      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "泥娃娃，泥娃娃，一个泥娃娃⋯⋯\r 童谣的背后，隐藏著神秘惊悚的故事。在游戏公司工作的旭川，为开发一项新的恐怖VR游戏，意外将一尊来自凶宅现场的残破泥娃娃带回家，没想到怀有身孕、身为文物修护师的妻子慕华对其产生异常执念，不断进行修复。随著家中怪事频传，慕华状态也越来越虚弱，旭川无计可施，辗转求助通灵驱魔人阿生，而泥娃娃背后深埋的骇人祕密，也随之浮出水面⋯⋯",
          "runtime": 0,
          "tagline": "",
          "title": "泥娃娃"
        }
      },
      {
        "iso_3166_1": "DE",
