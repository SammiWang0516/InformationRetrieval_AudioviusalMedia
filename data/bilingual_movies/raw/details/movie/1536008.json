      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ชายคนหนึ่งที่ตัดสินใจรับสืบทอดวิชาหมอผีลึกลับผู้แก่กล้าด้วยวิชาโหงพรายเพื่อล้างแค้นส่วนตัว ก่อนจะได้พบบทเรียนสำคัญ… เมื่อความกระหายแค้น กำลังจะทำให้เขาห่างไกลจากคำว่ามนุษย์โดยสิ้นเชิง",
          "runtime": 0,
          "tagline": "คำสารภาพของหมอผีที่ยังไม่ถูกเล่า",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A man who decides to inherit the art of shamanism to exact personal revenge, leading to a series of terrifying events that change his life forever.",
          "runtime": 126,
          "tagline": "The confession that has never been revealed.",
          "title": "Confessions of a Shaman"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "Gọi hồn âm binh rước quỷ về nhà.",
          "title": "Tà Sư Sám Hối"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "托爾的家庭非常不幸，母親過世、父親負債累累又酗酒，叔叔則是愛好暴力的惡霸。托爾深信母親的死是父親和叔叔造成的，為了向他們復仇，他向當地的薩滿蒂安尋求協助。蒂安答應幫助托爾，但條件是他必須成為下一任的薩滿。托爾答應之後不久，父親跟叔叔相繼意外身亡。然而，托爾的決定也為他招來了一連串恐怖事件……",
          "runtime": 0,
          "tagline": "",
          "title": "薩滿的最後告解"
        }
      }
