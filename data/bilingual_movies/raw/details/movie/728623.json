        "data": {
          "homepage": "https://epic-pictures.com/film/dont-log-off",
          "overview": "When Sam vanishes mid-video call, her friends race to uncover what happened. As they dig online, they vanish one by one. A sinister force is at play - can they solve the mystery before they're next?",
          "runtime": 95,
          "tagline": "Terror has entered the chat.",
