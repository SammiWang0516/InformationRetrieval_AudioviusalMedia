    "translations": [
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Nos contará la historia de Toñi, una abuela excéntrica que sobrevive como puede entre negocios ruinosos y una actitud despreocupada ante la vida. Su hija Daniela, ejecutiva estresada y madre soltera, quiere mantenerla lejos. Pero la pequeña Alexia, hija de Daniela, ve en su abuela a su persona favorita en el mundo.",
          "runtime": 87,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Toñi, an eccentric grandmother, gets by between failed businesses and a carefree attitude. Her daughter Daniela, a stressed executive and single mom, wants to keep her away.",
          "runtime": 87,
          "tagline": "",
          "title": "My Amazing Grandma"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "托妮是一位行事古怪的祖母，靠着一次次失败的生意和无忧无虑的心态勉强度日。她的女儿丹妮拉是个压力重重的企业主管，同时也是一位单亲妈妈，一心想让母亲离自己远点。",
          "runtime": 87,
          "tagline": "",
          "title": "了不起的祖母"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Het vertelt het verhaal van Toñi, een excentrieke grootmoeder die de eindjes aan elkaar knoopt met mislukte bedrijven en een zorgeloze levenshouding. Haar dochter Daniela, een gestreste manager en alleenstaande moeder, wil haar het liefst op afstand houden. Maar de kleine Alexia, Daniela's dochter, ziet haar grootmoeder als haar allerliefste persoon.",
          "runtime": 87,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "ca",
        "name": "Català",
        "english_name": "Catalan",
        "data": {
          "homepage": "",
          "overview": "Ens explicarà la història de la Toñi, una àvia excèntrica que sobreviu com pot entre negocis ruïnosos i una actitud despreocupada davant de la vida. La seva filla Daniela, executiva estressada i mare soltera, vol mantenir-la lluny. Però la petita Alexia, filla de la Daniela, veu en l'àvia la persona favorita al món.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Una abuela de espíritu libre, que siempre saca de quicio a su hija, convierte la escapada rural de su nieta en una aventura divertida al irrumpir allí con una autocaravana.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Excentrická babička Toña prochází životem s bezstarostným přístupem a řadou neúspěšných podnikatelských pokusů. Její dcera Daniela je vystresovaná manažerka a svobodná matka, která se snaží držet svou divokou matku co nejdále od rodiny. Naopak vnučka Alexia svou babičku zbožňuje.",
          "runtime": 0,
          "tagline": "",
          "title": "Naše divoká babička"
