  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Second Lieutenant and India's youngest Param Vir Chakra recipient, Arun Khetarpal, gave his life fighting for his battalion and the country during the 1971 Battle of Basantar. Ikkis also takes a reflective look at the futility of war through the eyes of Khetarpal's father, who visits his ancestral home in Sargodha and Alma Mater for reunion, which now happens to be in post-partition Pakistan, 30 years later.",
          "runtime": 148,
          "tagline": "He was 21, will remain as that.",
          "title": "Ikkis"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Фильм рассказывает о короткой, но яркой жизни офицера Аруна Кетапала, павшего в битве при Басантаре в ходе индо-пакистанской войны 1971 года. Параллельно разворачивается история его отца, который спустя 30 лет отправляется в Пакистан, чтобы пройти по следам сына. Картина соткана из воспоминаний: военные будни, юношеская любовь и последний бой с превосходящими силами противника. Прошлое и настоящее сходятся воедино, чтобы сохранить память о подвиге.",
          "runtime": 0,
          "tagline": "",
          "title": "Двадцать один"
        }
      },
      {
        "iso_3166_1": "IN",
        "iso_639_1": "hi",
