      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Biopic über Arun Khetarpal, der 1971 im dritten Indisch-Pakistanischen Krieg zum erfolgreichsten Panzerkommandanten der indischen Armee wurde.",
          "runtime": 144,
          "tagline": "",
          "title": "Ikkis"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "於 1971 年印巴戰爭的烽火之中，年輕士兵阿倫・凱特拉帕爾置身於歷史中的嚴峻考驗——坦克隆隆前進，局勢一觸即發；而他的英勇無畏，鑄就成一段不朽的傳奇。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
