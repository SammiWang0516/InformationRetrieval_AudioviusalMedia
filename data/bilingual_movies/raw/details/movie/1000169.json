    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Denis Mukwege, médecin congolais et futur Prix Nobel de la paix, soigne — au péril de sa vie — des milliers de femmes victimes de violences sexuelles en République démocratique du Congo. Sa rencontre avec Guy Cadière, chirurgien belge, va redonner un souffle à son engagement.",
          "runtime": 105,
          "tagline": "Certains combats peuvent changer le cours de l’histoire.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Denis Mukwege, a Congolese doctor, pastor and future Nobel Peace Prize laureate, meets Guy Cadière, a Belgian surgeon and atheist. Despite their differences, they unite for a common purpose: to restore the bodies and dignity of thousands of women who have been used as weapons of war in the eastern Democratic Republic of Congo.",
          "runtime": 110,
          "tagline": "The one who heals.",
          "title": "Muganga"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Denis Mukwege, kongijski lekarz, pastor i przyszły laureat Pokojowej Nagrody Nobla, spotyka Guya Cadière, belgijskiego chirurga i ateistę. Pomimo różnic, łączy ich wspólna misja: przywrócenie ciał i godności tysiącom kobiet, które stały się bronią wojenną we wschodniej części Demokratycznej Republiki Konga.",
          "runtime": 105,
          "tagline": "",
          "title": "Muganga - Celui qui soigne"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Mukwege, médico congoleño y futuro Premio Nobel de la Paz, arriesga su vida para atender a miles de mujeres víctimas de violencia sexual en la República Democrática del Congo. Su encuentro con el cirujano belga Guy Cadière fortalecerá su compromiso.",
          "runtime": 105,
          "tagline": "",
          "title": "Muganga: El sanador"
        }
      }
