  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "http://www.mattersmedia.com/films/",
          "overview": "After the 9/11 attacks, after the smoke was gone, after the rubble cleared away, New Yorkers had a city to rebuild. In response to fast-tracked redevelopment plans, more than 5,000 people gathered in the largest town hall in American history. They came to vote on the city’s six proposals for rebuilding Ground Zero. But instead, the people rejected the top down approach and successfully charted a new path forward. Their work determined what is at Ground Zero today. And their story is an example of what democracy can look like.",
          "runtime": 72,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "9·11 테러 이후, 연기가 걷히고 잔해가 치워지자 뉴욕 시민들은 도시 재건이라는 거대한 과제를 마주하게 되었다. 이때 가장 근본적인 문제는 바로 그라운드 제로의 미래에 대해 그 누구도 합의할 수 없었다는 점이었다. 어떤 이들은 무너진 쌍둥이 빌딩을 예전 모습 그래도 복원하길 원했고, 다른 이들은 그 곳을 희생자들을 기리는 신성한 추모의 공간으로 남겨야 한다고 믿었다. 그러던 중, 모든 것을 바꿔놓는 하나의 사건이 일어난다.",
          "runtime": 67,
          "tagline": "",
          "title": "9/11: 그라운드 제로를 되찾다"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "El 11 de septiembre de 2001, cerca de tres mil personas perdieron la vida en el atentado terrorista más devastador de la historia de Estados Unidos. Cuando el humo se disipó y los escombros fueron retirados, Nueva York afrontó la inmensa tarea de reconstruirse.",
          "runtime": 0,
          "tagline": "",
          "title": "11-S, recuperando la Zona Cero"
        }
      }
    ]
