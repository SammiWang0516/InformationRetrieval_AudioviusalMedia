    "translations": [
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Katharina, Ricky, Victoria und Malou leben gemeinsam in einer betreuten Wohngruppe – und haben sich dort ihr eigenes System geschaffen. Ohne Hierarchien, ohne Regeln, als bewusste Abgrenzung zu den Strukturen, die sie hinter sich lassen wollten: Familie, Schule, gesellschaftliche Erwartungen. Sozialarbeiter Ballack behält die Gruppe nur lose im Blick, was ihre selbstgewählte Ordnung zunächst möglich macht. Doch als individuelle Bedürfnisse, Konflikte und Grenzen aufeinandertreffen, gerät das fragile Gleichgewicht ins Wanken – und mit ihm das Ideal vom freien Zusammenleben.",
          "runtime": 108,
          "tagline": "Wild, mitreißend und mit einer Prise schwarzem Humor – vier Jugendliche, die der Welt den Kampf ansagen.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Katharina, Ricky, Victoria and Malou live in an assisted living group. There they have built up an anarchic utopia as an alternative to everything they reject: Parents, school, rules. With social worker Ballack as a half-hearted guardian, things go well until their “live and let live” agreement starts to falter.",
          "runtime": 108,
          "tagline": "",
          "title": "Thanks for Nothing"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Katharina, Ricky, Victoria a Malou žijí ve společné domácnosti s asistencí. Vybudovali si tam anarchistickou utopii jako alternativu ke všemu, co odmítají: k rodičům, škole i pravidlům. S vychovatelem Ballackem v roli vlažného dozorce vše funguje dobře, dokud nezačne skřípat jejich dohoda založená na zásadě „žít a nechat žít“.",
          "runtime": 0,
          "tagline": "",
          "title": ""
