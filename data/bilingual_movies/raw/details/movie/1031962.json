  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.whatwehide.com/",
          "overview": "After their mother dies of an overdose, two sisters hide her body to avoid being separated by the foster system, but as their secret threatens to unravel, they must confront the consequences of their desperate choice.",
          "runtime": 102,
          "tagline": "Not all secrets remain buried.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Nadat hun moeder een fatale overdosis heeft gekregen, vrezen twee zussen dat het pleegsysteem hen zal scheiden en besluiten ze het lichaam te verbergen. Maar hun leugen kan worden ontdekt en ze moeten beslissen hoe ver ze bereid zijn te gaan om hun geheim te bewaren.",
          "runtime": 102,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Когда их мать умирает из-за передозировки наркотиками, сёстры Спайдер и Джесси решают спрятать тело и сохранить её смерть в тайне, опасаясь, что их разлучат и распределят в разные приёмные семьи. Наркодилер матери и шериф, друг семьи, пытаются узнать, куда пропала мама, и девочкам предстоит решить, насколько далеко они готовы зайти, чтобы сохранить свою тайну.",
          "runtime": 102,
          "tagline": "",
          "title": "Никто не должен знать"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Después de que su madre sufra una sobredosis mortal, dos hermanas temen que el sistema de acogida las separe y deciden ocultar el cadáver. Pero su mentira puede ser descubierta y deben decidir hasta dónde están dispuestas a llegar para mantener su secreto.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "　　在她们的母亲服药过量后，两姐妹担心寄养系统会将她们分开，决定隐藏尸体。但他们的谎言可能会被发现，他们必须决定愿意在多大程度上保守自己的秘密。",
          "runtime": 0,
          "tagline": "",
          "title": "未葬之罪"
        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Depois de a mãe sofrer uma overdose fatal, duas irmãs temem que o sistema de adoção as separe e decidem esconder o corpo. Mas a mentira pode ser descoberta e elas têm de decidir até onde estão dispostas a ir para manter o segredo.",
          "runtime": 102,
          "tagline": "Nem todos os segredos permanecem enterrados.",
          "title": "What We Hide"
        }
      },
      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Ko njuna mati umre zaradi prevelikega odmerka mamil, se dve sestri bojita, da ju bo rejniški sistem ločil, zato skrijeta truplo. A ko grozi, da bo njuna prevara razkrita, se morata odločiti, kako daleč sta pripravljeni iti, da ohranita svojo skrivnost.",
          "runtime": 0,
          "tagline": "Ne ostanejo vse skrivnosti zakopane.",
          "title": "Spider in Jessie"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "לאחר שאמן מתה ממנת יתר קטלנית, שתי אחיות צעירות חוששות שמערכת האומנה תפריד ביניהן. מתוך פחד לאבד זו את זו, הן מחליטות להסתיר את הגופה. אבל ככל שהזמן עובר, הסוד עלול להתגלות – והן נאלצות להתמודד עם השאלה עד כמה הן מוכנות ללכת רחוק כדי לשמור על הקשר ביניהן ועל הסוד האפל שהן מסתירות.",
          "runtime": 0,
          "tagline": "",
          "title": "מה שאנחנו מסתירים"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Після того, як їхня мати помирає від передозування, дві сестри бояться, що система опіки розлучить їх, і вирішують приховати тіло. Але їхня брехня може розкритися, і тому вони мають вирішити, як далеко готові зайти, щоб зберегти свою таємницю.",
          "runtime": 0,
          "tagline": "",
          "title": "Те, що ми приховуємо"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Sau khi người mẹ qua đời vì dùng thuốc quá liều, hai chị em gái lo sợ sẽ bị hệ thống nuôi dưỡng chia cắt nên quyết định giấu xác. Nhưng lời nói dối ấy có nguy cơ bị phơi bày, và họ buộc phải đối mặt với câu hỏi: sẵn sàng đi bao xa để giữ kín bí mật này?",
          "runtime": 0,
          "tagline": "",
          "title": "Ẩn Giấu"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "După ce mama lor moare din cauza unei supradoze, surorile Spider și Jessie aleg să ascundă trupul pentru a evita separarea în sistemul de plasament. În timp ce încearcă să ducă o viață normală, sunt urmărite de dealerul mamei și de un șerif local care le cunoaște familia.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Après le décès par overdose de leur mère, deux sœurs ne voulant pas être séparées, dissimulent son cadavre. Bientôt un policier, le parrain et l'ex-petit ami de la mère commencent à se poser des questions sur sa disparition.",
          "runtime": 102,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在她們的母親服藥過量後，兩姐妹擔心寄養系統會將她們分開，決定隱藏屍體。但他們的謊言可能會被發現，他們必須決定願意在多大程度上保守自己的秘密。",
          "runtime": 0,
          "tagline": "",
          "title": "未葬之罪"
        }
      },
      {
        "iso_3166_1": "LT",
        "iso_639_1": "lt",
        "name": "Lietuvių",
        "english_name": "Lithuanian",
        "data": {
          "homepage": "",
          "overview": "Po tragiškos motinos mirties nuo perdozavimo dvi seserys baiminasi, kad globos sistema jas išskirs, todėl nusprendžia paslėpti kūną. Tačiau jų melas gali būti atskleistas, ir joms tenka spręsti, kiek toli jos pasirengusios eiti, kad išsaugotų savo paslaptį. Ši įtempta drama atskleidžia sudėtingus seserų santykius, jų desperatišką kovą už išlikimą kartu ir moralines dilemas, su kuriomis susiduria ieškodamos išeities iš beviltiškos situacijos.",
          "runtime": 0,
          "tagline": "",
          "title": "Ką mes slepiame"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Film opowiada o dwóch siostrach, które ukrywają śmierć matki z przedawkowania, by nie trafić do rodziny zastępczej i nie zostać rozdzielone",
          "runtime": 0,
          "tagline": "",
          "title": "Co ukrywamy"
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "بعد وفاة والدتهما بجرعة زائدة، تخفي شقيقتان جثتها كي لا تفرقهما دور الرعاية، لكن مع اقتراب سرهما من الانكشاف، تضطران إلى مواجهة عواقب قرارهما اليائس.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
