      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Een voormalig lid van de speciale eenheden ontdekt dat haar dochter is ontvoerd door een meedogenloze mensenhandelaars bende. Ze zet alles op alles om haar dochter terug te halen. Geholpen door een oud-militair, navigeert ze door de criminele onderwereld en ontdekt ze een web van corruptie dat zich uitstrekt van de straten van Los Angeles tot aan hooggeplaatste ambtenaren.",
          "runtime": 0,
          "tagline": "",
          "title": ""
