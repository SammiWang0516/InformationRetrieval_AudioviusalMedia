  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Haunted by loss and drifting away from his daughter, a retired Subedaar Arjun Maurya’s newly found civilian life is jolted by one reckless act. As old wounds reopen, he must summon the warrior within to face a new kind of war - one that hits too close to his heart.",
          "runtime": 142,
          "tagline": "Cross me and you’ll regret it",
          "title": "Subedaar"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ขณะถูกหลอกหลอนด้วยความสูญเสียและค่อยๆ ห่างเหินจากลูกสาว ชีวิตพลเรือนที่เพิ่งเริ่มต้นของทหารเกษียณ ซูเบดาร์ อรชุน เมารยะ ต้องสะเทือนจากการกระทำอันหุนหันเพียงครั้งเดียว เมื่อบาดแผลเก่าถูกเปิดขึ้นอีกครั้ง เขาจำต้องปลุกนักรบในตัวเองขึ้นมา เพื่อเผชิญหน้ากับสงครามรูปแบบใหม่ สงครามที่ใกล้ชิดหัวใจของเขาอย่างที่สุด",
          "runtime": 0,
          "tagline": "",
          "title": "ซูเบดาร์ ล้างบางอธรรม"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "사별의 슬픔과 점점 멀어지는 딸 때문에 괴로워하던 퇴역 원사 아르준 마우리아. 민간인으로서 그의 삶은 단 한 번의 무모한 행동으로 뒤흔들린다. 오래된 상처가 다시 벌어지자, 그는 내면의 전사 본능을 불러내어 자신에게 깊숙이 다가온 새 전쟁에 맞서야 한다.",
          "runtime": 0,
          "tagline": "",
          "title": "원사"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Przeżywa stratę i oddalanie się od córki. Emerytowany Subedaar Arjun Maurya, jego życie cywilne zostaje zachwiane przez jeden lekkomyślny czyn. Gdy stare rany się otwierają, musi przywołać w sobie wojownika, by stawić czoła nowemu rodzajowi wojny – takiej, która zbyt mocno go dotyka.",
          "runtime": 0,
          "tagline": "Sprzeciw się, a pożałujesz.",
          "title": "Subedaar"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "退役准尉阿爾俊莫里亞深受喪妻之痛所困，跟女兒的關係也日益疏離，他剛展開的平民生活卻被一個魯莽行為徹底擾亂。隨著舊傷口再度撕裂，他必須喚醒內心的戰士，迎接一場切身的全新戰爭。",
          "runtime": 0,
          "tagline": "",
          "title": "退伍軍官"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "退役准尉阿尔俊莫里亚深受丧妻之痛所困，跟女儿的关系也日益疏离，他刚展开的平民生活却被一个鲁莽行为彻底扰乱。随着旧伤口再度撕裂，他必须唤醒内心的战士，迎接一场切身的全新战争。",
          "runtime": 145,
          "tagline": "",
          "title": "退伍军官"
        }
      },
      {
        "iso_3166_1": "TR",
