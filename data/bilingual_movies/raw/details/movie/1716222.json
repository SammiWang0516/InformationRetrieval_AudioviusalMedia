  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A package arrives at their doorsteps. There is no sender's name. No explanation as to why it was delivered to them. But the moment they open it, their lives spiral into a nightmare. One by one, lives are put on the line. Now, the question is no longer how to avoid the package, but how to escape the curse once they have received it.",
          "runtime": 98,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ID",
        "iso_639_1": "id",
        "name": "Bahasa indonesia",
        "english_name": "Indonesian",
        "data": {
          "homepage": "",
          "overview": "Sebuah paket tiba di depan pintu. Tidak ada nama pengirim. Tidak ada alasan mengapa paket itu ditujukan kepada mereka. Namun, sejak paket itu dibuka, hidup penerimanya langsung berubah jadi mimpi buruk. Satu per satu nyawa menjadi taruhan. Kini, pertanyaannya bukan lagi bagaimana cara menghindari paket tersebut, melainkan bagaimana cara terhindar dari kutukan setelah menerimanya.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Группа студентов получает посылку с загадочной шкатулкой от неизвестного отправителя. Открывшие её умирают жуткой смертью. Оставшимся друзьям предстоит выяснить: кто или что стоит за этим проклятием и как избежать страшной участи.",
          "runtime": 98,
          "tagline": "",
          "title": "Шкатулка проклятия. Зло внутри"
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "يصل طرد إلى عتبة منزلهم بلا اسم مرسِل ولا تفسير لسبب وصوله، لكن ما إن يفتحوه حتى تنقلب حياتهم إلى كابوس.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Khi nhận hàng online trở thành án tử! Một nhóm sinh viên nhận được những kiện hàng bí ẩn không rõ nguồn gốc. Sự tò mò thôi thúc họ mở từng kiện hàng, nhưng cũng chính là lúc cơn ác mộng bắt đầu… Những cái chết kỳ dị liên tiếp xảy ra: thi thể bị đàn ong vây kín, tai nạn quái dị và sự mất kiểm soát tâm trí. Giữa vòng xoáy nghi kỵ, họ bàng hoàng nhận ra sự thật lạnh sống lưng: Mỗi lần nhận hàng đều có thể dẫn đến cái chết. Lời nguyền này đến từ đâu, ai là kẻ chủ mưu giật dây cho cuộc tàn sát đẫm máu? Một cuộc đua sinh tồn nghẹt thở, nơi lòng tin vỡ vụn và cái chết chực chờ sau mỗi lần mở đơn hàng online.",
          "runtime": 0,
          "tagline": "",
          "title": "Đơn Hàng Ma Ám"
        }
      }
    ]
  },
