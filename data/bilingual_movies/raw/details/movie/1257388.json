  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "เรื่องราวของ “โจ” เกมเมอร์หนุ่มดวงตก ได้รับมรดกเป็นบ้านที่มีผีเจ้าของบ้านคนเก่า “อนงค์” แถมมาด้วย แต่คนก็ไม่ยอมหนี ผีก็ไม่ยอมไป คนกับผีเลยจับมือกันเปิดบ้านผีสิงให้คนมาเที่ยวเล่น แถมยังได้เห็นความน่ารักของผีบ้านนี้มากขึ้นทุกวันจนเกิดเป็นความรัก",
          "runtime": 125,
          "tagline": "บ้านนี้ผีน่ารัก",
          "title": "อนงค์"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Joe finds a way to make some cash out of the creepy old house he inherited. But he didn't think he'd find love with one of the ghosts haunting it.",
          "runtime": 125,
          "tagline": "A cute ghost is here.",
          "title": "My Boo"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "沉迷於電動的廢柴阿喬（蘇提拉素維傑拉 飾），意外繼承一棟郊區的破舊老宅。一心想將房子變現還債的阿喬，卻驚覺屋子裡住著三個名叫阿儂（梅拉達蘇斯麗 飾）、金寶與金糕的阿飄，找師父作法都趕不走！於是阿喬靈機一動，與鬼聯手開鬼屋來嚇人，沒想到「真鬼屋」一夕爆紅讓他發了大財。然而，本性善良又甜美的阿儂，竟讓阿喬慢慢搞不清楚，內心對祂是心悸還是心動！？",
          "runtime": 0,
          "tagline": "",
          "title": "哈囉！萌鬼屋"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "祖（素提叻．素比吉 飾）是個倒楣的遊戲直播主，意外從富豪祖父中繼承了一棟古老大宅。但他很快發現這棟房子被前屋主的鬼魂阿儂（梅拉達．蘇斯麗 飾）及其鬼魂夥伴佔據。山窮水盡之際，祖靈機一觸，決定與這些「住客」合作，將計就計將大宅改造成全城最刺激的鬼屋。這個瘋狂的計劃不僅帶來意想不到的財富，更讓祖與阿儂之間萌生了一段超自然人鬼戀。但人鬼殊途，祖和阿儂能否跨越生死的界限，成就一段真摯動人的愛情？",
          "runtime": 0,
          "tagline": "",
          "title": "撞鬼遇到愛"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Một game thủ nghĩ ra kế hoạch kiếm tiền từ ngôi nhà ma ám mà ông cậu để lại nhưng lại sớm nảy sinh tình cảm với một trong những con ma tại đó.",
          "runtime": 0,
          "tagline": "",
          "title": "Bé Ma Của Anh"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "讲述一个男孩与女鬼之间的爱情。",
          "runtime": 0,
          "tagline": "",
          "title": "我的宝贝"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Joe, un joven jugador, no tiene suerte. Recibió una herencia de una casa con el fantasma del dueño anterior, Anong. Pero la gente se negó a escapar y el fantasma se negó a irse. Entonces, la gente y el fantasma unieron sus manos y abrieron la casa embrujada para que la gente viniera a jugar.",
          "runtime": 0,
          "tagline": "",
          "title": "My Boo - Anong"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
