        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Pumpkin, cô gái cuối cùng còn sống sau đại dịch xóa sổ nhân loại, lang thang giữa vùng đất hoang để tìm nhu yếu phẩm vào đêm trước Halloween. Nghi thức cô độc hằng năm của cô bị phá vỡ khi một băng cướp man rợ do Thalia cầm đầu tìm đến tận cửa, buộc Pumpkin phải dùng mọi thứ trong tay — từ kẹo ngọt, mưu mẹo đến vũ khí — để sống sót qua đêm.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "بعد أن يقضي وباءٌ على معظم البشرية، تعيش فتاة تُدعى بامبكن وحيدةً في عالم ما بعد نهاية العالم، وتحاول الحفاظ على تقاليد الهالوين. لكن وصول عصابة من الناهبين إلى منزلها يحوّل ليلتها إلى معركة من أجل البقاء",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Pumpkin, ostatnia dziewczyna na Ziemi i jedyna ocalała z plagi, która doprowadziła do zagłady ludzkości, przemierza pustkowia w poszukiwaniu zapasów w przeddzień Halloween. Jej samotny, świąteczny rytuał zostaje przerwany przez pojawienie się pod jej drzwiami brutalnego gangu rabusiów, któremu przewodzi przerażająca Thalia. Otoczona przez liczniejszych przeciwników, Pumpkin musi wykorzystać słodycze, spryt i broń, by stawić zaciekły opór i przetrwać tę noc.",
          "runtime": 0,
          "tagline": "",
          "title": "Przekleństwo Halloween"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "世界彻底废土，人类死绝，女孩是地球上最后一个活人。万圣夜她守着荒野破屋，本以为等来的是同类幸存者，结果撞破门的是杀心拉满的邪灵。没有求饶没有退路，狭小的木屋直接变屠宰场，她抄起身边所有能当武器的家伙，跟闯进来的邪灵展开不死不休的近身死砍，要么屠灵要么被屠，整个万圣夜全是血光与惨叫。",
          "runtime": 80,
          "tagline": "",
          "title": "万圣武士"
        }
      }
    ]
