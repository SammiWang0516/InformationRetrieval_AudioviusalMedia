      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Coreia do Sul, 15 de agosto de 1974. Durante uma cerimônia transmitida ao vivo, tiros são disparados contra o presidente Park Chung-hee. Ele sobrevive, mas a primeira-dama Yuk Young-soo e uma menina são mortas. Quando duas balas desaparecem dos registros oficiais, um inspetor que testemunhou o atentado, um editor de jornal veterano e um repórter iniciante conduzem investigações paralelas. Entre censura, ameaças e interesses ocultos, os três desafiam uma engrenagem determinada a enterrar a verdade.",
          "runtime": 131,
          "tagline": "",
          "title": "O(s) Assassino(s)"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
