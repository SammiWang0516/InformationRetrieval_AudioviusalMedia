      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "该片以1974年8月15日韩国光复节纪念仪式上，第一夫人陆英修（朴正熙的夫人）遇刺身亡的真实历史事件为背景。故事核心谜团围绕当时被捕的真凶文世光的证言展开—他声称自己“只发射了4发子弹，但现场却听到了更多的枪声”，影片将通过三种不同的视角交织追踪案件。",
          "runtime": 0,
          "tagline": "",
          "title": "暗杀者们"
        }
