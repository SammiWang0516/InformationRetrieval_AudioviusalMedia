      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "El director Arthur Cary narra la increíble historia del bajo Höfner original de Paul McCartney: su misteriosa desaparición y la búsqueda impulsada por los fans para recuperarlo. Comprado por solo 30 libras en Hamburgo cuando él tenía 18 años, este icónico instrumento marcó el sonido de los primeros éxitos del grupo antes de esfumarse y convertirse en uno de los grandes enigmas del rock.",
          "runtime": 0,
          "tagline": "",
          "title": "El bajo perdido de McCartney"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Depuis plus de cinquante ans, la disparition de la basse Höfner originale de Paul McCartney reste l’un des mystères les plus tenaces du rock ‘n’ roll. *The Hunt for the Lost Bass* raconte l’histoire extraordinaire de cet instrument emblématique, ainsi que la quête menée par ses fans pour le retrouver.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "18歳のポール・マッカートニーがドイツで購入し、ビートルズの初期サウンドの象徴となったヘフナー社のベースが、ある時期に姿を消した。ポールの依頼でヘフナー社が記録を辿ると、バンド解散時までは確かにあった。やがて、かつてのウイングスの機材担当者にたどり着くが...。ベースの行方とポールの音楽の変遷。",
          "runtime": 0,
          "tagline": "",
          "title": "マッカートニーの消えたベースを捜せ"
        }
      },
