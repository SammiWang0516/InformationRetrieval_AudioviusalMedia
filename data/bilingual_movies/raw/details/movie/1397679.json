    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "影片讲述了东北小伙李如意（崔志佳 饰）因追求导演梦想，阴差阳错成了艺术家火锅店老板。为给梦想筹备百万资金，李如意在“火锅争霸赛”中一路施展奇招，不仅与戏精班底现场飙戏，更跟老丈人同台竞技。在这场巅峰之战中，究竟谁能笑到最后？",
          "runtime": 98,
          "tagline": "活成这样 那咋了？",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Li Ruyi is a young man from Northeast China. His film director career is not going as planned and his father-in-law is trying to persuade Ruyi to take over his hot pot restaurant. Success can take surprising forms, as one keeps putting all their effort to realize their dreams!",
          "runtime": 98,
          "tagline": "",
          "title": "Hot Pot Artist"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "東北小夥李如意（崔志佳 飾）的導演事業遭逢變故，還被債主七哥（喬杉 飾）上門催債，無奈之下找到好兄弟張磊（魏翔 飾）、賈總（艾倫 飾）借錢卻遭戲精式婉拒，就在窮途末路之時李如意施展廚藝天賦，搖身一變成為火鍋屆“扛把子”，帶領一衆小弟誓要贏得“火鍋爭霸賽”的百萬獎金！在登頂之路上，李如意與老丈人袁飛（張琪 飾）、競爭對手陳華柳（于洋 飾）、倒霉夥計小天（宋小寶 飾）開展了一系列啼笑皆非的花式PK，最終冠軍究竟花落誰家？李如意是否會繼續在火鍋屆大展拳腳？抓馬人生等待解鎖……",
          "runtime": 98,
          "tagline": "",
          "title": "火鍋藝術家"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "東北小夥李如意（崔志佳 飾）的導演事業遭逢變故，還被債主七哥（喬杉 飾）上門催債，無奈之下找到好兄弟張磊（魏翔 飾）、賈總（艾倫 飾）借錢卻遭戲精式婉拒，就在窮途末路之時李如意施展廚藝天賦，搖身一變成為火鍋屆“扛把子”，帶領一眾小弟誓要贏得“火鍋爭霸賽”的百萬獎金！在登頂之路上，李如意與老丈人袁飛（張琪 飾）、競爭對手陳華柳（於洋 飾）、倒黴夥計小天（宋小寶 飾）開展了一系列啼笑皆非的花式 PK，最終冠軍究竟花落誰家？李如意是否會繼續在火鍋屆大展拳腳？抓馬人生等待解鎖……",
