      {
        "iso_3166_1": "GR",
        "iso_639_1": "el",
        "name": "ελληνικά",
        "english_name": "Greek",
        "data": {
          "homepage": "",
          "overview": "Παραμονή Πρωτοχρονιάς του 2000. Μια κλοπή όπλων από ένα στρατόπεδο. Ένας γνωστός εγκληματίας κρατάει όμηρο μια οικογένεια στο Παγκράτι και απειλεί να την ανατινάξει αν δεν εμφανιστεί ζωντανά στην τηλεόραση. Ένα τηλεοπτικό κανάλι σε αναβρασμό και την αστυνομία να κοιτάζει έναν δραπέτη να την εκθέτει για πολλοστή φορά. Όλοι τους νήματα σε έναν ιστό που κάποιοι υφαίνουν στο παρασκήνιο.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Yeni yılın yaklaştığı 1999 yılında Atina'da bir aileyi rehin alan ve tüm ülkenin gerçek zamanlı olarak izlediği bir dönemde canlı yayına çıkmayı talep eden çaresiz bir firarinin hikayesini anlatıyor.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "새천년을 앞두고 기대와 불안으로 물든 1999년 12월 31일의 아테네. 한 방송국으로 다급한 전화 한 통이 걸려 온다. 경찰을 농락하고 도망친 지명 수배자가 일가족을 인질로 삼은 채 신참 기자를 지명해 인터뷰를 요청한다. 세간의 이목이 쏠린 가운데, 기자는 일생일대의 전화 인터뷰를 해내야 한다. 수화기 너머로 끔찍한 인질극이 시작되는데…",
          "runtime": 92,
          "tagline": "",
          "title": "라스트 콜"
        }
      }
