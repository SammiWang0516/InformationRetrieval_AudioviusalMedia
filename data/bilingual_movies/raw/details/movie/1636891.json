      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "乔是一名前拳击手，他抛弃了自己的过去，帮助他的伴侣埃斯特雷拉（Estrella）在墨西哥一个崎岖的边境小镇经营自己的农场。最初被纳入父亲的自卫队，乔现在寻求更安静的生活，但经济困难迫使他重返拳击场，参加几次地下战斗，以支持农场的工人。起初，乔保持冷静，但当查韦斯和他的帮派在路上伏击他们，试图将他们赶走并杀死他们时，乔别无选择，只能反击，杀掉查韦斯及其手下。",
          "runtime": 0,
          "tagline": "",
          "title": "边境狂怒"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Phim theo chân Joe, một cựu võ sĩ đang sống tại Mexico và giúp điều hành trang trại của người bạn đời Estrella, khi khó khăn tài chính khiến anh phải tham gia các trận đấu ngầm để hỗ trợ công nhân trong trang trại, nhưng mọi chuyện trở nên nguy hiểm khi Joe và Marco bị băng đảng của Chavez tấn công trên đường, buộc anh phải dùng kỹ năng chiến đấu của mình.",
          "runtime": 0,
          "tagline": "",
          "title": "Lính Đánh Thuê"
