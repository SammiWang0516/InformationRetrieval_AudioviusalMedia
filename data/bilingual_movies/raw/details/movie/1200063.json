        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Phim kể về Cao Hàn (do Âu Hào thủ vai), một sinh viên xuất sắc ngành tài chính, có đạo đức ngay thẳng và khát vọng lớn trong sự nghiệp tài chính. Nhờ mối quan hệ bạn học với Chu Phong, người thừa kế tập đoàn Trác Năng đang chuẩn bị niêm yết, Cao Hàn bất ngờ có được cơ hội thực tập tại ngân hàng đầu tư quốc tế Lam Thạch. Tại đây, anh phải đối mặt với áp lực từ những thực tập sinh khác đều đến từ các trường danh tiếng, có xuất thân quyền quý hoặc được giới thiệu bởi các lãnh đạo cấp cao. So với họ, Cao Hàn trở nên lạc lõng và kém thế. May mắn thay, anh được Trương Thác Đức (do Lưu Đức Hoa thủ vai), chuyên gia phân tích hàng đầu, nhìn trúng và dẫn dắt. Dưới sự chỉ dạy của Trương Thác Đức, Cao Hàn nhanh chóng thích nghi với môi trường làm việc tốc độ cao và áp lực lớn, rèn luyện kỹ năng chuyên môn lẫn đàm phán. Thế nhưng anh dần nhận ra rằng, thành tích trong giới tài chính không đơn thuần là nhờ thực lực, mà còn liên quan đến quyền lực, quan hệ và những luật chơi ngầm đầy khắc nghiệt.",
          "runtime": 0,
          "tagline": "",
          "title": "Canh Bạc Phù Hoa"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Студент финансового факультета Гао Хань с отличием оканчивает престижный университет и строит грандиозные планы на будущее. Он амбициозен, усидчив и настроен на головокружительную карьеру. С помощью родителей своего друга Чу Фэна парень становится стажёром в крупном инвестиционном банке. Гао Хань погружается в мир акул фондового рынка под руководством опытного наставника. Теперь его обычное утро начинается с разбора горы электронных писем, бесконечных звонков и чтения новостей. Он осваивает искусство ведения переговоров, чтобы завоевать доверие клиентов. Каждый рабочий день готовит очередные сложные задачи, требующие от юноши освоения новых навыков, упорства и самоотдачи. Сможет ли он успешно пройти стажировку и получить постоянную работу в компании мечты?",
          "runtime": 110,
          "tagline": "",
          "title": "Охотники за деньгами"
        }
      }
    ]
  },
