  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A woman who believes she's cursed meets a troubled landlord while fighting community displacement. As they grow closer, her fear that all her lovers disappear threatens their connection.",
          "runtime": 104,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "Sari（張金珠 飾）自封「愛情黑寡婦」，因為她愛上的男人總是無聲無息失蹤！為了不再淪為失戀達人，她決心鎖上「愛情大門」，過單身日子。誰料命運愛搞亂，偏偏送來Jolo（保羅‧阿韋利諾 飾）——一個事業失意、被家族責任壓得頭昏腦脹卻意外帥氣的怪房東。兩人為了保住社區免於拆遷，從歡喜冤家變成拍檔，漸生情愫。Sari雖然心動，卻暗暗擔心詛咒再現，連累這位「搞鬼情人」也消失。救社區已經夠頭痛，難道還得順手拯救自己的愛情？",
          "runtime": 0,
          "tagline": "",
          "title": "愛清咀咀咒"
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "حبي سيجعلك تختفي"
        }
      },
      {
        "iso_3166_1": "FI",
        "iso_639_1": "fi",
        "name": "suomi",
        "english_name": "Finnish",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "Rakkauteni Saa Sinut Katoamaan"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Eine Frau, die glaubt, dass sie verflucht ist, lernt während ihres Kampfes gegen die Vertreibung aus der Gemeinde einen gestörten Vermieter kennen. Als sie sich näher kommen, bedroht ihre Angst, dass alle ihre Liebhaber verschwinden, ihre Verbindung.",
          "runtime": 104,
          "tagline": "",
          "title": "Meine Liebe wird dich verschwinden lassen"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Maudite de perdre tous ceux qu'elle aime, Sari a renoncé depuis longtemps à l'amour – jusqu'à ce qu'elle craque pour son propriétaire qui est bien décidé à rester à ses côtés.",
          "runtime": 0,
          "tagline": "",
          "title": "Mon Amour, Te Ferai Disparaître"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Condannata a perdere tutte le persone che ama, Sari ha rinunciato all'amore molto tempo fa... ma poi si invaghisce del suo padrone di casa, che sembra deciso a rimanere.",
          "runtime": 0,
          "tagline": "",
          "title": "Il Mio Amore, Ti Farà Sparire"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Sari, kobieta przekonana, że ​​jest przeklęta, ponieważ każdy mężczyzna, którego kocha, znika. Pojawia się Jolo, zamyślony właściciel, który zmaga się z podupadającym kompleksem apartamentów. Ich ścieżki krzyżują się, gdy walczą o uratowanie społeczności przed wysiedleniem, ale domniemana klątwa Sari zagraża ich rodzącemu się romansowi.",
          "runtime": 104,
          "tagline": "",
          "title": "My Love Will Make You Disappear"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Fadada a perder todo homem que ama, Sari desistiu do romance há muito tempo. Até se apaixonar por seu senhorio, que não pretende desistir tão cedo.",
          "runtime": 0,
          "tagline": "",
          "title": "Meu Amor Vai Fazer Você Desaparecer"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "这部浪漫喜剧讲述了莎莉（赵）的故事，她坚信自己被下了诅咒，因为每个她爱上的男人都会消失。乔洛（阿韦利诺）登场，他是个忧心忡忡的房东，正努力应对经营不善的公寓大楼。他们在为拯救一个社区不被拆迁而奋斗的过程中相遇，但莎莉所谓的诅咒威胁着他们刚刚萌芽的恋情。",
          "runtime": 0,
          "tagline": "",
          "title": "爱的消失魔咒"
        }
      }
    ]
  },
