  "translations": {
    "translations": [
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "국가의 질서가 무너진 근미래의 포구시에서, 버려진 사람들은 텍사스 온천이라는 폐쇄적인 공동체에 모여 살아간다. 로한은 형 교한과 함께 그곳의 노동자들을 관리하며 범죄와 폭력을 일상으로 받아들이고, 모자장수는 모두의 삶 위에 군림한다. 엄격한 지배 아래 유지되던 이 세계에 낯선 입주자 제인이 나타나면서 로한은 처음 느끼는 감정에 빠진다. 형의 폭력적인 애정과 정해진 역할에 익숙했던 그는 누군가를 향한 마음 때문에 당연하게 따르던 규칙을 다시 바라본다. 그러나 온천의 질서를 쥔 사람들에게 개인의 사랑은 허락할 수 없는 위협이 되고, 관계마다 의심과 욕망이 얽힌다. 살아남기 위해 복종해온 로한에게 사랑하는 사람을 지키는 일은, 자신이 속한 세계를 거스르는 선택으로 다가온다.",
          "runtime": 91,
          "tagline": "사랑을 배운 순간, 복종의 질서가 무너진다",
          "title": ""
        }
      },
