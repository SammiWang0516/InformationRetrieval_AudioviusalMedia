      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "https://www.tekhnefilm.com/Filmler/FilmDetay/2",
          "overview": "Emekli inşaat mühendisi Refik, Suriyeli bakıcısı Nesrin’e iki küçük oğluyla Avrupa’ya kaçması için bir miktar para verir. Refik, Kurban Bayramı’nda kendi çocuklarıyla bir araya gelme hazırlığı yaparken Nesrin, oğullarını ona bırakıp kayıplara karışır. Bu sırada, batık süt ürünleri tüccarı olan oğlu İhsan, atadan kalma köy arazisine hayvan çiftliği kurmak için babası Refik’i ve kız kardeşini maddi destek vermeye ikna etmeye çalışmaktadır. İstanbul’daki akademik kariyerini bırakıp Almanya’ya yerleşme planı yapan Refik’in kızı Nalan ise uzun bir aradan sonra baba evine döner.",
          "runtime": 93,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "身患绝症的雷菲克盼与子女共度开斋节，可孩子们只顾自我。他的叙利亚难民护工突然消失，将孩子留给他。雷菲克只得在被视作希望之城的伊兹密尔四处寻找护工，开启一段无奈的寻访之旅。",
          "runtime": 0,
          "tagline": "",
          "title": "若木断枝"
        }
      }
