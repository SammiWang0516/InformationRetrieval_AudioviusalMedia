  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.destinydistribution.com/",
          "overview": "A l’aube de la Seconde Guerre mondiale, François Touraine, grand virtuose du piano, n’a d’autre choix que de partir jouer en Allemagne pour sauver la femme qu’il aime, sa professeure. Rachel est juive dans une époque qui ne le permet plus… À son retour en France, il n’est plus que l’ombre de lui-même lorsqu’il rencontre Annette. Elle fera un geste incroyable pour lui permettre de remonter sur scène.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Losy młodego Francuza François Touraine’a na przestrzeni lat 20-50. Już jako dziecko poznał Rachelę, która uczyniła go wielkim wirtuozem fortepianu. On ulega urokowi swojej nauczycielki i staje się dorosły, lecz ona jest Żydówką w czasach, które już na to nie pozwalają. Aby ją uratować, François swoim kosztem odkryje konsekwencje antysemityzmu.",
          "runtime": 106,
          "tagline": "",
          "title": "Wybór pianisty"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "During the Second World War, François Touraine, a young piano prodigy, has no choice but to go and play in Germany to save the woman he loves. Because Rachel is Jewish in an age that no longer allows it... A great story of love, music and resistance through time and the horrors of the Occupation and Nazism.",
          "runtime": 105,
          "tagline": "During the war, music remains the last hope.",
          "title": "The Pianist's Choice"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "제2차 세계대전이 막 시작되던 무렵, 유대인으로 존재하는 것이 더 이상 용납되지 않던 시대. 위대한 피아노 거장 프랑수아 투랭은 자신의 스승이자 사랑하는 여인인 라헬을 구하기 위해 독일로 가서 연주할 수밖에 없는 처지에 놓인다.",
          "runtime": 106,
          "tagline": "",
          "title": "피아니스트의 연인"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "פרנסואה נמשך למוסיקה מאז שהיה ילד, אבל אביו חשב שזה מקצוע נשי ואמא שלו נגררה אחריו. היחידה שהאמינה בו הייתה מורה צעירה שזיהתה את הכישרון שלו וליוותה אותו עד שהפך לשם הכי חם באירופה. כשפורצת מלחמת העולם השנייה, פרנסואה מוזמן לנגן בתזמורת של ברלין ונחשף לרדיפות של השלטון הנאצי אחרי אמנים יהודיים. כשהוא חוזר לפריז הוא מגלה שהמורה שלו, האישה שאותה אוהב, נלקחה למחנה ריכוז והוא צריך להתמודד עם בחירה בלתי אפשרית: לשתף פעולה עם האויב – או לאבד את האישה שלימדה אותו הכול.",
          "runtime": 0,
          "tagline": "",
          "title": "בחירתו של הפסנתרן"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "La începutul celui de-al Doilea Război Mondial, un virtuoz al pianului e obligat să cânte în Germania pentru a o salva pe femeia iubită.",
          "runtime": 106,
          "tagline": "",
          "title": "Alegerea pianistului"
        }
      },
      {
        "iso_3166_1": "CZ",
