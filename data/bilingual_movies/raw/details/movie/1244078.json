        "data": {
          "homepage": "",
          "overview": "Na začátku 2. světové války musí pianista François Touraine hrát v Německu, aby zachránil milovanou učitelku.",
          "runtime": 106,
          "tagline": "",
          "title": "Klavíristova volba"
        }
      },
      {
