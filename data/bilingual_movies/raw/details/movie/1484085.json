  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://kinolorber.com/film/atonement",
          "overview": "In the early days of the Iraq War, a split-second decision made by a U.S. Marine during a tense standoff devastates an Iraqi family. Years later, aided by a New Yorker journalist, he seeks to reconcile with the family he destroyed.",
          "runtime": 118,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "어톤먼트"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Au début de la guerre en Irak, la décision, prise en une fraction de seconde par un marine américain, entraîne une fusillade qui dévaste une famille irakienne. Des années plus tard, avec l’aide d’un journaliste du New Yorker, il cherche à retrouver la femme qui a survécu, et sa famille.  L'Apaisement est inspiré de faits réels.",
          "runtime": 0,
          "tagline": "",
          "title": "L'Apaisement"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "2003年，巴格达，伊拉克战争爆发之初，三条人生轨迹彼此交汇。美国海军陆战队员卢朝一辆汽车开火，导致一名伊拉克妇女的丈夫和两个儿子身亡。《纽约时报》记者迈克尔在医院中找到了这位名叫玛丽亚姆的妇女和她幸存的女儿，并将她们的遭遇报道了出来。多年后，满心愧疚的卢联系上迈克尔，请求他帮忙安排一次与玛丽亚姆的会面，以求得到宽恕。",
          "runtime": 0,
          "tagline": "",
          "title": "求恕者"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Фільм заснований на однойменній статті Декстера Філкінса для журналу The New Yorker. У центрі історії — морський піхотинець Лу Лобелло, якого переслідують спогади про смертельний інцидент у Багдаді. Почуття провини та каяття спонукають його зв’язатися з Норою — єдиною вцілілою членкинею родини, якій, на думку Лу, він міг завдати шкоди.",
          "runtime": 0,
          "tagline": "",
          "title": "Спокута"
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Базиран на резониращата статия на Декстър Филкинс в New Yorker със същото име, за морския пехотинец Лу Лобело, преследван от спомени за смъртоносен инцидент в Багдад, чието пътуване на вина и разкаяние го кара да се свърже с Нора, единствения оцелял член на семейството, когото смята, че може би е наранил.",
          "runtime": 0,
          "tagline": "",
          "title": "Изкупление"
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "2003 yılında Bağdat’ta yaşayan Haçaturyan ailesi, çatışmalar nedeniyle evlerinden ayrılmak zorunda kalır. Evlerine dönmeye çalıştıkları sırada Amerikan askerleri ile direnişçiler arasındaki bir çatışmanın ortasında kalan aile, bir deniz piyadesinin saniyeler içinde verdiği karar sonucunda büyük bir kayıp yaşar. Aradan yıllar geçmesine rağmen yaşananların ağırlığını üzerinden atamayan Lou, olay hakkında haber yapan bir gazeteciden yardım ister. Amacı, hayatta kalan aile üyelerine ulaşarak geçmişte yaşananlarla yüzleşmek ve onlarla yeniden bir araya gelmenin bir yolunu bulmaktır.",
          "runtime": 115,
          "tagline": "",
          "title": "Kefaret"
        }
      }
    ]
