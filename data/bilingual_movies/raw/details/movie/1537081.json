  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.hallmarkchannel.com/christmas-above-the-clouds",
          "overview": "When a workaholic CEO tries to skip Christmas by flying to Australia, she’s in for the flight of her life. Haunted by her past, present, and future, she’s forced to confront the choices that led to her success yet left her flying solo. With the help of three quirky spirits and a surprise reunion with her ex, she might just rediscover the magic of Christmas—and the love she thought she’d lost.",
          "runtime": 84,
          "tagline": "A magical flight through Past, Present, and Future",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BE",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Wanneer een ambitieuze CEO besluit Kerstmis te ontvluchten met een vlucht naar Australië, krijgt ze meer dan ze had geboekt. Drie eigenzinnige geesten confronteren haar met haar verleden, heden en toekomst – en dwingen haar te beseffen dat succes niets waard is zonder liefde. Misschien wacht haar, duizenden kilometers van huis, toch nog een beetje kerstmagie… én een tweede kans.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Когато работохолик решава да избегне Коледа, като замине за Австралия, тя се изправя пред полета на живота си. Преследвана от миналото, настоящето и бъдещето, тя трябва да се изправи срещу решенията, които са я довели до успеха, но са я оставили самотна. С помощта на трима необичайни духа и изненадваща среща с бившия си, тя може би ще преоткрие магията на Коледа и любовта, която е смятала за загубена.",
          "runtime": 0,
          "tagline": "",
          "title": "Коледа над облаците"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Когда трудоголик и генеральный директор Элла Низер пытается сбежать от Рождества, улетев в Австралию, ее ждет переломный момент в жизни. Преследуемая своим прошлым, настоящим и будущим, она вынуждена столкнуться с выбором, который привел ее к успеху, но сделал ее одинокой. С помощью трех эксцентричных духов и неожиданной встречи со своим бывшим, она может вновь открыть для себя магию Рождества и вернуть любовь, которую она считала утраченной.",
          "runtime": 0,
          "tagline": "",
          "title": "Рождество над облаками"
        }
      },
      {
        "iso_3166_1": "DK",
        "iso_639_1": "da",
        "name": "Dansk",
        "english_name": "Danish",
        "data": {
          "homepage": "",
          "overview": "Da en arbejdsnarkoman af en administrerende direktør forsøger at springe julen over ved at flyve til Australien, venter der hende en flyvetur, hun sent vil glemme. Forfulgt af sin fortid, nutid og fremtid tvinges hun til at se de valg i øjnene, der førte til hendes succes – men som også efterlod hende helt alene. Med hjælp fra tre excentriske ånder og et uventet gensyn med sin ekskæreste kan hun måske genopdage julens magi – og den kærlighed, hun troede, hun havde mistet.",
          "runtime": 84,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Ella Neezer, PDG accro au travail, fuit Noël en réservant un vol vers l'Australie le soir du réveillon. Son assistante Bobbi doit l'accompagner et manquer les fêtes avec son fils. À bord, Ella retrouve Jake, son ex-fiancé, et voit ses plans complétement chamboulés. Ce voyage surnaturel va la confronter aux choix qui ont façonné sa vie.",
          "runtime": 84,
          "tagline": "",
          "title": "Noël au-dessus des nuages"
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "مديرة تنفيذية مدمنة على العمل تحاول التهرب من عيد الميلاد برحلة طيران إلى أستراليا، لكنها تخوض رحلة العمر حين تزورها ثلاثة أرواح طريفة تجبرها على مواجهة ماضيها وحاضرها ومستقبلها، إلى جانب لقاء مفاجئ بحبيبها السابق.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
