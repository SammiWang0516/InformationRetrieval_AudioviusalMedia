      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "סרט תיעודי מוזיקלי שהוקרן בבכורה עולמית בפסטיבל טרייבקה 2025, העוקב אחר וויזקיד משיכוני לאגוס ועד להפיכתו לאחד הכוכבים האפריקאים הבולטים בעולם ולאחת הדמויות המזוהות עם הפריצה הבינלאומית של האפרוביטס. וויזקיד, שנולד בשם איודג'י איברהים באלוגון, מתועד ברגעים אישיים, בקטעי הופעות ובחומרים מאחורי הקלעים של ההכנות למופע הענק שלו באצטדיון טוטנהאם הוטספר בלונדון. מתוך המסלול הזה הסרט מרחיב את המבט אל שינוי תרבותי גדול יותר, ובוחן כיצד מוזיקה אפריקאית נכנסה אל המיינסטרים העולמי וכיצד וויזקיד משתמש בהצלחה שלו כדי להשפיע על האופן שבו אפריקה נתפסת מחוץ ליבשת ולהדגיש גאווה וזהות אפריקאית",
          "runtime": 0,
          "tagline": "",
          "title": "Wizkid: לאגוס לנצח"
