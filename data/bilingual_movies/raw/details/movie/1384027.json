  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.screenaustralia.gov.au/the-screen-guide/t/spit-2024/41963/",
          "overview": "Spitteri finds himself locked up in an immigration detention centre upon his return to Australia. With old enemies on his tail and a target on his back, he navigates a series of comedic misadventures, sharing with his fellow detainees the meaning of mateship and what it is to be truly Australian.",
          "runtime": 105,
          "tagline": "Everyone Deserves A Seventh Chance.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Po 20 latach ucieczki za granicę, drobny były przestępca Johnny Spitieri (Spit) przedostaje się z powrotem do Australii na fałszywym paszporcie, by znaleźć się zamkniętym w ośrodku zatrzymań dla imigrantów. Starzy wrogowie przychodzą go szukać, zdeterminowani, by wyrównać stare rachunki. Podczas gdy walczy, by być o krok przed innymi, zaradny Spit znajduje nowych przyjaciół w areszcie, ucząc ich swojej wersji przyjaźni i tego, co znaczy być prawdziwym Australijczykiem.",
          "runtime": 105,
          "tagline": "",
          "title": "Spit"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Na 20 jaar naar het buitenland te zijn gevlucht, keert de kleine ex-crimineel Johnny Spitieri (Spit) met een vals paspoort terug naar Australië en wordt opgesloten in een detentiecentrum voor immigratie. Oude vijanden komen hem zoeken, vastbesloten om oude rekeningen te vereffenen. Terwijl hij worstelt om anderen een stap voor te blijven, vindt de vindingrijke Spit nieuwe vrienden in hechtenis en leert hen zijn versie van vriendschap en wat het betekent om een echte Australiër te zijn.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "HR",
        "iso_639_1": "hr",
        "name": "Hrvatski",
        "english_name": "Croatian",
        "data": {
          "homepage": "",
          "overview": "Johnny 'Spit' Spitieri se po povratku u Australiju nađe zatvoren u imigracijskom pritvorskom centru. Sa starim neprijateljima za petama i metom na leđima, proživljava niz komičnih nezgoda, dijeleći sa svojim kolegama pritvorenicima značenje drugarstva i što znači biti pravi Australac.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "После 20 лет бегства за границей мелкий бывший преступник Джонни Спитьери (Спит) возвращается в Австралию по поддельному паспорту, но попадает в центр содержания иммигрантов, где становится мишенью для своих старых врагов, решивших свести с ним счеты. Стремясь опередить их на один шаг, находчивый Спит находит новых друзей в центре, обучая их своему пониманию дружбы и тому, что значит быть настоящим австралийцем.",
          "runtime": 0,
          "tagline": "",
          "title": "Спит"
        }
      },
