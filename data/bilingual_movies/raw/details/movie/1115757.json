      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Dario é um jovem que mora com os pais e possui o mesmo grupo de amigos desde o colégio. Durante o verão, ele se relaciona com Caterina, uma garota que conheceu por acaso, e com Lara, a garota por quem ele sempre foi apaixonado. Dario agora precisa escolher entre permanecer em sua zona de conforto ou finalmente se libertar.",
