  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.studiocanal.fr/title/delocalises-2025/",
          "overview": "Le jour où Redouane va obtenir sa promotion et enfin passer contremaître, il apprend que l'usine de matelas où il travaille est délocalisée en Inde. Bien décidé à conserver sa promotion, il accepte de partir tout en ayant la garantie d'être payé double et emmène avec lui Marguerite, sa compagne. Une fois sur place, il découvre que son patron l'a dupé, il sera bien payé double mais en roupies. Furieux, il décide de se venger en enseignant aux équipes le meilleur des droits sociaux français.",
          "runtime": 86,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://distribution.studiotf1.com/cinema/888342/",
          "overview": "The day Redouane is going to get his promotion and finally become a foreman, he learns that the mattress factory where he works is being relocated to India. Determined to keep his promotion, he agrees to leave while having the guarantee of being paid double and takes his partner Marguerite with him. Once there, he discovers that his boss has duped him, he will indeed be paid double but in rupees. Furious, he decides to take revenge by teaching the teams the best of French social rights: strikes, demonstrations and RTT with the sole aim of overthrowing his boss. Between culture clash and social struggle, Redouane leads an unexpected revolution that could well change the destiny of the factory... and his own.",
          "runtime": 85,
          "tagline": "From Dream Job to Culture Shock!",
          "title": "Offshoring"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "W dniu, w którym Redouane ma otrzymać awans i zostać brygadzistą, dowiaduje się, że fabryka materacy, w której pracuje, zostaje przeniesiona do Indii. Zdeterminowany, by utrzymać awans, zgadza się odejść, gwarantując sobie podwójne wynagrodzenie i zabiera ze sobą swoją partnerkę Marguerite. Na miejscu okazuje się, że szef go oszukał i że dostanie podwójną wypłatę, ale w rupiach. Wściekły postanawia się zemścić, ucząc drużyny najlepszych francuskich metod walki o prawa socjalne: strajków i demonstracji, których jedynym celem jest obalenie swojego szefa. Pomiędzy starciem kultur i zmaganiami społecznymi Redouane przewodzi nieoczekiwanej rewolucji, która może zmienić losy fabryki i jego samego.",
          "runtime": 86,
          "tagline": "",
          "title": "Délocalisés"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Redouane pracuje v továrně na matrace a má jeden velký sen – stát se vedoucím. Když konečně dostane nabídku na povýšení, zdá se, že nastal čas i na další velký krok – zasnoubení s Marguerite. Jenže místo romantiky přichází překvapení: továrna se stěhuje do Indie. Dvojice balí kufry a vyráží… aniž by tušila, co je čeká.",
          "runtime": 0,
          "tagline": "Francouzská komedie se špetkou kari",
          "title": "Lásko, neblázni!"
        }
      }
    ]
