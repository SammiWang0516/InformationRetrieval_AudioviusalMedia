      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Giulia jest idealną córką. Studiuje, rysuje, marzy o życiu na wrzosowisku, kolekcjonuje pudełka i słodko się uśmiecha. Pewnego wieczoru znika, pochłonięta absurdalną śmiercią: kobietobójstwem. Przytłoczony najstraszniejszym bólem, jaki ojciec może znieść, Gino Cecchettin postanawia nie milczeć. Kwestionuje najokrutniejsze konsekwencje patriarchalnej kultury, która wciąż nas dotyka, i znajduje słowa, by przypomnieć sobie, kim była Giulia i czego się od niej nauczył. W tym długim liście, napisanym wspólnie z Marco Franzoso, Gino opowiada swoją historię jako ojca, dni radości i cierpienia. Jest wzruszony i zachęca nas do „budowania sojuszu między płciami, zamiast umacniania dominacji jednej nad drugą”. Wzywa nas do słuchania młodych ludzi w naszym kraju i do wspólnej pracy nad budowaniem relacji opartych na empatii i wzajemnym szacunku.",
          "runtime": 0,
          "tagline": "",
          "title": "Se domani non torno"
        }
      }
