  "translations": {
    "translations": [
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "대한민국 최고의 배우 슈퍼스타 오선희는 이혼 소송 후 고향 완도를 찾는다. 그곳에서 로스쿨을 때려치우고 고향에 틀어박혀 사는 첫사랑 조동필을 만나게 되고 어린 시절 친구들과도 어울리며 점점 웃음을 되찾게 된다. 하지만 이혼 소송 중인 남편 강성기가 고향 완도에 리조트 개발을 무리하게 추진하며 또 다른 위기를 맞는데...",
          "runtime": 99,
          "tagline": "다시 만난 우리, 인생도 사랑도 리스타트!",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Oh Sun-hee, the greatest star from Wando, files for divorce after a long-standing conflict with her husband, Kang Sung-gi, and heads to her hometown, Wando, to escape the noisy media. Initially planning to visit her parents' graves and then return to Seoul, she is drawn back to Wando by a familiar restaurant sign. There, she unexpectedly reunites with friends from her childhood.",
          "runtime": 99,
          "tagline": "",
          "title": "Sunny Day"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Oh Sun-hee, de grootste ster uit Wando, vraagt ​​een scheiding aan na een langdurig conflict met haar man, Kang Sung-gi, en gaat naar haar geboorteplaats Wando om aan de luidruchtige media te ontsnappen. Aanvankelijk was ze van plan de graven van haar ouders te bezoeken en daarna terug te keren naar Seoul, maar ze wordt teruggetrokken naar Wando door een uithangbord van een bekend restaurant. Daar wordt ze onverwacht herenigd met vrienden uit haar jeugd.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在离婚诉讼结束后，回到故乡莞岛的巨星吴善熙（音，郑惠仁 饰）遇到了纯情的初恋男友赵东弼（音，崔丹尼尔 饰）和故乡朋友们的故事，是一部给彼此带来重新开始的勇气，重启幸福人生的电影。",
          "runtime": 0,
          "tagline": "",
          "title": "灿烂的阳光"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在離婚訴訟結束後，回到故鄉莞島的巨星吳善熙（音，鄭惠仁 飾）遇到了純情的初戀男友趙東弼（音，崔丹尼爾 飾）和故鄉朋友們的故事，是一部給彼此帶來重新開始的勇氣，重啟幸福人生的電影。",
          "runtime": 0,
          "tagline": "",
          "title": "燦爛的陽光"
        }
      }
