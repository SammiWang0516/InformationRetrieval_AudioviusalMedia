  "translations": {
    "translations": [
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "高中老師恩妤（嚴正嵐 飾）受暗戀對象岳融（涂善存 飾）所邀，意外出席多年未見的大學同學訂婚派對，眾人起鬨挑戰禁忌招鬼遊戲「鬼牽手」，原本以為只是無傷大雅的飯後娛樂，同學卻接連意外死亡，驚恐發現一旦開始這場遊戲，就必須以「牽手」做為交棒儀式，將詛咒持續轉嫁給下一個人，開始牽手之後，就無法停止，詛咒將永遠追隨至死為止…！",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The teacher is invited by someone she likes to join a class reunion. They play a game to invite ghosts to make friends, unaware that curses are placed upon them. There is a reason for the malevolence.",
          "runtime": 0,
          "tagline": "",
          "title": "Hold to Death: Hand in Hand"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Группа друзей узнает о ритуале с рукопожатием, с помощью которого можно исполнить любое желание. Решив проверить его реальность, ребята запускают смертельный механизм, который все более изощренными способами будет настигать всех по очереди. Им придется придумать хитрый план и проверить на прочность свою дружбу, чтобы обмануть смерть.",
          "runtime": 0,
          "tagline": "",
          "title": "Пункт назначения. Рука смерти"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Cô giáo được người mình thầm thích mời đến tham dự một buổi họp lớp. Tại đây, cả nhóm chơi một trò gọi hồn để kết bạn với ma, nhưng không hề hay biết rằng mình đã bị gieo những lời nguyền. Và đằng sau sự ác độc ấy là một lý do.",
          "runtime": 0,
          "tagline": "",
          "title": "Quỷ Dắt Tay"
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "触れるたびに新たな悪夢が始まり、つながるたびに新たな犠牲者が生まれる。恐怖は取り憑くだけではなく、狩りにくる。高校教師のエンユは、かつての片想いの相手ロンに誘われ、大学時代の友人の婚約パーティーに参加する。その日の昼間、彼女は生徒から、「鬼牽手（Hand in Hand）」という遊びの謎めいた絵が描かれたノートを取り上げていた。パーティーの主催者ボボがそれを見つけ、遊び半分でやってみようと提案する。「三つの炎が消えたとき、誰が手を取るのか」。ルールは単純—呪文を唱え、手を握るだけ。だがその代償は命だった。一人また一人と悪夢が現実になり、死が追ってくる。呪いを遅らせるには、鎖を途切れさせてはならない。しかしつながるほどに、闇は力を増していく—。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
  },
