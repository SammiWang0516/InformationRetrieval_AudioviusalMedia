      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "身份迥異的天才少年劉全龍（彭昱暢飾）與富家少年陳倫（丁禹兮飾），因緣際會下開始了一場人生交換。兩個少年的人生鏡像，一場命運的冒險遊戲，就此開啟。GAME START！",
          "runtime": 0,
          "tagline": "",
          "title": "天才遊戲"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The story tells the story of Liu Quan Long, a lowly born and independent struggling young man who got the opportunity to exchange his life with a boy from another class in a famous university. Unexpectedly, what was waiting for him was a thrilling game.  Liu Quan Long is an impoverished young man who can't afford to go to university but has a great talent. Before meeting Chen Lun, he was an Internet cafe administrator outside the university who would never be noticed.  Chen Lun has a distinguished family and studied at an elite university just across the street from an internet cafe, but he had no intention of going to school. In order to cope with his parents abroad, he offered Liu Quan Long an invitation to the game of \"identity exchange\" and asked Liu Quan Long to replace him.",
          "runtime": 96,
          "tagline": "",
          "title": "Game of Identity"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "窮途末路的天才少年劉全龍（彭昱暢 飾），被偏執的富家公子陳倫（丁禹兮 飾）選中，被迫踏入一場為他量身打造的「換命遊戲」。豪華別墅、名車名錶、神祕女友一應俱全，在陳倫的精心打造下，劉全龍瞬間擁有了頂級人生。這場表面上各取所需的交易，暗地裡卻逐漸瀰漫著致命危機。 當眾星捧月般的快感助長了野心，貪婪的目光開始覬覦原主所擁有的一切，那個曾經溫順的「獵物」，開始在暗處露出獠牙；而掌控一切的「獵人」，似乎也早已另有盤算。無名屍體、操控與反噬、偽裝與沉淪……在這場遊戲裡，究竟是誰在控制誰？",
          "runtime": 0,
          "tagline": "",
          "title": "天才遊戲"
        }
      }
    ]
