      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Adi, homoseksualni najstnik, poletje preživlja v domači vasi v delti Donave. Po brutalnem nočnem napadu se mu naslednji dan svet postavi na glavo. Njegovi starši ga gledajo drugače, kot so ga prej, in navidezni mir vasi začne razpadati.",
