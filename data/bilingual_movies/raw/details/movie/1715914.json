      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "1985 schrieb WHAM! Geschichte als erste westliche Popgruppe, die im kommunistischen China auftrat. Die Konzerte von George Michael und Andrew Ridgeley in Peking und Guangzhou waren ein kultureller Meilenstein – Ost trifft West, Musik trifft Politik. Nun enthüllt neu restauriertes Filmmaterial die bisher unbekannte Geschichte dieser legendären Tournee, die WHAM! zu Weltruhm verhalf.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "V roce 1985 se WHAM! zapsali do historie jako první západní popová kapela, která vystoupila v komunistické Číně. Koncerty George Michaela a Andrewa Ridgeleyho v Pekingu a Kantonu představovaly významný kulturní milník – Východ se setkal se Západem, hudba s politikou. Nově restaurované záběry nyní odhalují dosud nevyprávěný příběh tohoto ikonického turné, které pomohlo katapultovat WHAM! mezi světové superhvězdy.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
