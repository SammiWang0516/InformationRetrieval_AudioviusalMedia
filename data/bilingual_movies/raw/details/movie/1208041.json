  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Mirah, a woman shunned by her village after the mysterious deaths of men connected to her, seeks refuge in a Padang restaurant owned by Bana, who falls in love with her. As more men die, Mirah discovers she’s cursed by her stepsister Puti with the deadly “Bahu Laweyan” curse, which kills any man who becomes intimately involved with her. Fueled by revenge, Mirah plans to destroy Puti’s happiness by targeting her husband. Despite the deadly curse, Mirah and Bana craft their own tragic love story, choosing to be together no matter the consequences.",
          "runtime": 97,
          "tagline": "",
          "title": "The Queen of Witchcraft"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "故事根植爪哇古老秘咒民间传说，女主米拉从小被继妹普蒂种下致命诅咒：任何与她产生亲密情愫、爱慕她的男性，都会接连离奇暴毙。接连数名男性因她诡异身亡后，米拉被全村视作「厄运载体、灾厄女人」，遭到村落驱逐、全民孤立。走投无路的她辗转落脚在巴东风味餐厅打工，餐厅老板巴纳无视外界流言，平等地接纳、爱上了饱受诅咒折磨的米拉。可甜蜜恋情很快被诅咒反噬，死亡阴影再度缠绕在巴纳身边。米拉这才查清，这道夺命咒术是继妹出于嫉妒刻意施加。为了守护爱人、挣脱世代诅咒，米拉放弃被动承受厄运，主动修习爪哇黑巫术，向施咒的继妹发起复仇反击。  爪哇古典民俗传说，巫术体系、祭祀礼仪、传统服饰场景考据考究，视觉暗黑美学氛围感极强，晚宴群鬼、巫术施法镜头极具视觉冲击力。",
          "runtime": 0,
          "tagline": "",
          "title": "摄魂天母"
        }
      }
    ]
  },
