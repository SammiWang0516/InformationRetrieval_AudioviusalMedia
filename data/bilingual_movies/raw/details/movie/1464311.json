      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "스페인에 정착한 중국인 이민자 가정의 2세대인 감독은 카메라를 들고 오빠 아웬의 삶을 들여다본다. ‘가족이란 세상에서 가장 가까운 타인’이란 말처럼, 동생의 시선은 낯설고 복잡한 인물의 초상을 만들어낸다. 절에서 시작해 가라오케에서 끝나는 영화의 여정은 아웬이라는 인물의 극단적인 양면을 고스란히 품는다. 명상을 통해 마음의 평화를 찾으려는 영혼과 도박, 폭력, 총기 사건에 얽혔던 갱스터로서의 과거. 사업가이자 가장으로서의 일상과 거리의 형제들과 어울리는 삶.",
          "runtime": 0,
          "tagline": "",
          "title": "새벽에서 다시 새벽으로"
        }
