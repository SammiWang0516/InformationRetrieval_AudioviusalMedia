      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Paryż, współczesny dzień, w typowym bistro. Jade (Kim Higelin), rozczarowana młoda kobieta, poznaje Leo (Victor Poirier), charyzmatycznego mężczyznę. Wyruszają na spontaniczną i niekonwencjonalną randkę, pełną lekkości, destrukcyjnej terapii i głębokich rozmów. Podczas gdy wspólnie eksplorują miasto, odkrywają więź, która przekracza normy i oczekiwania społeczne, kwestionując znaczenie miłości i związków we współczesnym świecie.",
          "runtime": 90,
          "tagline": "",
