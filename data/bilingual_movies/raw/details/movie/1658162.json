      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "네팔 쿰부 계곡에 사는 타망족 형제는 산과 각기 다른 관계를 맺고 있다. 한 명은 에베레스트 베이스캠프로 향하는 관광객의 짐꾼으로 일하며 가이드를 꿈꾸고, 다른 한 명은 고산 수도원의 불교 승려로 위대한 라마가 되기를 꿈꾸며 형제의 안전한 등반을 기도한다. 산악 관광의 성장으로 오히려 심화된 가난에서 벗어나려는 두 형제는 생존과 꿈 사이에서 삶을 바꿀 선택과 마주한다.",
          "runtime": 90,
          "tagline": "",
          "title": "설산에서"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Terwijl Lhakpa zijn langdurige studie tot boeddhistische monnik afrondt, werkt zijn broer SangBahadur als drager voor de internationale reizigers die de Everest tot een toeristisch centrum maken. Familiezaken dwingen de jongste om uit zijn pensioen te komen en de kost te verdienen. Daarbij wordt hij geconfronteerd met de moderne wereld in al haar paradoxale complexiteit.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
