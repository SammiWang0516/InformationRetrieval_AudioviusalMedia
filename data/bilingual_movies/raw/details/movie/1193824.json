  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "http://rabbittrapfilm.com",
          "overview": "When a musician and her husband move to a remote house in Wales, the music they make disturbs local ancient folk magic, bringing a nameless child to their door intent on infiltrating their lives.",
          "runtime": 88,
          "tagline": "Let them in.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Situé en 1973, les musiciens Daphne et Darcy Davenport, quittent Londres pour s'installer dans une cabane isolée au Pays de Galles afin de terminer leur nouveau disque. Lorsqu'ils enregistrent accidentellement sur le terrain un son mystique jamais entendu auparavant par des oreilles humaines, un enfant étrange entre dans leur vie...",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Het verhaal speelt zich af in 1973, de getrouwde muzikanten Daphne en Darcy Davenport verhuizen van Londen naar een afgelegen hut in Wales om hun nieuwe plaat te voltooien.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "음악가와 그녀의 남편이 웨일즈의 외딴 집으로 이사를 가게 되자, 그들이 만드는 음악 때문에 그 지역의 고대 민속 마법이 방해를 받아, 이름 없는 아이가 그들의 집에 찾아와 그들의 삶에 침투하려고 한다.",
          "runtime": 89,
          "tagline": "",
          "title": "래빗 트랩"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "1976 год. Супруги Дарси и Дафна приезжают в валлийскую деревушку, чтобы заняться своими проектами. Оба работают со звуком: Дафна создаёт мелодии из звуков, которые муж-звукорежиссёр записывает на портативный микрофон. Однажды во время записи Дарси падает в некий магический круг, а на следующий день к ним заявляется якобы сосед — подросток, который постепенно втирается к паре в доверие и начинает рассказывать про разные верования этих краёв.",
          "runtime": 0,
          "tagline": "",
          "title": "Ловушка для кролика"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Подружжя музикантів Дафні та Дарсі Давенпорт переїжджають із Лондона до котеджу в Уельсі, щоб завершити свій новий альбом. Випадково вони записують містичний звук, якого ніхто ніколи не чув, і поступово втрачають зв’язок із реальністю.",
          "runtime": 0,
          "tagline": "",
          "title": "Пастка для кролика"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Cuando una música y su esposo se mudan a una casa remota en Gales, la música que crean altera la magia popular ancestral del lugar, trayendo a su puerta a un niño sin nombre que tiene la intención de infiltrarse en sus vidas.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Daphne și Darcy Davenport sunt doi muzicieni căsătoriți care s-au mutat din Londra la o cabană din Țara Galilor pentru a-și finaliza noul album. Din întâmplare, ei înregistrează un sunet nemaiauzit până atunci și se deconectează treptat de la realitate.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "AE",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "http://rabbittrapfilm.com",
          "overview": "عندما تنتقل موسيقية وزوجها إلى منزل ناءٍ في ويلز، تثير الموسيقى التي يصنعانها قوى سحرية فولكلورية قديمة في المنطقة، مما يجلب إلى بابهما طفلًا بلا اسم يعتزم التغلغل في حياتهما.",
          "runtime": 97,
