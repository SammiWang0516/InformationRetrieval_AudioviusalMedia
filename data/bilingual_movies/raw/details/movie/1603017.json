      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Câu chuyện kể về Trình Khải, một lính đặc chủng đã giải ngũ. Để tìm kiếm người vợ là Tiêu Linh, một nhân viên y tế bị mất tích, anh một mình xâm nhập vào khu vực Shachar, nơi các thế lực khủng bố hoành hành. Trình Khải lén thâm nhập cứ điểm trung tâm Talin, đối đầu trực diện với bọn lính đánh thuê đang chiếm đóng nơi đây. Trong quá trình đó, anh nhận được sự trợ giúp then chốt từ Mira, một cô gái bị bắt cóc. Hai người cùng nhau trốn tránh truy sát, vượt qua muôn vàn hiểm nguy, cuối cùng phá vỡ vòng phong tỏa, giải cứu Mira khỏi nanh vuốt của đám lính đánh thuê, viết nên một hành trình sinh tử đầy cam go và quả cảm.",
          "runtime": 0,
          "tagline": "",
          "title": "Ứng Cứu Lôi Đình"
        }
      }
