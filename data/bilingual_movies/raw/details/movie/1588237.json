        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "https://www.fortnite.com/@epic/the-lost-chapter-yukis-revenge?lang=it",
          "overview": "Quentin Tarantino, il visionario regista, sognava un capitolo della saga di Kill Bill che non ha mai visto la luce sul grande schermo. Un capitolo chiamato: \"La vendetta di Yuki\". Oltre 20 anni dopo, Tarantino ed Epic hanno unito le forze per dare vita a questa storia su Fortnite. Creato con Unreal Engine e grazie ai modelli dei personaggi Fortnite, Il Capitolo perduto: La vendetta di Yuki di Tarantino è interpretato da Uma Thurman.",
          "runtime": 0,
          "tagline": "",
          "title": "Il capitolo perduto: La vendetta di Yuki"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "https://www.fortnite.com/@epic/the-lost-chapter-yukis-revenge?lang=ko",
          "overview": "독사 암살단의 수장 오렌 이시이를 쫓던 브라이드의 칼끝에 쓰러진 소녀 암살자 고고 유바리. 그 죽음의 소식은 바다 건너 일본에 남은 쌍둥이 자매 유키에게 전해진다. 빌은 브라이드가 다음 표적을 찾아 로스앤젤레스로 향할 것을 알고, 언니의 복수심으로 불타는 유키를 미국으로 보낸다. 선명한 핑크색 콜벳을 몰고 낯선 도시를 누비며 관광객처럼 사진을 찍고 거리를 즐기던 유키는, 공항에서 마침내 노란 추리닝의 그 여자를 발견한다. 해가 저물 때까지 조용히 뒤를 밟은 끝에 한 모텔 앞에 다다른 유키. 서로의 미모를 칭찬하는 묘한 일본어 대화가 끝나는 순간, 기관총과 수류탄이 쏟아지는 피의 밤이 시작된다. 킬 빌의 세계에서 끝내 잊혀질 운명이었던 또 하나의 챕터가 지금 펼쳐진다.",
          "runtime": 0,
          "tagline": "\"복수는 언니의 몫이 아니었다. 이번엔 내 차례다\"",
          "title": "잊혀진 챕터: 유키의 복수"
        }
      },
