      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Lidia en haar vader, Pablo, keren na de dood van haar moeder terug naar de vuurtoren van de familie. Pablo, zich bewust van Lidia's fragiele emotionele evenwicht, maakt zich zorgen over een mogelijke terugval na haar zelfmoordpoging. Lidia, geïrriteerd door het gebrek aan vertrouwen van haar vader, zal ontdekken dat er iets niet klopt bij de vuurtoren en dat er gevaar op hen wacht als ze de waarheid niet te weten komen.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
