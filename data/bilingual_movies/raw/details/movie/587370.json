      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Tom, Susan i Derek wracają do ogrodu pełnego zaczarowanych stworzeń i przygód, w którym niegdyś słuchali ulubionych opowiadań babci. Tworząc własne historie według rodzinnej tradycji, odkrywają, że wyobraźnia potrafi rozjaśnić nawet najbardziej pochmurny dzień. Wspólnie z dziadkiem sięgają po wspomnienia, które – jak bajki – nie blakną, a zmieniają kształt i zostają w sercu na zawsze. Opowieści z magicznego ogrodu to animacja poklatkowa, która pokazuje, jak ważne jest pielęgnowanie pamięci o bliskich, aby – z pomocą wyobraźni – odnaleźć nadzieję i wsparcie nawet w najtrudniejszych chwilach.",
          "runtime": 71,
          "tagline": "Rodzeństwo wraca do magicznego ogrodu, by poprzez tworzenie własnych opowieści ożywić wspomnienia o babci.",
          "title": "Opowieści z magicznego ogrodu"
        }
      },
      {
