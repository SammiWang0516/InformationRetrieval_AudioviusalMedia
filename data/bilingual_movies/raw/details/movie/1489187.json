  "translations": {
    "translations": [
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Алиса заселяется в просторную квартиру в Санкт-Петербурге, в которой начинает сбоить зеркало, показывая юной квартирантке параллельную реальность той же самой квартиры. Вот только проживает в этой параллельной реальности не Алиса, а тусовщик Иван. Сумеют ли молодые люди распознать настоящую любовь и по силам ли им окажется объединить свои миры, чтобы встретиться в реальности и просто прикоснуться друг к другу?",
          "runtime": 99,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Alisa moves into a spacious apartment in St. Petersburg, where the mirror starts to malfunction, showing the young lodger a parallel reality of the same apartment. Only it is not Alisa who lives in this parallel reality, but the party animal Ivan. Will the young people be able to recognize true love and will they be able to unite their worlds in order to meet in reality and simply touch each other?",
          "runtime": 99,
          "tagline": "",
          "title": "You Drive Me Crazy"
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "Delirtiyorsun"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "艾莉莎（米拉·埃尔绍娃 饰）搬进了圣彼得堡一间宽敞的公寓，公寓里的镜子却开始出现故障。它向这位年轻的房客展现了同一个公寓的平行世界，只不过，在这个平行世界里生活的不是艾丽莎，而是和她抢这间公寓的派对狂人伊万（尤里·纳索诺夫 饰）。这两位年轻人能否认清真爱？他们又能否让两个世界相连，在现实中相遇，只为简单地触碰彼此？",
          "runtime": 0,
          "tagline": "",
          "title": "爱上平行时空的你"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "艾莉莎搬進了聖彼得堡一間寬敞的公寓，公寓裏的鏡子卻開始出現故障。它向這位年輕的房客展現了同一個公寓的平行世界，只不過，在這個平行世界裏生活的不是艾麗莎，而是和她搶這間公寓的派對狂人伊萬。這兩位年輕人能否認清真愛？他們又能否讓兩個世界相連，在現實中相遇，只為簡單地觸碰彼此？",
          "runtime": 99,
          "tagline": "",
          "title": "愛上平行時空的你"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
