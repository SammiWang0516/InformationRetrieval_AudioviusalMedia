  "translations": {
    "translations": [
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "https://www.downtownfilmes.com.br/filmes-detalhes/uma-advogada-brilhante",
          "overview": "Michelle, um advogado em ascensão, lida com a constante confusão de seu nome, de origem italiana, com um nome feminino. Além disso, ele precisa arcar com todas as despesas de seu filho para evitar que a ex-esposa se mude do Brasil com o garoto. Quando sua empresa é comprada pelo maior escritório de advocacia do país todos os advogados são demitidos para equilibrar a equipe de gênero. Por causa da confusão com seu nome, Michelle é poupado, mas precisa fingir ser mulher para manter o emprego. Isso torna seu trabalho ainda mais desafiador.",
          "runtime": 96,
          "tagline": "Ele queria um salto na carreira, mas não esperava um salto alto.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "In the film, actor Leandro Hassum plays lawyer Michelle Barbieri, known as Mike. The company where he works is bought by an office that decides to keep only women in its positions. However, the character is not fired, since, due to her name, the HR department believes that she is a woman. The character then starts dressing in women's clothing to stay in his job.",
          "runtime": 95,
          "tagline": "",
          "title": "A Bright Lawyer"
        }
      },
      {
        "iso_3166_1": "FR",
