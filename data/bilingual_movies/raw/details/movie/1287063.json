  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "In the aftermath of an explosion that rocked the Pike River Mine and took the lives of 29 West Coasters, two women step up to fight for accountability.",
          "runtime": 131,
          "tagline": "In the fight for their men, they found each other.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Oparty na tragedii na rzece Pike w 2010 roku. Dramat ukazuje głębokie skutki jednej z najgorszych katastrof górniczych w historii Nowej Zelandii.",
          "runtime": 138,
          "tagline": "",
          "title": "Pike River"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Картина повествует о крупнейшей современной горнодобывающей катастрофе в Новой Зеландии — взрыве в шахте Пайк Ривер в 2010 году, в результате которого погибли 29 человек. Главные героини — Анна Осборн и Соня Рокхаус. Каждая потеряла близких в трагедии — мужа и сына соответственно. Вместе они инициируют многолетнюю борьбу за правду и справедливость, которая превращается в масштабную общественную кампанию.",
          "runtime": 0,
          "tagline": "",
          "title": "Пайк Ривер"
        }
      },
      {
        "iso_3166_1": "IR",
        "iso_639_1": "fa",
        "name": "فارسی",
        "english_name": "Persian",
        "data": {
          "homepage": "",
          "overview": "داستان انفجار یک معدن زغال سنگ و مرگ 29 معدنچی در نیوزیلند که از نگاه دو زن داغدار، تلاش خانواده‌ها برای کشف حقیقت و رسیدن به عدالت را روایت می‌کند.",
          "runtime": 0,
          "tagline": "",
          "title": "رودخانه پایک"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "讲述了安娜·奥斯本和索尼亚·罗克豪斯的真实故事，这两位女性在2010年派克河煤矿悲剧后为正义而战，该悲剧夺去了29名男子的生命。",
          "runtime": 131,
          "tagline": "",
          "title": "派克河之殇"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "L'histoire vraie de la lutte de deux femmes, Anna Osborne et Sonya Rockhouse, qui ont perdu leurs proches dans la catastrophe de la mine de Pike River en Nouvelle-Zélande en 2010, où 29 hommes sont morts ; le film suit leur combat pour obtenir justice contre les puissants du gouvernement et de l'industrie, remettant en question les récits officiels pendant plus d'une décennie pour réclamer des comptes aux responsables et tenter de ramener leurs hommes.",
          "runtime": 131,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Basado en la tragedia de Pike River de 2010, este drama capta el profundo impacto de uno de los peores desastres mineros de la historia de Nueva Zelanda.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
