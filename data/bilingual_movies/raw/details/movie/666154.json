      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "בעיר מסתורית וקסומה בלב ליבה של אימפריית האינקה, חיה קיארה, נערה שאפתנית ונחושה, החולמת להיות שליחה רשמית של האימפריה. בהיותה אמיצה, חזקה ומהירה, היא כבר מתאימה לתפקיד פיזית; השליחים היו ידועים בנועזות ובמהירות שלהם, אולם תפקידם החשוב, כנושאי הודעות בין כל קצוות האימפריה, היה שמור באופן מסורתי ובלעדי - לגברים בלבד, כמו אביה הנערץ. קיארה מחליטה לצאת למסע מאתגר, במטרה להוכיח שהיא ראויה, וכדי להגשים את עצמה ואת חלומה.",
          "runtime": 0,
          "tagline": "",
          "title": "קיארה בממלכת האינקה"
        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Kayara, uma jovem inca, sonha juntar-se ao grupo de mensageiros Chasqui, composto exclusivamente por homens. Ela desafia as tradições e as normas de género para prosseguir a sua ambição contra todas as probabilidades.",
          "runtime": 81,
          "tagline": "",
          "title": "Kayara - A Menina Inca"
        }
      },
      {
        "iso_3166_1": "LT",
        "iso_639_1": "lt",
        "name": "Lietuvių",
        "english_name": "Lithuanian",
        "data": {
          "homepage": "",
          "overview": "Narsi ir užsispyrusi Kajara svajoja tapti pirmąja imperatoriškąja pasiuntine – garbingos ir nuo senų laikų Inkų imperijoje vertinamos profesijos atstove, kuria galėjo tapti tik patys greičiausi ir ištvermingiausi. Norėdama įrodyti, jog yra verta šio titulo, ji turės įveikti daugybę iššūkių ir pavojų kupiną kelią, kuriame svarbiausia – greitis, drąsa ir atkaklumas.\r Tačiau viskas apsiverčia aukštyn kojomis, kai Kajara sužino, jog jos gimtajam Auksiniam miestui gresia pavojus. Vien svajonės siekti nebeužtenka – dabar jai teks ne tik kovoti už savo vietą tarp geriausiųjų, bet ir surasti būdą apsaugoti savo namus bei visą imperiją!",
          "runtime": 0,
          "tagline": "",
          "title": "Narsioji Kajara"
        }
      },
      {
        "iso_3166_1": "EE",
        "iso_639_1": "et",
        "name": "Eesti",
        "english_name": "Estonian",
        "data": {
          "homepage": "",
          "overview": "idses Inkade riigis on au sees Chasquisi aunimetusega sõnumite kohale viijad. Nad on riigi kõige kiiremad, kõige osavamad ja kõige vastupidavamad, kes kunagi ei anna alla ja saavad hakkama ükskõik, kui raske ülesandega. Noor ja visa Kayara on võtnud endale eesmärgiks, et ka just temast peab saama üks nende hulgast. Selleks tuleb aga ette võtta pikk ja ohtlik seiklusrada ja edastada kõiki teisi võistlejaid.",
          "runtime": 0,
          "tagline": "",
          "title": "Kayara"
        }
      },
      {
        "iso_3166_1": "RS",
        "iso_639_1": "sr",
        "name": "Srpski",
        "english_name": "Serbian",
        "data": {
          "homepage": "",
          "overview": "У древном царству Инка, важне су поруке носили часкуи – муњевити „поштански курири” који су трчали брже од ветра! То је било тајно друштво супер-гласника у које су могли да уђу само момци. Али Кајара, храбра и снажна 16-годишња девојка, одлучује да промени правила игре. Жели да постане прва девојка-часкуи и ништа је на том путу неће зауставити! Претрчаће стрме планинске стазе, заронити у магловите џунгле и попети се до снежних врхова. Кајара ће открити тајанствени Златни Град, бранити га од похлепних уљеза и - наравно - спасити своје пријатеље и породицу. Хоће ли јој поћи за руком?",
          "runtime": 0,
          "tagline": "Кад храброст надјача традицију.",
          "title": "Кајара: Легенда о изгубљеном граду"
        }
      }
    ]
