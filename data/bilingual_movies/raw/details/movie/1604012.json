      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "\"David Bowie starb nie wirklich“ – so scheint es. Ob als Ziggy Stardust 1973, als Unfallopfer auf dem Album \"Lodger\" (1979) oder im Film \"Begierde\" (1983): Bowie inszenierte seinen Abschied immer wieder. Zehn Jahre nach seinem Tod würdigen die Regisseure Gautier & Leduc den genialen Musiker mit einer Hommage. Internationale Stars spielen Coverversionen, die sein Werk lebendig halten.",
          "runtime": 53,
          "tagline": "Heroes never die",
          "title": "Tribute to David Bowie"
        }
      }
