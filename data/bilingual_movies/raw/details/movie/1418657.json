      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Merriell Sunday Sr. e Hollis Bannister desapareceram no Alasca. Ellie e Merriell Jr. organizam uma busca, mas uma ameaça ancestral persegue a sua expedição pela selva, caçando-os enquanto procuram a verdade por trás dos desaparecimentos.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "석유 재벌과 유명 탐험가가 알래스카 북부 외딴 지역의 혹독한 겨울 속으로 사라지자, 정예 구조팀이 그들을 집으로 데려오기 위해 나선다. 하지만 그들이 알지 못하는 것은, 그곳이 예티의 영역이라는 사실이며, 혹독한 자연환경은 그들의 걱정거리 중 가장 사소한 것에 불과하다는 점이다.",
          "runtime": 0,
          "tagline": "",
          "title": "더 예티"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Wanneer een oliemagnaat en een beroemde avonturier verdwijnen in de barre winter van het afgelegen noorden van Alaska, probeert een speciaal samengesteld reddingsteam hen terug te halen. Wat ze niet weten, is dat ze het territorium van de Yeti betreden en dat de koude het minste van hun zorgen zijn.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Když ropný magnát a slavný dobrodruh zmizí v drsné zimě na odlehlém severu Aljašky, vybraný záchranný tým se pokusí přivést je zpět domů. Netuší však, že vkročili na území Yetiho, a přírodní živly jsou tím nejmenším z jejich starostí.",
          "runtime": 91,
