      {
        "iso_3166_1": "HR",
        "iso_639_1": "hr",
        "name": "Hrvatski",
        "english_name": "Croatian",
        "data": {
          "homepage": "",
          "overview": "Anna, shrvana iznenadnom smrću svojih roditelja, seli se iz New Yorka u mali floridski gradić kako bi živjela s bakom koju nikada nije upoznala. Izolirana, ranjiva i gladna prijateljstva, privremenu utjehu pronalazi u društvu dvoje lokalnih tinejdžera. No kada postane suučesnica njihova neoprostivog čina nasilja, Anna se nađe u kandžama gospodina Sandmana – iskrivljene duše izmučenog djeteta koji proganja snove nasilnika, a potom im, nakon što se probude, vadi i jede očne jabučice. Anna mora ispraviti svoju pogrešku prije nego što i sama postane žrtva tog jezivog prokletstva.",
          "runtime": 0,
          "tagline": "Ne možeš pobjeći svojim snovima.",
          "title": "Oko za oko"
        }
      },
