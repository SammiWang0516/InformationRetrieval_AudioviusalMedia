      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Weteran z Wietnamu, Jonathan Teller, cierpi na poczucie winy i paranoiczne urojenia. Postanawia odebrać sobie życie, ale gdy próbuje pogodzić się ze swoim wyborem i rzeczywistością, przypadkowe spotkanie zmienia wszystko.",
          "runtime": 0,
          "tagline": "",
          "title": "The Plastic Men"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Jonathan Teller é um homem mercado pela tragédia desde cedo. Obrigado a escolher entre ir para o Vietnã ou ser preso, ele opta pelo serviço militar. Após sobreviver ao conflito, Jonathan enfrenta uma luta ainda mais difícil: o transtorno de estresse pós-traumático, que domina seus dias e noites. Isolado e em sofrimento, ele vive como um -homem de plástico -, quebrado e moldado pela guerra. Porém, quando menos espera, um encontro como alguém que parece um anjo lhe oferece esperança e um possível caminho para a cura.",
          "runtime": 0,
          "tagline": "",
          "title": "Perturbado Pelo Passado"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Після жахів В’єтнаму Джонатан Теллер повертається додому, але війна не залишила його. Кожен день і кожна ніч стають боротьбою з темрявою всередині — привиди минулого, моторошні галюцинації та нав’язливе відчуття провини розмивають межу між реальністю і кошмаром. Стоячи на порозі власного самогубства, він випадково зустрічає те, що змінює все, змушуючи дивитися в очі демонам, які ховаються не лише всередині нього, а й у світі навколо. Темрява й тиша стають смертельною загрозою, а найменший звук може розквітнути жахом. Кожен крок, кожна ніч — це випробування, де межі між життям і смертю, між реальним і вигаданим повністю зникають, і Джонатан змушений знайти в собі сили, щоб вижити у власному кошмарі.",
          "runtime": 0,
          "tagline": "",
          "title": "Психоз: Зламана реальність"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Jonathan Teller, obligado a luchar en Vietnam, sobrevive al conflicto externo, pero libra una dura batalla interna contra el trastorno de estrés postraumático (TEPT), hasta que un encuentro inesperado cambia su trayectoria.",
          "runtime": 0,
          "tagline": "",
          "title": "Perturbado por el pasado"
        }
