  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Two best friends rally the neighbors in their tenement building to help them hide a dead body over the best/worst night of their lives.",
          "runtime": 90,
          "tagline": "5 floors. 4 neighbors. 3 cops. 2 bodies. 1 night.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "邦尼是个混混，一次干活时出了岔子，陷入了一场生死搏斗。在他最好的朋友迪诺的帮助下，这场搏斗开启了纽约一个炎热又漫长的夏日。他们和东村公寓楼的邻居们一起密谋隐藏一具尸体，却屡屡失败。我说尸体了吗？我是说多具尸体。警察一直在四处打探，楼下的邻居想开派对，一位爱彼迎的客人渴望爱情，一位疏远已久的父亲重新出现，而邦尼只想熬过这个夜晚。",
          "runtime": 0,
          "tagline": "",
          "title": "润出去"
        }
      },
      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Med divjim poletnim dnem in nočjo v stanovanjski zgradbi v East Villageu ulični prevarant Bunny ter njegov prijatelj Dino načrtujeta, da bi prikrila truplo. Skupaj z ekipo ekscentričnih sosedov sprožita niz norih dogodkov, ko ura tiktaka, vročina narašča in se njihova »najboljša/najslabša noč v življenju« spreminja v popoln kaos.",
          "runtime": 0,
          "tagline": "5 nadstropij. 4 sosedje. 3 policisti. 2 trupli. 1 noč.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Dos mejores amigos reúnen a los vecinos de su edificio de viviendas para que les ayuden a ocultar un cadáver y pasar la noche.",
