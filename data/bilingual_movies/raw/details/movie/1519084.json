      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "http://press.amazonmgmstudios.com/us/en/original-movies/the-merchants-of-joy",
          "overview": "Dans la ville qui ne dort jamais, chaque hiver, cinq familles transforment les trottoirs en avant-postes de fête. Les Marchands de joie suit ces inconditionnels de Noël qui préservent leur tradition familiale en allant chercher les sapins à la source. Ce sont des portraits authentiques qui montrent leur fierté, leur ténacité et la joie qu'ils apportent avec chaque sapin, saison après saison.",
          "runtime": 90,
          "tagline": "",
          "title": "Les Marchands de joie"
        }
