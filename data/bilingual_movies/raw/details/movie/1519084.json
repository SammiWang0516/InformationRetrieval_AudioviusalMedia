      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "W mieście, które nigdy nie śpi, każdej zimy pięć rodzin zmienia miasto w świąteczny jarmark. Film opowiada o zmaganiach towarzyszących zagrożonemu rodzinnemu biznesowi. Ciepły i ludzki obraz dumy, odwagi i radości, jaką przynoszą przez każde drzewko, każdemu klientowi, co sezon.",
