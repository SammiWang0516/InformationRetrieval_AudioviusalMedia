      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "熱情隨性的媽媽與講求紀律的爸爸發生衝突，夾在中間的小女孩該如何自處呢？一碗平凡的粥悄然化作奇幻世界，廚師與天文學家紛紛現身求助，期盼能擺脫「粥怪」的糾纏⋯⋯。本片運用獨特的黏土素材與誇張的透視美學，帶領觀眾以童趣視角看見孩子應對日常風暴的勇氣。",
          "runtime": 0,
          "tagline": "",
          "title": "早安！粥之美"
        }
      }
