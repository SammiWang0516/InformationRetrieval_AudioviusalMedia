      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "影片由菲律宾传奇女主播杰西卡·索霍亲自串联引路，将三个宣称由真实民间经历改编的恐怖噩梦搬上银幕：分段《Pocong（印尼僵尸/裹尸）》讲述了一名年轻的见习海员在首次随船出海的航程中，于幽闭沉闷的货轮深处遭遇东南亚最凶残的裹尸怨灵袭击的绝望经历；分段《Berbalang（食尸鬼）》则深入菲律宾最神秘的古老村落，剥开一个崇拜食尸秘术、靠蚕食活人内脏维持长生的恐怖邪教黑幕；分段《Sanib（附身）》聚焦于一名正在接受严苛训练的年轻见习神父，讲述他为了拯救被极恶怨灵附身自残的少女，不得不直面内心深处的信仰动摇与最原始的恶魔展开一场赌上灵魂的冰冷驱魔对决。",
          "runtime": 117,
          "tagline": "",
          "title": "菲律宾都市怪谈"
        }
      }
    ]
