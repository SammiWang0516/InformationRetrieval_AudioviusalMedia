      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "从少年到大师，回顾过去，从李秀满的个人档案中了解韩流的起源，以及SM娱乐旗下最受欢迎的艺人——宝儿、少女时代、EXO，以及最新成员Aespa——的音乐和素材。《李秀满：韩国流行音乐之王》是一部纪录片，记录了一位大胆梦想家的迷人人生，他的作品让韩国闻名世界，引发了一场全球运动，并持续定义着一个时代。",
          "runtime": 0,
          "tagline": "",
          "title": "李秀满：韩国流行音乐之王"
        }
      },
