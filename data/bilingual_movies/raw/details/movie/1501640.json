  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A honeymoon goes tragically wrong when new groom, Brendan, falls off a hotel balcony, leaving his bride, Sarah, devastated. When the autopsy points to murder, Sarah must quickly prove her innocence or risk a lifetime separated from her stepdaughter.",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Een huwelijksreis loopt tragisch mis wanneer de nieuwe bruidegom, Brendan, van een hotelbalkon valt en zijn bruid, Sarah, kapot achterlaat. Wanneer de autopsie op moord wijst, moet Sarah snel haar onschuld bewijzen, anders riskeert ze een leven lang gescheiden te blijven van haar stiefdochter.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Luna de miere se transformă într-un coșmar când mirele Brendan cade de pe balconul hotelului, lăsând-o pe mireasă, Sarah, devastată. Când autopsia indică crimă, Sarah trebuie să își dovedească rapid nevinovăția sau riscă să fie despărțită pentru totdeauna de fiica ei vitregă, Kennedy.",
          "runtime": 87,
          "tagline": "",
          "title": "Jurăminte spulberate"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Sarah et Brendan viennent de se marier. Mais lors de leur première nuit de lune de miel, Sarah découvre le corps sans vie de son mari. Soupçonnée, isolée, elle décide de mener l'enquête. Une quête de vérité qui révélera des secrets profondément enfouis... et changera à jamais la vie de ceux qui l'entourent.",
          "runtime": 90,
          "tagline": "",
          "title": "Une lune de miel mortelle"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Miesiąc miodowy zamienia się w koszmar, gdy Brendan ginie po upadku z dużej wysokości w hotelu. Policja uznaje zdarzenie za tragiczny wypadek, twierdząc, że nowożeniec przesadził z alkoholem i stracił równowagę. Siostra zmarłego, Rachel, nie potrafi pogodzić się ze stratą i doznaje wstrząsu, gdy autopsja wykazuje, że Brendan został zamordowany.",
          "runtime": 0,
          "tagline": "",
          "title": "Na krawędzi prawdy"
        }
      }
