      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Thudarum est un film dramatique indien en malayalam réalisé par Tharun Moorthy, qui a écrit le scénario avec K. R. Sunil. Il met en vedette Mohanlal et Shobana, ainsi que Farhaan Faasil, Maniyanpilla Raju, Binu Pappu, Irshad Ali, et Aarsha Chandini Baiju, Thomas Mathew, Krishna Praba, Prakash Varma, et Aravind dans des rôles secondaires. Le film a été produit par M. Renjith par l'intermédiaire de Rejaputhra Visual Media. La bande originale a été composée par Jakes Bejoy et sortira le 25 avril 2025.",
          "runtime": 163,
          "tagline": "",
          "title": "Thudarum"
        }
      },
