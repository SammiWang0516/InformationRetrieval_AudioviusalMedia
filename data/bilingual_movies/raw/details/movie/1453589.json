    "translations": [
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Noboru é um menino de 10 anos, descendente de japoneses, que recorre ao avô para investigar a história da família. Apesar de sempre ter evitado falar do passado, Hideo acaba aceitando se abrir para o neto e assim Noboru descobre ter um tio que nunca conheceu.",
          "runtime": 84,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Noboru is a 10-year-old boy in search of his cultural identity. He turns to his grandfather Hideo, to find out more about his family. Despite always avoiding his past, his grandfather agrees to tell his story. As Noboru delves into his family history, he discovers he has an uncle he’s never heard about.",
          "runtime": 84,
          "tagline": "",
          "title": "My Grandfather Is a Nihonjin"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Sao Paulo, années 1980… Noboru doit préparer pour l’école un exposé sur ses origines japonaises qu’il a toujours cherché à gommer. Il doit alors se tourner vers son grand-père grincheux, Hideo, pour apprendre à connaître en profondeur sa famille et l’histoire de l’arrivée de ce dernier au Brésil en 1920, quand il était encore un jeune homme. Ayant toujours voulu éviter d’évoquer son passé et son déracinement, poussé par son épouse, adorable grand-mère, Hideo accepte à contre-cœur de raconter à Noboru son histoire et son installation en Amérique du Sud. Au fur et à mesure que ce dernier plonge dans le récit de l’exil de ses ancêtres, le jeune écolier se plaira à s’approprier cette culture de l’autre bout du monde et découvrira même l’existence d’un oncle inconnu…",
          "runtime": 82,
          "tagline": "",
          "title": "Ma famille de samouraïs"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "日裔少年阿昇一直對自己的身份認同感到迷惘。為了尋找家族根源，他決定敲開公公那扇緊閉的心門。然而，公公對過去絕口不提，態度冷淡。在阿昇鍥而不捨的追問下，意外扯出一件塵封數十年的家族秘密。這段被刻意隱瞞的過去，反映了家族的掙扎與犧牲，更連繫著一個顛覆阿昇想像的隱密羈絆。這個發現將徹底改寫他對家族、對自己，以至對未來的定義。",
          "runtime": 0,
          "tagline": "",
          "title": "我的日本公公"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Noboru is een jongen van tien die op zoek is naar zijn culturele identiteit. Hij klopt aan bij zijn grootvader Hideo om meer over zijn familie te weten te komen. Hoewel hij zijn verleden altijd heeft ontweken, stemt zijn grootvader ermee in zijn verhaal te vertellen. Terwijl Noboru zich verdiept in zijn familiegeschiedenis, ontdekt hij dat hij een oom heeft waar hij nooit van heeft gehoord.",
          "runtime": 84,
          "tagline": "",
          "title": ""
        }
