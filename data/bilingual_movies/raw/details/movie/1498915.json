  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "​Having stepped back from acting after marriage and a subsequent divorce, actress Bae Jeongsu returns to the profession with a role in an independent film. As the film’s release approaches, she takes part in a series of press interviews, only to discover later, when asked to revisit those moments in her acting class, that she cannot clearly recall what was said.",
          "runtime": 85,
          "tagline": "",
          "title": "The Day She Returns"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "결혼 후 연기를 안 하게 되었고, 이혼 후 다시 일을 하기 위해 독립영화를 한 편 찍었다. 오늘 그 찍은 영화의 개봉을 위해 인터뷰를 한다. 중년의 나이가 돼서 아주 오랜만에 세상에 배우로 얼굴을 내미는 날이다. 세 번의 인터뷰가 삼 십분 간격으로 이어지고 여자는 질문들에 최선을 다해서 답한다. 인터뷰 후에 새로 시작한 연기수업에 가게 된다. 거기서 연기 선생은 오늘 있은 인터뷰를 다시 재현해보라고 한다. 인터뷰 중에 가장 중요한 부분에 다다르면 여자는 왠일인지 기억이 전혀 나지 않는 것 같다. 피곤하고 집으로 빨리 돌아가고 싶다. 딸이 기다리고 있다.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "她刚拍完一部独立电影，现在要接受三场采访。之后在表演课上，老师要求她重新演绎那些采访，但不知为何，她竟完全记不起来了。",
          "runtime": 0,
          "tagline": "",
          "title": "她回来的那天"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "После развода вернувшаяся в профессию актриса даёт три интервью в день премьеры своего независимого фильма.",
          "runtime": 84,
          "tagline": "",
          "title": "В тот день, когда она вернулась"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "她復出的那天"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Elle vient de terminer le tournage d’un film indépendant et doit maintenant donner trois interviews à ce sujet. Ensuite, lors de son cours de théâtre, son professeur lui demande de rejouer les interviews. Mais, pour une raison quelconque, elle est incapable de s’en souvenir.",
          "runtime": 84,
          "tagline": "",
          "title": "Le Jour de son retour"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Nadat actrice Bae Jeongsu zich na haar huwelijk en de daaropvolgende scheiding uit de acteerwereld had teruggetrokken, keert ze terug naar het vak met een rol in een independent film. Naarmate de release van de film nadert, neemt ze deel aan een reeks persinterviews, om later, wanneer haar in haar acteerles wordt gevraagd die momenten opnieuw op te roepen, te ontdekken dat ze zich niet duidelijk kan herinneren wat er werd gezegd.",
          "runtime": 0,
          "tagline": "",
          "title": ""
