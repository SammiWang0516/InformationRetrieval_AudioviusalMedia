        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "生于饱受战火摧残的黎巴嫩，要给首都贝鲁特写一封情书的话，可能会发现千头万绪不知从何说起。缺乏历史档案影片，导演Lana Daher就尝试来一次亲密对话，借用横跨七十年的黎巴嫩视听素材，包括电影及电视片段、家庭录像和照片，透过女性视角，重新剪辑及诠释，将集体创伤和个人记忆互相交织，重塑本来就支离破碎的历史。当中有女记者重返自己被空袭炸毁的家园实地报导，也有男子谈论游客观光来看战争遗迹，而在纷杂记忆里，既有毁灭与伤痕，更有欢笑和活力。",
          "runtime": 0,
          "tagline": "",
          "title": "你爱我吗？"
        }
      },
