        "data": {
          "homepage": "https://www.sonypictures.com/movies/turnonocturno",
          "overview": "A young nurse with a domestic abuse past starts working the night shift at a small hospital, where, during the night, the ghost of a nurse materializes.",
          "runtime": 107,
          "tagline": "There's no cure for this evil.",
          "title": "Night Shift"
        }
