  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Driven by childhood traumas of neglect and severe body image issues, a prominent beauty influencer's obsessive pursuit of online validation triggers a devastating spiritual curse, resulting in a gruesome physical deterioration that challenges her vanity.",
          "runtime": 110,
          "tagline": "",
          "title": "Evil Eye"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "乔伊是坐拥数万粉丝的美妆网红，人生全靠镜头前的完美容貌和直播间的赞美堆砌。从小被忽视的容貌焦虑刻进骨子里，她疯魔一样追求更高的播放量和更完美的外表。可这份极致的虚荣，却意外唤醒了古老的邪眼诅咒。先是眼睛里长出密密麻麻的小眼，接着畸变顺着血管爬满全身，肉身一寸寸溃烂扭曲。她必须在彻底变成怪物之前，挖出诅咒的根源，可越接近真相，越发现这一切都来自她最不堪的童年阴影。",
          "runtime": 110,
          "tagline": "",
          "title": "妙龄怨"
        }
      }
    ]
  },
