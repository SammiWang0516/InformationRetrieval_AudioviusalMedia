        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Egy magányos özvegy csendes élete felfordul, amikor egy tinédzser fiú véletlenül a kertjébe rúgja a labdáját.",
          "runtime": 0,
