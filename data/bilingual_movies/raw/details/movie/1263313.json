      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "伊斯馬埃爾的母親在小村經營著名為「粉紅屋」的妓院，他也因此被戲稱為「娼妓之子」。為了逃離這一切，他決定離開母親，去尋找人生中從未擁有的兩樣東西：父親與大海。他隨身帶著對父親唯一的記憶——一本《白鯨記》，與三條腿的狗巴卡略一同踏上旅途，穿越巴西乾旱的內陸荒地。然而這段旅程將告訴他，一個人終究需要面對自己，也無法逃離命運。",
          "runtime": 0,
          "tagline": "",
          "title": "我在紅燈區長大"
        }
      }
