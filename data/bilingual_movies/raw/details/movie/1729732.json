      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Późna jesień. Isak walczy o przetrwanie na pustkowiu. Pewnego dnia zza góry wyłania się Inger. Z nieszczęśliwego spotkania rodzi się miłość. W bezlitosnej naturze Isak i Inger walczą o wspólne życie. Kierując się miłością, budują farmę Sellanraa od zera. Kiedy mroczny sekret wychodzi na jaw, miłość zostaje wystawiona na próbę.",
          "runtime": 155,
          "tagline": "",
          "title": "Growth of the Soil"
        }
      },
      {
