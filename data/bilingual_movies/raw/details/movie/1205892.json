      {
        "iso_3166_1": "MY",
        "iso_639_1": "ms",
        "name": "Bahasa melayu",
        "english_name": "Malay",
        "data": {
          "homepage": "",
          "overview": "Au Yeung Wai Yip adalah seorang detektif swasta yang selama bertahun-tahun fokus pada penyelidikan kes orang hilang dan perselingkuhan. Suatu hari, dia menerima satu komisen \"istimewa\": pemilik agensi pelancongan memintanya menyiasat kekasihnya, yang ternyata adalah isteri Au Yeung Wai Yip sendiri. Sebagai seorang detektif swasta, dia terbiasa mencari kebenaran dengan mata yang dingin untuk kliennya, tetapi sukar baginya menghadapi kebenaran tentang perkahwinannya sendiri. Tidak tahan dengan siksaan batinnya, Au Yeung Wai Yip meninggalkan satu kes yang sedang berjalan - pencarian seorang klien terhadap tunangan yang hilang - dan pergi ke hotel untuk menangkap si selingkuh. Malangnya, perkahwinan tidak dapat diselamatkan pada akhirnya, dan tunangan klien itu terbunuh selepas dia meninggalkan tempat itu. Satu kes perselingkuhan biasa bertukar menjadi insiden pembunuhan!",
          "runtime": 0,
          "tagline": "",
          "title": "Behind the Shadows"
        }
      }
