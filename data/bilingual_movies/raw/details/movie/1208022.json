      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Na cidade de Fresno, no Texas, a prisão do grafiteiro Raphael leva-o a envolver-se numa cadeia de acontecimentos que incluem uma operação secreta, suicídio, tráfico de droga, suspeitas de crime, armas, uma jornalista e um negócio de plutónio que correu mal, resultando em verdadeiro caos total.",
