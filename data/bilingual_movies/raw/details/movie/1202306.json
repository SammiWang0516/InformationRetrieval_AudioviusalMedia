  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "After a near-death experience, Vanessa Shepherd faces nightmares in Abaddon. As mysterious deaths occur around her, she discovers her connection to the Abaddon Hotel, Carmichael Manor, and decades of unexplained murders.",
          "runtime": 108,
          "tagline": "A blood bond rooted in evil.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Après avoir frôlé la mort, Vanessa Shepherd est en proie à des cauchemars à Abaddon. Alors que des décès mystérieux se produisent autour d'elle, elle découvre le lien qui l'unit à l'hôtel Abaddon, au manoir Carmichael et à des décennies de meurtres inexpliqués.",
          "runtime": 108,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Assombrada por visões e pesadelos após uma experiência de quase morte, Vanessa Shepard mora em Abaddon, onde descobre sua terrível conexão com mortes misteriosas e com o Hotel Abaddon, que acontecem há décadas.",
          "runtime": 0,
          "tagline": "",
          "title": "HELL HOUSE LLC: A HERANÇA"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Ванесса начинает видеть странные кошмары, в которых призраки ведут ее в «Отель Абаддон» — проклятое место, известное как «Дом Ада». К девушке обращается журналистка, которая находит связь между этим отелем, поместьем Кармайклов и цепочкой загадочных смертей, происходящих десятилетиями. Ванесса выясняет, что трагедия, случившаяся в прошлом, пробудила древнее зло и теперь «Дом Ада» требует новых жертв. Ей предстоит понять, как остановить демона, пока все ее кошмары не стали реальностью.",
          "runtime": 0,
          "tagline": "",
          "title": "Дом ада. Спуск к дьяволу"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Po doświadczeniu bliskim śmierci Vanessa Shepherd zmaga się z koszmarami w Abaddon. Gdy wokół niej dochodzi do tajemniczych zgonów, odkrywa swój związek z hotelem Abaddon, rezydencją Carmichael i kilkoma niewyjaśnionymi morderstwami.",
          "runtime": 0,
          "tagline": "Więź krwi zakorzeniona w złu.",
          "title": "Hell House LLC: Rodowód"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "La popular serie de películas de Halloween regresa con la que podría ser su última entrega, profundizando en las historias de varios personajes de la franquicia, al tiempo que introducirá nuevos personajes y tramas.",
          "runtime": 0,
          "tagline": "Un vínculo de sangre arraigado en el mal.",
