      {
        "iso_3166_1": "IR",
        "iso_639_1": "fa",
        "name": "فارسی",
        "english_name": "Persian",
        "data": {
          "homepage": "",
          "overview": "داستان زنی به‌نام ونسا شپرد که پس از تجربه‌ای نزدیک به مرگ، در هتل آبادون با کابوس‌های متعددی روبه‌رو می‌شود.",
