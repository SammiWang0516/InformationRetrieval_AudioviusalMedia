      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Caro Cartwright, một cô gái đam mê thời trang cổ điển, bất ngờ đồng ý che chở cho Philippa Levreaux – kẻ từng là đối thủ thời thơ ấu của cô, nay đã trở thành người thừa kế đế chế thời trang cao cấp. Cuộc hội ngộ giữa hai người nhanh chóng tạo nên những màn đối đầu nảy lửa. Dù khác biệt, thậm chí chính vì những khác biệt ấy, cả hai dần giúp nhau vượt qua những thử thách trong cuộc sống, tìm thấy hướng đi riêng, trở thành phiên bản tốt nhất của bản thân và chạm đến ước mơ. Câu chuyện đầy phong cách và bản lĩnh này chứng minh rằng trái dấu không chỉ hút nhau mà còn có thể làm phong phú cuộc sống của mỗi người, nếu họ đủ can đảm đặt niềm tin vào chính mình và tình yêu đích thực.",
          "runtime": 0,
          "tagline": "",
          "title": "Nàng Lọ Lem Đội Vương Miện"
        }
      }
    ]
  },
