      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "1991-ben a vidéki Kínában, amikor a falusiak a jobb lehetőségek miatt a városokba vándorolnak, a tízéves Chuang a szülővárosában marad. Családjának harmadik gyermeke a nagyszabású nemzeti változások kellős közepén találja magát.",
