      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Due sorelle, Jean e Joan Holbrooke, sono così vicine l'una all'altra che parlano all'unisono, amano lo stesso uomo e hanno gli stessi sogni. Fanno anche lo stesso lapsus all'unisono. Non possiamo vedere il mondo come lo vedono loro, ma vediamo come il mondo reagisce a loro – attraverso i tribunali e la stampa, attraverso coloro che vogliono aiutare e coloro che vogliono usarli, attraverso gli occhi delle bestie sia addomesticate che selvagge, e persino attraverso i loro stessi echi nel nucleo della terra.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "L'histoire vraie de deux sœurs jumelles inséparables, Joan et Jean, qui vivent en marge de la société.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
