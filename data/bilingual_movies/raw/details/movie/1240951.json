        "english_name": "Norwegian",
        "data": {
          "homepage": "",
          "overview": "Når Alex får en ny mordsak, tilbyr hun Vilhelm å bli med henne og Josef til åstedet. Offeret ser ut til å ha tilknytning til et digitalt universitet som fokuserer på en ny type maskulinitet.",
          "runtime": 0,
          "tagline": "",
          "title": "Beck 52 - Den usynlige mannen"
        }
      },
      {
        "iso_3166_1": "SE",
