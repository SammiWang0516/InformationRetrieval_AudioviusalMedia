  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "About twenty years ago, Germany got to know Bernd Stromberg and his team from the claims department at CAPITOL Insurance. Back then, there was nothing vegan in the cafeteria, and bullying and sexism were commonplace in the office. Since then, the world of work has changed enormously. But has Bernd Stromberg changed too?",
          "runtime": 100,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "https://stromberg.myshow.de/",
          "overview": "Vor ca. zwanzig Jahren lernte Deutschland Bernd Stromberg und sein Team von der Schadensregulierung der CAPITOL-Versicherung kennen. Damals gab es noch nichts Veganes in der Kantine, Mobbing war Breitensport im Büro und Bernd Stromberg sagte: „Ich respektiere Frauen. Als Idee …“ Seither hat sich die Arbeitswelt enorm verändert. Bernd Stromberg auch? Ein großes Wiedersehen aller Beteiligter soll Klarheit bringen.",
          "runtime": 100,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Około dwadzieścia lat temu Niemcy po raz pierwszy spotkali Bernda Stromberga i jego zespół ds. roszczeń w firmie ubezpieczeniowej CAPITOL. W tamtych czasach w stołówce nie było opcji wegańskich, mobbing był na porządku dziennym w biurach, a Bernd Stromberg powiedział: „Szanuję kobiety. Jako ideę…”. Od tamtej pory świat pracy zmienił się diametralnie. Czy Bernd Stromberg również się zmienił? Duże spotkanie wszystkich zaangażowanych ma na celu rzucenie nieco światła na tę sprawę.",
          "runtime": 100,
          "tagline": "",
          "title": "Stromberg: Wieder alles wie immer"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Zo'n twintig jaar geleden leerde Duitsland Bernd Stromberg en zijn team van de schadeafdeling van CAPITOL Insurance kennen. Destijds was er niets veganistisch te vinden in de kantine en waren pesten en seksisme aan de orde van de dag op kantoor. Sindsdien is de arbeidswereld enorm veranderd. Maar is Bernd Stromberg zelf ook veranderd?",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Полнометражная комедия, являющаяся спин-оффом сериала Офис (2004) и фильма Офис в кино» (2014). В этом специальном продолжении культового немецкого «Офиса» старая гвардия компании «Капитоль» отправляется в ностальгическое путешествие.",
          "runtime": 0,
          "tagline": "",
          "title": "Офис: Снова все как всегд"
        }
      }
    ]
  },
