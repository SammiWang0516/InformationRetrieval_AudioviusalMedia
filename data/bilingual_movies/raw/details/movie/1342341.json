        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Kaptan Sabertooth’un güzel gemisi Kara Leydi, bir gece gizemli şekilde ziyaret edilir ve geminin en özel simgesi olan altın kaplan heykeli kaybolur. Bu olayın arkasında, çok zeki ve kararlı biri olan Kontes Sibylla vardır. Kaptan Sabertooth ve arkadaşları, kayıp heykelin izini sürerken eğlenceli bulmacalarla karşılaşır, yeni dostlar edinir ve birlikte takım olmanın, cesaretin ve paylaşmanın ne kadar önemli olduğunu keşfederler.",
          "runtime": 0,
          "tagline": "",
          "title": "Kaptan Sabertooth Kayıp Hazinenin Peşinde"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Die besten Freunde Raven und Pinky dienen unter Kapitän Säbelzahn, dem gefürchteten Piraten und König der sieben Meere. Als Sibylla, die gerissene Gräfin von Gral, ihr Schiff angreift, stiehlt sie eine wertvolle Galionsfigur und entführt Pinky.",
          "runtime": 0,
          "tagline": "",
          "title": ""
