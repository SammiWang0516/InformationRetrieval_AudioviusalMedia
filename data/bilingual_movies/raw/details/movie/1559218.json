  "translations": {
    "translations": [
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "弟の死により現実を見なくなった母親を筆頭に、家族の誰もが”不都合な真実“から目をそらし、それでもなお一緒に暮らしている、機能不全の羽猫家の約30年間を描いた物語。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "It is the year 1988. Yamabuki is an eight-year-old little boy growing up in a traditional family where every family member has problems and secrets they try to hide from each other. The father runs a failing construction company and has an intimate relationship with another woman. The mother is struggling with severe depression, as she cannot cope with the death of her youngest child. The grandfather, who used to be a construction engineer, hopes to start building an amusement park, but to no avail. The grandmother runs a small store where she sells items of forged origin. Yamabuki's big sister Beni is fed up with the lies of her predecessors and is looking for a way to run away from home. In the midst of all this chaos, Yamabuki has started to find solace in patting an imaginary dog.",
          "runtime": 125,
          "tagline": "",
          "title": "The Imaginary Dog and the Lying Cat"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Akcja rozgrywa się w roku 1988. Yamabuki to ośmioletni chłopiec dorastający w tradycyjnej rodzinie, w której każdy członek rodziny ma problemy i sekrety, które próbują przed sobą ukrywać. Ojciec prowadzi podupadającą firmę budowlaną i utrzymuje bliską relację z inną kobietą. Matka zmaga się z ciężką depresją, ponieważ nie może poradzić sobie ze śmiercią najmłodszego dziecka. Dziadek, były inżynier budowlany, marzy o budowie parku rozrywki, ale bezskutecznie. Babcia prowadzi mały sklepik, w którym sprzedaje podrobione przedmioty. Siostra ma dość kłamstw swoich poprzedników i szuka sposobu na ucieczkę z domu. W tym całym chaosie Yamabuki zaczyna szukać ukojenia w głaskaniu wyimaginowanego psa. 25 lat później, kiedy babcia, która spajała całą rodzinę, zostaje pochowana, a rodzina znów się spotyka, nadchodzi czas, aby wszyscy odwrócili się od przeszłości i szukali wzajemnego przebaczenia. Ale czy to możliwe?",
          "runtime": 125,
          "tagline": "",
          "title": "Kakuu no Inu to Uso wo tsuku Neko"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "羽猫家长子山吹（高杉真宙 饰）因母亲雪乃（安藤裕子 饰）无法接受弟弟离世，多年来一直假扮弟弟给母亲写信。父亲淳吾（安田显 饰）因不堪面对性情大变的妻子而逃往情人家，姐姐红（向里祐香 饰）宣称\"憎恶谎言与谎话精\"并反抗着一切。羽猫家的成员们各自回避着难以面对的真相，时而萌生脱离家庭的念头，却又在相互羁绊中度过了近三十年的岁月。",
          "runtime": 126,
          "tagline": "",
          "title": "幻犬诳猫"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "為了安慰無法接受弟弟過世的母親，小學生山吹假扮弟弟，繼續寫信給她。他的母親就此活在幻想的世界裡，父親則選擇逃避，投向情婦的懷抱，祖父是個優柔寡斷、只會空談夢想的老頭，祖母則是靠「謊言」經營生意，姊姊痛恨這一切的謊言和說謊的人，雖然同住一個屋簷下，卻與家人疏遠。山吹則習慣了這樣說謊的日子，在成長過程中也一直在說謊。令人憎恨卻又深愛著，這是羽貓一家長達30年，由「謊言」與「羈絆」交織的故事。",
          "runtime": 0,
          "tagline": "",
          "title": "虛構的狗跟說謊的貓"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "어린 시절의 상처를 안고 사는 주인공이 성인이 된 이후까지의 여정을 그린 극영화",
          "runtime": 126,
          "tagline": "",
          "title": "상상의 개와 거짓말쟁이 고양이"
        }
      }
    ]
  },
