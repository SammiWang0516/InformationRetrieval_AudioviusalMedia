  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A music student’s testimony ignites a feminist uprising on her campus, where protest becomes performance and collective voice becomes an act of resistance.",
          "runtime": 129,
          "tagline": "When She Speaks Up, A Movement Rises",
          "title": "The Wave"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
