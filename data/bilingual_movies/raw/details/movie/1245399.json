      {
        "iso_3166_1": "ES",
        "iso_639_1": "eu",
        "name": "euskera",
        "english_name": "Basque",
        "data": {
          "homepage": "",
          "overview": "Frida Kahlo neskato bakarti eta grinatsuaren istorioa da hau. Coyoacán koloretsu eta zirraragarrian hazi da, Mexikon, eta bere jakingurak ez du mugarik. Inguruan duen guztian aurkitzen du inspirazioa; naturan edo artean, adibidez. Bizitzak zailtasunak dakarzkionean, Fridak irudimen ikaragarriarekin egiten die aurre, eta mina sormen bihurtzen du.",
