  "translations": {
    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.effervescenceprod.com/?p=3973",
          "overview": "Quincy Jones fut le créateur des plus grands tubes de Michael Jackson et d’autres artistes tels que Ray Charles, Stevie Wonder, Jane Fonda et même du réalisateur Steven Spielberg. Aujourd’hui encore, son influence et son talent se ressentent chez des artistes contemporains comme Snoop Dogg, The Weeknd, Alicia Keys et Pharrell Williams. MC Solaar raconte l'histoire de ce petit-fils d'esclave qui, élevé dans la misère, a réussit à révolutionner l'industrie musicale pendant plus d'un demi-siècle et dont le parcours exceptionnel incarne les grandes mutations de la société moderne.",
          "runtime": 52,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
