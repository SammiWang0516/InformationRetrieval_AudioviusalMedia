      {
        "iso_3166_1": "FI",
        "iso_639_1": "fi",
        "name": "suomi",
        "english_name": "Finnish",
        "data": {
          "homepage": "",
          "overview": "Henkilökuvadokumentti musiikkituottaja Quincy Jonesista, joka tunnetaan mm. Michael Jacksonin menestyslevyjen tuottajana. Monipuolinen Jones aloitti jazzmuusikkona ja -kapellimestarina 50-luvulla ja työskenteli myöhemmin pitkään mm. elokuvasäveltäjänä. Hän voitti uransa aikana lukuisia palkintoja, mm. 28 Grammya. Jones kuoli 2024.",
          "runtime": 52,
          "tagline": "",
          "title": "Quincy Jones, musiikkimies"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Een persoonlijke documentaire over muziekproducer Quincy Jones, bekend van de productie van Michael Jacksons hitalbums. De veelzijdige Jones begon in de jaren 50 als jazzmuzikant en dirigent en werkte later lange tijd als filmcomponist. Hij won talloze prijzen gedurende zijn carrière, waaronder 28 Grammy's. Jones overleed in 2024.",
          "runtime": 52,
          "tagline": "",
          "title": ""
        }
      }
    ]
