    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.arte.tv/fr/videos/130154-000-A/supertramp/",
          "overview": "En mars 1975, Supertramp se produit au Hammersmith Odeon à un moment clé de son évolution. Porté par le succès de Crime of the Century, le groupe s’impose comme une figure singulière du rock britannique, à la croisée du progressif et d’une écriture plus mélodique. Cette tournée qui précède l’enregistrement de Crisis? What Crisis?, révèle un groupe en pleine affirmation : ce concert capture Supertramp à l’instant précis où son ambition artistique rencontre un public élargi.",
          "runtime": 75,
          "tagline": "",
          "title": "Supertramp - Hammersmith Odeon, 1975"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Zwischen dem Erfolg von Crime of the Century und den Aufnahmen zu Crisis? What Crisis? begeistert die Band im Londoner Konzertsaal Hammersmith Odeon das Publikum mit ihrer einzigartigen Verbindung aus Progressive Rock und melodischem Songwriting. Die Gesangsdualität von Rick Davies († 2025) und Roger Hodgson macht das Konzert zu einem legendären Moment britischer Rockgeschichte.",
          "runtime": 75,
          "tagline": "",
          "title": "Supertramp - Hammersmith Odeon, 1975"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Supertramp: Crime of the Century in Concert at Hammersmith Odeon 1975 is a comprehensive release capturing the British progressive rock band's landmark March 9, 1975 show in London. Restored from original 16mm film, this release features a Dolby Atmos audio mix and a setlist that bookends their hit album. Just prior to embarking on their first major North American tour in 1975, Supertramp played a highly anticipated, sold-out show at London's Hammersmith Odeon. This performance showcased the classic line-up of Rick Davies, Roger Hodgson, Dougie Thomson, John Helliwell, and Bob Siebenberg at the critical moment Crime of the Century was propelling them to global fame.",
          "runtime": 75,
          "tagline": "",
          "title": "Supertramp: Crime of the Century in Concert at Hammersmith Odeon 1975"
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Supertramp: \"Crime of the Century in Concert at Hammersmith Odeon 1975\" è una pubblicazione completa che cattura il punto di riferimento della band progressive rock britannica del 9 marzo 1975 a Londra. Ripristinato da un film originale da 16mm, questa uscita presenta un mix audio Dolby Atmos e una scaletta che termina il loro album di successo. Poco prima di intraprendere il loro primo grande tour nordamericano nel 1975, Supertramp ha suonato un attesissimo show sold-out all'Hammersmith Odeon di Londra. Questa performance ha mostrato la formazione classica di Rick Davies, Roger Hodgson, Dougie Thomson, John Helliwell e Bob Siebenberg nel momento critico in cui Crime of the Century li stava spingendo alla fama globale.",
          "runtime": 75,
          "tagline": "",
          "title": ""
        }
      }
