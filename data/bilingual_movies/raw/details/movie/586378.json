      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Leon despierta en un hospital sin memoria y con un chip en el cerebro que lo conecta a dispositivos informáticos. Al descubrir que fue parte de un experimento ilegal, se da cuenta de que tiene que huir. Mientras intenta reconstruir su pasado, descubre que trabajaba para una empresa que desarrollaba chips ilegales de combate. Y ahora todo el mundo lo quiere cazar: la empresa y un grupo de traficantes van tras él, en búsqueda de la tecnología del chip. Decidido a destapar la verdad, Leon se debe enfrentar a una red de conspiraciones",
          "runtime": 0,
          "tagline": "",
          "title": "Identification"
        }
      }
