      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "失去記憶的里昂在醫院病房中醒來，腦中被植入一枚能連結電腦系統的生物晶片。在神祕男子的警告下，他才驚覺自己置身於一場機密實驗之中；隨著碎片般的記憶逐漸拼湊，里昂發現自己因舉報非法研發的「戰鬥晶片」而招致殺身之禍。里昂必須殺出重圍，奪回生機。",
          "runtime": 0,
          "tagline": "",
          "title": "芯控危機"
        }
      },
      {
        "iso_3166_1": "BR",
