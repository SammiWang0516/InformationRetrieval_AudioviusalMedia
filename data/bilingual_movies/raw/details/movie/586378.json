      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "모든 기억을 포맷당하고 실험실에서 깨어난 남자. 업그레이드된 신체능력으로 탈출하라! 사이보그 암살자들의 추적이 시작된다. 머리에 이식된 칩의 음모를 밝히고 지워진 기억을 되찾아라! 반드시 딸을 구해야 한다! 놈들과 최후의 대결이 시작된다!",
          "runtime": 0,
          "tagline": "딸을 구하기 위해, 삭제된 기억을 되찾아라!",
          "title": "아이덴티티 제로"
        }
