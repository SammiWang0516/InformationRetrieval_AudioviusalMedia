    "translations": [
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Julia crede di aver trovato l'uomo con cui costruire il proprio futuro quando conosce e sposa Ivan, affascinante e apparentemente innamorato di lei. Dopo il matrimonio, però, alcuni comportamenti dell'uomo iniziano a insospettirla. Julia scopre gradualmente che Ivan potrebbe averla sposata per interesse e che dietro la loro relazione si nasconde un piano organizzato per impossessarsi del suo denaro. A complicare ulteriormente la situazione c'è Mei Li, una donna legata a Ivan e coinvolta nei suoi inganni. Quando comprende di essere stata vittima di una truffa sentimentale, Julia decide di non arrendersi e cerca un modo per reagire, dando inizio a un pericoloso confronto fatto di manipolazioni, segreti e desiderio di vendetta.",
          "runtime": 110,
          "tagline": "",
          "title": "Amore crudele"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Iván ayuda a Julia cuando intentan robarle el bolso y ella se enamora perdidamente de él. En apariencia, él no quiere aprovecharse de su confianza, pero pronto necesitará su ayuda para conseguir los papeles de residencia, lo que pondrá a prueba la sinceridad de lo que sienten el uno por el otro.",
          "runtime": 0,
          "tagline": "",
          "title": "Amor cruel"
        }
      }
    ]
