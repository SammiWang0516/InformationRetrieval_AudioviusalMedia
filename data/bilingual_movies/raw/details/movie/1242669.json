        "data": {
          "homepage": "",
          "overview": "Un mag ambulant passa la nit en un hotel que descobrirà que no pot abandonar, només continuar endinsant-s’hi, coneixent pel camí els seus insòlits residents.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
