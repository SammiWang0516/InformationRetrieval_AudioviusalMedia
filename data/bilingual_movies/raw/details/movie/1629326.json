      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "故事属于前作前传，主角明茹多年前被家族驱逐，时隔多年重新回到自家祖传染坊。这座老宅染坊埋藏着家族的黑暗过往，她回来之后，灵异怪事接连爆发，鬼魂魅影不断出现。随着不断追查，她被迫直面母亲死亡背后残酷的真相，还有祖辈流传下来的恐怖契约，这份契约牵扯恶魔附身的诅咒，家族世代都被这个邪祟枷锁捆绑，明茹要在这间凶宅里面对抗恶灵，同时还要解开家族代代逃不开的宿命。",
          "runtime": 0,
          "tagline": "",
          "title": "开棺2：恶魔附身"
        }
      }
