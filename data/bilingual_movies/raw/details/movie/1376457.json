      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "在乍得一个偏远村庄，少女凯卢常被无法理解的幻象困扰。她结识了身负痛苦秘密的流亡女子阿雅，并开始重新认识自己的过去、梦境与村庄。当她出面保护遭村长驱逐的阿雅时，也不得不面对村民的恐惧与愤怒，为自由而抗争。",
          "runtime": 0,
          "tagline": "",
          "title": "苏姆苏姆，星辰之夜"
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "No deserto de Ennedi, no Chade, montanhas milenares emergem da areia, guardando a memória de um passado esquecido e sussurrando antigas lendas. Kellou, de 17 anos, é atormentada por visões que não compreende e que a afastam dos outros moradores de seu vilarejo. Sua vida muda ao conhecer Aya, uma mulher rejeitada pela comunidade. Do encontro entre as duas nasce um vínculo que aproxima o visível e o invisível, a memória e a resistência.",
          "runtime": 101,
          "tagline": "",
          "title": "Soumsoum, a Noite das Estrelas"
        }
