  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Alaa, a radio host who fears commitment, enters relationships that end for trivial reasons until he meets Farida, who seems perfect. He then discovers she is one of the largest arms dealers. When he tries to leave her, she forces him to marry her, dragging him into a series of dangerous situations.",
          "runtime": 105,
          "tagline": "",
          "title": "Take Care of Yourself"
        }
      },
      {
        "iso_3166_1": "SA",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "علاء، مذيع إذاعي يخشى الارتباط ويدخل في علاقات عاطفية تنتهي لأسباب تافهة، حتى يلتقي بفريدة التي تبدو فتاة مثالية، قبل أن يكتشف أنها من أكبر تجار السلاح. ومع محاولته إنهاء العلاقة، يجد نفسه عالقًا في سلسلة من الأحداث الخطيرة بعدما تجبره فريدة على الزواج منها، لتبدأ مغامرة مليئة بالمفارقات والتشويق.",
          "runtime": 105,
          "tagline": "",
          "title": "خلي بالك من نفسك"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Der Radiomoderator Alaa hat viele romantische Begegnungen, aber lässt sich nie länger auf eine Frau ein, weil er sich nicht binden will. Das könnte sich ändern, als eine feinfühlige Farida (Yasmin Abdelaziz) als sein Idealbild einer Frau in sein Leben tritt – die sich dann allerdings als Waffendealerin entpuppt.",
          "runtime": 107,
          "tagline": "",
          "title": "Khaly Balak Min Nafsak"
        }
      },
      {
        "iso_3166_1": "TR",
        "iso_639_1": "tr",
        "name": "Türkçe",
        "english_name": "Turkish",
        "data": {
          "homepage": "",
          "overview": "Ala, bağlanma korkusu nedeniyle romantik ilişkilerini çoğunlukla yüzeysel gerekçelerle ve kısa sürede bitiren bir radyo sunucusudur. Sıradan bir hayat süren Ala'nın yaşantısı, tesadüfen tanıştığı Feride ile farklı bir yöne evrilir. Başlangıçta nazik, zarif ve ideal bir kadın izlenimi veren Farida ile olan ilişkisi ilerledikçe, Ala onun gizli kimliğiyle yüzleşmek zorunda kalır. Feride'nin aslında büyük bir silah tüccarı olduğunun anlaşılması, Ala'yı rutin hayatından kopararak alışık olmadığı tehlikeli bir durumun ortasında bırakır.",
          "runtime": 105,
          "tagline": "",
          "title": "Ayağını Denk Al"
        }
      }
    ]
  },
