      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一個東南亞小鎮中，卷王警察于大海（彭于晏 飾）起早貪黑，努力工作，讓小鎮連續7年維持0犯罪率。結果因為沒有案子，警察將被全員辭退，“鐵飯碗”成了“塑料碗”，為保住工作，于大海決定和隊友們一起造個大案。與此同時，真正的大案正在發生，前來投奔羅四季（艾倫 飾）的盜墓賊羅浩（周遊 飾）、牛大輪（闫佩倫 飾）一家人，盯上了傳說中藏有寶藏的古墓，而這個古墓就在警局之下......",
          "runtime": 103,
          "tagline": "",
          "title": "爆水管"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "누명을 쓰고 좌천된 SWAT 팀장은 경찰서 폐쇄를 막기 위해 사건을 만들려다 지하 고분의 보물을 발견하고 경찰과 도굴꾼의 기상천외한 보물 쟁탈전이 시작된다.",
          "runtime": 0,
          "tagline": "숨겨진 전설의 금괴를 찾아라!",
          "title": "보물도둑들"
        }
      }
