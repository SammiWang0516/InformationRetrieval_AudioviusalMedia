      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Angelo ist ein Zehnjähriger, der davon träumt, Entdecker und Zoologe zu werden. Als er seine Oma besuchen will, lassen seine Eltern ihn an einer Raststätte zurück, und er beschließt, sich auf der Suche nach ihnen einen Weg durch den Wald zu bahnen.",
