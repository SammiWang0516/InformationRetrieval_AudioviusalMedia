      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Na kaszubskim kempingu, otoczonym jeziorem i lasem, gdzie rodziny, pary i single przybywają w poszukiwaniu wakacyjnego odpoczynku, tworzą się nowe relacje i narastają konflikty. Niektórzy się zakochują, inni zaczynają darzyć się niechęcią. Podczas gdy dorośli zmagają się z brakiem umiejętności komunikacyjnych, dzieci, pozostawione same sobie, budują własny świat przesycony kaszubskimi legendami i strasznymi opowieściami. Gdy pewnego ranka mieszkańcy kempingu odkrywają przebite opony w swoich autach, atmosfera gęstnieje i do głosu dochodzą wzajemne animozje.",
          "runtime": 80,
          "tagline": "",
          "title": "Swornegacie"
        }
      }
