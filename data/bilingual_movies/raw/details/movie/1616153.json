      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Jung, neugierig und voller Tatendrang verlässt Siri Hustvedt ihre Heimat Minnesota und stürzt sich mitten hinein ins pulsierende New York. Auf der Suche nach der Hauptfigur ihres ersten Romans beginnt eine Reise, die sie nicht nur zur Schriftstellerin macht, sondern zu einer der wichtigsten Stimmen der amerikanischen Gegenwartsliteratur.",
          "runtime": 115,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "年輕的席莉胡思薇，離開明尼蘇達寬闊寧靜的故鄉，來到充滿未知挑戰的紐約。在尋找第一部小說主角的過程中，她穿梭於書店、街道與記憶之間，逐步拼湊出屬於自己的聲音與世界。這趟創作之旅不僅引領她成為當代美國文壇的重要作家，也讓她不斷回望自身的經驗：童年的孤獨、對女性處境的敏感觀察，以及對語言與身分的深層思考。影片同時展開她與作家保羅奧斯特長達數十年的情感與思想對話，兩人在文字與生活中彼此映照。然而，當疾病與死亡悄然逼近，創作與愛情交織成更為深刻的生命課題—關於陪伴、失去，以及如何在告別之中繼續書寫與存在。",
          "runtime": 0,
          "tagline": "",
          "title": "席莉胡思薇：自我迴旋"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Sabine Lidl presenta el viaje de Siri Hustvedt desde su primera novela hasta convertirse en una de las voces referentes de la literatura contemporánea: una película sobre las perspectivas feministas, Paul Auster (el alma gemela de Hustvedt) y el poder del pensamiento.",
          "runtime": 110,
          "tagline": "",
          "title": "Siri Hustvedt, la danza del yo"
        }
      }
