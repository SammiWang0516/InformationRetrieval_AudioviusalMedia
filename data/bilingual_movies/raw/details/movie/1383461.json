      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "באמצעות הקלטות של האזנות סתר באישור סוכנות האף-בי-איי, חושף \"8 באוקטובר\" כיצד חמאס פועל במשך עשרות שנים כדי לחדור לאוניברסיטאות האמריקאיות ולתקשורת. שיא הפעילות התרחשה בעקבות מתקפת חמאס על ישראל ב-7 באוקטובר.  הסרט גם מתעמק באופן שבו אנטישמיות שינתה צורה לאורך השנים, כשהגלגול האחרון שלה הוא אנטי-ציונות קיצונית, שהפכה את ישראל למוקצה בין האומות ומבקשת לשלול את זכותה להתקיים.  ובסופו של דבר, הסרט עונה על השאלה: מדוע העולם צריך לדאוג? ובעקבותיה המסקנה שהדמוקרטיה, ערכי החיים והחירות עומדים על כף המאזניים מול מוות וג'יהאדיזם.",
          "runtime": 0,
          "tagline": "היום שאחרי המתקפה",
          "title": "8 באוקטובר"
        }
      },
