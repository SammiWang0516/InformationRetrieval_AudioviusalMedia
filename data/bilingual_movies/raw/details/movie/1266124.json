  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "东汉末年，朝纲崩坏，天下群雄并起。怀抱理想的曹操投身乱世，从讨伐董卓到迎奉天子，在一次次选择与征战中逐渐走上属于自己的道路。与此同时，昔日故交袁绍也在乱世中不断壮大，年轻的汉献帝刘协则在权力夹缝中寻找自己的位置。随着曾经并肩而行的人走向不同方向，曹操与袁绍之间的矛盾日益加深，一场足以改变天下格局的官渡之战也逐渐逼近。在群星闪耀的乱世之中，每个人都在寻找自己的使命与归宿……",
          "runtime": 122,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "At the end of the Eastern Han Dynasty, the world was in chaos. Cao Cao defeated Dong Zhuo, welcomed the emperor, and fought at Guandu, becoming a great hero.",
          "runtime": 122,
          "tagline": "",
          "title": "Three Kingdoms: Starlit Heroes"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "東漢末年，天下大亂。曹操討董卓、迎天子、戰官渡，成為一代英豪，與袁紹和劉協等人一起用選擇和行動回答了“我從哪裏來？我的使命是什麼？我是天上哪顆星？”",
          "runtime": 0,
          "tagline": "",
          "title": "三國的星空第一部"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ในช่วงท้ายของราชวงศ์ฮั่น แผ่นดินได้ตกอยู่ท่ามกลางความโกลาหล โจโฉได้ทำการปราบ ตั๋งโต๊ะ, ต้อนรับองค์จักรพรรดิ และต่อสู้ที่เมืองกวนตู้ จนกลายมาเป็นวีรบุรุษแห่งยุคสมัย",
          "runtime": 0,
          "tagline": "",
          "title": "สามก๊ก ปฐมบทโจโฉ"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
