      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "赤发鬼再度现世，并与小说家路空文在异世界相遇。随着自我意识逐渐觉醒，赤发鬼开始试图挣脱既定的命运，甚至掌控所有人的人生。铜虎、小橘子、行者、霹雳火、黑龙、入云龙等人也因此被卷入危机。面对一个开始反抗创作者、试图改写自己命运的角色，路空文和异世界的众人再次陷入一场难以预料的冒险……",
          "runtime": 134,
          "tagline": "",
          "title": "刺杀小说家2"
        }
