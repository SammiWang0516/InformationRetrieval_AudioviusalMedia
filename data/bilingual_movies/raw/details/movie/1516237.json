  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A murder leads a newly pregnant mom-to-be to discover her IVF procedure may not have come from her husband, and someone will stop at nothing to keep her from discovering who the real father is.",
          "runtime": 88,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Un meurtre amène une future maman à découvrir que les spematozoïdes pour la FIV ne viennent peut-être pas de son mari, et quelqu'un ne reculera devant rien pour l'empêcher de découvrir l'identité du vrai  père.",
          "runtime": 88,
          "tagline": "",
          "title": "Qui est le père de mon bébé ?"
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Jen és Spencer nem is lehetnének boldogabbak, hiszen a sikeres beültetés után végre babát várnak. Viszont a családi fogadáson megtörténik a tragédia: Spencer unokatestvérét holtan találják. Ezzel megkezdődik a hazugságok áradata, amely egy megdöbbentő felfedezéshez vezet, ami miatt Jen megkérdőjelezi a férje megbízhatóságát. Jennek ezután versenyt kell futnia az idővel, hogy kiderítse, mi a valóság, és mi az átverés.",
          "runtime": 0,
          "tagline": "",
          "title": "A gyerek, akiről a férjem hazudot"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Jen, în sfârșit însărcinată după mai multe tratamente de fertilitate, crede că urmează cea mai fericită perioadă din viața ei. Dar totul se schimbă când ajunge la familia soțului și un deces suspect o pune pe urmele unui secret tulburător: bărbatul cu care rămăsese însărcinată poate să nu fie soțul ei, iar adevărul pe care îl caută o aruncă într o poveste de mister și pericol.",
          "runtime": 88,
          "tagline": "",
          "title": "Al cui e copilul?"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一起谋杀案让一位即将迎来新生命的准妈妈意识到，她的试管婴儿手术并非由她的丈夫主导，而且有人会不惜一切手段阻止她查明真正的父亲是谁。",
          "runtime": 0,
          "tagline": "",
          "title": "我丈夫隐瞒的孩子"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Gdy dochodzi do tajemniczego morderstwa, ciężarna kobieta zaczyna podejrzewać, że coś jest nie tak z jej przeszłością - i z procedurą in vitro, dzięki której zaszła w ciążę.",
          "runtime": 0,
          "tagline": "",
          "title": "Rodzinne tajemnice"
        }
      }
    ]
