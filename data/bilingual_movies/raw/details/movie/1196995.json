      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Eine wilde, verrückte Reise durch das Leben mehrerer miteinander verbundener Charaktere – geprägt von Humor, Rivalität, Missverständnissen und chaotischen Ereignissen: Die Geschichte beginnt wahrscheinlich mit dem scheinbar gewöhnlichen Leben von Dileeps Figur, als er durch Zufall oder Schicksal in die Welt zweier sehr unterschiedlicher Männer (die Figuren von Vineeth und Dhyan) verwickelt wird, deren Rivalität oder gegensätzliche Weltanschauungen eine Kette absurder, urkomischer – und vielleicht gefährlicher – Ereignisse auslösen. Während ihre Geschichten aufeinanderprallen, nutzt der Film Komik, Action, dramatische Wendungen und emotionale Momente, um zu untersuchen, wie Angst, Hingabe und Respekt menschliche Beziehungen und Entscheidungen bestimmen. Dabei sorgt eine große Gruppe von Figuren für zusätzliche Nebenhandlungen, Spaß, Verwirrung und Überraschungen – bis hin zu einem Höhepunkt, in dem Chaos, Komik und emotionale Spannungen zusammenlaufen.",
          "runtime": 160,
          "tagline": "",
          "title": "Bha Bha Ba"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一名看似平凡的警察意外发现一个惊天阴谋，他必须与一帮搞笑的动作英雄联手，共同对抗邪恶势力，拯救世界的故事。",
          "runtime": 0,
          "tagline": "",
          "title": "神怒快闪"
        }
      }
