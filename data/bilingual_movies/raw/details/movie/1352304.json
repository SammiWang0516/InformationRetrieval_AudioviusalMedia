    "translations": [
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://diaphana.fr/film/adieu-monde-cruel/",
          "overview": "Otto Vidal, 14 ans, a disparu après avoir adressé une lettre d’adieu aux élèves de sa classe. Alors que tout le monde le croit mort, Léna, une fille de son lycée, le reconnaît une nuit en train d’errer dans les rues de la ville.",
          "runtime": 93,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Fourteen-year-old Otto writes a suicide letter to his family and classmates, but his attempt fails. Too ashamed to go back home, he hides. As night falls, he roams the city streets like a ghost—until a girl from his high school, Léna, recognizes him.",
          "runtime": 93,
          "tagline": "",
          "title": "Goodbye Cruel World"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "또래로부터 괴롭힘을 당하던 14세 소년이 작별의 편지를 쓴 뒤 사라진다. ‘이건 자살이 아니라 살인’이라고 쓴 52통의 편지에 사람들은 그가 죽었을 거라 짐작한다.",
          "runtime": 0,
          "tagline": "",
          "title": "굿바이, 이놈의 잔인한 세상"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "De veertienjarige Otto schrijft een afscheidsbrief aan zijn familie en klasgenoten, maar zijn poging mislukt. Te beschaamd om naar huis terug te keren, verstopt hij zich. Wanneer de nacht valt, doolt hij als een geest door de straten van de stad—tot een meisje van zijn middelbare school, Léna, hem herkent.",
          "runtime": 93,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Czternastoletni Otto pisze list pożegnalny do rodziny i kolegów z klasy, ale jego próba kończy się niepowodzeniem. Zbyt zawstydzony, by wrócić do domu, ukrywa się. Nocą nawiedza ulice miasta niczym duch, aż rozpoznaje go Lena, dziewczyna z jego szkoły.",
          "runtime": 93,
          "tagline": "",
          "title": "Żegnaj, okrutny świecie"
        }
      }
