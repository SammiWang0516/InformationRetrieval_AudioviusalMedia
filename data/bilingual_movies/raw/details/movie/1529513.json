      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "馬來西亞地產商宋龍辰以泰國降頭術奪取土地經營權，致多人喪命。泰國記者Fon懷疑其中有異，展開調查。四名年輕自媒體人前往泰國拍攝民俗，返國後接連遭遇怪事甚至喪生，Fon推測他們受降頭迫害，遂尋求高僧白師傅協助。宋龍辰繼續借黑巫師擴張勢力，與白師傅展開黑白降頭之戰。",
          "runtime": 0,
          "tagline": "",
          "title": "蠱降"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "泰國記者 Fon 追查一宗校園慘案時意外揭發地產商與黑巫師勾結，利用降頭逼害村民賣地；與此同時，幾名網紅因風流債遭邪術索命，釀離奇傷亡。兩股血債交織，白師傅臨危受命，與眾人奔走泰國邊界，與黑降頭師展開正邪跨國鬥法。降頭殺人無形，亦能反噬其身。善惡到頭終有報，一念罪孽，死局難逃。",
          "runtime": 0,
          "tagline": "",
          "title": "蠱降"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Cổ Thuật Hắc Ngải (Kong Tao – 蠱降) là bộ phim kinh dị hợp tác giữa Thái Lan và Malaysia, lấy cảm hứng từ những nghi thức trù ếm, bùa ngải và tà thuật hắc ám bí ẩn bậc nhất châu Á.  Phim theo chân một nhóm YouTuber chuyên khám phá các hiện tượng siêu nhiên tại Thái Lan. Thế nhưng, một chuyến ghi hình tưởng chừng vô hại lại vô tình đánh thức lời nguyền chết chóc, buộc cả nhóm phải chạy đua với thời gian để tìm đến một pháp sư trước khi trở thành những nạn nhân tiếp theo.  Đặc biệt, bộ phim đánh dấu màn lột xác của Kao Supassara – \"tình đầu Thái Lan\" – trong một vai diễn hoàn toàn mới, kết hợp cùng Philip Keung, hứa hẹn mang đến một siêu phẩm kinh dị nặng đô, đậm màu sắc tà thuật và văn hóa bùa ngải Đông Nam Á.",
          "runtime": 0,
          "tagline": "",
          "title": "Cổ Thuật Hắc Ngải"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "马来西亚地产商宋龙辰以泰国降头术夺取土地经营权，致多人丧命。 泰国记者Fon怀疑其中有异，展开调查。 四名年轻自媒体人前往泰国拍摄民俗，返国后接连遭遇怪事甚至丧生，Fon推测他们受降头迫害，遂寻求高僧白师傅协助。 宋龙辰继续借黑巫师扩张势力，与白师傅展开黑白降头之战。",
          "runtime": 0,
          "tagline": "",
          "title": "蛊降"
        }
      }
    ]
