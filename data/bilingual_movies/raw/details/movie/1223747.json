  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Grumpy widower Walter lives alone with his dog in Regensburg and spends his time writing restaurant reviews on the internet. But when he meets his old childhood sweetheart, art professor Alice, whom he had unsuccessfully proposed to 40 years earlier, his life changes radically once again.",
          "runtime": 106,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Der mürrische Witwer Walter Adler lebt allein mit seinem Hund in Regensburg und vertreibt sich die Zeit damit, Restaurant-Bewertungen ins Internet zu schreiben. Doch als er seine alte Jugendliebe, die Kunstprofessorin Alice, wieder trifft, der er 40 Jahre zuvor erfolglos einen Heiratsantrag gemacht hatte, ändert sich sein Leben noch einmal radikal: Um sie endlich für sich zu gewinnen, schreibt er sich als Gaststudent in ihrem Seminar ein. Nicht ahnend, dass er nicht nur von Alice herausgefordert wird, sondern auch von einer Generation von Studierenden, mit denen er scheinbar nichts mehr gemein hat …",
          "runtime": 90,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "性格有些古板的鳏夫Walter退休后独自生活，日常靠撰写餐厅点评打发时间。某天他偶遇了年少时的恋人Alice——40年前他曾向Alice求婚却遭到拒绝。重遇后Walter重燃爱意，想要再次追求Alice，Alice提出条件：Walter必须真正走进、了解她的生活。为了达成这个要求，这位退休老人报名参加了身为艺术教授的Alice开设的课程，由此展开了一系列充满笑点与温情的追爱故事。",
          "runtime": 0,
          "tagline": "",
          "title": "白发再求婚"
        }
      }
    ]
