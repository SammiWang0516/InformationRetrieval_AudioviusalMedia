      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um prefeito excêntrico busca transformar Alvarado, Veracruz, em um destino turístico filmando um filme ao estilo de Hollywood. Ele reúne uma equipe peculiar de locais, liderada por um camarógrafo novato, para embarcar nesse projeto ambicioso.",
          "runtime": 0,
          "tagline": "",
          "title": "Louco México Mágico"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "韦拉克鲁斯州阿尔瓦拉多镇的怪咖市长，一门心思把小镇打造成旅游胜地，脑洞大开决定拍一部好莱坞式电影造势。他凑起一群完全不懂拍片的当地人组成草台班子，领头的还是个十五岁少年摄像师，一群门外汉硬搞大片，闹出无数荒诞乌龙。",
          "runtime": 0,
          "tagline": "",
          "title": "疯狂魔幻墨西哥"
        }
      }
