  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.hallmarkchannel.com/holiday-touchdown-a-chiefs-love-story",
          "overview": "Alana Higman, a die-hard Kansas City Chiefs fan, and her family are competing to win the team's Fan of the Year contest, in a process judged by the director of fan engagement Derrick. As the pair spends time together, it's clear there's a spark between them. But when her grandfather's vintage Chiefs good luck winter hat goes missing, Alana begins to doubt everything she believed about fate, destiny and even questions her future with Derrick.",
          "runtime": 84,
          "tagline": "Don't fumble the perfect catch",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Alana Higman, een Kansas City Chiefs-fan, en haar familie strijden om de Fan van het jaar-wedstrijd van het team te winnen, in een proces dat wordt beoordeeld door de directeur van fan club Derrick. Terwijl het paar samen tijd doorbrengt, is het duidelijk dat er een vonk tussen hen is. Maar wanneer de vintage geluks winter muts van haar grootvader vermist raakt, begint Alana te twijfelen aan alles wat ze geloofde over het lot, het lot en twijfelt ze zelfs aan haar toekomst met Derrick.",
          "runtime": 84,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Алана, преданная болельщица \"Канзас-Сити Чифс\", и её семья соревнуются за победу в конкурсе \"Болельщик года\", который проводит директор по взаимодействию с фанатами Дерек.",
          "runtime": 0,
          "tagline": "",
          "title": "Рождественский тачдаун: Любовь в стиле Чифс"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "A Kansas City, Alana et sa famille sont supporters inconditionnels de l'équipe de football américain des Chiefs. À l'approche de Noël, le club officiel des supporters de l'équipe organise un concours du meilleur supporter. Alana et sa famille sont finalistes, et vont devoir faire bonne impression pour gagner. Le directeur du club des supporters, Derreck, doit les mener jusqu'à la victoire. Nouvellement arrivé en ville, il n'est ni sociable, ni passionné par le football américain, et d'un naturel sceptique. Sa rencontre avec Alana et sa famille va ouvrir son esprit et changer sa vie.",
          "runtime": 84,
          "tagline": "",
          "title": "Une victoire pour Noël"
        }
      },
      {
        "iso_3166_1": "CA",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
