      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Egy elkényeztetett városi macska, Miss Moxy a dél-franciaországi nyaralás során elszakad a gazdájától, és kénytelen hazafelé tartó hosszú útjára indulni egy nyűgös kutya és egy idős madár társaságában. Az úton kettejükre van utalva, miközben veszélyes és kalandos helyzetek sorát élik át, és Miss Moxy fokozatosan ráébred, hogy a barátság és az együttműködés sokkal többet jelent, mint amit addig gondolt. (Csillag Lajos)",
          "runtime": 0,
          "tagline": "",
          "title": "Moxy cica nagy utazása"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "휴가지에서 가족과 떨어진 도도한 도시 고양이 '목시'의 귀가 여정을 그린 작품이다.",
