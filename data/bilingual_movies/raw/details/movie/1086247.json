      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "2002 год. 28-летняя Кейт Мосс – уже живая легенда моды, но за образом вечной иконы она отчаянно жаждет, чтобы её наконец увидели настоящую. Рискнув, она сближается с гениальным художником Люсьеном Фрейдом (внуком Зигмунда Фрейда). Два титана британской культуры встречаются, и Кейт решается на смелый шаг – обнажиться перед его кистью. В каждом мазке Фрейд исследует скрытые глубины её души, превращая супермодель в вечную музу. Из шумных вечеринок – в тишину самопознания. Это история о том, как, обретя свой голос, Кейт Мосс открывает свою истинную сущность.",
          "runtime": 97,
          "tagline": "",
          "title": "Кейт Мосс и Фрейд"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
