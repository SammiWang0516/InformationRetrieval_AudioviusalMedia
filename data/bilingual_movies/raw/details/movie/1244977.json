      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Valentin, zagubiony i bez grosza przy duszy mężczyzna, po dwudziestu latach nieobecności spotyka się ze swoim synem Josephem, co pogrąża go i jego żonę Alice w całkowitym chaosie. Z JP, Milą i Gigi w pobliżu, diabeł powinien mieć się na baczności…",
          "runtime": 84,
          "tagline": "",
          "title": "Plus forts que le diable"
        }
