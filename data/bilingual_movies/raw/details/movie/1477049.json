    "translations": [
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Cris, una corredora de élite, sufre un brote psicótico que la obliga a alejarse de la alta competición. No todos a su alrededor podrán o sabrán cómo ayudarla pero Natalia, su hermana, será su refugio para aceptar su condición y redefinir su ritmo de vida.",
          "runtime": 0,
          "tagline": "",
          "title": "Corredora"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "ca",
        "name": "Català",
        "english_name": "Catalan",
        "data": {
          "homepage": "",
          "overview": "La Cris, una corredora d'elit, té un brot psicòtic que l'obliga a allunyar-se de l'alta competició. No tothom al seu voltant podrà o sabrà com ajudar-la, però la Natàlia, la seva germana, serà el seu refugi per acceptar la seva condició i redefinir el seu ritme de vida.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Cris dedicates herself body and soul to athletics. While preparing for the 800-meter race at the Spanish National Championships, she suffers a severe psychotic break brought on by mounting pressure. As recovery unfolds, Cris keeps her eyes fixed on the track, holding on to the dream that has always defined.",
          "runtime": 96,
          "tagline": "",
          "title": "Runner"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "Cris是頂尖長跑手，時刻都在田徑場上追趕分秒，豈料全國錦標賽前夕，精神崩潰突然來襲，迫使她暫別高強度競賽。越是心急欲重拾狀態，就越是因為藥物治療步履維艱。追逐速度讓人暫忘心魔，及時停下卻需更大勇氣。還好妹妹Natàlia 作為她的避風港，協助她驅散內心恐懼情緒的出口，陪伴她學會接受自己的狀況並重新定義人生的步伐。導演 Laura García Alonso 受親人經歷啟發，首部長片細膩描寫運動員的自我爭鬥。",
          "runtime": 0,
          "tagline": "",
          "title": "停一步的速度"
        }
      },
      {
        "iso_3166_1": "BE",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Cris wijdt zich met lichaam en ziel aan atletiek. Terwijl ze zich voorbereidt op de race van 800 meter op de Spaanse Nationale Kampioenschappen, lijdt ze aan een ernstige psychotische aanval, veroorzaakt door de toenemende druk. Terwijl het herstel zich ontvouwt, houdt Cris haar ogen op de baan gericht en houdt ze vast aan de droom die altijd gedefinieerd is.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
