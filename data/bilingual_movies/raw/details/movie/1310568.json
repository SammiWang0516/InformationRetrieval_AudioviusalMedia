        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "1934-ben Miranda Green magánnyomozó egy gyilkosságot vizsgál a kairói brit nagykövetségen, ahol egy szigorúan titkos dokumentumot loptak el. Az eset veszélybe sodorhatja mind a Buckingham-palotát, mind a világbékét.",
          "runtime": 0,
          "tagline": "",
