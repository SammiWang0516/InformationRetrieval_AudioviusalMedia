      {
        "iso_3166_1": "FI",
        "iso_639_1": "fi",
        "name": "suomi",
        "english_name": "Finnish",
        "data": {
          "homepage": "",
          "overview": "Ylläksellä kuvattu Delivery Run sijoittuu Minnesotan talvisiin maisemiin. Ruokalähetti Leellä on jo valmiiksi vaikeaa selvitä päivästä. Hänellä on rahaa vaativa unelma, mutta tulot tuppaavat valumaan nuoren miehen sormien välistä saman tien. Sen vuoksi hän on väärille tahoille velkaa summia, joita on vaikea koota ruokakuljetustipeillä. Yritettävä kuitenkin on, mutta matkan varrella hän saa peräänsä metsiä halkovia autioita teitä piinaavan tappajan - massiivisen kuormurin, jonka eteen tyly aura on valjastettu muiden tielläliikkujien kiusaksi. Leellä on vastassa auran lisäksi sen kuljettaja, joka asustaa vuorella kuin peikko konsanaan. Näennäisenä apunaan hädän hetkellä Leellä on tuttu Highway Patrolman Nathan, joka ei kuitenkaan ole oikein tehtäviensä tasalla.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um entregador de comida se vê envolvido em uma perseguição mortal na região selvagem e gelada de Minnesota, perseguido por um motorista de limpa-neve enlouquecido por razões desconhecidas, enfrentando situações de risco de vida e sendo forçado a usar a inteligência para escapar sozinho de seu implacável perseguidor.",
          "runtime": 74,
          "tagline": "Seja mais esperto ou seja ultrapassado.",
          "title": "Entrega Fatal"
        }
