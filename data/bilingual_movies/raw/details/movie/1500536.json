      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ในช่วงการสังหารหมู่ที่หนานจิงในปี 1937 พนักงานไปรษณีย์คนหนึ่งในปลอมตัวเป็นช่างภาพ และช่วยเหลือกองทัพญี่ปุ่น ในขณะที่แอบให้ที่หลบซ่อนแก่ผู้ลี้ภัยชาวญี่ปุ่นอย่างลับ ๆ ในภายหลังเขาได้เสี่ยงชีวิตในการเคลื่อนย้ายพวกเขา และเปิดเผยหลักฐานเกี่ยวกับความโหดร้ายที่เกิดขึ้น",
          "runtime": 0,
          "tagline": "",
          "title": "บันทึกหนานจิง"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Phim xoay quanh nhân vật A Chang do diễn viên Haoran Liu thủ vai, một người đưa thư phải giả làm thợ rửa ảnh cho quân đội Nhật để sinh tồn trong thời kỳ hỗn loạn. A Chang âm thầm che chở những người dân và binh lính Trung Quốc trong một tiệm ảnh, đồng thời đối mặt với áp lực từ Wang Guanghai – phiên dịch viên cho quân Nhật. Câu chuyện dựa trên những bức ảnh thật ghi lại tội ác chiến tranh, lấy cảm hứng từ tiệm ảnh Huadong, nơi lưu giữ những bằng chứng quan trọng cho Tòa án Chiến tranh Nam Kinh. Phim không chỉ gây ấn tượng với kịch bản sâu sắc mà còn được đầu tư kỹ lưỡng về âm nhạc của Fei Peng, hình ảnh quay phim của Wang Tianxing và hiệu ứng đặc biệt tinh tế, tạo nên không khí chân thực và ám ảnh.",
          "runtime": 0,
          "tagline": "",
          "title": "Tiệm Ảnh Nam Kinh"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Podczas japońskiej okupacji Nankinu dochodzi do masowych mordów, gwałtów i grabieży. Listonosz Ah Chang przypadkowo trafia do zakładu fotograficznego, w którym wraz z jego właścicielem i innymi ukrywającymi się cywilami zostaje zmuszony do wywoływania zdjęć wykonywanych przez japońskiego fotografa wojskowego Hideo Itō. Wśród negatywów znajdują się zarówno spreparowane materiały propagandowe, jak i autentyczne fotografie dokumentujące zbrodnie wojenne. Bohaterowie decydują się ukryć dowody i przemycić je poza miasto. Ich działania prowadzą do serii dramatycznych poświęceń, a zdjęcia ostatecznie trafiają do opinii międzynarodowej, stając się niepodważalnym dowodem w procesach zbrodniarzy wojennych po zakończeniu wojny.",
          "runtime": 0,
          "tagline": "",
          "title": "Masakra w Nankinie"
        }
      },
