  "translations": {
    "translations": [
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Una storia d’amore in cui i confini tra presenza e assenza, cura e dipendenza, desiderio e controllo si confondono fino a dissolversi. Leo e Anne si inseguono, si sfiorano, si perdono, si cercano. Non riescono a lasciarsi né a liberarsi. Tra le stanze risuona la voce di Ava che attraversa il tempo e lascia affiorare ciò che resiste, o che non può più essere trattenuto.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Leo and Ava chase each other—coming close, drifting apart, and searching for their way back. They cannot let go, nor break free. Through the rooms, Ava’s voice echoes across time, carrying to the surface what endures—and what can no longer be held back.",
          "runtime": 123,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
