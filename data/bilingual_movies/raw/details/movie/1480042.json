  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://locksmithanimation.com/films/cardboard",
          "overview": "When an overwhelmed, single dad pig moves his piglets into a rundown trailer park, he fears he’s failed his family. But soon his kids create a wildly imaginative game from a simple cardboard box, and Dad has a choice: dwell on the past or join them on their intergalactic adventure.",
          "runtime": 10,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "Quando un papà single sopraffatto dagli eventi trasferisce i suoi maialini in un fatiscente parcheggio per roulotte, teme di aver deluso la sua famiglia. Ma presto i suoi figli inventano un gioco incredibilmente fantasioso utilizzando una semplice scatola di cartone, e papà si trova di fronte a una scelta: rimuginare sul passato o unirsi a loro nella loro avventura intergalattica.",
          "runtime": 9,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Un papá cerdito llega con sus dos hijos a un nuevo hogar tan inhóspito como inesperado: una caravana en medio de un desierto desolado. Hundido por la pérdida de su esposa, un recuerdo del pasado amenaza con atraparlo en la tristeza. Pero al ver a los pequeños explorar y jugar con entusiasmo, deberá decidir si seguir anclado al dolor o sumarse a la aventura, abrirse al presente y reconstruir su vida junto a ellos.",
          "runtime": 0,
          "tagline": "",
          "title": "Caja de cartón"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Kiedy przytłoczony, samotny ojciec-świniak przenosi swoje prosiaczki do podupadłego parku przyczep kempingowych, obawia się, że zawiódł rodzinę. Wkrótce jednak jego dzieci tworzą niezwykle pomysłową grę z prostego kartonowego pudełka, a tata staje przed wyborem: rozpamiętywać przeszłość czy dołączyć do nich w ich międzygalaktycznej przygodzie.",
          "runtime": 10,
          "tagline": "",
          "title": "Cardboard"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "　　一只不堪重负的单身猪爸爸带着他的小猪们搬进了拖车公园，他担心自己辜负了家人。但很快，孩子们就创造出了一个天马行空的游戏，爸爸面临着一个选择：是沉湎于过去，还是加入他们的冒险之旅。",
          "runtime": 0,
          "tagline": "",
          "title": "纸板游戏"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "搬進狹小拖車後，單親豬爸爸擔心讓孩子失望；孩子們卻把紙箱變成奇幻樂園，也帶著父親重新找回快樂與陪伴。",
          "runtime": 0,
          "tagline": "",
          "title": "紙箱裡的世界"
        }
      }
    ]
