      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Nekdanja dirkačica se vrne v šport preko dirkaške akademije, kjer spozna Willa. Ko se zaljubita, postaneta tekmeca, ki se borita za prvenstvo Formule 1, kar jo prisili, da izbira med ljubeznijo in zmago.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Max sempre viveu pela velocidade. Num mundo que a rejeitou, um ex-piloto ousado mantém a fé e persegue um único objetivo: torná-la a mais rápida de todas.",
          "runtime": 0,
          "tagline": "",
          "title": "Faster: No Limite da Velocidade"
        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Max sempre viveu para a velocidade. Quando descobre o karting, decide que um dia será campeã de Fórmula 1. No entanto, aos 17 anos, nenhuma equipa está disposta a apostar nela. Perante um mundo que lhe vira as costas, um ex-piloto irreverente reconhece o seu potencial e decide ajudá-la a perseguir o seu sonho.",
          "runtime": 0,
          "tagline": "Não há travões quando o sonho acelera",
          "title": "Faster – Máxima Velocidade"
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "",
          "overview": "幼い頃からスピードに魅せられ、F1の世界チャンピオンを夢見てきた少女マックス。数々のジュニア大会で実績を積みレーシングスクールで優勝したが、F3のドライバーに選ばれたのはライバルのウィル。“女性である”という理由だけで道は閉ざされていた。そんな彼女に手を差し伸べたのは、かつて挫折を味わった伝説の元F1レーサーのスタン。彼女に可能性を見出したスタンは無名のチームで、男性優位の過酷な世界の頂点を目指す。マックスの前に立ちはだかるのは、実力・経験・支援すべてを持つエリートたちと最大のライバルのウィル。性別も過去も常識もすべてを置き去りにして、マックスは限界の先へと飛び込んでいく。",
          "runtime": 0,
          "tagline": "",
          "title": "フォーミュラ"
        }
      }
    ]
