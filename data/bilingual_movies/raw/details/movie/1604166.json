  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "宋隐（宋洋 饰）奉命调查“极乐膏”制贩案件。办案期间，他获得了游侠夜刹、大夫燕云升（陈立农 饰）、药师素娥（姜佩瑶 饰）等人的帮助。他们通过顽强战斗与勇敢牺牲，撕碎了犯罪头目白启年的保护伞，还一方安定。宋隐继续踏上铲奸除恶的漫漫长路。",
          "runtime": 85,
          "tagline": "",
          "title": "无归客"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 85,
          "tagline": "",
          "title": "The Man with No Return"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Tống Ẩn nhận lệnh điều tra vụ án sản xuất và buôn bán \"Cực Lạc Cao\". Trong quá trình phá án, anh nhận được sự giúp đỡ của hiệp khách Dạ Sát, đại phu Yến Vân Thăng và dược sư Tố Nga. Nhờ vào những trận chiến ngoan cường và sự hy sinh dũng cảm, họ đã xé toang tấm bình phong che chở cho tên tội phạm cầm đầu Bạch Khải Niên, mang lại sự bình yên cho người dân.",
          "runtime": 0,
          "tagline": "",
          "title": "Vô Quy Khách"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "조정의 특수 사관 송은은 중앙에서 내려온 밀명을 받고, 사람들의 정신과 육체를 파괴하는 치명적인 독약 ‘극락고’의 유통 실태를 조사하게 된다. 추적 끝에 만난 유랑 무사 야찰, 신비로운 명의 연운승, 약사 소아와 함께 그는 어둠 속에 숨겨진 거대한 음모의 실체를 파헤치기 시작한다.  검은 진실이 드러날수록 송은은 정의와 충성 사이에서 갈등하게 되는데…",
          "runtime": 0,
          "tagline": "정의의 칼날은 어디로 향해야 하는가",
          "title": "무귀객"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ซ่งอิ่นได้รับคำสั่งให้สืบสวนคดีการผลิตและจำหน่าย \"ครีมบลิส\" ในระหว่างการสืบสวน เขาได้รับความช่วยเหลือจากอัศวินเย่ซา แพทย์เยี่ยนอวิ๋นเซิง เภสัชกรซู่เอ๋อ และคนอื่น ๆ ผ่านการต่อสู้ที่มุ่งมั่นและการเสียสละอย่างกล้าหาญ พวกเขาได้ทำลายคนที่ปกป้องหัวหน้าอาชญากรไป๋ฉี่เนี่ยนและฟื้นฟูสันติภาพให้กับพื้นที่",
          "runtime": 0,
          "tagline": "",
          "title": "ไร้ทางหวนคืน"
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Nach dem grausamen Tod seines Bruders wird ein mächtiger Schwertkämpfer in seine von Korruption vergiftete Heimatprovinz entsandt. Zwischen skrupellosen Beamten, einem florierenden Drogenhandel und einer geheimnisvollen Maskengestalt, die im Schatten tödliche Rache übt, gerät er selbst in Gefahr. Während er eine düstere Verschwörung aufdeckt, muss er loyale Mitstreiter um sich scharen, um den Kampf für seine Heimat zu gewinnen.",
          "runtime": 0,
          "tagline": "",
          "title": "The Bladesman"
        }
      }
    ]
