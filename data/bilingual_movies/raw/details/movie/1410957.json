  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "本片改编自同名漫画，讲述了以当红年轻演员的身分开始迈向明星之路的柊木昴（八木勇征 饰），以及他青梅竹马的女高中生天野千明（福本莉子 饰），有着“明星和素人”这种令人着急的关系的超王道爱情故事。",
          "runtime": 108,
          "tagline": "",
          "title": "隔壁的星光"
        }
      },
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://stella-eiga.jp/",
          "overview": "隣同士の家に住む千明と昴は仲の良い幼なじみだったが、昴が芸能界にスカウトされたことで状況が一変する。人気モデルになっても今までと変わらず接してくれる昴に対し、千明は一定の距離を保ちながらも、幼い頃から抱いていた恋心を止められずにいた。思いを募らせた彼女はついに昴に胸の内を明かすが、幼なじみとしてしか見ていないと言われてしまう。これまで毎日のように接してきた千明と昴は、この日からすれ違うようになる。昴の活躍を見て一念発起しアルバイトを始めた千明は、先輩アルバイトの高橋との距離が縮まっていくなかで、傷ついた心が少しずつ癒えていく。一方、昴は活躍の場をモデルからドラマの世界へと移し、スターの道を突き進んでいくが……。",
          "runtime": 108,
          "tagline": "芸能人×幼なじみ　近くて遠い青春ラブストーリー",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Chiaki, a normal teenage girl, has a crush on her best friend Subaru, a rising Japanese actor. She must decide whether to take her shot or risk losing him.",
          "runtime": 0,
          "tagline": "",
          "title": "Stella Next to Me"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "本片改編自同名漫畫，講述了以當紅年輕演員的身分開始邁嚮明星之路的柊木昴（八木勇徵 飾），以及他青梅竹馬的女高中生天野千明（福本莉子 飾），有著“明星和素人”這種令人著急的關係的超王道愛情故事。",
          "runtime": 0,
          "tagline": "",
          "title": "隔壁的星光"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "千明與昴是住在隔壁的青梅竹馬，昴因被星探發掘而成為新生代人氣男演員，千明暗戀昴多年，卻因身份差距始終隱藏心意。最終她鼓起勇氣告白，卻只換來「我只把你當青梅竹馬」的回應。心碎的千明決定壓抑感情，選擇以朋友的身份繼續支持他，「近在咫尺卻遙不可及」的暗戀會有結果嗎？",
          "runtime": 108,
          "tagline": "單戀的青梅竹馬 如今成為大明星",
          "title": "隔壁的星光"
        }
      }
    ]
