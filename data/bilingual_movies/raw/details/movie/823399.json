        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.dariusfilms.com/?films=daniels-gotta-die",
          "overview": "Billionaire Edward Powell has died, leaving his vast estate to his four adult children.  Their inheritance comes with one big catch: the dysfunctional family must spend the weekend together at the family beach house on the Cayman Islands.",
          "runtime": 90,
          "tagline": "Fortune favors the bold.",
          "title": ""
        }
