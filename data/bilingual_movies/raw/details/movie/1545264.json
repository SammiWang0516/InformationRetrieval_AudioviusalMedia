      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "影片以北陆的港口城市为舞台，讲述了原本是黑社会成员的大叔（馆博 饰）与因事故失去双亲的视障少年幸太（尾上真秀 饰）之间十几年间的友情。大叔想方设法筹到了钱，治好了幸太的眼睛后却离开了。成为青年的幸太（真荣田乡敦 饰）相信了“其实叔叔以前是刑警”的谎言，为了追逐给自己带来光明的憧憬之人而当上了刑警。",
          "runtime": 118,
          "tagline": "",
          "title": "港之光"
        }
