  "translations": {
    "translations": [
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Недалёкое будущее. Мир разорён Третьей мировой войной, из-за которой рухнули ключевые экосистемы, а Северная Америка оказалась разделена на четыре основных квадранта. Благодаря учёному Айону Прескотту, человечеству удалось избежать вымирания. Компания Прескотта Alpire создала Onyx — смертоносный нановирус, который распространяется через часы, заражает носителя и указывает ему цель для устранения в обмен на противоядие.",
          "runtime": 0,
          "tagline": "Судья. Палач. Свобода.",
          "title": "Капкан времени"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "North America has been divided into four main quadrants. A power-hungry corporation has taken over the conventional prison system and made criminals the new law enforcers.  The owner of that corporation, nanoscientist Eion Prescott, created a nano-virus called Onyx. Which is distributed through deadly watches to criminals. First, infecting them. Then, forcing them into eliminating each other for freedom. Who can topple the corporation's entire system from within?",
          "runtime": 87,
          "tagline": "Judge. Executioner. Freedom.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Một tập đoàn tham lam quyền lực đã thâu tóm hệ thống nhà tù truyền thống và biến tội phạm thành những người thực thi pháp luật mới.",
          "runtime": 0,
          "tagline": "",
          "title": "Mã tiêu diệt"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "W przyszłości pełnej przestępczości, żądna władzy korporacja wydała śmiercionośne rozkazy przestępcom, zmuszając ich do wzajemnej eliminacji w imię wolności. Tylko jeden z nich może obalić cały system od wewnątrz.",
          "runtime": 0,
          "tagline": "SĘDZIA. KAT. WOLNOŚĆ.",
          "title": "Hard Matter"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Într‑un viitor marcat de infracționalitate, o corporație puternică impune deținătorilor de cronometre mortale să se elimine unii pe alții pentru a obține libertatea. Lukas, Eion și Elera se trezesc prinși într-un sistem letal, unde alianțe și confruntări le decid șansele de supraviețuire și controlul propriei vieți.",
          "runtime": 87,
          "tagline": "",
          "title": "Motivație letală"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "犯罪泛滥的未来，一家权力企业垄断监狱系统，为罪犯发放致命手表，逼迫他们互相残杀以换取自由。埃勒拉是被操控的杀手之一，她必须在生死猎杀中活下来，却发现自己有着双重身份——她既是企业的棋子，也是系统内部的颠覆者。在霓虹雨夜的都市与冰冷的企业实验室之间，埃勒拉一边与其他罪犯厮杀，一边暗中布局，试图从内部推翻这个操控人性的暗黑系统。",
          "runtime": 0,
          "tagline": "",
          "title": "杀戮密码"
        }
      },
