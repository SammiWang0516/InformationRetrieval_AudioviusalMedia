      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "หนุ่มฮอตจาก VMX อย่าง แอสทริด ลี, ชีน่า ดิซอน, รีอา มอนเตมายอร์ และ เลียนา โรซาเลส ต่างตกหลุมรักกันอย่างจังเมื่อเด็กหนุ่มปริศนาในสระว่ายน้ำได้เข้าร่วม Wet and Wild Resort เขาเอาชนะใจพวกเธอได้อย่างง่ายดาย แต่ไม่นานก็พบว่าตัวเองไม่ได้บริสุทธิ์ผุดผ่องแต่อย่างใด",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "VMX的性感女郎阿斯特丽德·李、奇娜·迪宗、瑞亚·蒙特马约尔和莉安娜·罗萨莱斯在一位神秘的泳池男孩加入“湿身狂野度假村”后，迅速坠入爱河。他轻易赢得了她们的芳心，但很快她们就发现他远非表面看起来那么单纯。",
          "runtime": 0,
          "tagline": "",
          "title": "滑情陷阱"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "סטריד לי, צ'ינה דיזון, ריאה מונטמאיור וליאנה רוזלס, חברות VMX לוהטות, מוצאות את עצמן מוטרפות כשנער בריכה מסתורי מצטרף למלון \"Wet and Wild\". הוא כובש בקלות את ליבן, אך עד מהרה מתגלה שהוא רחוק מלהיות תמים.",
          "runtime": 82,
          "tagline": "",
          "title": "חלקלק"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "모두를 매혹시킨 완벽한 남자의 비밀! 빈틈없이 완벽하고 엄격하기로 소문난 리조트의 여사장. 엄격한 분위기에 직원들은 숨 막히는 긴장 속에 살아간다. 하지만 잘생긴 외모와 묘한 분위기를 풍기는 한 남자 직원이 새로 오면서 리조트의 공기는 순식간에 뒤바뀐다. 차갑던 사장조차 그의 매력에 무너져 다정하게 변해가고, 리조트의 모든 여직원들은 그를 차지하기 위해 은밀한 유혹의 경쟁을 시작한다. 그는 모든 여자와 관계를 맺으면서도 이를 철저히 비밀에 부치며 아슬아슬한 이중생활을 즐긴다. 사랑인 줄 알았던 매혹 뒤에 감춰진 진실. 그녀들은 무사히 빠져나올 수 있을까?",
          "runtime": 0,
          "tagline": "",
          "title": "그녀들이 사랑한 남자"
        }
      }
