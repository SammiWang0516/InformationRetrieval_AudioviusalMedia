  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A documentary film that observes, listens to, and interacts with Fito Páez from a place of profound intimacy. The camera, almost invisible, witnesses his every move, accompanying him for over a year during recordings, rehearsals, tours, and performances in major cities across Latin America, Europe, and the United States. It is also a journey through the life of one of the greatest Spanish-language artists: his loves and heartbreaks, children and friendships, excesses, tragedies, failures, and successes.",
          "runtime": 112,
          "tagline": "",
          "title": "Fito Páez: The World Within a Song"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "아르헨티나 록의 아이콘 피토 파에스를 밀착 조명한 다큐멘터리. 그가 어디서도 볼 수 없었던 진솔한 모습으로 자신의 삶과 사랑, 음악을 돌아본다.",
          "runtime": 0,
          "tagline": "",
          "title": "피토 파에스: 노래 한 곡에 세상을 담은 남자"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Una película documental que observa, escucha e interactúa con Fito Páez desde un lugar de profunda intimidad.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Cu acces fără precedent, acest documentar intim prezintă vedeta rock argentiniană, Fito Páez, vorbind deschis despre viață, dragoste și muzică.",
          "runtime": 0,
          "tagline": "",
          "title": "Fito Páez: Lumea într-un cântec"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "2024 年的一场意外，让驰骋乐坛四十余年的阿根廷摇滚巨匠菲托・派斯被迫中止环球巡演，命运按下暂停键，也促成这场向内的回望之旅。导演作为他多年挚友，得以获得前所未有的近距离拍摄权限，镜头隐匿于一旁，历时一年有余，跟随音乐人辗转拉美、欧洲、美国，捕捉录音室的打磨、排练的焦灼、舞台之上的沸腾瞬间。 　　大量尘封的档案影像、现场实录与袒露内心的私人对话交织成片。不止是关于作品与荣光，更剖开音乐人完整的生命切面：炽热的爱恋与心碎别离，亲情羁绊与挚友相伴，人生的放纵沉沦、命运悲剧、失意低谷与登顶时刻。世间万般悲欢，皆被写进他的歌声之中。",
          "runtime": 0,
          "tagline": "",
          "title": "菲托·帕兹：歌中的世界"
        }
      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Un documental que observa, escucha e interactúa con Fito Páez desde una profunda intimidad. La cámara, casi invisible, es testigo de cada uno de sus movimientos, acompañándolo durante más de un año entre grabaciones, ensayos, giras y presentaciones en las principales ciudades de América Latina, Europa y Estados Unidos. Es también un recorrido por la vida de uno de los artistas más grandes de la música en español: sus amores y desamores, sus hijos y amistades, los excesos, las tragedias, los fracasos y los éxitos.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um documentário que observa, ouve e interage com Fito Páez com profunda intimidade. A câmera é uma testemunha quase invisível de cada passo dele e o acompanha por mais de um ano em meio a gravações, ensaios, turnês e apresentações em cidades importantes da América Latina, Europa e Estados Unidos. Também é uma jornada pela vida de um dos maiores artistas de língua espanhola: seus amores, mágoas, filhos, amizades, excessos, tragédias, fracassos e triunfos.",
          "runtime": 0,
          "tagline": "",
          "title": "Fito Páez: O Mundo Cabe em Uma Canção"
        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um documentário que observa, escuta e interage com Fito Páez a partir de uma profunda intimidade. A câmara, quase invisível, testemunha cada movimento seu, acompanhando-o durante mais de um ano durante gravações, ensaios, digressões e apresentações em grandes cidades da América Latina, Europa e Estados Unidos. É também uma viagem pela vida de um dos maiores artistas de língua espanhola: os seus amores e desilusões, filhos e amizades, excessos, tragédias, fracassos e sucessos.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "สารคดีนี้พาไปสัมผัสชีวิตเบื้องลึกของฟิโต ปาเอซ ร็อกสตาร์ชาวอาร์เจนตินาอย่างใกล้ชิดแบบที่ไม่เคยมีมาก่อน ผ่านการบอกเล่าเรื่องราวชีวิต ความรัก และดนตรี",
          "runtime": 0,
          "tagline": "",
          "title": "ฟิโต ปาเอซ: โลกทั้งใบในบทเพลง"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "פורטרט תיעודי אינטימי וחשוף של כוכב הרוק הארגנטינאי פיטו פאאס, שמביט לאחור על חייו ומדבר בכנות על אהבותיו ועל המוזיקה שלו. מאת הבמאי מטיאס גילברט.",
          "runtime": 112,
          "tagline": "",
          "title": "פיטו פאאס: העולם כולו בתוך שיר"
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Un film documentaire qui observe, écoute et interagit avec Fito Páez dans une profonde intimité. La caméra, presque invisible, est témoin de chacun de ses gestes, l'accompagnant pendant plus d'un an lors d'enregistrements, de répétitions, de tournées et de concerts dans les grandes villes d'Amérique latine, d'Europe et des États-Unis. C'est aussi un voyage à travers la vie de l'un des plus grands artistes hispanophones : ses amours et ses peines, ses enfants et ses amitiés, ses excès, ses tragédies, ses échecs et ses succès.",
          "runtime": 0,
          "tagline": "",
          "title": "Fito Paez : Le monde dans une chanson"
        }
      },
