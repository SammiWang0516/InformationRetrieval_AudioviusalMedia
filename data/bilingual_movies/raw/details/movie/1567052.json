      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "九歲的梅有點自閉傾向，初經來臨之際，懷孕的母親陷入長眠，鄰居則不斷播放〈花事將啟〉的詩詞朗讀。千禧年將至，隨著日食逼近，他在感官刺激、身體變化與被迫長大的壓力中尋找出口。本片帶有強烈的魔幻與實驗色彩，以風格化的瑰麗影像，捕捉世紀轉換之際，身處時代縫隙的女人與女孩身影，凝視他們如何面對社會賦予女性的角色、責任與想像。",
          "runtime": 0,
          "tagline": "",
          "title": "月花"
        }
