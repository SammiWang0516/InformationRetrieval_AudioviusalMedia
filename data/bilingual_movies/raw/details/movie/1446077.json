      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "영화는 건축가 렌초 피아노의 주도 하에 이뤄진, 전설적인 영화관의 재건축 과정을 다룬다. 3년에 걸쳐 촬영된 기록들은 그 현장을 사회의 축소판으로 비춰내며, 영화의 마법을 만들어 내기 위해 필요한 노동의 현실과, 그 안에 존재하는 다양한 역할과 위계를 살핀다. 사람들은 미세혈관처럼 건물 안팎을 오가며, 유기체처럼 그려지는 건물의 들숨과 날숨을 구성하는 요소가 된다.",
          "runtime": 94,
          "tagline": "",
          "title": "컨스트럭션 사이트"
        }
