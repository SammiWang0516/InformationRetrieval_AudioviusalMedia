  "translations": {
    "translations": [
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "http://www.oficinadodiabofilme.com/",
          "overview": "Após tentar a vida como músico na cidade grande, Pedro fracassa e volta, sem rumo, para a casa de sua mãe no interior. O demônio Natan levou Pedro a escolhas erradas, no entanto, suas tentações não conseguiram desvirtuá-lo completamente. Decididos a condenar a alma de Pedro ao Inferno, a Oficina convoca o experiente demônio Fausto para guiar Natan em sua missão.",
          "runtime": 124,
          "tagline": "Inspirado no best-seller \"Cartas de um Diabo a seu Aprendiz\" de C. S. Lewis",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "In a competition in Hell, a master devil instructs his apprentice on human behavior while following the path of a \"client\" at the crossroads between good and evil.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Um ambicioso jovem demônio é instruído por um demônio mais velho e experiente na arte e na ciência de condenar uma alma ao Inferno. Em meio a tentações, dilemas e duras lições sobre o coração humano, o destino da alma humana está em jogo.",
          "runtime": 124,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Эта фирма с незапамятных времён сотрудничает с людьми. Её реклама эффективнее всего, ведь она транслируется напрямую в нашу голову. Чей голос мы слышим в минуты душевных терзаний? Кто ведёт нас за руку по пути к успеху? И какую цену придётся за этот успех заплатить?",
          "runtime": 0,
          "tagline": "",
          "title": "Мастерская сатаны"
        }
      }
    ]
