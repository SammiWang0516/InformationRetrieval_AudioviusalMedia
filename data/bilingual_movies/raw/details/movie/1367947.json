  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Set in 1960s Java, a young Javanese woman betrays her teacher, falls in love and must face dire consequences.",
          "runtime": 132,
          "tagline": "",
          "title": "Gowok: Javanese Kamasutra"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "W kulturze jawajskiej Gowok to określenie kobiety, która jest wynajmowana do nauczania nastoletnich chłopców lub chłopców przed ślubem, zasad prowadzenia gospodarstwa domowego i seksualności. Rodzina pana młodego wynajmuje gowok dla swojego syna przed ślubem. Gowok nauczy jednego z nich, jak zadowolić żonę i zapoznać się z ciałem kobiety.",
          "runtime": 130,
          "tagline": "",
          "title": "Gowok: Kamasutra Jawa"
        }
      },
      {
        "iso_3166_1": "ID",
        "iso_639_1": "id",
