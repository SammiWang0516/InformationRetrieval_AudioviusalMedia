        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "История священника, который сомневается в своей вере, но вынужден участвовать в изгнании демона из подростка.",
          "runtime": 96,
          "tagline": "",
          "title": "Астрал. Доминион"
