      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Alyssa, uma jovem destemida, e Mehdi, um artista sensível, são melhores amigos desde a infância. Sufocados pela vida nos subúrbios de Túnis, eles veem em um concurso de arte na ilha de Djerba a chance de escapar dessa realidade. Alyssa, então, arrasta Mehdi para uma jornada fantástica através da Tunísia, colocando a amizade deles à prova.",
          "runtime": 0,
          "tagline": "",
          "title": "De Onde Vem o Vento"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Nieustraszona Alyssa i wrażliwy artysta Mehdi, przyjaciele od dziecka, czują się uwięzieni w życiu na obrzeżach Tunisu. Gdy Alyssa odkrywa konkurs artystyczny w Dżerbie, który może dać im szansę na nowy start, wciąga Mehdiego w pełną przygód podróż przez Tunezję. Wyprawa szybko wystawi ich przyjaźń na próbę.",
          "runtime": 0,
          "tagline": "",
          "title": "Skąd się bierze wiatr"
        }
      },
      {
        "iso_3166_1": "IL",
        "iso_639_1": "he",
        "name": "עִבְרִית",
        "english_name": "Hebrew",
        "data": {
          "homepage": "",
          "overview": "אליסה, נערה מרדנית בת 19, ומהדי, חברה הביישן בן ה-23, מרגישים לכודים במציאות חייהם בתוניסיה וחולמים למצוא דרך לברוח. כאשר מהדי מגלה על תחרות אמנות בדרום המדינה, בעיר ג'רבה, שהפרס בה יכול לממן עבורם התחלה חדשה, השניים מחליטים לצאת יחד למסע דרכים. במהלך המסע ההרפתקני והמאתגר ברחבי תוניסיה, החברות שלהם עומדת במבחן בזמן שהרצון שלהם לחופש מתנגש עם מציאות החיים בעולם הערבי-פטריכאלי שסביבם.",
          "runtime": 100,
          "tagline": "",
          "title": "מהיכן באה הרוח"
        }
