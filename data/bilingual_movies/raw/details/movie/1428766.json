      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Passado em 1986, durante um escaldante verão australiano, a celebração de três melhores amigos numa casa de praia transforma-se numa sangrenta luta pela sobrevivência quando uma brincadeira corre terrivelmente mal.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
