  "translations": {
    "translations": [
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "У школі проводять батьківські збори. Причина — на виборах президента школи переміг найгірший учень з можливих, тож тепер батьки впевнені у фальсифікації голосів. Раціональне обговорення швидко переростає у запеклі дебати, які розкривають недосконалість шкільної системи освіти та викривають особисті сімейні таємниці кожної з родин.",
          "runtime": 90,
          "tagline": "Вони забули голову вдома",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "When the daughter of a teacher wins the school presidential election, outraged parents suspect fraud and convene a parents’ meeting that spirals into fierce debates, exposing gaps in upbringing and revealing secrets no one could have imagined.",
          "runtime": 90,
          "tagline": "",
          "title": "Parents Meeting"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Победа сына учительницы на выборах президента школы кажется родителям подозрительной и вызывает волну возмущения. Уверенные в фальсификации, они собирают экстренное родительское собрание, которое быстро выходит из-под контроля. Спокойный разговор превращается в ожесточённые дебаты, где всплывают ошибки воспитания, скрытые обиды и тайны, о которых никто не осмеливался говорить. Обычный школьный конфликт становится зеркалом взрослых проблем, разоблачающим куда больше, чем просто исход выборов.",
          "runtime": 0,
          "tagline": "",
          "title": "Родительское собрание"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Wanneer de dochter van een leraar de verkiezingen voor schoolpresident wint, vermoeden verontwaardigde ouders fraude en beleggen ze een ouderbijeenkomst. Deze bijeenkomst escaleert in felle debatten, waarbij tekortkomingen in de opvoeding aan het licht komen en geheimen worden onthuld die niemand had kunnen vermoeden.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
  },
