      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "WWE SummerSlam 2026 (Tag 1) fand am Samstag, dem 1. August 2026, im U.S. Bank Stadium in Minneapolis, Minnesota, statt.  Match Card:  WWE Women’s World Championship Match: Liv Morgan vs. IYO SKY  6-Man Tag Team Match: LA Knight, Solo Sikoa & Royce Keys vs. Jacob Fatu & The Usos (Jimmy Uso & Jey Uso)  Gunther vs. Nick Aldis  6-Woman Tag Team Match: Fatal Influence (Jacy Jayne, Fallon Henley & Lainey Reid) vs. The Bella Twins (Nikki & Brie Bella) & Paige Undisputed WWE Championship Match: CM Punk vs. Cody Rhodes Hell in a Cell Match: Brock Lesnar vs. Oba Femi",
          "runtime": 173,
          "tagline": "",
          "title": "WWE SummerSlam 2026: Samstag"
        }
      },
      {
        "iso_3166_1": "PT",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "O SummerSlam de 2026, também promovido como SummerSlam: Minnesota, é um evento de luta livre profissional do tipo \"pay-per-view\" (PPV) e transmitido em direto, produzido pela WWE. Trata-se da 39.ª edição anual do SummerSlam e decorreu ao longo de duas noites, a 1 e 2 de agosto, no U.S. Bank Stadium, em Minneapolis, Minnesota.",
          "runtime": 190,
          "tagline": "",
          "title": ""
        }
      }
