        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Set in the politically turbulent late 1950s, Krishnan Pillai, a playful ruffian chosen by the Church to lead a defensive force, the Christopher Sena. His mission to resist the Communist government takes a detour when he experiences an ideological awakening and falls in love with a comrade, sparking an epic tale of rebellion against feudal power and oppression.",
          "runtime": 128,
          "tagline": "An Epic Of A Crusader",
          "title": "Pallichattambi"
        }
