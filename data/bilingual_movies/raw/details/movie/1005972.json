        "data": {
          "homepage": "https://triart.se/bio/hypnosen",
          "overview": "André and Vera are a young entrepreneurial couple. They get the opportunity to pitch their female health app at a prestigious competition. Before going there, Vera tries hypnotherapy to quit smoking. From this point, her attitude changes and André starts to behave unexpectedly.",
          "runtime": 100,
          "tagline": "",
          "title": "The Hypnosis"
        }
