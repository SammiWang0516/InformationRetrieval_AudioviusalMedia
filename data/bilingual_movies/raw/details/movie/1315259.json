  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Renowned influencer Dzanielle navigates fake friends among the elite, Ozempic-sharting Upper East Siders, only to discover her true self and her first genuine friendship amidst her comedic quest for a million followers.",
          "runtime": 88,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "A renomada influenciadora Dzanielle enfrenta amigos falsos entre os moradores do Upper East Side, que vivem ostentando cartões black, lidando com os efeitos colaterais do Ozempic e viciados em exercícios. Em sua jornada cômica em busca de um milhão de seguidores, ela encontra sua primeira amizade verdadeira e descobre quem realmente é.",
          "runtime": 0,
          "tagline": "",
          "title": "Milagre na Rua 74"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Znana influencerka Dzanielle nawiązuje kontakty z fałszywymi przyjaciółmi wśród czarnoskórych, sprośnych i uzależnionych od ćwiczeń mieszkańców Upper East Side. W swojej komediowej pogoni za milionem obserwujących, odnajduje swoją pierwszą prawdziwą przyjaciółkę i swoje prawdziwe „ja”.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "De bekende influencer Dzanielle manoeuvreert zich door een web van nep vrienden te midden van de zwarte, met creditcards betalende, Ozempic-achtige kapsels sprekende en aan fitness verslaafde bewoners van de Upper East Side. In haar komische zoektocht naar een miljoen volgers vindt ze haar eerste echte vriendin en ontdekt ze wie ze werkelijk is.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "剧情聚焦纽约上东区顶级母婴网红Dzanielle，她将全部人生重心绑定在冲刺百万粉丝这一目标上，日常精心雕琢镜头前的精致人设，周旋在一众只看重流量、奢侈品资源、圈层地位的塑料闺蜜之间，圈子里所有人际交往都是互相蹭热度、攀比医美与穿搭的数据博弈，光鲜滤镜之下全是精神内耗与虚伪客套。就在她被流量焦虑裹挟、自我逐渐空洞麻木时，一段完全不带流量目的、纯粹真诚的友谊闯入她的生活，迫使她亲手撕碎长期打造的完美网红外壳，直面虚假人设带来的自我迷失，踏上剥离流量枷锁、找寻真实自我、重新定义生活价值的成长之路！",
          "runtime": 0,
          "tagline": "",
          "title": "74号街的奇迹"
        }
      }
    ]
  },
