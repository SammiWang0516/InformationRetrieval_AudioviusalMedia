  "translations": {
    "translations": [
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Рома — амбициозный, но неудачливый коммерсант. Чтобы выплатить долги из-за прогоревшего бизнеса, он впервые идёт на мошенничество — вписывает себя в завещание одинокого старика, соседа по даче. Но вместе с домом и участком Рома наследует и… четырех живых гномов, которых скрывал старик. Гномы обладают способностью находить клады, которые можно тратить лишь на добрые дела — этим гномы и занимались со своим покойным хозяином. Если же присвоить клад, то волшебные силы гномов начнут иссякать. Рома мечтает о богатстве и обманом убеждает гномов отправиться в путешествие за легендарным сокровищем, которого Роме хватило бы на всю оставшуюся жизнь.",
          "runtime": 93,
          "tagline": "«Добро никогда не сдаётся»",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A young swindler Roma deceives a wealthy old man out of his inheritance. Along with the property, he inherits four gnomes – good magical creatures capable of finding ancient treasures. But their power can only be used for good deeds. Roma, through deceit, begins to exploit them to get rich, but with each bad act, the power of the mysterious creatures wanes.",
          "runtime": 96,
          "tagline": "",
          "title": "The Treasures of the Gnomes"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "Mladý podvodník Roma oklame bohatého starého muže a připraví ho o dědictví. Spolu s majetkem zdědí i čtyři trpaslíky – dobrotivé kouzelné bytosti, které dokážou nacházet starodávné poklady. Jejich sílu však lze využít pouze k dobrým skutkům. Roma je začne podvodem zneužívat, aby zbohatl, ale s každým zlým činem síla těchto tajemných bytostí slábne.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Der junge Betrüger Roma prellt einen reichen alten Mann um sein Erbe. Zusammen mit dem Besitz erbt er vier Gnome – gutmütige, magische Wesen, die uralte Schätze aufspüren können.",
