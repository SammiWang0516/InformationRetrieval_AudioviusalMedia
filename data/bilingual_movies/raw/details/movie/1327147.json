      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "https://next-film.pl/film/skrzat-nowy-poczatek/",
          "overview": "Opowieść o dziesięcioletniej Hani, która po śmierci mamy przeprowadza się do innego miasta. Tam przez swoje opowieści o małych stworkach staje się obiektem drwin. Zabiera więc do szkoły medalik, który – jak twierdzi – jest prezentem od skrzata. Nowe koleżanki okradają ją i stawiają ultimatum. Hania musi udowodnić istnienie skrzatów. W przeciwnym razie medalik przepadnie.",
          "runtime": 99,
          "tagline": "Przygoda, która poruszy Wasze serca!",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "https://www.yellowaffair.com/pixie",
          "overview": "New in town, eleven-year-old Hania is bullied for believing in pixies. She makes friends with the outsider Michał and a real pixie, Sindri, on a quest to prove their existence. Their journey helps Hania face new beginnings and understand the power of friendship.",
          "runtime": 99,
          "tagline": "It's time to believe.",
          "title": "Pixie. The New Beginning"
        }
      },
      {
        "iso_3166_1": "EE",
        "iso_639_1": "et",
        "name": "Eesti",
        "english_name": "Estonian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "Pisihaldjas tegutseb jälle"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "10 岁的哈尼亚在母亲去世后搬到了另一个城镇。在学校里，她对小精灵的信仰 —— 这是由她已故的母亲燃起的 —— 让她成了众人嘲笑的对象。恶霸们偷走了她的吊坠，那是小精灵送的礼物，现在她必须证明小精灵的存在，否则就会永远失去它。",
          "runtime": 0,
          "tagline": "",
          "title": "精灵新生"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Переехав в новый город, 11-летняя Ханя сталкивается с насмешками сверстников — никто не верит, что гномы существуют. Оставшись почти одна, она находит поддержку в таком же изгое, мальчике по имени Михал, и неожиданно — в самом настоящем гноме по имени Синдри. Вместе они отправляются в удивительное приключение, чтобы доказать миру существование волшебных существ. Это путешествие помогает Хане принять перемены, поверить в себя и понять, что настоящая дружба способна творить чудеса.",
          "runtime": 0,
          "tagline": "",
          "title": "Гном: Новое начало"
        }
      },
      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Haņja kopā ar savu tēti tikko ir pārcēlusies uz citu pilsētu un sāk iet jaunā skolā. Jau pirmajā skolas dienā Haņja klasesbiedriem atklāj, ka tic elfiem, un ar to pietiek, lai citi par viņu sāktu zoboties. Klases meitenes pieprasa, lai Haņja pierādītu, ka elfi tiešām eksistē. Skolotājas dēls Mihals palīdz Haņjai izpildīt trīs uzdevumus, ko viņai uzlicis elfs, tomēr solīto pierādījumu kā nav, tā nav.",
          "runtime": 0,
          "tagline": "",
          "title": "Trīs elfa uzdevumi"
        }
      },
