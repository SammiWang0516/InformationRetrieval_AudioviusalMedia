  "translations": {
    "translations": [
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "ปิดเทอมใหม่ พร้อมกลับมาเจอความสยองเรื่องใหม่กันหรือยัง สานต่อปรากฏการณ์แฟรนไชส์หลอนลึกเกรดเอบวก จาก “มหา’ลัยสยองขวัญ” (2552), “เทอมสอง สยองขวัญ” (2565) และ “เทอม 3” (2567) สู่ “เทอม 4” ผนึกกำลัง 4 เรื่องสยอง 4 สถาบัน 4 ภูมิภาคที่จะทวีความสยองขั้นสุดเป็นสี่เท่า ตำนานไหนจะเป็นตัวแทนความหลอนของภูมิภาค",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Four Thai campuses, four deadly legends. Students face a cursed bridge, a ghost house, a cruel ritual and a haunted room in this horror anthology.",
          "runtime": 128,
          "tagline": "Friends forever. Fear forever.",
          "title": "Haunted Universities 4"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "集結來自泰國四大區域的校園恐怖傳說，這些故事在泰國各地的大學代代流傳至今，分別為：北部的《粉紅房間》描述一位大一新生入住宿舍，她被分配到一間粉紅色的房間，卻不知道房間的前主人還徘徊在這裡；中部的《妃嬪之屋》圍繞著一對攝影師和模特兒展開，她們前往一座古老的宅邸「妃嬪之屋」進行拍攝，結果遭遇一連串神祕事件；南部的《D日之夜》描述一名大一新生拒絕參加迎新儀式，學長姐的鬼魂因此盯上了他；東北部的《白橋》以一對明星情侶為主角，他們決定在學校的「白橋」分手，渾然不知這座橋已經被詛咒了。",
          "runtime": 0,
          "tagline": "",
          "title": "猛鬼大學：4不瞑目"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "影片由四段独立校园灵异故事组成：红房间、妃嫔宿舍、D-Day迎新夜、白桥。四个故事源自泰国四方代代相传的校园传闻，揭露校园体制压迫与代代延续的盲从诅咒。青春校园之下，藏着枉死亡魂永不消散的怨念。",
          "runtime": 0,
          "tagline": "",
          "title": "猛鬼大学4"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Bốn trường đại học Thái Lan, bốn truyền thuyết chết người. Sinh viên đối mặt với cây cầu tử thần, ngôi nhà ma, nghi lễ tàn nhẫn và căn phòng ma ám trong tuyển tập kinh dị này.",
          "runtime": 0,
          "tagline": "",
          "title": "Chuyện Ma Giảng Đường 4"
        }
      }
    ]
