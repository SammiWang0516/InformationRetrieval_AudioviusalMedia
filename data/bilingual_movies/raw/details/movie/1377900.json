      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Ros Knight, az MI5 fegyvertechnikai szakértője váratlanul egy titkos bevetés kellős közepén találja magát, amikor ügynök barátja, Hugh oldalán egy halálos biológiai fegyver megszerzését kell megakadályoznia. Az akció azonban katasztrófába torkollik, Ros célponttá válik, és hamarosan nemcsak könyörtelen zsoldosok, hanem a saját rendszerük is ellene fordul. Menekülés közben kénytelen felkeresni elhidegült apját, Charles Knightot, a legendás, visszavonult kémvadászt, akinek vidéki birtoka lesz az utolsó menedékük. Miközben a támadók ostrom alá veszik a házat, apának és lányának félre kell tenniük régi sérelmeiket, hogy túléljék az éjszakát, megvédjék a fegyvert, és leleplezzenek egy összeesküvést, amely a brit hírszerzés legmélyéig ér.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "臭名昭著的前间谍捕手查尔斯·奈特早已隐退江湖，却被一场危及国土安全的血腥阴谋强行拽回漩涡。他被迫与隔阂深重的女儿罗斯联手，追查真相、阻止灾难。蓄谋入侵者突袭庄园，目标直指他本人。腹背受敌的绝境之下，父女依靠老派间谍手段与求生本能，在密闭宅邸死战，层层撕开藏在阴谋之下的惊天秘辛。",
          "runtime": 0,
          "tagline": "",
          "title": "叛谍猎手"
