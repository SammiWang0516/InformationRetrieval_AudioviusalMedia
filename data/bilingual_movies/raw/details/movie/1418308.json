  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A group of friends stumbles upon an ancient board game hidden in a remote temple. Once the die is cast, a vengeful spirit is unleashed, turning the game into a deadly trap. To survive, they must figure out how to end it before they become its next victims.",
          "runtime": 125,
          "tagline": "Roll the dice. Stay alive. Till sunrise.",
          "title": "Ghost Board"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "เรื่องราวของเด็กกลุ่มหนึ่ง ที่โดนลงโทษให้ไปทำความสะอาดวัดป่า และบังเอิญได้พบกับกล่องโบราณที่ถูกซ่อนเอาไว้ในโบสถ์ร้าง พวกเขาทำวัตถุชิ้นหนึ่งตกลงสู่พื้น และชีวิตของเด็กกลุ่มนี้ก็ไม่เหมือนเดิมอีกต่อไป เพราะสิ่งนั้นคือลูกเต๋าจากเกมกระดานอาถรรพ์ ที่เมื่อได้ทอยแล้วจะปลดปล่อยความสยองเกินคาดเดา ทางเดียวที่จะเอาชีวิตรอด คือต้องเผชิญหน้ากับผี และเอาชนะมันให้ได้ก่อนรุ่งสาง!",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "一群朋友在一个偏僻的寺庙中发现了一副古老的棋盘游戏。一旦骰子掷出，一个复仇的幽灵便被释放，游戏变成致命的陷阱。为了生存，他们必须设法结束这场游戏，否则就会成为下一个受害者。",
          "runtime": 0,
          "tagline": "",
          "title": "通灵棋盘"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "",
          "runtime": 0,
          "tagline": "",
          "title": "Джуманджи: Тёмный уровень"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "벌을 받고 오래된 숲속 법당을 청소하러 온 아이들은 버려진 예배당 안에서 오래된 상자를 발견한다. 상자에서 꺼낸 정체불명의 물체가 바닥에 떨어지는 순간, 저주받은 보드게임이 깨어난다. 살아남으려면 동이 트기 전까지 깨어난 영혼들과 맞서 싸워 이겨야 한다.",
          "runtime": 0,
          "tagline": "",
          "title": "고스트 보드게임"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Mỗi lần gieo xúc xắc là mỗi lần quỷ xuất hiện. Trong lúc dọn dẹp một ngôi đền bỏ hoang, một nhóm trẻ vô tình tìm thấy bàn cờ cổ bị phong ấn từ lâu. Sau khi gieo viên xúc xắc bí ẩn và đọc lên những câu đồng dao kỳ lạ, chúng nhận ra mình đã bắt đầu một trò chơi chết chóc. Mỗi lượt chơi đều kéo theo sự xuất hiện của những linh hồn đáng sợ, buộc cả nhóm phải tìm cách phá giải lời nguyền trước khi trời sáng.",
          "runtime": 0,
          "tagline": "",
          "title": "Đồng Dao Ma Quái"
        }
      },
      {
        "iso_3166_1": "HK",
