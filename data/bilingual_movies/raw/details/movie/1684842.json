  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Three girls try to flee their village to escape the superstitions and fanatic hostility surrounding them. Only the blind girl makes it out, finding herself face-to-face with an elephant.",
          "runtime": 81,
          "tagline": "Between blindness and belief.",
          "title": "The Blind Girl and an Elephant"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "孟加拉的一座偏远乡村似乎被文明社会遗忘，依旧被宗教桎梏和陋习偏见笼罩。失明的莫米、在校少女希玛与怀有身孕的莱莉，三人渴望逃离故土，奔赴自由文明的城市。一次偷偷外出时偶遇大象，唤醒了她们心底的好奇与反抗意识。然而家人的控制与村民的打压如此强势，最后谁可以成功逃离？这是年仅25岁的孟加拉新锐导演历经多年打磨的剧情长片首作，倾注导演诸多私人情感体验，以黑白影像叩问现实记忆与日常生活的裂缝。",
          "runtime": 81,
          "tagline": "",
          "title": "盲女与大象"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "В деревне, пострадавшей от пандемии, три юные девушки мечтают вырваться из уготованной им судьбы. Их пути постепенно расходятся на фоне насилия, принудительных браков и публичных унижений. Лишь Моми, слепая девочка, отправляется во внутреннее путешествие, ведомая видением таинственного слона, который становится символом надежды и возможности обрести свободу. Современная притча о притеснении, стойкости и непреодолимом стремлении к освобождению.",
          "runtime": 81,
          "tagline": "",
          "title": "Слепая девочка и слон"
        }
      }
    ]
  },
