        }
      },
      {
        "iso_3166_1": "IT",
        "iso_639_1": "it",
        "name": "Italiano",
        "english_name": "Italian",
        "data": {
          "homepage": "",
          "overview": "L'Undisputed WWE Universal Championship sarà in palio quando Roman Reigns difenderà il suo titolo contro il vincitore del Royal Rumble 2024, Cody Rhodes. Lo Scottish Warrior Drew McIntyre avrà finalmente la possibilità di vincere un titolo mondiale di fronte alle masse mentre affronterà il World Heavyweight Champion Seth \"Freakin\" Rollins allo Showcase of the Immortals. Inoltre, un grande tag team match nella prima serata in cui Cody Rhodes e il World Heavyweight Champion Seth \"Freakin\" Rollins si scontreranno testa a testa con Dwayne \"The Rock\" Johnson e l'Undisputed WWE Universal Champion Roman Reigns in un match con enormi implicazioni per WrestleMania.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
