      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "После ядерного удара, опустошившего Калифорнию, группа ветеранов и преступников оказывается запертой на складе. В мире, где грань между добром и злом стерта, им предстоит сражаться за жизнь, противостоя мародерам, радиации и друг другу.",
          "runtime": 0,
          "tagline": "",
          "title": "Блэкаут"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Na een verwoestende nucleaire aanval op Californië moet een groep veteranen en criminelen, die vastzitten in een pakhuis, vechten om te overleven tegen plunderaars, straling en elkaar in een wereld waar de grens tussen goed en kwaad vervaagd is.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Konflikt USA-Chiny eskaluje. Weterani Noah i Ella Daniels szukają schronienia, ale ich bezpieczna przystań szybko zamienia się w pole bitwy. Kryjówka zostaje zaatakowana przez bezwzględnych złodziei, dowodzonych przez Atticusa Reeda.",
          "runtime": 0,
          "tagline": "",
          "title": "Strefa uderzenia"
