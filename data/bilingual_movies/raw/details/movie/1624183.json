      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "미중 갈등이 임계점에 다다른 가까운 미래. 전직 특수부대원 노아와 아내 엘라는 창고를 거점으로 정부 하청 사업을 운영중이다. 무장 강도 애티커스 리드 일당이 1,200만 달러 상당의 암호화폐 키를 노리고 창고를 습격한 바로 그 순간, 캘리포니아에 핵폭탄이 떨어진다. 전기도, 통신도, 도망칠 곳도 사라진 세상. 군인과 범죄자는 같은 창고 안에 갇힌 채 약탈자와 방사능, 그리고 서로를 상대로 살아남아야 한다.",
          "runtime": 81,
          "tagline": "종말 이후, 진짜 전쟁이 시작된다",
