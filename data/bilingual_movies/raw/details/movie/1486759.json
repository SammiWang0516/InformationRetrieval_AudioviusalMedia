      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Nola, pomoc kucharska, szuka stabilizacji po pobycie w szpitalu psychiatrycznym. Po intensywnej zmianie, po kolacji, rozbija się na rowerze – i budzi się, widząc nad sobą ojca, z którym nie utrzymuje kontaktu i który nie ma dachu nad głową. Kiedy go przyjmuje, stare rany odżywają, a jej świat się rozpada. Rozdarta między przeszłością a teraźniejszością, miłością a stratą, Nola musi zmierzyć się z żałobą, przebaczeniem i kruchą nadzieją na uzdrowienie.",
          "runtime": 83,
          "tagline": "",
          "title": "Seahorse"
        }
