      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "贝尼在机场门口遇到了杰克，两人之间似乎产生了好感。他们的关系在阿姆斯特丹的旅行中逐渐发展，还经历了亲密接触，同时也揭示了其中错综复杂的权力关系。",
          "runtime": 82,
          "tagline": "",
          "title": "陌路同途"
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Benji se encuentra con Jake en la puerta de embarque de un aeropuerto y surge una química instantánea. Su relación se desarrolla a través de viajes a Ámsterdam y momentos de intimidad, revelando unas complejas dinámicas de poder. Una comedia dramática británica imprescindible que disecciona una relación tóxica con humor y emoción en estado puro. Inspirada en un desamor real, lo que empieza como unas emocionantes escapadas mensuales a la capital holandesa pronto se desmorona hasta convertirse en una relación de conveniencia abocada al fracaso. Incapaz de pasar página tras ser abandonado, Benji entra en una espiral de adicción y encuentros esporádicos, atormentado por el amor que perdió.",
          "runtime": 82,
          "tagline": "",
          "title": "Departures"
        }
      }
