      {
        "iso_3166_1": "BE",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Ally erft Timeless Tidings, de winkel die haar grootmoeder Joy in de jaren veertig opende om haar met de hand gedrukte tijdingen te verkopen. Decennialang was de winkel een werk van liefde, toewijding en opoffering voor Joy. Ally heeft die opoffering echter altijd gezien als een last die Joys leven en geluk in de weg stond.  Wanneer Ally terugkeert om de winkel klaar te maken voor verkoop, ontmoet ze Bennett – een oude ziel die vastbesloten is de erfenis van haar grootmoeder te bewaren. Terwijl Ally en Bennett samen de toekomst van Timeless Tidings verkennen, zorgt een vleugje goddelijke tussenkomst ervoor dat ze niet alleen de winkel, maar ook zichzelf door nieuwe — of beter gezegd, oude — ogen leren zien.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Ally erft Timeless Tidings, de winkel die haar grootmoeder Joy in de jaren veertig opende om haar met de hand gedrukte tijdingen te verkopen. Decennialang was de winkel een werk van liefde, toewijding en opoffering voor Joy. Ally heeft die opoffering echter altijd gezien als een last die Joys leven en geluk in de weg stond. Wanneer Ally terugkeert om de winkel klaar te maken voor verkoop, ontmoet ze Bennett – een oude ziel die vastbesloten is de erfenis van haar grootmoeder te bewaren. Terwijl Ally en Bennett samen de toekomst van Timeless Tidings verkennen, zorgt een vleugje goddelijke tussenkomst ervoor dat ze niet alleen de winkel, maar ook zichzelf door nieuwe — of beter gezegd, oude — ogen leren zien.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
