        "data": {
          "homepage": "",
          "overview": "A dauntless film director, an enfant terrible in his early days, confrontational with censorship, always pushing the boundaries of freedom of expression, chronicler of the darkest corners of the transition, De la Iglesia will fall into the clutches of drug addiction, being forgotten and sometimes repudiated for more than a decade before eventually shaking off the ostracism to make films once again, that habit he could never kick.",
          "runtime": 95,
          "tagline": "",
          "title": "Eloy de la Iglesia: Film Addict"
        }
      },
      {
        "iso_3166_1": "ES",
