      {
        "iso_3166_1": "ES",
        "iso_639_1": "ca",
        "name": "Català",
        "english_name": "Catalan",
        "data": {
          "homepage": "",
          "overview": "Documental de Virginia Tangvald que reconstrueix la història de la seva família de navegants, marcada per la llibertat, el mar i la tragèdia. A través d'arxius i testimonis, la directora explora la figura del seu pare, Peter Tangvald, aventurer llegendari, i descobreix les ombres darrere del mite. El film és alhora una recerca d'identitat i una reconciliació amb un passat familiar ple de pèrdues i secrets.",
          "runtime": 0,
          "tagline": "",
          "title": "Els fantasmes del mar"
        }
      }
