        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Een ontvoerd meisje in Augusta beweert dat haar redder Jim was. Deze laatste is echter een overleden politieagent. Rechercheur Wells onderzoekt de zaak terwijl er weer een kind verdwijnt. Hierdoor komen oude moorden aan het licht en rijzen vragen over een spookachtige aanwezigheid.",
          "runtime": 102,
          "tagline": "",
          "title": ""
        }
      },
