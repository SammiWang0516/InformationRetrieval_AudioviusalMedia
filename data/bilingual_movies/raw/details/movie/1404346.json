  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "The Philippines, 1902. The land is raw, wounded, occupied. Smoke clings to the trees. Blood soaks the soil. The war is over – but the violence lingers. Widows fill the villages. Mothers vanish into silence. Among them walks Sisa, barefoot and broken, dismissed as mad by those who fear what they don't understand. But madness is only the surface.",
          "runtime": 114,
          "tagline": "Her silence was survival. Her madness, a weapon. Her mission: revenge.",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Pod łachmanami i bełkotem Sisa skrywa sekret: jest szpiegiem. Ocalałą. Matką ograbioną ze wszystkiego poza wściekłością. Dręczona wizjami, których nie potrafi uciszyć, rozpoczyna cichy bunt – gromadzi kobiety, które, tak jak ona, zostały zepchnięte na margines. Podczas gdy zdrada ją otacza, Sisa balansuje na granicy pamięci i szaleństwa, pytając, co trzeba zrobić, by się podnieść, gdy świat już cię pogrzebał.",
          "runtime": 115,
          "tagline": "Jej milczenie było przetrwaniem. Jej szaleństwo bronią. Jej misja: zemstą.",
          "title": "Sisa"
        }
      },
      {
        "iso_3166_1": "GR",
        "iso_639_1": "el",
        "name": "ελληνικά",
        "english_name": "Greek",
        "data": {
          "homepage": "",
          "overview": "Φιλιππίνες, 1902. Η γη είναι άγρια, πληγωμένη, υπό κατοχή. Ο καπνός είναι κολλημένος στα δέντρα. Το αίμα ποτίζει το χώμα. Ο πόλεμος έχει τελειώσει – αλλά η βία παραμένει. Οι χήρες γεμίζουν τα χωριά. Οι μητέρες χάνονται στη σιωπή. Ανάμεσά τους περπατά η Σίσα, ξυπόλυτη και ράκος, περιφρονημένη ως τρελή από εκείνους που φοβούνται ό,τι δεν καταλαβαίνουν. Όμως η τρέλα είναι μόνο η επιφάνεια.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "时间回到 1902 年，菲美战争落下了残酷血腥的帷幕。太多人成为了战争的牺牲品，阿留就是其中一员，在村民家人惨遭屠杀的劫难中幸存。大家并不知道，她身上藏着秘密，而她正准备用这个秘密来复仇。",
          "runtime": 0,
          "tagline": "",
          "title": "谍女阿留"
        }
      }
    ]
  },
