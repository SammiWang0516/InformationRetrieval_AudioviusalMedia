    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "　　女大学生高冉（管乐 饰）勇敢追求符合自己恋爱标准的阳光开朗大男孩董乐（姚弛 饰），却惨遭拒绝！致力摆脱母胎solo的她，身边却充斥着各种“妖魔鬼怪”。但没关系！糟糕的男士只会让高冉越挫越勇！直到她遇到了非标准恋爱对象张扬（周澄奥 饰），明白了只要勇敢做自己，总会有人来爱你。当标准遇上心动就会不停破例……  　　影片根据清英的漫画《女巨人也要谈恋爱》改编。",
          "runtime": 95,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Gao Ran a 180 meter tall girl, who plays basketball, is chasing God Dong Le. After being rejected she unexpectedly meets Zhang Yang, a designer whom design she destroys. In order to makeup for his loss. Gao Ran becomes Zhang Yang's model. In the process, she finds herself entangled in a series of embarrassing  situations...",
          "runtime": 0,
          "tagline": "",
          "title": "Tall Girl"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "鐵憨憨籃球少女高冉（管樂 飾）一記扣殺，直接幹翻脆皮打工人張揚（周澄奧 飾），將張揚的設計成果毀于一旦！為了彌補他的損失，高冉只能親自上陣充當張揚的模特。就這樣，在相互幫助和激勵的過程中，兩個人擦出了愛情的火花，不僅解決了問題，還上演了一出輕鬆幽默的愛情故事。",
          "runtime": 95,
          "tagline": "",
          "title": "非標準戀愛"
