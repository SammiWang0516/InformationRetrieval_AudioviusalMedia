  "translations": {
    "translations": [
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "When ten-year-old Alice's parents mysteriously vanish one day, she turns to a spirited group of young detectives for help. Their mission becomes more challenging when her brother Milan must join their investigation. He can't be left alone, and wherever Alice goes, he goes too. Milan sees and experiences the world differently, and what starts as a complication soon becomes their greatest strength. The children discover creative and heartwarming ways to connect with Milan, and his unique perspective proves invaluable to their detective work. Together, this unlikely team embarks on an extraordinary adventure, unraveling clues and solving a mystery bigger than they ever imagined. Through friendship, understanding, and courage, they not only crack the case but also discover something even more precious: the power of acceptance, the magic of true teamwork, and bonds that will last a lifetime.",
          "runtime": 83,
          "tagline": "Sometimes the greatest detectives see the world differently.",
          "title": "Extraordinary"
        }
      },
      {
        "iso_3166_1": "HR",
        "iso_639_1": "hr",
        "name": "Hrvatski",
        "english_name": "Croatian",
        "data": {
          "homepage": "",
          "overview": "Nakon tajanstvenog nestanka roditelja, desetogodišnja Alisa kreće u potragu s ekipom dječaka detektiva i svojim neobičnim bratom koji svijet doživljava drukčije. Upravo njegova jedinstvena perspektiva postaje neočekivani ključ razotkrivanja misterije.",
          "runtime": 83,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "LV",
        "iso_639_1": "lv",
        "name": "Latviešu",
        "english_name": "Latvian",
        "data": {
          "homepage": "",
          "overview": "Pēc Alisas domām, ar viņas brāli Milanu viss ir sarežģīti. Arī uz laukiem ģimenei jāpārceļas brāļa dēļ – viņam tur būšot labāk. Bet kā ar Alisu? Par to, lai viņai būtu labāk, šķiet, neviens pat neiedomājas. Negaidīti Alisa uzzina, ka Milanu varētu izņemt no ģimenes. Tas nedrīkst notikt! Bet vecāki ir kā zemē iekrituši. Kā lai viņus atrod, ja Milanu vienu atstāt nedrīkst? Pēkšņi uzrodas vietējie puikas detektīvi. Viņi arī Milanu ir gatavi ņemt komandā. Bērni dodas meklēt pazudušos vecākus. Pavedieni ved uz pilsētu, un bērni atklāj noziegumu, kas izrādās lielāks, nekā sākumā varētu šķist.",
          "runtime": 83,
          "tagline": "",
          "title": "Misija: atrast vecākus"
        }
      },
      {
        "iso_3166_1": "SI",
        "iso_639_1": "sl",
        "name": "Slovenščina",
        "english_name": "Slovenian",
        "data": {
          "homepage": "",
          "overview": "Ko nekega dne skrivnostno izginejo starši desetletne Alise, se po pomoč obrne na živahno skupino mladih detektivov. Njihova naloga postane še zahtevnejša, ko se mora preiskavi pridružiti njen brat Milan. Ne more ostati sam, in kamorkoli gre Alisa, gre tudi on. Milan svet vidi in doživlja drugače, in kar se sprva zdi zaplet, kmalu postane njihova največja prednost. Otroci odkrijejo ustvarjalne in ganljive načine, kako se povezati z Milanom, njegova edinstvena perspektiva pa se izkaže za neprecenljivo pri njihovem detektivskem delu. Skupaj se ta nenavadna ekipa poda na izjemno pustolovščino, razpleta sledi in rešuje skrivnost, večjo, kot so si kdaj koli predstavljali. Skozi prijateljstvo, razumevanje in pogum ne razvozlajo le primera, temveč odkrijejo tudi nekaj še dragocenejšega: moč sprejemanja, čar pravega timskega duha in vezi, ki bodo trajale vse življenje.",
          "runtime": 0,
          "tagline": "Včasih najboljši detektivi vidijo svet malo drugače.",
          "title": "Bučko"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "부모가 갑자기 사라진 열 살 앨리스는 어린이 탐정단과 함께 수사에 나선다. 세상을 특별한 방식으로 바라보는 오빠 밀란과 함께 단서를 좇으며, 아이들은 우정과 협력, 그리고 서로를 이해하는 힘을 배워간다.",
          "runtime": 83,
          "tagline": "",
          "title": "엄마 아빠가 최면에 걸렸어요!"
        }
      }
    ]
  },
