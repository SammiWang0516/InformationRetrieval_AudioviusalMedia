  "translations": {
    "translations": [
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "　　女儿木木的出生，让年轻的聋人夫妻小马和晓静的生活有了新的希望。一家三口和同为听障人士的红姐互相帮扶着克服生活的苦，使用手语交流的他们如同少数族裔般孤独地生活在健听人中间。他们的共同心愿是木木可以像健全人一样健康快乐地长大。可木木直到该上小学的年纪还是迟迟没有开口讲话。小马接受不了女儿和他们是一样的，也因此和晓静发生了不少争执。然而木木不说话的理由，却是所有人都想不到的……",
          "runtime": 111,
          "tagline": "你没说的话 其实我都懂",
          "title": "不说话的爱"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Deaf Xiao Ma and his daughter Mumu rely on each other for companionship. The little \"big sister\" Mumu serves as the family's pillar—bridging communication between her father and the outside world, helping him secure work and earn a living. However, as Mumu grows older, she must integrate into the hearing world, and their inseparable life is about to be disrupted. Just then, a criminal syndicate that specifically preys on the deaf sets its sights on Xiao Ma. Desperate to protect his daughter, he is gradually lured step by step into the abyss of crime...",
          "runtime": 111,
          "tagline": "My life is worth nothing without my daughter.",
          "title": "Mumu"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "聾人小馬（張藝興飾）和女兒木木（李珞桉飾）彼此為伴，木木是家中「頂樑柱」，替爸爸和外界溝通，幫爸爸接工作賺錢。然而隨著木木的長大，她必須要融入聽人的世界，兩人形影不離的生活即將被打破。就在此時，一個專門利用聾人犯罪的團夥盯上了小馬，愛女心切的他一步步被騙入了犯罪的深淵. . . . .",
          "runtime": 0,
          "tagline": "",
          "title": "不説話的愛"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "聾人小馬和女兒木木彼此為伴，木木是家裡的支柱，替爸爸和外界溝通，幫爸爸接工作賺錢。然而隨著木木長大，她必須要融入聽人的世界，兩人形影不離的生活即將被打破。就在此時，一個專門利用聾人犯罪的集團盯上了小馬，愛女心切的他一步步被騙入了犯罪的深淵…",
          "runtime": 0,
          "tagline": "",
          "title": "不說話的愛"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Bộ phim xoay quanh cuộc sống của Tiểu Mã (Trương Nghệ Hưng thủ vai) – một người cha khiếm thính sống cùng con gái Mộc Mộc. Trong suốt thời thơ ấu, Mộc Mộc trở thành cầu nối giúp cha giao tiếp và hòa nhập với xã hội. Tuy nhiên, khi cô bé trưởng thành, mong muốn được bước ra thế giới bình thường của người nghe khiến mối quan hệ cha con bắt đầu đối diện với khoảng cách và mâu thuẫn. Một biến cố bất ngờ xảy ra, buộc cả hai phải đưa ra những lựa chọn quan trọng để tìm lại nhau…",
          "runtime": 0,
          "tagline": "",
          "title": "Tình Yêu Không Thể Nói Thành Lời"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "เสี่ยวหม่าหูหนวกและมู่มู่ลูกสาวของเขาอยู่เคียงข้างกันและกัน มู่มู่ที่อายุน้อยแต่โตเป็นผู้ใหญ่เป็น \"เสาหลัก\" ของครอบครัว คอยสื่อสารกับโลกภายนอกให้กับพ่อของเธอและช่วยเขาหาเลี้ยงชีพ แต่เมื่อมู่มู่เติบโตขึ้น เธอต้องปรับตัวให้เข้ากับโลกของการได้ยินและชีวิตที่แยกจากกันไม่ได้ของทั้งสองกำลังจะพังทลาย อุบัติเหตุไม่เพียงทำให้เสี่ยวหม่าเสียใจเท่านั้น แต่ยังทำให้มู่มู่ตัดสินใจเรื่องหนึ่งอย่างลับ ๆ อีกด้วย...",
          "runtime": 0,
          "tagline": "",
          "title": "รักที่ไม่เอื้อนเอ่ย"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Фильм повествует о Сяо Ма, человеке с нарушениями слуха и речи, и его дочери Муму. Жизнь Сяо Ма не из легких, ведь ему приходится преодолевать множество трудностей, связанных с его инвалидностью, и в то же время быть опорой своему ребенку. Однако несмотря на все препятствия, любовь и связь между отцом и дочерью остается неизменно сильной и поддерживает их в самые сложные моменты. Этот фильм представляет собой трогательное и вдохновляющее повествование о семейных узах, преодолении и взаимопонимании. Он показывает, как преодолевать жизненные испытания с достоинством и любовью.",
          "runtime": 0,
          "tagline": "",
          "title": "Безмолвная любовь"
        }
