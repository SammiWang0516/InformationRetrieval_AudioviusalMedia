      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "与成瞎子齐名的捉刀人“豺狗”裴兴以“打不死”著称，向来奉行拿命换钱、不问是非的生存之道。冷血麻木的他在亲眼见证坚守公义的好友接连遭到强权杀害后，沉寂已久的侠义之心逐渐被唤醒。为了替好友讨回公道，裴兴决定打破捉刀人的规矩，以牙还牙、严惩恶人。然而这一选择也让他成为其他捉刀人的目标，一场属于捉刀人之间的生死较量由此展开……",
          "runtime": 90,
          "tagline": "捉刀办事 拿命换钱",
          "title": "捉刀人"
        }
      },
      {
        "iso_3166_1": "HK",
