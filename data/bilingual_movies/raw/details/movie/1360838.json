      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "자칼로 알려진 페이 싱은 한때 아무런 감정 없이 돈을 위해 생명을 거래했다. 그러나 정의를 위해 싸우는 이들이 권력자들에게 짓밟히는 것을 목격한 후, 그의 정의감이 깨어난다. 이제 그는 악을 처단하며 복수를 다짐하고, 다른 실력 있는 검객들과 대결을 벌인다.",
          "runtime": 0,
          "tagline": "",
          "title": "착도인"
        }
      },
      {
        "iso_3166_1": "TH",
        "iso_639_1": "th",
        "name": "ภาษาไทย",
        "english_name": "Thai",
        "data": {
          "homepage": "",
          "overview": "\"ดาบคลั่ง\" ได้รับการอัปเกรดแล้ว นักดาบ \"หมาจิ้งจอก\" เผยซิ่ง (รับบทโดย ชื่อเสี่ยวหลง) มีชื่อเสียงเลื่องลือว่า \"ฆ่าไม่ตาย\" เขาเป็นนักฆ่าเลือดเย็นและเย็นชาที่ฆ่าเพียงเพื่อเงิน หลังจากเห็นผู้ที่ยืนหยัดเพื่อความยุติธรรมถูกกำจัดโดยผู้มีอำนาจ ความเป็นอัศวินที่แฝงอยู่ของเขาค่อย ๆ ตื่นขึ้นและเขาตัดสินใจที่จะตอบโต้ในลักษณะเดียวกัน บนเส้นทางแห่งการแก้แค้นเพื่อลงโทษผู้กระทำความชั่ว เขายังต้องแข่งขันกับนักดาบที่มีทักษะสูงหลายคนด้วย",
          "runtime": 0,
          "tagline": "",
          "title": "ดาบคลั่ง"
        }
      },
