      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "城市青年阿南德年过三十，因父亲去世不得不前往印度西部粗犷乡村服丧十日，期间与当地一位竭力保持单身的农民建立了温情纽带。随着丧期结束、归期迫近，阿南德必须为这段关系的未来做出抉择。",
          "runtime": 0,
          "tagline": "",
          "title": "仙人掌梨"
        }
