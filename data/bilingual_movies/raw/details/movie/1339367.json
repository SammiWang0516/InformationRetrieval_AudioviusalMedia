  "translations": {
    "translations": [
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Santiago, un cabo de la policía argentina, cruza la frontera hacia Uruguay huyendo de otros agentes policiales que lo andan buscando. Valiéndose de su uniforme, va inspeccionando puestos de comida regional, probando lácteos y embutidos para sobrevivir, al tiempo que intenta pasar desapercibido entre los lugareños. Sin dinero ni hospedaje pero con empatía y astucia, comienza a tramar una nueva vida, recibiendo la ayuda de personajes locales que va cruzando en el camino e, incluso, encuentra a quien cree puede ser el amor de su vida.",
          "runtime": 93,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Santiago, an Argentine police corporal, crosses the border into Uruguay fleeing from other police officers who are looking for him. Using his uniform, he inspects regional food stalls, sampling dairy products and cold cuts to survive, while trying to go unnoticed among the locals. Without money or lodging, but with empathy and cunning, he begins to plot a new life, receiving help from local characters he meets along the way and even finding what he believes to be the love of his life.",
          "runtime": 95,
          "tagline": "",
          "title": "A Loose End"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Santiago, argentyński policjant, przekracza granicę z Urugwajem, uciekając przed innymi policjantami podążającymi jego tropem. Wykorzystując swój mundur, sprawdza lokalne stragany z jedzeniem, testując nabiał i wędliny, aby przetrwać, starając się jednocześnie pozostać niezauważonym wśród miejscowych. Nie mając ani pieniędzy, ani miejsca do spania, ale dzięki życzliwości i dowcipowi, zaczyna budować nowe życie, otrzymując pomoc od lokalnych postaci, które pojawiają się na jego drodze, a nawet spotykając osobę, która jego zdaniem może być miłością jego życia.",
          "runtime": 95,
          "tagline": "",
          "title": "Un cabo suelto"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "阿根廷一名低级警员逃往乌拉圭，躲避追捕他的警察。在没有钱财和住处的情况下，他凭借机智与热心应对困境，得到当地人的帮助，并邂逅了可能成为人生挚爱的人",
          "runtime": 0,
          "tagline": "",
          "title": "亡命警探"
        }
      },
      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Santiago, een Argentijnse politieagent, steekt de grens over naar Uruguay op de vlucht voor andere agenten die naar hem op zoek zijn. In zijn uniform inspecteert hij kraampjes met streekproducten, waar hij zuivelproducten en vleeswaren proeft om te overleven, terwijl hij probeert onopgemerkt te blijven tussen de lokale bevolking. Zonder geld of onderdak, maar met empathie en slimheid, begint hij een nieuw leven te plannen. Hij krijgt hulp van lokale figuren die hij onderweg ontmoet en vindt zelfs wat hij denkt dat de liefde van zijn leven is.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      }
    ]
