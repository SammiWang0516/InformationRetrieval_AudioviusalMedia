  "translations": {
    "translations": [
      {
        "iso_3166_1": "JP",
        "iso_639_1": "ja",
        "name": "日本語",
        "english_name": "Japanese",
        "data": {
          "homepage": "https://enjou-movie.jp/",
          "overview": "両親に厳しく育てられ、自身の感情を表現することが苦手な主人公・小林樹里恵（通称・じゅじゅ）。家族との関係に耐え切れず、家を飛び出した彼女は、SNSを頼りに新宿・歌舞伎町に辿り着く。初めて知る新たな世界で、様々な人との出会いを経て、自分の意思を持つことができるようになった彼女にとって唯一の安心できる居場所となったはずだったが……。",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "When runaway teen Ju-Ju is embraced by a tribe of misfit youths in Kabukicho, she finds belonging for the first time — until betrayal and despair twist her haven into a prison, and she's left with one way to take back control.",
          "runtime": 103,
          "tagline": "Want to know why I set fire to Kabuki-cho?",
          "title": "BURN"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "가출 청소년 주주는 가부키초의 아웃사이더 무리에 받아들여지면서 생애 처음으로 소속감을 느낀다. 그러나 배신과 절망이 안식처를 감옥으로 뒤바꾸고, 주주에게는 삶의 주도권을 되찾기 위한 단 하나의 선택만이 남게 된다.",
          "runtime": 0,
          "tagline": "",
          "title": "염상"
        }
      },
      {
        "iso_3166_1": "TW",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "歌舞伎町街頭，離家少女闖入一群邊緣青年共築的烏托邦。他們以愛情旅館為家，收容每一個破碎的靈魂。在自由的新樂園裡，藍色特調下肚便能望見滿天星斗，短暫忘卻家庭陰霾，但成長的代價也隨之而來。逃亡究竟是美好新生開局，抑或是毀滅的序曲？",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "歌舞伎町街头，离家少女闯入一群边缘青年共筑的乌托邦。他们以爱情旅馆为家，收容每一个破碎的灵魂。在自由的新乐园裡，蓝色特调下肚便能望见满天星斗，短暂忘却家庭阴霾，但成长的代价也随之而来。逃亡究竟是美好新生开局，抑或是毁灭的序曲？",
          "runtime": 0,
          "tagline": "",
          "title": "炎上"
        }
      },
      {
        "iso_3166_1": "HK",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "邪教家庭長大的口吃少女，每天祈求脫離家暴。出走到新宿的邊青樂園，在那裏感到被接納，彷彿獲得新生。喝下神奇特飲飄飄欲仙，遇見同樣不幸的女孩相濡以沫，一起在人慾橫流的社會賺快錢，期望能把家中妹妹也解救出來。長久允在《喪青獻世樂團》(43屆)後，再以其濃烈絢爛的影像風格，將市川崑的《炎上》改頭換面移植到今日東京街頭，把失序青春變成目迷五色的萬花筒。歌舞伎町燃起桃紅烈燄，森七菜演繹由天國墮向地獄的150天，一雙清澈無辜的大眼睛，將要看透美與毀滅的關係。",
          "runtime": 0,
          "tagline": "",
          "title": "歌舞伎町炎上事件"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Когда сбежавшая из дома девушка-подросток по имени Джу-Джу находит приют в компании таких же изгоев в квартале Кабукитё, она впервые ощущает, что нашла свое место. Но предательство и отчаяние превращают этот «островок безопасности» в тюрьму. У неё остается только один способ вернуть себе контроль над своей жизнью.",
          "runtime": 103,
          "tagline": "",
          "title": "Гори"
        }
      }
    ]
  },
