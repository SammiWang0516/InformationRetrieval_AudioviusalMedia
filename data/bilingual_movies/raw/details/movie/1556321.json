      {
        "iso_3166_1": "BR",
        "iso_639_1": "pt",
        "name": "Português",
        "english_name": "Portuguese",
        "data": {
          "homepage": "",
          "overview": "Ambientado na década de 1960 em Kanchanaburi, na Tailândia, acompanhe o soldado Yak e o Sargento Paphan em uma missão de resgate na densa floresta de Khao Khwang. Lá, eles enfrentam o lendário Saming, um espírito de tigre devorador de homens que consegue assumir a forma humana.",
          "runtime": 0,
          "tagline": "",
          "title": "Death Whisperer: Saming the Werebeast"
        }
      },
      {
        "iso_3166_1": "BG",
        "iso_639_1": "bg",
        "name": "български език",
        "english_name": "Bulgarian",
        "data": {
          "homepage": "",
          "overview": "Проследява търсенето на изчезнал военен офицер в джунглата на Кхао Кхванг, където легендата гласи, че духът на човекоядния тигър Саминг приема човешка форма в Тайланд през 60-те години.",
          "runtime": 0,
          "tagline": "",
          "title": "Смъртоносен шепот: Саминг върколакът"
        }
      },
      {
        "iso_3166_1": "VN",
        "iso_639_1": "vi",
        "name": "Tiếng Việt",
        "english_name": "Vietnamese",
        "data": {
          "homepage": "",
          "overview": "Cuộc gặp gỡ đầu tiên giữa Yak và Trung sĩ Paphan khi cả hai dấn thân vào một nhiệm vụ sinh tử: truy tìm một người đàn ông mất tích. Dẫn đầu toán quân tiến sâu vào vùng hiểm địa âm u, họ phải đối mặt với Hổ tinh ăn thịt người vùng Khao Khwang, kẻ sở hữu khả năng biến hóa khôn lường thành muôn hình vạn trạng. Bị bủa vây giữa ngàn trùng nguy hiểm của rừng thiêng, Yak và Trung sĩ Paphan chỉ còn một con đường duy nhất: sát cánh chiến đấu để sinh tồn và vạch trần sự thật tàn khốc trước khi chính họ trở thành mồi ngon tiếp theo của nó.",
          "runtime": 0,
          "tagline": "",
          "title": "Quỷ Ăn Tạng 4: Hổ Tinh"
        }
      },
