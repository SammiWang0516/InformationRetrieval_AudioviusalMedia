  "translations": {
    "translations": [
      {
        "iso_3166_1": "LT",
        "iso_639_1": "lt",
        "name": "Lietuvių",
        "english_name": "Lithuanian",
        "data": {
          "homepage": "",
          "overview": "Turtingas ir darbštus ūkininkas turėjo vienintelį sūnų. Pasinėręs į bohemišką sostinės gyvenimą, jis gyveno nerūpestingai – tapydavo paveikslus, kai užeidavo įkvėpimas, linksmindavosi, kada panorėjęs, o merginos pačios krisdavo jam į lovą viena po kitos. Jų vardų jis net nebeprisiminė. Kai gyvenimas toks smagus, kam, po galais, svajoti apie tėvo žemes ir traktoriaus vairavimą?\r Tačiau vieną dieną viskas apsivertė aukštyn kojomis. Nuleidęs galvą, palaidūnas sūnus grįžo pas tėvą.",
          "runtime": 95,
          "tagline": "",
          "title": "Milijonieriaus jubiliejus"
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "A wealthy, hard-working farmer has an only son. Immersed in the bohemian lifestyle of the capital, he lives a carefree life—painting pictures when he feels like it, partying when he feels like it, with girls falling into his bed one after another. It's hard to even remember their names. When life is so fun, who would dream of taking over their father's land and driving a tractor? But one day, life is turned upside down. With his head bowed, the prodigal son returns to his father.",
          "runtime": 96,
          "tagline": "",
          "title": "The Millionaire’s Anniversary"
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Комедия Тадаса Видмантаса о миллионерах. Сын-гуляка меняет богему на ферму отца, когда его мир рушится. Дома он застает отца с молодой пассией. Вместе им предстоит устроить юбилей по литовским традициям. Это веселая история о семье, богатстве и переменах.",
          "runtime": 0,
          "tagline": "",
          "title": "Юбилей миллионера"
        }
      }
    ]
