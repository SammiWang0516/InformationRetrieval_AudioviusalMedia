      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Alma Lancaster, 18, lijkt een perfect leven te leiden in een welgestelde familie die denkt dat ze rechten studeert. In het geheim jaagt ze op haar ware droom: films maken. Op de campus ontmoet ze Vadim Arcadi, 20, een magnetische en solitaire rebel met een beladen verleden. Gedwongen om samen te werken aan een studentenfilm, botsen ze, groeien ze naar elkaar toe en worden ze verliefd — tegen wil en dank. Maar iemand houdt hen in de gaten, vastbesloten hen uit elkaar te drijven en geheimen te onthullen die zowel Alma als Vadim kunnen verwoesten.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
