    "translations": [
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Toni Lomas alcanzó la fama cuando participó en un exitoso talent show. Ahora no tiene donde caerse muerto. Su situación cambia cuando Malena, un amor del pasado, le pone en contacto con Junior, el hijo de un rico empresario, para que robe un valioso cuadro de la casa familiar. Para llevar a cabo el golpe, Toni buscará dos aliados: la Mari y el Gallego, formando un equipo en el que cada uno persigue sus propios intereses.",
          "runtime": 97,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "US",
        "iso_639_1": "en",
        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Toni, once a famous singer, now has gambling debts and struggles to make ends meet. His luck changes when Malena, a former lover, introduces him to Junior, a wealthy young man, ready to hire him to steal a priceless painting from his own mother. To carry out this supposedly easy heist, Toni recruits a clumsy crew, forming a team in which each one pursues their own interests.",
          "runtime": 0,
          "tagline": "",
          "title": "A Sucker's Born Every Minute"
        }
      },
      {
        "iso_3166_1": "UA",
        "iso_639_1": "uk",
        "name": "Український",
        "english_name": "Ukrainian",
        "data": {
          "homepage": "",
          "overview": "Колись Тоні здобув славу на талант-шоу, а нині він боржник, готовий на все заради грошей. Доля знайомить його з іншим пройдисвітом – мажором, який замовляє викрадення неоціненної картини... з будинку своєї ж матері. Тоні збирає команду незграбних спільників, та «легка справа» обертається справжнім хаосом.",
          "runtime": 0,
          "tagline": "",
          "title": "Хто кого навколо пальця"
        }
      }
    ]
  },
