        "name": "English",
        "english_name": "English",
        "data": {
          "homepage": "",
          "overview": "Three friends are caught between the pressures of life and the promise of instant wealth through a crow satay ritual. But when ghosts begin to appear incessantly, they must choose: continue serving for money, or stop before everything spirals out of control.",
          "runtime": 105,
          "tagline": "Awas ketagihan.",
          "title": "Crow Satay Supernatural Wealth Ritual"
        }
      },
