      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "莱奥诺加入了一家当代舞蹈团，试图揭开《祈祷》这部神秘舞作的秘密——这是一部三十年前由她的母亲演出的传奇作品。她希望借此探明是什么击碎了母亲的人生。在此过程中她发现了一种近乎仪式般的舞蹈实践：每一个动作都仿佛在召唤过去的幽灵，重新撕开一个家族传承中的旧日伤口。",
          "runtime": 0,
          "tagline": "",
          "title": "灰烬中的祈祷"
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Leonor, meksykańska tancerka niedawno zatrudniona przez montrealską grupę, pragnie rozwikłać tajemnicę „Oraison”, legendarnego spektaklu, który jej matka wykonała trzydzieści lat temu, mając nadzieję na zrozumienie, co ją złamało. Odkrywa rytuał, w którym każdy gest przywołuje duchy przeszłości i otwiera rany rodu.",
          "runtime": 90,
          "tagline": "",
          "title": "Oraison"
