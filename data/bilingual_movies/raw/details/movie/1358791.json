      },
      {
        "iso_3166_1": "MX",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Carola vive en el desierto de Atacama con su padre, Pacífico, explotando una mina de cobre, aunque ocultan un secreto: una veta de oro. Tras un enfrentamiento violento con un minero intruso, Pacífico queda herido. Carola toma su lugar en la mina, desafiando su propia juventud y la hostilidad de los demás mineros para alcanzar su sueño de una casa junto al mar..",
          "runtime": 83,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "ES",
        "iso_639_1": "es",
        "name": "Español",
        "english_name": "Spanish",
        "data": {
          "homepage": "",
          "overview": "Oro Amargo nos transporta a las profundidades del desierto de Atacama, sumergiéndonos en la minería artesanal del norte de Chile. La trama sigue a un pirquinero y su hija mientras enfrentan los peligros de una mina ilegal de oro, un entorno hostil donde la muerte siempre acecha, y donde ella deberá aprender a sobrevivir.",
          "runtime": 83,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Dieser Neo-Western spielt in der aussterbenden Welt des handwerklichen Bergbaus im Norden Chiles. Im Mittelpunkt stehen die Kämpfe und das Empowerment einer jungen Frau, die gegen patriarchalische Strukturen und das Gesetz des Dschungels um den Erhalt des Familienunternehmens kämpft.",
          "runtime": 83,
          "tagline": "",
          "title": "Bitter Gold"
        }
      },
      {
        "iso_3166_1": "CZ",
        "iso_639_1": "cs",
        "name": "Český",
        "english_name": "Czech",
        "data": {
          "homepage": "",
          "overview": "V poušti Atacama provozuje šestnáctiletá Carola s otcem tajný zlatý důl. Když se otec zraní, Carola ho musí zastoupit.",
          "runtime": 0,
          "tagline": "",
          "title": "Cena zlata"
        }
      },
      {
        "iso_3166_1": "RO",
        "iso_639_1": "ro",
        "name": "Română",
        "english_name": "Romanian",
        "data": {
          "homepage": "",
          "overview": "Când tatăl său este rănit, Carola ajunge în fruntea unei echipe de mineri și trebuie să lupte cu lăcomia, misoginia și amenințările din jur pentru a le proteja viitorul.",
          "runtime": 83,
          "tagline": "",
          "title": "Aur amar"
        }
      },
      {
        "iso_3166_1": "HU",
        "iso_639_1": "hu",
        "name": "Magyar",
        "english_name": "Hungarian",
        "data": {
          "homepage": "",
          "overview": "Az Atacama-sivatagban a 16 éves Carola és apja rézbányájukban egy aranytelérre bukkannak. Amikor az apát megtámadja egy betolakodó bányász és megsérül, Carola veszi át a helyét a bányában, hogy megvalósítsa álmát: egy tengerparti otthont.",
          "runtime": 0,
          "tagline": "",
          "title": "Keserű arany"
        }
      },
      {
        "iso_3166_1": "CN",
        "iso_639_1": "zh",
        "name": "普通话",
        "english_name": "Mandarin",
        "data": {
          "homepage": "",
          "overview": "卡罗拉今年 16 岁，她梦想着接受高等教育，拥有一栋临海小屋，可她却和父亲帕西菲科一同生活在阿塔卡马沙漠腹地。父女二人和一小群矿工靠手工开采眼镜蛇金矿勉强糊口。父女俩瞒着其他人藏着一处宝藏：一条金矿脉，他们只在夜里偷偷开采。和所有人一样，他们渴望改写自己的命运。某天，一名矿工撞破了他们的秘密，粗暴闯入矿洞。为继续追寻心心念念的梦想，卡罗拉决心反抗这片荒野中根深蒂固的父权体系与不成文规矩，同时克服自身的稚嫩与不成熟。",
          "runtime": 0,
          "tagline": "",
          "title": "金砂逆流"
        }
      }
    ]
