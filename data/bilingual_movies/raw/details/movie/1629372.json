      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "https://www.arte.tv/fr/videos/122213-000-A/the-way-we-move/",
          "overview": "Pionnière de l’interprétation musicale en langue des signes, Amber Galloway révèle le lien profond et méconnu entre le monde sourd et la musique. Le film la suit alors qu’elle transmet sa méthode de chansigne à de nouveaux interprètes, jusqu’à un objectif : les conduire, aux côtés de stars internationales, sur les scènes du mythique festival ACL à Austin (Texas, USA).",
          "runtime": 95,
          "tagline": "",
          "title": "The Way We Move - Chansigne : quand le corps devient musique"
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "라이브 음악 전문 미국수어(ASL) 통역사이자 업계를 대표하는 인물인 앰버 갤러웨이를 따라가는 다큐멘터리. 앰버는 음악을 청각장애인 공동체도 온전히 즐길 수 있도록 하는 것을 사명으로 삼고, 그 예술을 후배들에게 전수한다. 뛰어난 교수법을 바탕으로 아직 미숙한 신입 통역사들을 특별한 여정으로 이끌며, 이들이 오스틴 시티 리미츠 음악 페스티벌에서 자신과 함께 활동할 수 있는 실력을 갖추기를 꿈꾼다.",
          "runtime": 95,
          "tagline": "",
          "title": "무대 위 비트는 손짓"
        }
      }
    ]
  },
