      {
        "iso_3166_1": "AE",
        "iso_639_1": "ar",
        "name": "العربية",
        "english_name": "Arabic",
        "data": {
          "homepage": "",
          "overview": "بعد خيانة مدمّرة قضت على شبكتها الاستخباراتية بأكملها، تنطلق قاتلة محترفة نخبوية في مهمة لا هوادة فيها لتفكيك العصابة المسؤولة.",
          "runtime": 86,
          "tagline": "",
