      {
        "iso_3166_1": "DE",
        "iso_639_1": "de",
        "name": "Deutsch",
        "english_name": "German",
        "data": {
          "homepage": "",
          "overview": "Die Geheimagentin Maria Herrera ermittelt undercover an einer Ballettschule, um die Frau eines Kartellbosses auszuspionieren. Doch dann fliegt ihre Tarnung auf und sie muss ums nackte Überleben kämpfen...",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "KR",
        "iso_639_1": "ko",
        "name": "한국어/조선말",
        "english_name": "Korean",
        "data": {
          "homepage": "",
          "overview": "그녀는 암살자였다.\r 발레는 단지 위장이었다.\r 하지만 배신으로 모든 것을 잃었을 때,\r 그녀는 발레 무대를 전장의 무대로 바꾸었다.\r 우아한 몸짓 뒤에 감춰진 치명적인 칼날.\r 그녀의 마지막 무대가 막을 올린다.",
          "runtime": 0,
          "tagline": "",
          "title": "발레리나 어쌔신"
        }
      },
      {
        "iso_3166_1": "SE",
        "iso_639_1": "sv",
        "name": "svenska",
        "english_name": "Swedish",
        "data": {
          "homepage": "",
          "overview": "En kvinnlig lönnmördare börjar med balett som en del av ett uppdrag. Efter att hennes organisation blivit förrådd och utplånad, infiltrerar hon balettvärlden för att hitta förrädaren och besegra det syndikat som jagar henne.",
          "runtime": 86,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "FR",
        "iso_639_1": "fr",
        "name": "Français",
        "english_name": "French",
        "data": {
          "homepage": "",
          "overview": "Une tueuse à gages doit suivre des cours de ballet dans le cadre d’une mission sous couverture. Pendant son infiltration, toute son organisation criminelle est anéantie par une taupe. Dévastée, elle remonte la chaîne hiérarchique pour démanteler le syndicat qui a détruit sa vie, tout en étant traquée par les mêmes personnes qu’elle cherche à éliminer.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "RU",
        "iso_639_1": "ru",
        "name": "Pусский",
        "english_name": "Russian",
        "data": {
          "homepage": "",
          "overview": "Профессиональная киллерша вынуждена записаться в балетную школу, чтобы выполнить особо важное задание. После того, как тайную организацию, на которую она работала, уничтожают, девушке приходится самостоятельно искать виновных. Продвигаясь всё глубже в мир балета, она пытается разоблачить предателя и уничтожить преступный синдикат, разрушивший её жизнь.",
          "runtime": 0,
          "tagline": "",
          "title": "Балерина-убийца"
        }
      }
