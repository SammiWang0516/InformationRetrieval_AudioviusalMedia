      {
        "iso_3166_1": "NL",
        "iso_639_1": "nl",
        "name": "Nederlands",
        "english_name": "Dutch",
        "data": {
          "homepage": "",
          "overview": "Een gevoelig tienermeisje zit tijdens haar vakantie vast met Glenn (O'Connell), de ietwat smakeloze vriend van haar vrijgeestige moeder (Bush), die toevallig ook haar adjunct-directeur is. Om de vakantie te redden, smeedt het meisje in het geheim een ​​plan om het stel uit elkaar te drijven.",
          "runtime": 0,
          "tagline": "",
          "title": ""
        }
      },
      {
        "iso_3166_1": "PL",
        "iso_639_1": "pl",
        "name": "Polski",
        "english_name": "Polish",
        "data": {
          "homepage": "",
          "overview": "Summer liczyła na spokojne lato, ale zamiast tego trafia na wakacje z nowym chłopakiem swojej matki - żenująco wyluzowanym wicedyrektorem jej szkoły. Gdy orientuje się, że ta dwójka naprawdę się do siebie zbliża, postanawia zrobić wszystko, by ich rozdzielić zanim dojdzie do miłosnej katastrofy.",
          "runtime": 0,
          "tagline": "",
          "title": "Lato moich koszmarów"
        }
      }
